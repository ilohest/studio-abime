# --- Sanity ---------------------------------------------------------------
# Récupérables sur https://www.sanity.io/manage (Project ID) après `npx sanity init`.
PUBLIC_SANITY_PROJECT_ID="votre-project-id"
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2025-02-19"

# URL du Studio utilisée par le stega pour rendre les textes cliquables.
# Le Studio n'est plus embarqué : en local il tourne sur http://localhost:3333
# (`npm run studio:dev`), en ligne sur https://studio.studioabime.com.
PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# --- Studio autonome ------------------------------------------------------
# La CLI Sanity n'expose au navigateur QUE les variables préfixées SANITY_STUDIO_
# (le préfixe PUBLIC_ d'Astro y est ignoré) : le Studio a donc son propre jeu.
# Sur Vercel, ces quatre-là vont sur le projet « Studio », les PUBLIC_ sur le site.
SANITY_STUDIO_PROJECT_ID="votre-project-id"
SANITY_STUDIO_DATASET="production"
SANITY_STUDIO_API_VERSION="2025-02-19"
# Origine du site chargée dans l'aperçu du Presentation Tool.
SANITY_STUDIO_SITE_URL="http://localhost:4321"

# --- Édition visuelle (Presentation Tool) ---------------------------------
# "true" en local et sur l'environnement de preview, "false" en production.
# Active le stega, désactive le CDN et bascule les routes en rendu à la demande.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="true"

# Token de lecture (Viewer) — JAMAIS préfixé PUBLIC_, il reste côté serveur.
# À créer dans sanity.io/manage → API → Tokens. Requis pour lire les brouillons.
SANITY_API_READ_TOKEN=""

# Token d'écriture (Editor) — utilisé UNIQUEMENT par `npm run legal:seed`, en
# local, pour créer les brouillons des pages légales. Ni le site ni le build
# n'en ont besoin : il peut rester vide partout ailleurs.
SANITY_API_WRITE_TOKEN=""

# --- Site -----------------------------------------------------------------
PUBLIC_SITE_URL="http://localhost:4321"

# --- Formulaire de contact ------------------------------------------------
# Clé serveur Resend et adresse d’expédition vérifiée dans Resend.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Studio Abîme <contact@studioabime.com>"
CONTACT_TO_EMAIL="elodie@studioabime.com"
# Adresse utilisée lorsque le client répond à son e-mail de confirmation.
CONTACT_REPLY_TO_EMAIL="elodie@studioabime.com"

# --- Écran de maintenance -------------------------------------------------
# Le site peut être masqué derrière un écran de maintenance, activable par la
# cliente dans le back-office (Réglages du site → Écran de maintenance).
#
# Mot de passe qui lève le rideau. Il n'est PAS dans Sanity : le contenu d'un
# dataset est lisible publiquement par l'API. Laissé vide, l'écran s'affiche
# sans formulaire — personne n'entre, pas même vous.
# En production : à poser en variable d'environnement du projet Cloudflare
# « Site » (Settings → Variables and Secrets), chiffrée.
MAINTENANCE_PASSWORD=""

# Court-circuite l'interrupteur du back-office : "on" ferme le site, "off"
# l'ouvre, vide (par défaut) laisse décider Sanity. Sert à travailler l'écran en
# local, et à rouvrir le site en urgence si Sanity est injoignable.
MAINTENANCE_MODE=""

# --- Shopify (boutique headless) ------------------------------------------
# Domaine technique de la boutique, toujours en .myshopify.com (pas le domaine public).
# Visible dans Shopify → Settings → Domains.
PUBLIC_SHOPIFY_STORE_DOMAIN="studio-abime-dev.myshopify.com"

# Jeton Storefront API. Contrairement au token Sanity, il est PUBLIC par conception :
# l'API Storefront est prévue pour être appelée depuis le navigateur (panier, stock).
# Il ne donne accès qu'à la lecture du catalogue et à la gestion des paniers.
#
# Obtention : installer l'app officielle « Headless » depuis le Shopify App Store,
# puis « Create storefront » → jeton d'accès PUBLIC.
# Ne PAS passer par une app personnalisée « legacy » : cette voie est fermée depuis
# janvier 2026 et se désactive au transfert de la boutique vers la cliente.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=""

# Version de l'API Storefront (trimestrielle : 2026-01, 2026-04, 2026-07…).
# À faire évoluer volontairement, jamais automatiquement.
PUBLIC_SHOPIFY_API_VERSION="2026-07"

# Portée `unauthenticated_read_product_inventory` accordée à la vitrine ?
# Elle seule permet de lire le stock réel, donc d'afficher « 12 places restantes »
# à côté du total annoncé par le metafield `studio.quantite_max`.
#
# Obtention : canal Headless → votre vitrine → section Storefront API →
# autorisations → cocher la lecture de l'inventaire des produits.
#
# À laisser sur "false" tant que ce n'est pas fait : l'API ne se contente pas de
# renvoyer un champ vide, elle REJETTE toute requête qui demande le stock — la
# fiche produit disparaîtrait entièrement. `npm run shopify:families` indique
# l'état réel de la portée, quelle que soit la valeur mise ici.
PUBLIC_SHOPIFY_INVENTORY_SCOPE="false"
