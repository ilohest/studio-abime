# --- Sanity ---------------------------------------------------------------
# Récupérables sur https://www.sanity.io/manage (Project ID) après `npx sanity init`.
PUBLIC_SANITY_PROJECT_ID="votre-project-id"
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2025-02-19"

# URL du Studio utilisée par le stega pour rendre les textes cliquables.
# Studio embarqué : "/studio". Studio déployé : "https://studio-abime.sanity.studio".
PUBLIC_SANITY_STUDIO_URL="/studio"

# --- Édition visuelle (Presentation Tool) ---------------------------------
# "true" en local et sur l'environnement de preview, "false" en production.
# Active le stega, désactive le CDN et bascule les routes en rendu à la demande.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="true"

# Token de lecture (Viewer) — JAMAIS préfixé PUBLIC_, il reste côté serveur.
# À créer dans sanity.io/manage → API → Tokens. Requis pour lire les brouillons.
SANITY_API_READ_TOKEN=""

# --- Site -----------------------------------------------------------------
PUBLIC_SITE_URL="http://localhost:4321"
