---
import { VisualEditing } from '@sanity/astro/visual-editing';

import '~/styles/global.css';

import Footer from '~/components/Footer.astro';
import Seo from '~/components/Seo.astro';
import JsonLd from '~/components/JsonLd.astro';
import CustomCursor from '~/components/CustomCursor.astro';
import ServicesRail from '~/components/ServicesRail.astro';
import TextReveal from '~/components/TextReveal.astro';

import { defaultLocale, getLocaleMeta, type Locale } from '~/i18n/config';
import { localizedPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { visualEditingEnabled } from '~/lib/sanity/env';
import type { ImageInput, JsonLdGraph } from '~/lib/seo/jsonLd';
import type { Seo as SeoType, SiteContext } from '~/lib/sanity/types';

interface Props {
  locale: Locale;
  site: SiteContext;
  seo?: SeoType;
  /** Titre de repli quand le document ne définit pas de titre SEO. */
  title: string;
  /** Classe appliquée au <body> — permet à un template d'inverser le thème. */
  bodyClass?: string;
  /** Masque le pied de page pour les vues immersives qui portent leur propre navigation. */
  hideFooter?: boolean;
  /** Affiche le rail de services persistant des pages intérieures. */
  showServicesRail?: boolean;
  /** Active les overlays Sanity uniquement sur les pages dont le contenu provient du CMS. */
  enableVisualEditing?: boolean;
  /** URLs de la même page dans les autres langues (hreflang + sélecteur). */
  alternates?: Partial<Record<Locale, string>>;
  /**
   * Données structurées Schema.org de la page (voir `src/lib/seo/jsonLd.ts`).
   * Une page qui n'en fournit pas n'émet simplement aucun bloc.
   */
  jsonLd?: JsonLdGraph | null;
  /** Vignette de partage de la page, déjà résolue (voir `resolveShareImage`). */
  shareImage?: ImageInput | null;
  /** Description propre au document, employée à défaut de description SEO. */
  descriptionFallback?: string;
  /** Nature de la page pour Open Graph. */
  ogType?: 'website' | 'article';
  /** Dates ISO de l'article — ignorées hors `ogType="article"`. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Rubrique de l'article. */
  section?: string;
  /** Tient la page hors des moteurs (404, confirmation de commande). */
  noIndex?: boolean;
}

const {
  locale,
  site,
  seo,
  title,
  bodyClass = '',
  hideFooter = false,
  showServicesRail = true,
  enableVisualEditing = true,
  alternates = {},
  jsonLd = null,
  shareImage = null,
  descriptionFallback,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  section,
  noIndex = false,
} = Astro.props;

const resolvedBodyClass = [bodyClass, showServicesRail && 'has-services-rail'].filter(Boolean).join(' ');

const meta = getLocaleMeta(locale);
const t = useTranslations(locale);

const alternateEntries = Object.entries(alternates) as [Locale, string][];

/**
 * `x-default` désigne la version servie à qui ne correspond à aucune langue
 * déclarée. Sans elle, Google choisit lui-même — souvent mal. On pointe la
 * langue par défaut du site, qui est aussi celle servie à la racine.
 */
const defaultAlternate = alternates[defaultLocale];
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Le corps de texte est préchargé : il conditionne le premier rendu utile. -->
    <link
      rel="preload"
      href="/fonts/GT-Canon-M-Narrow-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GT-Canon-Mono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo
      locale={locale}
      site={site}
      seo={seo}
      fallbackTitle={title}
      shareImage={shareImage}
      descriptionFallback={descriptionFallback}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      noIndex={noIndex}
    />

    {
      alternateEntries.map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={new URL(href, Astro.site ?? Astro.url).toString()} />
      ))
    }

    {
      defaultAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultAlternate, Astro.site ?? Astro.url).toString()}
        />
      )
    }

    <JsonLd graph={jsonLd} />

    <slot name="head" />

    <TextReveal />
  </head>

  <body class={resolvedBodyClass}>
    <a
      href="#contenu"
      class="type-sous-titre sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-abime focus:px-4 focus:py-2 focus:text-papier"
    >
      {t('nav.skipToContent')}
    </a>

    {/*
      Pas d'en-tête : la navigation vit dans le pied de page. Le composant
      `src/components/Header.astro` reste disponible si une barre de navigation
      devient nécessaire sur les pages intérieures.
    */}
    {showServicesRail && <ServicesRail locale={locale} mode="page" homeHref={localizedPath(locale)} />}

    <main id="contenu" data-page-content={showServicesRail ? '' : undefined}>
      <slot />
    </main>

    {!hideFooter && <Footer locale={locale} site={site} alternates={alternates} />}

    <CustomCursor />

    {/*
      Overlay d'édition visuelle : monté uniquement en mode preview.
      Combiné au stega, il rend chaque texte cliquable et remonte les
      modifications au Presentation Tool.
    */}
    {enableVisualEditing && visualEditingEnabled && <VisualEditing enabled />}
  </body>
</html>
