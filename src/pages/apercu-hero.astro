---
/**
 * ⚠️ PAGE TEMPORAIRE — À SUPPRIMER une fois le CMS alimenté.
 *
 * Permet de visualiser le hero avec des contenus figés, tant qu'aucun projet
 * Sanity n'est branché. Une fois la page d'accueil créée dans le Studio, ce
 * fichier n'a plus de raison d'être (sinon il reste publié sur /apercu-hero).
 */
import '~/styles/global.css';
import ManifestoHero from '~/components/sections/ManifestoHero.astro';
import type { ManifestoHero as ManifestoHeroType } from '~/lib/sanity/types';

export const prerender = true;

const section: ManifestoHeroType = {
  _key: 'preview',
  _type: 'manifestoHero',
  metaLines: [
    { _key: '1', label: 'Par', value: 'Studio Abime' },
    { _key: '2', label: 'Type', value: 'Labo de Com' },
    { _key: '3', label: 'Mail', value: 'elodie@studioabime.com' },
    { _key: '4', label: 'Date', autoDate: true },
  ],
  hypothesisLabel: 'HYPOTHÈSE',
  hypothesis: "communiquer, c'est relier des systèmes.",
  intentionLabel: "NOTE D'INTENTION",
  intention: [
    "Ce qu'on montre est toujours un choix, jamais un hasard.",
    'Autant le faire consciemment.',
  ],
  tagline:
    "Studio Abime est un labo de com et d'identités sensorielles qui naissent d'une plongée sous le visible.",
  showStamp: true,
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aperçu — Hero manifeste</title>
  </head>
  <body>
    <ManifestoHero section={section} locale="fr" />
  </body>
</html>
