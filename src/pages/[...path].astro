---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionRenderer from '~/components/sections/SectionRenderer.astro';
import ProjectTemplateRenderer from '~/templates/project/ProjectTemplateRenderer.astro';
import LaboPageView from '~/components/LaboPage.astro';
import ContactPage from '~/components/ContactPage.astro';
import ExperienceTransitionLab from '~/components/ExperienceTransitionLab.astro';
import ExperienceReferences from '~/components/ExperienceReferences.astro';
import JournalIndex from '~/components/JournalIndex.astro';
import JournalPost from '~/components/JournalPost.astro';
import ShopIndex from '~/components/ShopIndex.astro';
import ProductPage from '~/components/ProductPage.astro';
import OrderConfirmation from '~/components/OrderConfirmation.astro';
import CollectionPage from '~/components/CollectionPage.astro';
import PolicyPage from '~/components/PolicyPage.astro';
import LegalHeader from '~/components/LegalHeader.astro';

import { absoluteUrl, buildRouteManifest, matchRoute } from '~/lib/routing';
import { buildPageGraph, fromShopMedia } from '~/lib/seo/jsonLd';
import { resolveShareImage } from '~/lib/seo/shareImage';
import {
  getCollectionByHandle,
  getProductByHandle,
  getProducts,
  shopifyImageUrl,
} from '~/lib/shopify/catalogue';
import { getShopPolicy } from '~/lib/shopify/policies';
import { getSiteContext } from '~/lib/siteContext';
import { getDocumentAlternates, getPolicyAlternates, getStaticAlternates } from '~/lib/alternates';
import { legalPageId } from '~/i18n/routes';
import { loadQuery } from '~/lib/sanity/loadQuery';
import {
  homePageQuery,
  pageByIdQuery,
  projectBySlugQuery,
  projectsIndexQuery,
  projectsPageQuery,
  clientsQuery,
  laboPageQuery,
  laboArchiveProjectsQuery,
  journalIndexQuery,
  journalPageQuery,
  shopPageQuery,
  postBySlugQuery,
} from '~/lib/sanity/queries';
import { getHomeFallback } from '~/content/homeFallback';
import { getJournalCategory } from '~/content/journalCategories';
import { getShopIntro } from '~/content/shopFallback';
import { getLaboFallback } from '~/content/laboFallback';
import { useTranslations } from '~/i18n/ui';
import type { Collection as ShopCollection, Product as ShopProduct, ProductCard as ShopProductCard, ShopPolicy } from '~/lib/shopify/types';
import type {
  Client,
  JournalPage,
  LaboPage,
  Page,
  Post,
  PostCard,
  Project,
  ProjectCard,
  ProjectsPage,
  ShopPage,
} from '~/lib/sanity/types';

/**
 * ═══════════════════════════════════════════════════════════════════════════
 * ROUTE UNIVERSELLE
 * ═══════════════════════════════════════════════════════════════════════════
 * Un seul fichier sert l'intégralité du site public : accueil, pages
 * institutionnelles, index portfolio et pages projet — dans toutes les langues.
 *
 * Pourquoi pas une arborescence `src/pages/[locale]/experiences/[slug].astro` ?
 * Parce que les segments d'URL sont traduits (`/experiences` ↔ `/en/work`) et que
 * le préfixe de langue est conditionnel. Une arborescence figée obligerait à
 * dupliquer des fichiers à chaque nouvelle langue. Ici, `src/lib/routing.ts`
 * porte toute la logique : ajouter une langue ne touche AUCUN fichier de route.
 *
 * Rendu : statique par défaut ; à la demande quand l'édition visuelle ou le
 * mode maintenance sont actifs. Cette route ne décide pas elle-même : le mode
 * est posé pour tout le site par `output` dans `astro.config.ts` — Astro
 * n'évalue pas un `export const prerender` calculé, il n'en lit que le
 * littéral, et une expression y serait silencieusement ignorée.
 */

export async function getStaticPaths() {
  const routes = await buildRouteManifest();

  return routes.map((route) => ({
    // '/' → path undefined (racine) ; '/experiences/abime' → 'experiences/abime'.
    params: { path: route.path === '/' ? undefined : route.path.slice(1) },
  }));
}

const route = matchRoute(Astro.params.path);
if (!route) return Astro.rewrite('/404');

const { locale } = route;
const site = await getSiteContext(locale);
const t = useTranslations(locale);

/* ── Chargement du contenu selon le type de route ─────────────────────────── */

let page: Page | null = null;
let project: Project | null = null;
let projects: ProjectCard[] = [];
let projectsPage: ProjectsPage | null = null;
let clients: Client[] = [];
let laboPage: LaboPage | null = null;
let journalPage: JournalPage | null = null;
let posts: PostCard[] = [];
let post: Post | null = null;
let shopProducts: ShopProductCard[] = [];
let shopPage: ShopPage | null = null;
let shopProduct: ShopProduct | null = null;
let shopCollection: ShopCollection | null = null;
let shopRelated: ShopProductCard[] = [];
let shopPolicy: ShopPolicy | null = null;

if (route.kind === 'shop') {
  /*
    Deux sources en parallèle : Shopify pour le catalogue, Sanity pour le texte
    d'ouverture. Aucune des deux ne bloque l'autre — une boutique vide reste une
    page lisible, et un singleton non créé retombe sur le texte du dépôt.
  */
  const [products, pageContent] = await Promise.all([
    getProducts(),
    loadQuery<ShopPage | null>({ query: shopPageQuery, locale, fallback: null }),
  ]);
  shopProducts = products;
  shopPage = pageContent;
}

if (route.kind === 'product') {
  shopProduct = await getProductByHandle(route.handle);
  // Tirage dépublié ou renommé depuis la génération du manifeste.
  if (!shopProduct) return Astro.rewrite('/404');

  if (shopProduct.primaryCollectionHandle) {
    const collection = await getCollectionByHandle(shopProduct.primaryCollectionHandle);
    // Le tirage courant ne se suggère pas lui-même.
    shopRelated = (collection?.products ?? []).filter((p) => p.id !== shopProduct!.id).slice(0, 4);
  }
}

if (route.kind === 'policy') {
  shopPolicy = await getShopPolicy(route.policy);
  // Politique retirée de l'admin — ou redevenue un modèle à compléter — depuis
  // la génération du manifeste.
  if (!shopPolicy) return Astro.rewrite('/404');
}

if (route.kind === 'collection') {
  shopCollection = await getCollectionByHandle(route.handle);
  // Collection dépubliée ou renommée depuis la génération du manifeste.
  if (!shopCollection) return Astro.rewrite('/404');
}

if (route.kind === 'labo') {
  const [pageContent, latestProjects] = await Promise.all([
    loadQuery<LaboPage | null>({
      query: laboPageQuery,
      locale,
      fallback: null,
    }),
    loadQuery<ProjectCard[]>({
      query: laboArchiveProjectsQuery,
      locale,
      fallback: [],
    }),
  ]);

  laboPage = pageContent ?? getLaboFallback(locale);
  if (laboPage.archiveProjects.length === 0 && latestProjects.length > 0) {
    laboPage = { ...laboPage, archiveProjects: latestProjects };
  }
} else if (route.kind === 'journal') {
  const [journalPosts, pageContent] = await Promise.all([
    loadQuery<PostCard[]>({ query: journalIndexQuery, locale, fallback: [] }),
    loadQuery<JournalPage | null>({ query: journalPageQuery, locale, fallback: null }),
  ]);
  posts = journalPosts;
  journalPage = pageContent;
} else if (route.kind === 'post') {
  post = await loadQuery<Post | null>({
    query: postBySlugQuery,
    params: { slug: route.slug },
    locale,
    fallback: null,
  });
} else if (route.kind === 'contact') {
  // La page contact est une expérience de marque dédiée : son contenu essentiel
  // reste disponible même lorsque Sanity est momentanément indisponible.
} else if (route.kind === 'home') {
  page = await loadQuery<Page | null>({ query: homePageQuery, locale, fallback: null });
  // Tant qu'aucune page d'accueil n'est désignée dans Sanity, on sert le
  // contenu d'amorçage plutôt qu'un 404 sur la racine du site.
  page ??= getHomeFallback(locale);
} else if (route.kind === 'legalPage') {
  page = await loadQuery<Page | null>({
    query: pageByIdQuery,
    params: { id: legalPageId(route.key, locale) },
    locale,
    fallback: null,
  });
  // Page retirée de Sanity depuis la génération du manifeste.
  if (!page) return Astro.rewrite('/404');
} else if (route.kind === 'project') {
  project = await loadQuery<Project | null>({
    query: projectBySlugQuery,
    params: { slug: route.slug },
    locale,
    fallback: null,
  });
} else {
  const [data, pageContent, clientList] = await Promise.all([
    loadQuery<{ projects: ProjectCard[] }>({
      query: projectsIndexQuery,
      locale,
      fallback: { projects: [] },
    }),
    loadQuery<ProjectsPage | null>({ query: projectsPageQuery, locale, fallback: null }),
    loadQuery<Client[]>({ query: clientsQuery, locale, fallback: [] }),
  ]);
  projects = data.projects;
  projectsPage = pageContent;
  clients = clientList;
}

// Contenu supprimé ou dépublié depuis la génération du manifeste.
if (
  route.kind !== 'projectIndex' &&
  route.kind !== 'contact' &&
  route.kind !== 'journal' &&
  route.kind !== 'shop' &&
  route.kind !== 'product' &&
  route.kind !== 'orderConfirmation' &&
  route.kind !== 'collection' &&
  route.kind !== 'policy' &&
  !page &&
  !project &&
  !post &&
  !laboPage
) {
  return Astro.rewrite('/404');
}

/* ── Métadonnées communes ─────────────────────────────────────────────────── */

const document = project ?? post ?? page;
const alternates =
  route.kind === 'projectIndex'
    ? getStaticAlternates('projectIndex')
    : route.kind === 'journal'
      ? getStaticAlternates('journal')
    : route.kind === 'contact'
      ? getStaticAlternates('contact')
    : route.kind === 'labo'
      ? getStaticAlternates('labo')
    : route.kind === 'home'
      ? getStaticAlternates('home')
    : route.kind === 'shop'
      ? getStaticAlternates('shop')
    : route.kind === 'orderConfirmation'
      ? getStaticAlternates('orderConfirmation')
    : route.kind === 'policy'
      ? getPolicyAlternates(route.policy)
      : await getDocumentAlternates(document?._id, locale);

/* Les intitulés de section sont fixés en code : le CMS porte le contenu. */
const projectIndexTitle = t('nav.projects');
const journalTitle = t('journal.title');
const shopTitle = t('shop.title');

const title =
  route.kind === 'projectIndex'
    ? projectIndexTitle
    : route.kind === 'journal'
      ? journalTitle
    : route.kind === 'contact'
      ? 'Contact'
    : route.kind === 'labo'
      ? (laboPage?.title ?? 'Le Labo')
    : route.kind === 'shop'
      ? shopTitle
    : route.kind === 'product'
      ? (shopProduct?.title ?? t('shop.title'))
    : route.kind === 'orderConfirmation'
      ? t('shop.confirmationTitle')
    : route.kind === 'collection'
      ? (shopCollection?.title ?? t('shop.title'))
    : route.kind === 'policy'
      ? t(`policy.${route.policy}` as 'policy.terms')
      : (document?.title ?? site.localized?.siteTitle ?? '');

const journalIntro = journalPage?.intro?.trim();

const projectsIntro = projectsPage?.intro?.trim();

// L'ancienne planche autonome fournissait les deux derniers médias de la
// composition. Sur l'accueil, on les rattache au manifeste avant de retirer
// seulement son enveloppe `plateSpread`. Un manifeste déjà complet n'est pas
// dupliqué : on ne remplit que les emplacements manquants jusqu'à cinq.
const pageSections = route.kind === 'home'
  ? (() => {
      const sections = page?.sections ?? [];
      const legacyPlate = sections.find((section) => section._type === 'plateSpread');

      return sections.flatMap((section) => {
        if (section._type === 'plateSpread') return [];
        if (section._type !== 'studioStatement' || !legacyPlate?.figures?.length) {
          return [section];
        }

        const figures = section.figures ?? [];
        const missingFigures = legacyPlate.figures.slice(0, Math.max(0, 5 - figures.length));

        return [{ ...section, figures: [...figures, ...missingFigures] }];
      });
    })()
  : page?.sections;

/*
  Les pages d'informations légales partagent une présentation propre (colonne
  pleine largeur, titres de section resserrés — voir `.page-legal` dans
  global.css). Elles arrivent par deux routes différentes : les politiques de
  boutique viennent de Shopify, les trois autres sont des documents Sanity
  adressés par leur identifiant.
*/
const isLegalPage = route.kind === 'policy' || route.kind === 'legalPage';

/* Le titre est en code, comme l'adresse : le CMS ne porte que le texte. */
const legalTitle =
  route.kind === 'legalPage' ? t(`legal.${route.key}` as 'legal.notice') : t('legal.title');

const hasEmbeddedServicesRail = pageSections?.some((section) => section._type === 'servicesMenu') ?? false;

/* ── Référencement ────────────────────────────────────────────────────────── */

/*
  Les métadonnées d'une page se calculent ici, une fois, et servent à la fois
  aux balises `<head>` et aux données structurées : c'est ce qui garantit que ce
  qu'un moteur lit dans le JSON-LD est exactement ce qu'un partage affiche.
*/

const seo =
  route.kind === 'projectIndex'
    ? projectsPage?.seo
    : route.kind === 'journal'
      ? journalPage?.seo
      : route.kind === 'labo'
        ? laboPage?.seo
        : route.kind === 'shop'
          ? shopPage?.seo
          : document?.seo;

/*
  Le manifeste du Labo accepte encore des paragraphes saisis en simple chaîne,
  d'avant que chacun porte sa largeur de composition.
*/
const laboParagraphText = (paragraph: LaboPage['philosophy'][number] | undefined) =>
  typeof paragraph === 'string' ? paragraph : paragraph?.text;

/** Extrait propre à la page, à défaut de description SEO saisie. */
const descriptionFallback =
  route.kind === 'project'
    ? project?.excerpt
    : route.kind === 'post'
      ? (post?.excerpt ?? post?.standfirst)
      : route.kind === 'product'
        ? shopProduct?.excerpt
        : route.kind === 'collection'
          ? shopCollection?.descriptionHtml?.replace(/<[^>]*>/g, ' ').trim()
          : route.kind === 'journal'
            ? journalIntro
            : route.kind === 'projectIndex'
              ? projectsIntro
              : route.kind === 'shop'
                ? shopPage?.intro?.trim()
                : route.kind === 'labo'
                  ? laboParagraphText(laboPage?.philosophy?.[0])
                  : route.kind === 'policy'
                    ? shopPolicy?.body?.replace(/<[^>]*>/g, ' ').trim()
                    : undefined;

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;

const collectionImage = shopCollection?.image;

const shareImage = resolveShareImage(
  {
    seo: seo?.image,
    document: project?.thumbnail ?? post?.coverImage ?? null,
    external: shopProduct
      ? fromShopMedia(shopProduct)
      : collectionImage
        ? {
            url: shopifyImageUrl(collectionImage.url, 1200),
            width: collectionImage.width ?? undefined,
            height: collectionImage.height ?? undefined,
            alt: collectionImage.altText ?? shopCollection?.title,
          }
        : null,
    siteDefault: site.localized?.defaultSeoImage,
  },
  origin,
);

/*
  Deux routes restent hors des moteurs : la confirmation de commande, atteinte
  uniquement par redirection depuis le paiement et sans contenu à indexer, et
  toute page marquée comme telle dans le CMS.
*/
const noIndex = route.kind === 'orderConfirmation';

const jsonLd = buildPageGraph({
  route,
  site,
  locale,
  canonical: absoluteUrl(Astro.url.pathname, Astro.site),
  origin,
  title,
  description: seo?.description || descriptionFallback || site.localized?.siteDescription,
  image: shareImage,
  isLegal: isLegalPage,
  lastmod: project?.updatedAt ?? post?.updatedAt ?? page?.updatedAt,
  page,
  project,
  post,
  product: shopProduct,
  collection: shopCollection,
  projects,
  posts,
  products: shopProducts,
});
---

<BaseLayout
  locale={locale}
  site={site}
  seo={seo}
  title={title}
  shareImage={shareImage}
  descriptionFallback={descriptionFallback}
  jsonLd={jsonLd}
  ogType={route.kind === 'post' ? 'article' : 'website'}
  publishedTime={post?.publishedAt}
  modifiedTime={post?.updatedAt}
  section={post ? (getJournalCategory(post.category)?.title ?? undefined) : undefined}
  noIndex={noIndex}
  bodyClass={[
    route.kind === 'projectIndex' || route.kind === 'project' ? 'page-projects' : '',
    route.kind === 'labo' ? 'page-labo' : '',
    route.kind === 'journal' || route.kind === 'post' ? 'page-journal' : '',
    route.kind === 'contact' ? 'page-contact' : '',
    route.kind === 'shop' ||
    route.kind === 'product' ||
    route.kind === 'orderConfirmation' ||
    route.kind === 'collection'
      ? 'page-shop'
      : '',
    isLegalPage ? 'page-legal' : '',
  ].filter(Boolean).join(' ')}
  alternates={alternates}
  showServicesRail={!hasEmbeddedServicesRail}
  enableVisualEditing={route.kind !== 'contact'}
>
  {project && <ProjectTemplateRenderer project={project} locale={locale} />}

  {laboPage && <LaboPageView page={laboPage} locale={locale} />}

  {post && <JournalPost post={post} locale={locale} />}

  {
    route.kind === 'journal' && (
      <JournalIndex
        posts={posts}
        locale={locale}
        title={journalTitle}
        number="03."
        intro={journalIntro}
      />
    )
  }

  {route.kind === 'contact' && <ContactPage />}

  {shopProduct && <ProductPage product={shopProduct} related={shopRelated} locale={locale} />}

  {route.kind === 'orderConfirmation' && <OrderConfirmation locale={locale} />}

  {shopPolicy && <PolicyPage policy={shopPolicy} locale={locale} />}

  {shopCollection && <CollectionPage collection={shopCollection} locale={locale} />}

  {
    route.kind === 'shop' && (
      <ShopIndex
        products={shopProducts}
        locale={locale}
        title={shopTitle}
        number="04."
        intro={shopPage?.intro?.trim() || getShopIntro(locale)}
      />
    )
  }

  {
    isLegalPage && page && (
      <div class="legal-header-block container-wide pt-(--spacing-section)">
        <div class="reading-column">
          <LegalHeader title={legalTitle} />
        </div>
      </div>
    )
  }

  {page && <SectionRenderer sections={pageSections} locale={locale} />}

  {
    route.kind === 'projectIndex' && (
      <div class="project-index container-wide py-(--spacing-section)">
        <header class="project-index__header">
          <h1 class="project-index__title type-titre text-balance" data-text-reveal>
            02. {projectIndexTitle}
          </h1>
          {projectsIntro && <p class="project-index__intro type-copy text-pretty">{projectsIntro}</p>}
        </header>

        {/*
          Les fiches de projet sont des titres de niveau 3. Sans ce niveau 2,
          la page saute du titre principal aux fiches : un lecteur d'écran qui
          navigue de titre en titre perd la marche intermédiaire. Le titre est
          masqué à l'œil, la composition ne l'affichant pas.
        */}
        <h2 class="sr-only">Tous les projets</h2>

        <ExperienceTransitionLab
          projects={projects}
          locale={locale}
          editorialCards={projectsPage?.editorialCards ?? []}
          clients={clients}
        />

        <ExperienceReferences projects={projects} clients={clients} locale={locale} />
      </div>
    )
  }
</BaseLayout>

<style>
  .project-index__header {
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }

  .project-index__title {
    text-align: center;
  }

  .project-index__intro {
    max-width: 76rem;
    margin-top: clamp(5.5rem, 12vw, 12rem);
    margin-inline: auto;
    text-indent: clamp(7rem, 20vw, 22rem);
  }

  @media (max-width: 767px) {
    .project-index__header {
      margin-bottom: 3rem;
    }

    .project-index__intro {
      margin-top: 4rem;
      text-indent: clamp(2.5rem, 20vw, 5rem);
    }
  }
</style>
