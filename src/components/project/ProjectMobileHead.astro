---
import ProjectElementCell from '~/components/project/ProjectElementCell.astro';
import ProjectFacts from '~/components/project/ProjectFacts.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/**
 * Morceau du cartouche projet rendu dans le flux MOBILE.
 *
 * Au bureau, les deux se tiennent hors du flux, dans le coin haut droit de la
 * page (voir `ProjectTemplateRenderer`) : la mise en page les donne à voir en
 * même temps que le titre, et l'ordre du document n'a pas d'importance.
 *
 * Sur écran étroit, la case ouvre maintenant le projet avant son titre tandis
 * que le relevé reste après celui-ci. `part` permet aux trois gabarits de poser
 * ces deux morceaux autour du même `h1`, sans dupliquer leur mise en forme.
 */
interface Props {
  project: Project;
  locale: Locale;
  part?: 'cell' | 'facts' | 'both';
  class?: string;
}

const { project, locale, part = 'both', class: className } = Astro.props;
---

<div class:list={['project-mobile-head', className]} data-part={part}>
  {part !== 'facts' && <ProjectElementCell project={project} />}
  {part !== 'cell' && <ProjectFacts project={project} locale={locale} />}
</div>

<style>
  /* Au bureau, c'est le cartouche du coin qui fait le travail. */
  .project-mobile-head {
    display: none;
  }

  @media (max-width: 899px) {
    .project-mobile-head {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: flex-end;
      gap: clamp(2rem, 7vw, 2.75rem);
      margin-block: clamp(3.5rem, 10vw, 4.5rem) clamp(2.5rem, 8vw, 3.5rem);
    }

    /* La case ouvre la composition, alignée sur le bord droit historique. */
    .project-mobile-head[data-part='cell'] {
      margin-block-end: clamp(2.5rem, 8vw, 3.5rem);
    }

    /* Le relevé conserve sa respiration sous le titre. */
    .project-mobile-head[data-part='facts'] {
      margin-block-start: clamp(3.5rem, 10vw, 4.5rem);
    }
  }
</style>
