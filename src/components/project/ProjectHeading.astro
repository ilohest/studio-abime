---
import type { Project } from '~/lib/sanity/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<header class="project-heading">
  <h1 class="project-heading__title type-titre text-balance" data-text-reveal>
    {project.title}
  </h1>

  {project.headline && (
    <p class="project-heading__standfirst type-annotation text-pretty" data-text-reveal>
      {project.headline}
    </p>
  )}
</header>

<style>
  .project-heading {
    width: 100%;
    max-width: var(--container-content);
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  /* Même échelle et même rythme que le titre d'un article. */
  .project-heading__title {
    margin-top: clamp(1.2rem, 3vw, 2rem);
    font-size: clamp(1.75rem, 5.5vw, var(--text-titre));
  }

  /* Même mesure et même variante italique que le chapô d'un article. */
  .project-heading__standfirst {
    max-width: 34ch;
    margin-inline: auto;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    /*
      La classe `type-annotation` porte déjà ces valeurs. Les répéter ici est
      intentionnel : le chapô reste identique à celui d'un article même si la
      portée typographique d'un gabarit projet évolue plus tard.
    */
    font-family: var(--font-annotation);
    font-size: var(--text-annotation);
    line-height: var(--text-annotation--line-height);
    letter-spacing: var(--tracking-annotation);
    font-style: italic;
    font-weight: 400;
  }
</style>
