---
import { projectDisplayNumber } from '~/lib/references';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { Project, ProjectChannel } from '~/lib/sanity/types';

/**
 * Fiche projet — relevé technique.
 *
 * Aucun cadre, aucune matière, aucun fond : rien que des intitulés et leurs
 * valeurs, posés en colonnes. La fiche s'efface derrière ce qu'elle énonce.
 *
 * Chaque champ tient sur UNE ligne : l'intitulé à gauche, la valeur poussée
 * contre le bord droit. Deux colonnes se dessinent d'elles-mêmes — celle des
 * intitulés, celle des valeurs — et se lisent chacune de haut en bas, sans
 * qu'aucun filet ne les sépare. Même motif que la fiche technique d'un produit.
 *
 * Les valeurs multiples s'empilent sous la première au lieu de s'enfiler en une
 * phrase, et gardent le bord droit : on lit une liste, pas une énumération.
 *
 * La cote ouvre le relevé — c'est le numéro de la case du projet dans la table
 * des éléments, donné comme une donnée parmi les autres et non comme un décor.
 *
 * Les champs vides disparaissent : une fiche à deux lignes reste composée, là
 * où des lignes vides trahiraient un gabarit.
 */
interface Row {
  label: string;
  values?: string[];
  links?: Array<{ label: string; href: string }>;
}

interface Props {
  project: Project;
  locale: Locale;
  class?: string;
}

const { project, locale, class: className } = Astro.props;
const t = useTranslations(locale);

/** Adresse lisible : l'URL sans son protocole ni sa barre finale. */
const readableUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const channels = (project.channels ?? [])
  .filter((channel): channel is ProjectChannel & { url: string } => Boolean(channel.url))
  .map((channel) => ({ label: channel.label || readableUrl(channel.url), href: channel.url }));

const reference = projectDisplayNumber(project);

const allRows: Row[] = [
  { label: t('project.reference'), values: reference !== undefined ? [`N° ${reference}`] : undefined },
  { label: t('project.client'), values: project.client ? [project.client] : undefined },
  { label: t('project.sector'), values: project.sector ? [project.sector] : undefined },
  { label: t('project.year'), values: project.year ? [String(project.year)] : undefined },
  { label: t('project.services'), values: project.services?.filter(Boolean) },
  { label: t('project.channels'), links: channels.length > 0 ? channels : undefined },
];

const rows = allRows.filter((row) => Boolean(row.values?.length || row.links));
---

{
  rows.length > 0 && (
    <div class:list={['facts', className]}>
      <dl class="facts__list">
        {rows.map((row) => (
          <div class="facts__row">
            <dt class="facts__term">{row.label}</dt>
            <dd class="facts__data">
              {row.links
                ? row.links.map((link) => (
                    <a href={link.href} class="facts__link" target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))
                : row.values?.map((value) => <span class="facts__value">{value}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  /*
    Largeur imposée ici et non par le parent : posée dans une colonne en `flex`,
    la fiche se réduirait sinon à la largeur de son texte. La requête de
    conteneur la rend autonome — elle se replie sur SA largeur, pas sur celle
    de l'écran, et tient donc aussi bien en pleine colonne que dans une marge.
  */
  .facts {
    width: 100%;
    container-type: inline-size;
  }

  .facts__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    gap: 0.4rem;
  }

  /*
    L'espace entre l'intitulé et sa valeur n'est pas fixe : il prend ce qui
    reste. C'est lui qui tient les deux colonnes alignées sur les deux bords,
    quelle que soit la largeur donnée à la fiche.
  */
  .facts__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .facts__term,
  .facts__data,
  .facts__value,
  .facts__link {
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: 1.55;
  }

  /* `flex: none` : l'intitulé garde sa longueur, c'est la valeur qui se replie. */
  .facts__term {
    flex: none;
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .facts__data {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
    letter-spacing: var(--tracking-copy);
    text-align: right;
  }

  .facts__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: opacity 0.25s ease;
    width: fit-content;
  }

  .facts__link:hover {
    opacity: 0.55;
  }

  /*
    Trop étroite pour tenir les deux bords — un intitulé long y toucherait sa
    valeur —, la fiche renonce à la ligne unique : l'intitulé passe au-dessus
    et tout revient au bord gauche, faute de quoi les valeurs flotteraient
    seules à droite sans colonne en face.
  */
  @container (max-width: 13rem) {
    .facts__row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem;
    }

    .facts__data {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
