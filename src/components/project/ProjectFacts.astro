---
import { projectDisplayNumber } from '~/lib/references';
import { projectInitials } from '~/lib/viewModels';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { Project, ProjectChannel } from '~/lib/sanity/types';

/**
 * Fiche projet — étiquette de flacon.
 *
 * Le site range ses projets comme une table des éléments ; leur fiche est donc
 * l'étiquette collée sur l'échantillon : un cadre double, une cote et un
 * symbole en tête, les champs alignés sous des filets pointillés, la mention du
 * studio en pied comme la marque d'un préparateur.
 *
 * La cote et le symbole sont ceux de la case du projet dans la table — c'est le
 * même objet, décrit trois fois : dans la table, dans la grille, ici.
 *
 * Les champs vides disparaissent : une étiquette à deux lignes reste composée,
 * là où des lignes vides trahiraient un gabarit.
 */
interface Row {
  label: string;
  value?: string;
  links?: Array<{ label: string; href: string }>;
}

interface Props {
  project: Project;
  locale: Locale;
  class?: string;
}

const { project, locale, class: className } = Astro.props;
const t = useTranslations(locale);

/** Adresse lisible : l'URL sans son protocole ni sa barre finale. */
const readableUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const channels = (project.channels ?? [])
  .filter((channel): channel is ProjectChannel & { url: string } => Boolean(channel.url))
  .map((channel) => ({ label: channel.label || readableUrl(channel.url), href: channel.url }));

const allRows: Row[] = [
  { label: t('project.client'), value: project.client },
  { label: t('project.sector'), value: project.sector },
  { label: t('project.year'), value: project.year ? String(project.year) : undefined },
  { label: t('project.services'), value: project.services?.join(', ') },
  { label: t('project.channels'), links: channels.length > 0 ? channels : undefined },
];

const rows = allRows.filter((row) => Boolean(row.value || row.links));
const reference = projectDisplayNumber(project);
const symbol = projectInitials(project.title);
---

{
  rows.length > 0 && (
    <div class:list={['label-frame', className]}>
      <div class="label">
        {reference !== undefined && (
          <p class="label__head" aria-hidden="true">
            <span class="label__ref">N<span class="label__ord">o</span> {reference}</span>
            <span class="label__symbol">{symbol}</span>
          </p>
        )}

        <dl class="label__rows">
          {rows.map((row) => (
            <div class="label__row">
              <dt class="label__term">{row.label}</dt>
              <dd class="label__data">
                {row.links ? (
                  <ul class="label__links">
                    {row.links.map((link) => (
                      <li>
                        <a href={link.href} class="label__link" target="_blank" rel="noopener noreferrer">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))}
        </dl>

        <p class="label__foot" aria-hidden="true">Studio Abîme · Labo de com.</p>
      </div>
    </div>
  )
}

<style>
  /*
    Les filets suivent l'encre du texte et non un gris fixe : l'étiquette reste
    lisible aussi bien sur Papier que sur un fond inversé.
  */
  .label-frame {
    /*
      Largeur imposée ici et non par le parent : posée dans une colonne en
      `flex`, l'étiquette se réduirait sinon à la largeur de son texte.
    */
    width: 100%;
    container-type: inline-size;
  }

  .label {
    --label-rule: color-mix(in oklab, var(--color-ink) 55%, transparent);
    --label-hair: color-mix(in oklab, var(--color-ink) 30%, transparent);
    position: relative;
    padding: clamp(0.9rem, 1.6vw, 1.3rem);
    border: 1px solid var(--label-rule);
  }

  /*
    Le second filet, en retrait : c'est lui qui fait l'étiquette de flacon
    plutôt que le simple cadre. Tracé en incrustation pour ne rien peser sur la
    mise en page.
  */
  .label::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid var(--label-hair);
    pointer-events: none;
  }

  .label__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--label-rule);
    margin: 0 0 0.9rem;
    font-family: var(--font-titre);
    gap: 1rem;
  }

  .label__ref {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* L'exposant de « N° », posé à la main : la fonte n'a pas d'ordinal. */
  .label__ord {
    font-size: 0.62em;
    vertical-align: 0.42em;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .label__symbol {
    font-size: 1.15rem;
    letter-spacing: -0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .label__rows {
    display: grid;
    margin: 0;
    gap: 0;
  }

  .label__row {
    display: grid;
    align-items: baseline;
    padding-block: 0.55rem;
    border-bottom: 1px dotted var(--label-hair);
    gap: 0.4rem 1.2rem;
    grid-template-columns: minmax(5.5rem, 8rem) minmax(0, 1fr);
  }

  .label__row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .label__term {
    font-family: var(--font-titre);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .label__data {
    margin: 0;
    font-family: var(--font-annotation);
    font-size: 1rem;
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .label__links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .label__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 0.25s ease;
  }

  .label__link:hover {
    opacity: 0.55;
  }

  .label__foot {
    padding-top: 0.8rem;
    border-top: 1px solid var(--label-rule);
    margin: 0.9rem 0 0;
    font-family: var(--font-titre);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Étroite, l'étiquette empile l'intitulé et sa valeur. */
  @container (max-width: 20rem) {
    .label__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
