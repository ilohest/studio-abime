---
import { projectsIndexPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';

/**
 * Retour à la liste des projets.
 *
 * Reprend le langage minimal des CTA, avec une flèche coudée inversée pour
 * rendre immédiatement perceptible le retour vers l'index.
 */
interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<a href={projectsIndexPath(locale)} class:list={['button-minimal back-link', className]}>
  <span class="button-minimal__label">{t('project.backToProjects')}</span>
  <span class="button-minimal__arrow back-link__arrow" aria-hidden="true">↲</span>
</a>

<style>
  .back-link {
    color: var(--color-ink);
  }

  .back-link:hover .back-link__arrow {
    transform: translate(-0.18em, 0.1em);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link__arrow,
    .back-link:hover .back-link__arrow {
      transform: none;
    }
  }
</style>
