---
import { projectsIndexPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';

interface Props {
  locale: Locale;
  title: string;
  class?: string;
}

const { locale, title, class: className } = Astro.props;
const t = useTranslations(locale);
---

<nav
  class:list={['breadcrumb project-breadcrumb type-note', className]}
  aria-label={t('nav.breadcrumb')}
>
  <ol role="list">
    <li>
      <a class="link-underline" href={projectsIndexPath(locale)}>{t('nav.projects')}</a>
    </li>
    <li aria-current="page">
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      <span>{title}</span>
    </li>
  </ol>
</nav>
