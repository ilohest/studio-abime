---
import NextEntry from '~/components/NextEntry.astro';

import { projectPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { projectInitials } from '~/lib/viewModels';
import type { Locale } from '~/i18n/config';
import type { ProjectCard } from '~/lib/sanity/types';

/**
 * Renvoi vers le projet suivant.
 *
 * La composition est partagée avec l'article suivant du Journal
 * (`NextEntry.astro`) : les deux fins de lecture se ressemblent parce qu'elles
 * font la même chose.
 */
interface Props {
  project?: ProjectCard | null;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

{
  project && (
    <NextEntry
      href={projectPath(locale, project.slug)}
      label={t('project.next')}
      number={String(project.number ?? 1).padStart(2, '0')}
      symbol={projectInitials(project.title)}
      title={project.title}
      image={project.thumbnail}
    />
  )
}
