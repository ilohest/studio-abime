---
import SanityImage from '~/components/primitives/SanityImage.astro';
import { projectPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { ProjectCard } from '~/lib/sanity/types';

interface Props {
  project?: ProjectCard | null;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

{
  project && (
    <nav class="container-wide py-(--spacing-section)" aria-label={t('project.next')}>
      <a href={projectPath(locale, project.slug)} class="group grid gap-8 md:grid-cols-2 md:items-center">
        <div class="overflow-hidden bg-sable">
          <SanityImage
            image={project.thumbnail?.asset ? project.thumbnail : project.coverImage}
            width={900}
            ratio="landscape"
            sizes="(min-width: 768px) 50vw, 100vw"
            alt={project.title}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />
        </div>

        <div>
          <p class="type-sous-titre text-muted">{t('project.next')}</p>
          <p class="type-titre mt-3 text-balance">{project.title}</p>
          {project.client && <p class="type-annotation mt-2 text-muted">{project.client}</p>}
        </div>
      </a>
    </nav>
  )
}
