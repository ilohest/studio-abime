---
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/** Fiche projet — client, année, services, catégories. Partagée par les modèles. */
interface Props {
  project: Project;
  locale: Locale;
  class?: string;
}

const { project, locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

const rows = [
  { label: t('project.client'), value: project.client },
  { label: t('project.year'), value: project.year?.toString() },
  { label: t('project.services'), value: project.services?.join(', ') },
  {
    label: 'Catégories',
    value: project.categories?.map((category) => category.title).join(', '),
  },
].filter((row) => Boolean(row.value));
---

{
  rows.length > 0 && (
    <dl class:list={['flex flex-col gap-4', className]}>
      {rows.map((row) => (
        <div class="border-t border-line pt-3">
          <dt class="type-sous-titre text-muted">{row.label}</dt>
          <dd class="type-copy mt-1">{row.value}</dd>
        </div>
      ))}
    </dl>
  )
}
