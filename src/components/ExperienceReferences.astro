---
import { buildClientFootnotes } from '~/lib/references';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { Client, ProjectCard } from '~/lib/sanity/types';

/**
 * Références — note de bas de page.
 *
 * Le geste : ce que la table des éléments range en initiales, cette note le
 * développe en toutes lettres, comme l'appareil critique d'un livre. L'appel de
 * note n'est pas un compteur mais le NUMÉRO ATOMIQUE de la case occupée : la
 * note et la table se lisent l'une par l'autre.
 *
 * Ne sont listés que les clients sans page projet : les projets publiés se
 * lisent déjà dans la table et dans la grille.
 */
interface Props {
  projects: ProjectCard[];
  clients?: Client[];
  locale: Locale;
}

const { projects, clients = [], locale } = Astro.props;
const t = useTranslations(locale);

const footnotes = buildClientFootnotes(projects, clients);
---

{
  footnotes.length > 0 && (
    <aside id="references" class="references" aria-labelledby="references-title">
      <h2 id="references-title" class="references__title type-note">
        {t('references.title')}
      </h2>

      <ul class="references__list" role="list">
        {footnotes.map(({ client, atomicNumber }) => (
          <li class="references__item type-note" id={atomicNumber ? `reference-${atomicNumber}` : undefined}>
            <span class="references__marker" aria-hidden="true">
              {atomicNumber ?? '—'}
            </span>
            <span class="references__body">
              <span class="references__name">{client.name}</span>
              {client.sector && <span class="references__sector">{client.sector}</span>}
            </span>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .references {
    /*
      La note ferme la page : sans hauteur minimale, elle et le pied de page ne
      remplissaient pas un grand écran, et le défilement butait sur la fin du
      document AVANT d'avoir amené la note en haut — on gardait sous les yeux la
      fin de la section précédente. En réservant une hauteur d'écran moins la
      place du pied, l'ancre atteint sa cible et la page se clôt sur la note
      suivie du pied, sans blanc résiduel.
    */
    min-block-size: calc(100svh - 12rem);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 8rem);
    /*
      Zéro, et non la garde habituelle : la note doit venir jusqu'au bord haut
      de l'écran, sinon la bande laissée libre montre la fin de la section
      précédente. Rien n'est fixé en haut au bureau ; sur écran étroit, c'est la
      garniture de la section, plus généreuse, qui dégage le titre de la barre
      de marque.
    */
    scroll-margin-top: 0;
  }

  .references__title {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-sous-titre);
  }

  .references__list {
    display: grid;
    gap: 0.55rem clamp(1.5rem, 4vw, 3.5rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
    Une case de client mène ici. Pas de marge de défilement calculée comme sur
    les services du Labo : la note ferme la page, le navigateur bute donc sur
    la fin du document et la section entre de toute façon entière dans l'écran.
    C'est `:target` qui fait le travail utile — le reste recule, la ligne qu'on
    est venu lire garde l'encre pleine et son appel de note se tamponne.
  */
  .references__item {
    display: grid;
    align-items: baseline;
    gap: 0.6rem;
    grid-template-columns: 2.1rem 1fr;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: clamp(5rem, 10vw, 9rem);
    transition: color 320ms ease;
  }

  .references__list:has(.references__item:target) .references__item:not(:target) {
    color: var(--color-muted);
  }

  .references__item:target .references__marker {
    padding-inline: 0.35em;
    margin-inline-end: -0.35em;
    background: var(--color-ink);
    color: var(--color-ink-invert);
  }

  .references__marker {
    width: fit-content;
    justify-self: end;
    color: var(--color-muted);
    font-size: var(--text-note);
    font-variant-numeric: tabular-nums;
    text-align: right;
    transition: background-color 320ms ease, color 320ms ease;
  }

  /*
    Une ligne de registre, et non un flux de texte : le nom tient le bord
    gauche, le secteur le bord droit. Le filet qui souligne chaque entrée les
    relie — c'est lui qui remplace le point médian d'autrefois, devenu inutile
    dès lors que les deux membres ne se touchent plus.
  */
  .references__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem clamp(0.75rem, 2vw, 1.5rem);
    min-width: 0;
    flex-wrap: wrap;
  }

  .references__name {
    min-width: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-sous-titre);
  }

  /*
    `auto` plutôt que `space-between` seul : si le nom passe à la ligne, le
    secteur reste collé au bord droit au lieu de venir se ranger sous lui.
  */
  .references__sector {
    margin-inline-start: auto;
    color: var(--color-muted);
    font-size: var(--text-note);
    text-align: right;
  }

  /*
    Sur écran étroit, la barre de marque est fixe en haut : la note doit pouvoir
    descendre assez pour passer dessous, sinon le titre se glisse derrière elle.
    On réserve donc moins de place au pied de page qu'au bureau.
  */
  @media (max-width: 767px) {
    .references {
      min-block-size: calc(78svh - 6rem);
      /* Dégage le titre de la barre de marque, fixe en haut de l'écran. */
      padding-block-start: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .references__item,
    .references__marker {
      transition: none;
    }
  }
</style>

