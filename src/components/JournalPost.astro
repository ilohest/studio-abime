---
import { stegaClean } from '@sanity/client/stega';

import JournalComposition from '~/components/journal/JournalComposition.astro';
import NextEntry from '~/components/NextEntry.astro';
import SanityImage from '~/components/primitives/SanityImage.astro';

import { journalIndexPath, postPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { formatJournalStamp } from '~/lib/journal';
import type { Locale } from '~/i18n/config';
import type { Post } from '~/lib/sanity/types';

/**
 * Article du Journal.
 *
 * L'article s'ouvre sur son titre, sans appareil préalable. La rubrique, la
 * date et la fiche appartiennent à la grille du Journal : les répéter ici
 * ferait précéder la lecture d'un inventaire que le lecteur vient de traverser.
 *
 * Deux modèles, une seule saisie :
 *
 *  - « Article de revue »    — colonne de lecture étroite, figures réduites.
 *    Le visuel de tête est lui aussi ramené à l'échelle d'une planche : un
 *    article scientifique ne s'ouvre pas sur une image pleine largeur.
 *
 *  - « Planche illustrée »   — colonne plus large, visuel de tête déployé.
 *
 * Voir `JournalComposition.astro` pour l'appareil de notes et de figures.
 */
interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);

const template = stegaClean(post.template) === 'planche' ? 'planche' : 'revue';

const next = post.next ?? null;
---

<article class="journal-post" data-template={template}>
  {/*
    Le retour se tient en haut à gauche, hors de la colonne de titre — la même
    place que sur une page projet. Il quitte l'article, il n'en fait pas partie.
  */}
  <div class="journal-post__top container-wide">
    <a href={journalIndexPath(locale)} class="button-minimal journal-post__back">
      <span class="button-minimal__label">{t('journal.backToJournal')}</span>
      <span class="button-minimal__arrow journal-post__back-arrow" aria-hidden="true">↲</span>
    </a>
  </div>

  <header class="journal-post__header container-content">
    <h1 class="journal-post__title type-titre text-balance" data-text-reveal>{post.title}</h1>

    {post.standfirst && (
      <p class="journal-post__standfirst type-annotation text-pretty" data-text-reveal>{post.standfirst}</p>
    )}
  </header>

  {post.coverImage?.asset && (
    <figure class="journal-post__cover container-wide">
      <SanityImage
        image={post.coverImage}
        width={template === 'planche' ? 1600 : 1100}
        sizes={template === 'planche' ? '(min-width: 1440px) 90rem, 100vw' : '(min-width: 1024px) 44rem, 90vw'}
        loading="eager"
        fetchpriority="high"
        alt={post.coverImage.alt || post.title}
        class="journal-post__cover-image"
      />
    </figure>
  )}

  <div class="journal-post__body container-wide">
    <JournalComposition blocks={post.blocks} template={template} locale={locale} />
  </div>

  {next && (
    <NextEntry
      href={postPath(locale, next.slug)}
      label={t('journal.next')}
      number={String(next.number ?? 1).padStart(2, '0')}
      symbol={formatJournalStamp(next.publishedAt)}
      title={next.title}
      image={next.coverImage}
    />
  )}
</article>

<style>
  /* La page démarre sous la barre de marque, fixée en haut de l'écran en mobile. */
  .journal-post__top {
    padding-top: max(clamp(2rem, 4vw, 4rem), var(--mobile-brand-clearance));
  }

  .journal-post__header {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .journal-post__back:hover .journal-post__back-arrow {
    transform: translate(-0.18em, 0.1em);
  }

  /*
    Un titre d'article est bien plus long qu'un nom de projet : la taille de
    titre de la charte devient sa borne haute, atteinte dès qu'il y a la place.
  */
  .journal-post__title {
    margin-top: clamp(1.2rem, 3vw, 2rem);
    font-size: clamp(1.75rem, 5.5vw, var(--text-titre));
  }

  .journal-post__standfirst {
    max-width: 34ch;
    margin-inline: auto;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  /*
    Un visuel au fond transparent laisserait paraître la couleur de la page à
    travers l'image. La figure porte donc sa propre surface, comme les vignettes
    de la grille.
  */
  .journal-post__cover {
    background: var(--color-surface-alt);
  }

  /*
    En modèle revue, le visuel de tête est une planche, pas une bannière : il
    reste à l'échelle de la colonne de lecture, centré.
  */
  .journal-post[data-template='revue'] .journal-post__cover {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
  }

  .journal-post__cover-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .journal-post__body {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-post__back-arrow,
    .journal-post__back:hover .journal-post__back-arrow {
      transform: none;
    }
  }
</style>
