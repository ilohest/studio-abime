  }

  .labo-orbits__core {
    /*
      Le noyau n'est plus un disque : ni fond, ni filet, ni grain. Il ne reste
      que la phrase, posée au centre du système — c'est elle le foyer, et non
      la pastille qui la portait.
    */
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(8.5rem, 14vw, 11.5rem);
    aspect-ratio: 1;
    place-content: center;
    text-align: center;
    transform: translate(-50%, -50%);
    /*
      Aucun halo autour du noyau. Il en portait un — un anneau de papier posé
      par-dessus la scène — pour dégager la phrase du fond. Mais le noyau passe
      AU-DESSUS des orbites : cet anneau effaçait les trajectoires qui le
      traversaient et tronquait les étiquettes qui passaient devant. Le système
      se lit maintenant d'un trait, sans zone morte.
    */
  }

  .labo-orbits__core > * {
    position: relative;
    z-index: 1;
