    │ Composer un texte en colonnes est d'ordinaire déconseillé à l'écran : │
    │ l'écran ne pagine pas. Arrivé au bas de la première colonne, il faut  │
    │ REMONTER chercher le haut de la seconde — un geste que le papier ne   │
    │ demande jamais.                                                       │
    │                                                                       │
    │ L'objection tombe à une condition, et une seule : que le bloc tienne  │
    │ dans la hauteur d'un écran. Le manifeste fait environ deux mille      │
    │ signes — à cette mesure et à ce corps, les deux colonnes tiennent     │
    │ ensemble sous les yeux, et se lisent alors exactement comme la page   │
    │ imprimée dont elles viennent.                                         │
    │                                                                       │
    │ ➜ Si le texte s'allonge nettement depuis le Studio, cette condition   │
    │   cesse d'être vraie : revenir à une seule colonne plutôt que de      │
    │   laisser le lecteur remonter.                                        │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-philosophy__notes {
    columns: 2;
    column-gap: clamp(2rem, 4vw, 3.5rem);
    inline-size: min(100%, 52rem);
    max-inline-size: 100%;
    min-inline-size: 0;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .labo-philosophy__note {
    margin: 0;
    font-family: var(--font-copy);
    /* Sous le corps courant : c'est l'appareil du document, pas sa voix. */
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    /*
      Fer à fer et césure : les deux vont ensemble. Justifier une colonne
      étroite sans couper les mots ouvre des blancs irréguliers d'une ligne à
      l'autre — le défaut même que la composition en colonnes doit éviter.
    */
    text-align: justify;
    hyphens: auto;
    orphans: 2;
    widows: 2;
  }

  .labo-philosophy__note + .labo-philosophy__note {
    margin-top: 0.85em;
  }

  @media (min-width: 1280px) {
    .labo-philosophy__page {
      inline-size: min(100%, 52rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
    }
  }

  /*
   * Entre tablette et petit desktop, le rail fixe retire 16rem à la page.
   * Cette plage doit donc être composée selon la largeur réellement restante,
   * et non comme un viewport desktop complet.
   */
  @media (min-width: 768px) and (max-width: 1279px) {
    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
      padding-right: clamp(2.5rem, 5vw, 4rem);
    }

    .labo-philosophy__page {
      inline-size: min(100%, 42rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
      padding-inline-end: 0;
    }

  }

  .labo-philosophy__keywords {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.7vw, 3rem);
    margin-top: clamp(5rem, 10vw, 10rem);
    font-family: var(--font-titre);
    font-size: clamp(1.5rem, 2.7vw, var(--text-titre));
    line-height: 0.92;
    letter-spacing: var(--tracking-copy);
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    cursor: default;
  }

  .labo-philosophy__letter {
    display: inline-block;
    height: 0.92em;
    overflow: hidden;
    perspective: 4em;
  }

  .labo-philosophy__letter-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--letter-index) * 34ms);
  }

  .labo-philosophy__letter-track > span {
    display: block;
    height: 0.92em;
    line-height: 0.92;
  }

  @media (hover: hover) and (pointer: fine) {
    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: translateY(-50%);
    }
  }

  .labo-section-heading {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .labo-section-heading h2 {
    max-width: 16ch;
  }

  /*
    L'équipe : une déclaration composée au fer à fer, puis le texte de service
    qui la précise. La note de fondation est une pièce rapportée — photographie
    posée à gauche, feuille de papier à droite, comme un document glissé dans
    le cahier.
  */
  /*
    La section s'ouvre DIRECTEMENT sur sa déclaration : le repère « [03 — … »
    a été retiré. La garde du haut reprend donc à son compte ce que le repère
    et sa marge occupaient — sans elle, la déclaration remontait se coller aux
    mots-clés qui ferment la section précédente.
  */
  .labo-team {
    /*
      Le blanc au-dessus du repère vaut celui qui, dans la section Vision,
      sépare le repère « [02 — … » de sa colonne. La section précédente en
      apporte déjà une part par sa propre garde basse : celle-ci ne pose que
      le complément.
    */
    padding-block: clamp(1.5rem, 2.5vw, 2.5rem) clamp(2.5rem, 4.5vw, 4.5rem);
  }

  .labo-team__lead {
    margin: 0;
    /* Même alinéa que la citation du manifeste : le bloc s'ouvre en retrait. */
    text-indent: clamp(3.5rem, 8vw, 8rem);
    font-family: var(--font-copy);
    font-size: clamp(2rem, 4.6vw, 4rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-titre);
    /*
      Les deux bords sont alignés, comme un bloc de titre imprimé. La césure
      reste interdite : à cette taille, un mot coupé se verrait de loin.
    */
    text-align: justify;
    hyphens: none;
  }

  /*
    ┌─ LA MÊME COLONNE, RENVOYÉE À DROITE ──────────────────────────────────┐
    │ Ce paragraphe reprend EXACTEMENT la colonne de lecture de la section  │
    │ Vision — largeur, corps, justification, césure, alinéa — mais poussée │
    │ contre le bord droit de la page. Les deux blocs se répondent alors    │
    │ d'une section à l'autre, en miroir.                                   │
    │                                                                       │
    │ La largeur — quatre dixièmes de ce qui reste une fois la gouttière    │
    │ prise — vient d'une composition à deux colonnes qui a été écartée     │
    │ depuis. Elle est conservée telle quelle : elle vaut désormais pour    │
    │ elle-même, une colonne nettement plus étroite que la mesure de la     │
    │ page, et c'est cet écart qui la détache du manifeste d'en face.       │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-team__body {
    width: calc((100% - clamp(2.5rem, 6vw, 6rem)) * 0.4);
    max-width: 100%;
    /* `auto` à gauche : c'est lui qui renvoie le bloc contre le bord droit. */
    margin: clamp(2.5rem, 5vw, 4rem) 0 0 auto;
    font-family: var(--font-copy);
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    text-align: justify;
    hyphens: auto;
    text-indent: 2em;
    orphans: 2;
    widows: 2;
  }

  /*
    ┌─ LA NOTE DE FONDATION, EN BAS DE PAGE ────────────────────────────────┐
    │ Ce n'était pas une note mais un feuillet : un pavé de texte au corps  │
    │ courant, sur son propre papier, posé au milieu de la page. Il se      │
    │ lisait comme une section de plus.                                    │
    │                                                                       │
    │ C'en est une maintenant, au sens du livre : appelée depuis le mot     │
    │ qu'elle éclaire, rejetée au pied de la section, en petit corps, sans  │
    │ fond propre. Ce qui la désigne n'est plus un cadre mais le FILET      │
    │ COURT au-dessus d'elle et le blanc qui l'en sépare — la convention    │
    │ typographique exacte, qui ne coûte pas une couleur de plus.           │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-note {
    /*
      Le corps de la note. Nettement sous le texte courant — c'est le petit
      corps qui dit « note », avant même le filet — mais au-dessus du seuil de
      lisibilité d'un texte suivi de quatre paragraphes.
    */
    --note-size: clamp(0.8125rem, 0.55vw + 0.7rem, 0.9375rem);
    display: grid;
    /*
      Le numéro PEND dans la marge, le texte s'aligne sur lui-même : c'est ce
      décrochement qui fait lire un appel de note plutôt qu'une liste. La
      colonne est en `ch` de la note elle-même — elle tient « 1. » et son
      espace, quelle que soit la taille rendue.
    */
    grid-template-columns: 3ch minmax(0, 1fr);
    column-gap: 0.75rem;
    /*
      La note appartient encore à la section, mais elle est au PIED : le blanc
      au-dessus doit être franchement plus large que celui qui sépare deux
      paragraphes, sinon elle se lit comme la suite du texte.
    */
    margin-top: clamp(5rem, 9vw, 9rem);
    /* Mesure courte, comme en bas de page : la note ne file pas sur la laize. */
    max-width: 44rem;
    /*
      Même garde que les autres ancres de la page : arrivé par l'appel, on
      atterrit sur le filet et non le nez collé au bord haut de l'écran.
    */
    scroll-margin-top: clamp(1.5rem, 3vw, 3rem);
  }

  /*
    Le filet de note. Court et calé à gauche, comme l'imprimeur le pose : un
    trait sur toute la mesure ferait une séparation de section, pas une note.
  */
  .labo-note::before {
    content: '';
    grid-column: 1 / -1;
    width: 6rem;
    height: 1px;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    background-color: var(--color-line);
  }

  /*
    Le numéro est composé EXACTEMENT comme le titre qu'il précède — même fonte,
    même corps, même interligne, même approche. C'est la seule façon de les
    poser sur une même ligne de base : deux corps différents, et le chiffre
    flotte au-dessus ou sous le titre, quel que soit l'alignement demandé à la
    grille.
  */
  .labo-note__number,
  .labo-note__title {
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: var(--text-note--line-height);
    letter-spacing: var(--tracking-sous-titre);
    font-weight: 400;
  }

  .labo-note__number {
    /*
      Sans cela, la case de grille s'étire sur toute la hauteur de la note :
      le renvoi devient un lien de trois signes de large sur trois cents de
      haut, qui s'allume quand on passe à côté du texte.
    */
    align-self: start;
    color: var(--color-ink);
    text-decoration: none;
  }

  .labo-note__title {
    margin: 0 0 clamp(0.75rem, 1.5vw, 1.25rem);
    text-transform: uppercase;
  }

  /*
    Deux colonnes, comme le bas d'une page de livre. Le texte est court : les
    deux colonnes tiennent ensemble dans un écran, on ne remonte donc jamais
    chercher le haut de la seconde — c'est la seule condition qui rend la
    composition en colonnes lisible à l'écran.
  */
  .labo-note__columns {
    columns: 2;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /*
    Le texte de la note est dans la fonte de labeur, au petit corps : c'est un
    texte suivi, pas une mention machine. L'interligne reste ouvert — un petit
    corps serré sur quatre paragraphes ne se lit plus.
  */
  .labo-note__paragraph {
    margin: 0;
    font-family: var(--font-copy);
    font-size: var(--note-size);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    /*
      Fer à fer, et l'alinéa remplacé par un blanc entre les paragraphes : sur
      une colonne étroite, l'un ET l'autre feraient deux marques pour un seul
      changement de paragraphe.
    */
    text-align: justify;
    /*
      La césure est ce qui REND la justification tenable ici : sur une colonne
      de moins de cinquante signes, sans elle, les blancs entre mots s'ouvrent
      d'une ligne à l'autre et creusent des rivières. C'est le réglage inverse
      des grands textes de la page, où un mot coupé se verrait de loin.
    */
    hyphens: auto;
    /* Jamais une ligne seule au pied ou en tête d'une colonne. */
    orphans: 2;
    widows: 2;
  }

  .labo-note__paragraph + .labo-note__paragraph {
    margin-top: 0.7em;
  }

  .labo-note__signature {
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    font-family: var(--font-annotation);
    font-size: var(--note-size);
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    text-align: right;
  }

  /*
    L'APPEL, dans le texte. Exposant : la convention du livre, et le seul moyen
    de poser un renvoi dans une phrase sans en casser la ligne.

    `position: relative` plutôt que `<sup>` : l'élément exposant natif modifie
    la hauteur de ligne du paragraphe qui le porte, et la déclaration de la
    section est composée au fer à fer sur quatre lignes — un interlignage qui
    bouge sur une seule d'entre elles se voit immédiatement.
  */
  .labo-note__call {
    position: relative;
    top: -0.45em;
    margin-left: 0.12em;
    /*
      Le rapport de l'appel à son texte, et non une taille fixe : la
      déclaration passe de 2 à 4 rem selon la largeur, l'appel la suit.
    */
    font-size: 0.42em;
    letter-spacing: 0;
    text-decoration: none;
    /* Le chiffre ne se justifie pas avec le reste de la ligne. */
    white-space: nowrap;
    /* Cible tactile élargie sans toucher à la ligne : la garniture ne pousse rien. */
    padding-inline: 0.3em;
    margin-inline: -0.18em;
  }

  .labo-note__call:hover,
  .labo-note__call:focus-visible,
  .labo-note__number:hover,
  .labo-note__number:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /*
    À l'arrivée par l'ancre, la note se signale une fois — sinon on atterrit au
    pied d'une section sans savoir ce qu'on est venu y lire. Le filet suffit :
    il s'épaissit le temps qu'on le remarque, et rien ne bouge dans la page.
  */
  .labo-note:target::before {
    width: 12rem;
    height: 2px;
    transition:
      width 0.5s ease-out,
      height 0.5s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-note:target::before {
      transition: none;
    }
  }

  .labo-services {
    padding-block: clamp(2rem, 3vw, 3.5rem) clamp(7rem, 11vw, 11rem);
    /*
      Destination commune de toutes les fiches : l'en-tête « Index orbital ».

      La garde était de 9 rem au large : l'ancre déposait la section si bas que
      le titre flottait au milieu de l'écran, précédé d'un tiers de page vide.
      Elle se resserre — juste de quoi ne pas coller l'en-tête au bord — et
      cède le pas, sur écran étroit, au dégagement de la barre de marque, qui
      lui est fixe et masquerait le titre.

      Le script des fiches lit cette valeur pour composer la sienne
      (`--service-anchor-offset`) : la resserrer ici les resserre toutes.
    */
    scroll-margin-top: max(clamp(1.5rem, 3vw, 3rem), var(--mobile-brand-clearance, 0rem));
  }

  /*
    Écart resserré : la légende appartient à la figure au-dessus d'elle, pas à
    la grille en dessous. Une marge de fin de section l'aurait détachée des deux.
  */
  .labo-services__heading {
    margin-bottom: clamp(2rem, 3.5vw, 3.5rem);
    font-size: var(--text-note);
    line-height: 1.25;
  }

  /* Même place et même corps que le repère de la page Contact. */
  .labo-hero__index {
    display: block;
    margin-top: clamp(3rem, 6vw, 5rem);
    color: var(--color-muted);
    /*
      Réserve courte au-dessus de l'ancre : elle doit rester inférieure à la
      marge propre du repère (3 à 5 rem), sans quoi le défilement s'arrête assez
      haut pour laisser dépasser la dernière ligne du texte précédent — et la
      section s'ouvre sur la fin de la précédente.
    */
    scroll-margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .labo-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /*
      Colonnes resserrées : la gouttière ne sert plus qu'à séparer deux blocs de
      texte, la largeur de mesure de chacun (40ch sur le paragraphe) suffisant
      déjà à les tenir à distance.
    */
    column-gap: clamp(1.5rem, 2.2vw, 2.5rem);
    row-gap: clamp(3rem, 4.5vw, 4.5rem);
  }

  /*
    Les nœuds de l'orbite mènent tous au même endroit, sans que le clic soit
    intercepté : chaque fiche garde son ancre — donc partageable, et le bouton
    retour conserve son repère — mais sa marge de défilement vaut sa distance à
    l'en-tête. Le navigateur atterrit alors toujours sur « Index orbital », et
    `:target` désigne la fiche demandée. La valeur exacte est posée au chargement
    par le script ; la valeur de repli sert tant qu'il n'a pas mesuré.

    En dessous de 768 px, le script ne pose rien : c'est le repli qui s'applique,
    et le clic mène à la fiche elle-même (voir le script de la section).
  */
  /*
    Deux colonnes : la lune à gauche, le chiffre et l'intitulé empilés à droite
    — la disposition exacte du nœud sur l'orbite. Le corps de la fiche reprend
    ensuite toute la largeur : c'est le COUPLE chiffre-titre que la lune
    désigne, pas le paragraphe.
  */
  .labo-service {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.6em;
    align-items: center;
    /*
      `start` et non l'étirement par défaut : une fiche plus courte que sa
      voisine est tirée à la hauteur de la rangée, et ses lignes — chiffre,
      intitulé, corps — se répartissaient l'excédent. L'écart entre le chiffre
      et son titre passait alors de 9 à 26 px d'une colonne à l'autre. Les
      rangées gardent désormais leur hauteur propre, identique partout.
    */
    align-content: start;
    min-height: 0;
    scroll-margin-top: var(--service-anchor-offset, clamp(5rem, 10vw, 9rem));
    transition: color 320ms ease;
  }

  /*
    Mise en évidence par RETRAIT : l'index entier passe en gris, la fiche lue
    seule garde l'encre pleine et son numéro tamponné. Rien ne s'ajoute à la
    page, et la marge négative compense le fond pour que le chiffre ne bouge pas.
  */
  .labo-services__grid:has(.labo-service:target) .labo-service:not(:target) {
    color: var(--color-muted);
  }

  .labo-service:target .labo-service__number {
    padding-inline: 0.45em;
    margin-inline-start: -0.45em;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    opacity: 1;
  }

  .labo-service__number,
  .labo-service h3 {
    font-family: var(--font-titre);
  }

  /*
    La lune précède le chiffre sur la même ligne, comme la pastille précède
    l'étiquette sur l'orbite. Calée sous la ligne de base pour se centrer sur la
    hauteur d'œil du chiffre plutôt que de flotter au-dessus.
  */
  /*
    Les lunes de l'index tournent lentement sur elles-mêmes, autour de leur
    propre centre : le même mouvement que sur l'orbite, à mi-voix. Une révolution
    par minute et demie — assez lent pour qu'on ne le surprenne qu'en s'arrêtant.
  */
  .labo-service__symbol {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
    width: clamp(1.4rem, 1.9vw, 1.8rem);
    height: auto;
    transform-origin: 50% 50%;
    animation: labo-service-moon-spin 90s linear infinite;
  }

  @keyframes labo-service-moon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .labo-service__body {
    /* Le texte repart du bord de la fiche, sous le couple qu'il développe. */
    grid-column: 1 / -1;
  }

  /*
    `min-height` valait 2,9em : deux lignes réservées sous CHAQUE intitulé, pour
    que les paragraphes des trois colonnes démarrent tous à la même hauteur
    quand l'un des titres se casse en deux. Le prix en était une ligne creuse
    sous les quatre titres qui tiennent sur une seule.

    On traite désormais la cause plutôt que le symptôme : la mesure passe de 28
    à 32ch, ce qui suffit à faire tenir « Produire selon les besoins » — le seul
    qui débordait — sur une ligne. Les cinq titres font alors la même hauteur,
    l'alignement est obtenu sans rien réserver, et le plancher retombe à une
    ligne juste.

    ⚠️ L'alignement dépend donc maintenant de la longueur des intitulés saisis
    dans le CMS. Un titre nettement plus long repassera à deux lignes et fera
    démarrer SON paragraphe un cran plus bas que les autres. C'est un écart
    visuel mineur et réversible (remonter la mesure, ou revenir à un plancher de
    2,84em) — pas une casse de mise en page.
  */
  .labo-service h3 {
    max-width: 36ch;
    min-height: 1.42em;
    font-size: var(--text-note);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
  }

  /*
    La description est composée dans la fonte des TITRES, en petit corps —
    la voix dactylographiée du site, celle des mentions et des repères. Les
    fiches se lisent alors comme les entrées d'un index technique, et non
    comme des paragraphes de labeur posés dans une grille.
  */
  .labo-service p {
    max-width: 40ch;
    margin-top: clamp(0.35rem, 0.5vw, 0.5rem);
    font-family: var(--font-titre);
    font-size: var(--text-copy);
    /*
      Interligne ouvert d'un cran : le mono a des fûts plus étroits et des
      approches plus larges que la fonte de labeur, ses lignes se confondent
      plus vite. C'est ce qui rend le petit corps tenable sur trois lignes.
    */
    line-height: 1.55;
    letter-spacing: var(--tracking-copy);
  }

  /*
    Les prestations couvertes par l'étape : une ligne d'étiquettes. Le point
    médian sépare la liste sans faire partie du contenu.

    L'italique passe par GT Canon Narrow S — la voix d'annotation du système,
    dessinée penchée. Poser `font-style: italic` sur le mono aurait fait
    fabriquer une oblique au navigateur, c'est-à-dire un faux italique.
    Les capitales et leur interlettrage tombent avec lui : ils avaient été
    réglés pour le mono et alourdissent un italique de labeur.
  */
  .labo-service__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin-top: clamp(0.55rem, 0.8vw, 0.8rem);
    padding: 0;
    font-family: var(--font-annotation);
    /*
      Corps du texte courant, et non celui des notes : ce sont les outils du
      studio, pas une mention de bas de fiche. L'italique et l'opacité suffisent
      à les tenir au second plan. Au-dessus de 768 px, ce corps est repris plus
      bas avec celui de la description — voir le bloc qui suit la liste.
    */
    font-size: var(--text-copy);
    line-height: 1.4;
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    list-style: none;
    opacity: 0.68;
  }

  .labo-service__tools li + li::before {
    content: '•';
    display: inline-block;
    margin-inline-end: 0.5em;
  }

  /*
    ┌─ LES FICHES SE COMPOSENT PLUS PETIT AU LARGE ─────────────────────────┐
    │ Neuf fiches sont montrées d'un coup sur la grille de bureau. Au corps │
    │ du texte courant, l'ensemble se lisait comme neuf paragraphes mis     │
    │ côte à côte ; plus petit, il redevient ce qu'il est — un index, qu'on │
    │ parcourt avant d'y entrer.                                            │
    │                                                                        │
    │ La réduction ne vaut qu'au-dessus de 768 px. En colonne unique, les   │
    │ fiches se lisent une par une : elles gardent le corps courant, qui    │
    │ est le bon pour un texte suivi sur un écran tenu à la main.           │
    └────────────────────────────────────────────────────────────────────────┘
  */
  @media (min-width: 768px) {
    .labo-service p {
      font-size: 0.9375rem;
    }

    /*
      Les prestations descendent d'un cran de plus que la description : elles
      restent au second plan, comme l'italique et l'opacité le disent déjà.
      Les laisser au corps de la description les aurait fait remonter au même
      rang qu'elle une fois celle-ci réduite.
    */
    .labo-service__tools {
      font-size: 0.875rem;
    }
  }

  .labo-service__number {
    grid-column: 2;
    display: block;
    width: fit-content;
    transition: background-color 320ms ease, color 320ms ease;
    /*
      Plus serré que l'écart titre/description : le numéro se lit comme
      l'étiquette du titre, pas comme une ligne autonome au-dessus de lui.
    */
    margin-bottom: clamp(0.4rem, 0.6vw, 0.6rem);
    font-size: var(--text-note);
    line-height: 1;
    letter-spacing: var(--tracking-sous-titre);
    opacity: 0.68;
  }

  /*
    ── LA CONSTELLATION ─────────────────────────────────────────────────────
    Une figure a besoin d'air : elle n'a ni titre visible ni filet, c'est le
    BLANC qui la détache de la note de fondation au-dessus et du repère de la
    méthode en dessous. Sa garde basse est donc plus généreuse que celle d'une
    section de texte — on doit voir la constellation seule, un instant, avant
    que la page ne reprenne la parole.
  */
  .labo-constellation {
    padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 7vw, 7rem);
  }

  /*
    La garde HAUTE vaut celle qu'avait le repère en tête de la section Équipe —
    le rythme des repères est le même d'une section à l'autre.
  */
  .labo-method {
    padding-block: clamp(1.5rem, 2.5vw, 2.5rem) clamp(5rem, 9vw, 9rem);
    /*
      Destination de l'entrée 01.3 du rail. Même garde que la section Services,
      barre de marque comprise : sur écran étroit, celle-ci est fixe et
      couvrirait le repère si l'ancre déposait la section au ras du bord.
    */
    scroll-margin-top: max(clamp(1.5rem, 3vw, 3rem), var(--mobile-brand-clearance, 0rem));
  }


  /*
    ── L'ÉTAGÈRE ────────────────────────────────────────────────────────────
    Cinq tranches côte à côte. Le meuble n'est pas dessiné : ce sont les
    tranches elles-mêmes, rangées et alignées au pied, qui le donnent à voir.
    Un filet sous elles avait été essayé — il fermait la composition d'un
    trait noir plus fort que tout ce qu'il portait.

    `position: relative` n'est pas décoratif : il fait de l'étagère le parent
    de positionnement des tranches, et c'est sur cette base que le script
    mesure la course de chacune (`offsetLeft`).
  */
  /*
    La scène : l'étagère, et les deux couches de spécimen qui l'encadrent. Elle
    porte la laize et le blanc de tête, l'étagère n'a plus qu'à la remplir —
    les couches se calent ainsi sur le rectangle exact de l'étagère, sans que
    la mesure soit écrite deux fois.
  */
  .labo-method__stage {
    position: relative;
    width: min(100%, 62rem);
    margin: clamp(3.5rem, 6vw, 6rem) auto 0;
  }

  .labo-method__shelf {
    position: relative;
    z-index: 2;
    display: flex;
    gap: clamp(0.15rem, 0.3vw, 0.3rem);
    align-items: flex-end;
    width: 100%;
    list-style: none;
  }

  /*
    Les deux couches ne se distinguent que par leur RANG et leur découpe :
    la nette dessous, débordante ; la floue par-dessus, arrêtée au rectangle
    de l'étagère. Aucune des deux ne reçoit le pointeur — c'est la tranche qui
    répond au survol, pas l'image qu'elle appelle.
  */
  .labo-method__reveal,
  .labo-method__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .labo-method__reveal {
    z-index: 0;
  }

  /*
    Le flou est posé sur l'IMAGE, la découpe sur la couche : dans l'autre sens,
    le flou aurait adouci le bord de la découpe et l'étagère aurait perdu son
    arête franche.
  */
  .labo-method__veil {
    z-index: 1;
    overflow: hidden;
  }

  .labo-method__veil .labo-method__ghost {
    filter: blur(14px);
  }

  /*
    Chaque spécimen se centre sur SA tranche : la colonne se déduit du rang et
    du nombre de strates, la mise en page n'a rien à déclarer de plus.

    La hauteur déborde l'étagère d'environ un tiers — c'est ce débordement
    qu'on voit net — mais reste sous la hauteur de la fenêtre : le spécimen ne
    dépasse jamais la page.
  */
  .labo-method__ghost {
    position: absolute;
    top: 50%;
    left: calc((var(--ghost-index) + 0.5) / var(--ghost-count) * 100%);
    translate: -50% -50%;
    opacity: 0;
    transition: opacity 460ms ease;
  }

  /* Même raison qu'au picto : l'image vient d'un composant enfant. */
  .labo-method__ghost :global(img) {
    display: block;
    width: auto;
    max-width: none;
    height: min(42rem, 74svh);
  }

  /*
    Amélioration progressive, et rien d'autre : la planche ne se montre qu'aux
    pointeurs capables de survoler, et qu'à partir de la composition debout —
    couchées, les tranches n'ont plus de « derrière ». En dessous, les couches
    ne sont pas rendues, donc jamais téléchargées.
  */
  @media (max-width: 767px), (hover: none), (pointer: coarse) {
    .labo-method__reveal,
    .labo-method__veil {
      display: none;
    }
  }

  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .labo-method__stage:has(.labo-strate:nth-child(1):hover) :is(.labo-method__reveal, .labo-method__veil) > :nth-child(1),
    .labo-method__stage:has(.labo-strate:nth-child(2):hover) :is(.labo-method__reveal, .labo-method__veil) > :nth-child(2),
    .labo-method__stage:has(.labo-strate:nth-child(3):hover) :is(.labo-method__reveal, .labo-method__veil) > :nth-child(3),
    .labo-method__stage:has(.labo-strate:nth-child(4):hover) :is(.labo-method__reveal, .labo-method__veil) > :nth-child(4),
    .labo-method__stage:has(.labo-strate:nth-child(5):hover) :is(.labo-method__reveal, .labo-method__veil) > :nth-child(5) {
      opacity: 1;
    }

    /*
      LE PAPIER DEVIENT TRANSLUCIDE. Les cinq tranches, pas seulement celle
      qu'on désigne : le spécimen est plus large qu'une tranche, et c'est de
      passer derrière ses voisines qui fait l'effet.

      Elles restent OPAQUES hors survol, et c'est nécessaire : au rangement,
      une tranche en course passe devant les autres, et on ne doit pas les voir
      au travers.
    */
    .labo-method__stage:has(.labo-strate:hover) .labo-strate {
      background-color: color-mix(in oklab, var(--color-surface) 56%, transparent);
    }

    .labo-method__stage:has(.labo-strate:hover) .labo-strate__spine {
      background-color: transparent;
    }

    /*
      Le petit spécimen s'efface pendant que le grand paraît : c'est la même
      image, la montrer deux fois à deux tailles la ferait bégayer. Son
      mélange au papier n'a d'ailleurs plus de fond sur lequel se poser.
    */
    .labo-method__stage:has(.labo-strate:hover) .labo-strate__picto {
      opacity: 0;
    }

    .labo-strate,
    .labo-strate__spine,
    .labo-strate__picto {
      transition: background-color 460ms ease, opacity 460ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-method__ghost,
    .labo-strate,
    .labo-strate__spine,
    .labo-strate__picto {
      transition: none;
    }
  }

  /*
    La tranche elle-même : un rectangle de papier, cerné d'un filet. Le fond est
    OPAQUE et repris du papier de la page — c'est ce qui permet à une tranche en
    cours de rangement de passer devant les autres sans les laisser transparaître.

    Les cinq se partagent la largeur à parts égales (`flex: 1 1 0`) : sur une
    étagère, ce sont les livres qui s'ajustent au meuble.
  */
  .labo-strate {
    flex: 1 1 0;
    min-width: 0;
    height: clamp(20rem, 32vw, 28rem);
    padding: clamp(0.7rem, 1vw, 1rem) clamp(0.45rem, 0.7vw, 0.7rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  /*
    LE PIVOT. Le contenu de la tranche se compose à la verticale, et se lit de
    bas en haut — le sens du dos d'un livre en France.

    `writing-mode: vertical-rl` le compose de haut en bas ; la rotation d'un
    demi-tour le retourne. On obtient ainsi la lecture ascendante sans
    `sideways-lr`, que Safari ne connaît toujours pas.

    Conséquence sur l'ORDRE : la rotation inverse l'axe. Le document se lit donc
    mot, phrase, spécimen — et se rend spécimen en tête, phrase, puis mot au
    pied. C'est l'ordre du dos de livre, et c'est aussi l'ordre juste pour un
    lecteur d'écran, qui rencontre l'intitulé avant ce qui l'explique.
  */
  .labo-strate__spine {
    display: flex;
    writing-mode: vertical-rl;
    /*
      `sideways` et non l'orientation « mixte » par défaut : celle-ci REDRESSE
      certains signes au lieu de les coucher avec le reste de la ligne, et
      l'apostrophe courbe en fait partie — « L'enquête » se composait « L ~
      enquête », signe debout au milieu de lettres couchées. Sideways couche
      tout le monde du même quart de tour.
    */
    text-orientation: sideways;
    transform: rotate(180deg);
    /*
      La rotation fait de cette boîte un contexte d'empilement, et c'est DANS
      ce contexte que les spécimens se mélangent au fond. Sans fond ici, ils
      se mélangeraient au vide : leur blanc resterait blanc. Le papier est
      donc repris sur la boîte qui pivote, pas seulement sur la tranche.
    */
    background: var(--color-surface);
    width: 100%;
    height: 100%;
  }

  /*
    Le couple mot + phrase. `flex-direction: column` suit ici l'axe de BLOC,
    qui est horizontal en composition verticale : les deux se rangent donc en
    travers de la tranche, l'un à côté de l'autre, et non l'un après l'autre.

    C'est ce qui les fait partir du même pied — toutes leurs lignes commencent
    au bas de la tranche. Empilés dans l'axe de lecture, la phrase démarrait
    là où le mot s'arrêtait, et les deux blocs descendaient en escalier.
  */
  .labo-strate__label {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 0.8vw, 0.8rem);
    min-inline-size: 0;
  }

  .labo-strate__word {
    font-family: var(--font-copy);
    font-size: clamp(1.05rem, 1.5vw, 1.5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: var(--tracking-copy);
    text-transform: none;
  }

  /*
    La phrase, dans la voix d'annotation du système — l'italique dessiné de GT
    Canon Narrow S, et non un romain penché. Deux crans sous le mot : elle le
    commente, elle ne le double pas.
  */
  .labo-strate__note {
    color: var(--color-muted);
    font-family: var(--font-annotation);
    font-size: clamp(0.7rem, 0.85vw, 0.85rem);
    font-style: italic;
    line-height: 1.35;
    letter-spacing: var(--tracking-annotation);
  }

  /*
    Le spécimen, renvoyé à l'autre bout de la tranche par une marge automatique
    — le haut, une fois la rotation appliquée.

    LE QUART DE TOUR. Le spécimen est composé DANS la tranche, comme le texte :
    il suit donc le même sens de lecture. Sans lui, il restait dans le sens de
    la page pendant que tout le reste avait pivoté — on le voyait couché dès
    qu'on penchait la tête pour lire le mot. Le cadrage est carré, la rotation
    ne change donc pas l'encombrement et rien ne se décale autour.

    `multiply` pose les prises de vue sur le papier de la page : le blanc de
    leur fond s'y fond, elles s'impriment plutôt qu'elles ne se collent. Une
    image déjà détourée, elle, n'a rien à y perdre — le mélange n'agit que là
    où il y a de la matière.
  */
  .labo-strate__picto {
    margin-inline-start: auto;
    align-self: center;
    /*
      EMPREINTE CARRÉE, CADRAGE LIBRE. Les cinq spécimens n'ont pas le même
      format — deux dessins en hauteur, trois prises de vue au carré — et c'est
      le CSS qui leur donne leur cadre commun, pas le fichier.

      Rien n'est ajouté autour du sujet : une image mise au carré à la
      fabrication, par des marges transparentes, ressort OPAQUE et blanche du
      service d'images — deux bandes claires de part et d'autre du dessin, que
      le `multiply` ne rattrape pas puisqu'il n'éclaircit jamais. Le cadre est
      donc affaire de CSS, et le fichier garde son format propre.
    */
    display: block;
    width: min(100%, 7rem);
    aspect-ratio: 1;
    transform: rotate(90deg);
    mix-blend-mode: multiply;
  }

  /*
    `:global` est ici une NÉCESSITÉ, pas un raccourci : l'image est rendue par
    `SanityImage`, et la portée de style d'Astro s'arrête aux éléments écrits
    dans ce fichier. Sans elle, la règle ne désignerait rien — et le spécimen
    reprendrait sa taille naturelle, chacun la sienne. Le porteur, lui, nous
    appartient : c'est lui qui tient la boîte, le quart de tour et le mélange.
  */
  .labo-strate__picto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* La légende appartient à l'étagère : même mesure, même bord gauche. */
  .labo-method__caption {
    width: min(100%, 62rem);
    margin: clamp(0.8rem, 1.2vw, 1.2rem) auto 0;
    font-size: var(--text-note);
    line-height: 1.25;
  }

  /*
    ── L'ÉTAGÈRE COUCHÉE ────────────────────────────────────────────────────
    Sous 768 px, cinq tranches côte à côte tomberaient à soixante pixels de
    large : le mot y tiendrait encore, sa phrase non. On ne réduit donc pas la
    composition, on la RETOURNE — les tranches se couchent et s'empilent, et
    les cinq strates redeviennent ce qu'elles nomment : des couches.

    Le pivot est annulé, le texte revient à l'horizontale, et le spécimen passe
    en tête de ligne (`order`) puisque l'inversion de la rotation ne le porte
    plus.
  */
  @media (max-width: 767px) {
    .labo-method__shelf {
      flex-direction: column;
      /*
        L'axe secondaire a basculé avec la direction : le `flex-end` de
        l'étagère debout renverrait ici chaque couche contre le bord droit, à
        la largeur de son seul contenu — la première strate y perdait trois
        pixels sur les autres. Empilées, elles prennent toute la laize.
      */
      align-items: stretch;
      gap: 0;
      width: 100%;
    }

    .labo-strate {
      flex: none;
      height: auto;
      padding: clamp(0.9rem, 3vw, 1.2rem) clamp(0.8rem, 3vw, 1.1rem);
    }

    /* Les filets mitoyens se superposent : une seule ligne entre deux couches. */
    .labo-strate + .labo-strate {
      border-top: 0;
    }

    .labo-strate__spine {
      align-items: center;
      gap: clamp(0.9rem, 4vw, 1.2rem);
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      transform: none;
    }

    /*
      Couché, le couple redevient ce qu'il est à la lecture : le mot, et sa
      phrase dessous. C'est la même relation qu'à la verticale — seul l'axe
      qui la porte a tourné.
    */
    .labo-strate__label {
      flex: 1 1 auto;
      gap: 0.3rem;
    }

    .labo-strate__word {
      font-size: clamp(1.05rem, 4.5vw, 1.35rem);
    }

    .labo-strate__note {
      font-size: clamp(0.8rem, 3.4vw, 0.95rem);
    }

    /*
      Le spécimen repasse en tête de ligne : la rotation ne l'y porte plus. Il
      reprend aussi le sens de la page, puisque le texte à côté de lui l'a
      repris.
    */
    .labo-strate__picto {
      order: -1;
      flex: none;
      align-self: center;
      width: clamp(3.5rem, 16vw, 4.5rem);
      margin-inline-start: 0;
      transform: none;
    }

    .labo-method__caption {
      width: 100%;
      margin-top: clamp(1rem, 4vw, 1.5rem);
    }
  }

  .labo-archive {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .labo-archive__layout {
    display: grid;
    grid-template-columns: clamp(12rem, 20vw, 19rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .labo-archive__head {
    position: relative;
    z-index: 2;
    padding-top: 0.15rem;
  }

  .labo-archive__head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, var(--text-titre));
    line-height: 1;
  }

  .labo-archive__rail {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .labo-orbits {
      width: 100%;
      min-height: 0;
    }

    .labo-orbits::before {
      inset: 0;
    }

    .labo-orbits__axis {
      width: 98%;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 17vw, 7.5rem);
    }

    .labo-orbits__core strong {
      font-size: var(--text-copy);
    }

    .labo-orbit__label {
      left: 1.55rem;
      display: block;
      width: auto;
      padding: 0;
      transform-origin: -1.55rem 50%;
    }

    .labo-orbit__label-text {
      display: none;
    }

    .labo-orbit__label-index {
      display: block;
      font-size: var(--text-note);
      opacity: 0.72;
    }

    .labo-services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .labo-services__grid {
      row-gap: clamp(2.75rem, 4.5vw, 4rem);
    }

    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

  }

  @media (max-width: 767px) {
    .labo-orbit__label-index {
      font-size: var(--text-note);
    }

    .labo-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 25vw, 6.5rem);
    }

    .labo-orbits__core strong {
      font-size: var(--text-note);
    }

    .labo-philosophy,
    .labo-section-heading,
    .labo-archive__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }


    .labo-philosophy {
      min-height: auto;
      padding-top: 5rem;
    }

    .labo-philosophy__margin {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .labo-philosophy__scale {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      min-height: 3.25rem;
      background:
        repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px 0.55rem) left bottom 1rem / 100% 0.65rem no-repeat,
        linear-gradient(var(--color-line), var(--color-line)) left bottom 1rem / 100% 1px no-repeat;
    }

    .labo-philosophy__scale::before,
    .labo-philosophy__scale::after {
      bottom: 0.7rem;
      width: 1px;
      height: 1.25rem;
    }

    .labo-philosophy__scale::before {
      top: auto;
      right: auto;
      left: 0;
    }

    .labo-philosophy__scale::after {
      right: 0;
    }

    .labo-philosophy__scale span {
      top: 0;
      right: auto;
      left: 0;
      transform: none;
    }

    .labo-philosophy__marginalia {
      text-align: right;
    }

    .labo-philosophy__folio {
      margin-bottom: 3.5rem;
      font-size: var(--text-note);
    }

    .labo-philosophy__page {
      width: calc(100% - 1.2rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
      margin-top: 5rem;
    }

    .labo-archive__head {
      padding-bottom: 1.5rem;
    }

    .labo-archive__rail {
      grid-column: 1;
    }

    .labo-services__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
      row-gap: 3.5rem;
    }

    .labo-service {
      min-height: auto;
    }

    .labo-service h3 {
      max-width: none;
      min-height: 0;
    }

    /*
      Les plafonds en `ch` étaient pensés pour une colonne large : sur la
      seule colonne mobile, ils laissaient le texte inutilement étroit,
      repliés bien avant le bord de son conteneur.
    */
    .labo-service p {
      max-width: none;
    }

    /*
      Le fer à fer suppose une ligne assez longue pour absorber les blancs :
      sur une colonne mobile, il creuserait des rivières. On revient au fer à
      gauche, et l'alinéa se resserre.
    */
    .labo-team__lead,
    .labo-team__body {
      text-align: left;
    }

    .labo-team__lead,
    .labo-team__body {
      text-indent: 2rem;
    }

    .labo-team__body {
      width: 100%;
      margin-left: 0;
      /* Trop étroit pour couper les mots — même arbitrage que les colonnes. */
      hyphens: none;
    }

    /*
      En colonne, le numéro ne pend plus dans une marge qu'il n'y a pas : il
      passe au-dessus du texte, sur sa propre ligne. Le décrochement aurait
      mangé un dixième de la mesure pour trois caractères.
    */
    .labo-note {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.35rem;
    }

    /*
      Une seule colonne : à cette largeur, deux ne feraient plus que trente
      signes par ligne — la justification y creuserait des trous quoi qu'on
      fasse, et la césure couperait un mot sur deux.
    */
    .labo-note__columns {
      columns: 1;
    }

  }

  /*
    Composition éditoriale de la séquence Vision.

    AUCUN FOND PROPRE : la section se pose à même le papier de la page. Elle
    portait une texture, un lavis coloré et un grain par-dessus le fond du
    site — trois épaisseurs sous un texte long, qui se lisait à travers elles.
    Ce qui doit se voir ici, c'est le texte.
  */
  .labo-philosophy {
    box-sizing: border-box;
    width: auto;
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .labo-philosophy {
    display: block;
    min-height: 0;
    /*
      Garde du haut RÉDUITE. Les Services se referment déjà sur une garde
      généreuse : les deux s'additionnaient, et le repère « [02 — … » se
      retrouvait à plus de 250 px du dernier contenu, contre environ 170 aux
      autres charnières de la page. C'est ce blanc cumulé qu'on rabat, pas
      celui de la section précédente — elle en a besoin pour ses fiches.
    */
    padding-block: clamp(2rem, 3vw, 3rem) clamp(1.5rem, 2.5vw, 2.5rem);
    overflow: clip;
  }

  .labo-philosophy__scale,
  .labo-philosophy__marginalia,
  .labo-philosophy__folio {
    display: none;
  }

  .labo-philosophy__page {
    width: min(100%, 66rem);
    max-width: 100%;
    margin-inline: auto;
  }

  /*
    Le repère de section se cale sur la MARGE DE LA PAGE, pas sur la colonne de
    lecture. Il partageait la boîte centrée de 66 rem : dès que la page est
    plus large, le centrage l'écartait du bord et il ne tombait plus sur la
    même verticale que « [01 — Services] » ou « [03 — La méthode] ».

    Le bloc de texte, lui, reste centré : c'est le folio qui rejoint la marge,
    pas la colonne qui s'y déplace.
  */
  .labo-philosophy__margin {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  .labo-philosophy__margin {
    display: block;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .labo-philosophy__index {
    white-space: normal;
  }

  .labo-philosophy__page {
    display: block;
    position: relative;
    padding: 0;
  }

  /*
    Le chapeau. Il était composé à près de deux fois le plus grand corps de la
    charte, sur dix-sept signes de large : quatre mots par ligne, une accroche
    d'affiche. Ce que la section annonce, c'est un document de recherche — le
    chapeau descend donc au rapport d'un chapeau de revue, à peine plus d'une
    fois et demie le texte qui le suit.

    Fer à gauche, sur une mesure COURTE qui ne prend pas toute la laize : c'est
    ce qui le détache des deux colonnes en dessous, sans changer ni de fonte ni
    de couleur.
  */
  .labo-philosophy__lead {
    width: min(100%, 40rem);
    max-width: 100%;
    margin: 0;
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-indent: 0;
    text-align: left;
    text-wrap: pretty;
  }

  .labo-philosophy__quote,
  .labo-philosophy__quote-close {
    display: inline;
    position: static;
    margin: 0;
    font-size: 1em;
    line-height: inherit;
  }

  /*
    ┌─ POURQUOI DEUX COLONNES TIENNENT ICI ─────────────────────────────────┐
    │ Composer un texte en colonnes est d'ordinaire déconseillé à l'écran : │
    │ l'écran ne pagine pas. Arrivé au bas de la première colonne, il faut  │
    │ REMONTER chercher le haut de la seconde — un geste que le papier ne   │
    │ demande jamais.                                                       │
    │                                                                       │
    │ L'objection tombe à une condition, et une seule : que le bloc tienne  │
    │ dans la hauteur d'un écran. Le manifeste fait environ deux mille      │
    │ signes ; à cette mesure et à ce corps, les deux colonnes tiennent     │
    │ ensemble sous les yeux, et se lisent alors comme la page imprimée     │
    │ dont elles viennent.                                                  │
    │                                                                       │
    │ ➜ Si le texte s'allonge nettement depuis le Studio, la condition      │
    │   cesse d'être vraie : revenir à UNE colonne plutôt que de faire      │
    │   remonter le lecteur.                                                │
    └───────────────────────────────────────────────────────────────────────┘
  */
  /*
    Les deux colonnes prennent TOUTE la laize du bloc de texte.

    Elles étaient tenues à 54 rem dans une boîte de 66 : le blanc restant se
    posait tout entier à leur droite, et la section se lisait décalée — le
    chapeau et le repère à gauche, les colonnes au milieu, les quatre notions
    seules contre le bord droit. À pleine laize, le blanc qui les entoure est
    celui de la page, donc le même des deux côtés, et leur bord droit retrouve
    celui des notions.
  */
  .labo-philosophy__notes {
    display: block;
    columns: 2;
    column-gap: clamp(2rem, 4vw, 3.5rem);
    width: 100%;
    max-width: 100%;
    margin-top: clamp(3rem, 5vw, 5rem);
  }

  /*
    Un seul corps, une seule mesure, une seule fonte pour tout le manifeste.
    Les paragraphes changeaient de largeur et de taille selon un réglage du
    Studio : trois compositions dans un même texte, et l'œil devait retrouver
    à chaque bloc où reprendre sa lecture.
  */
  .labo-philosophy__note {
    width: 100%;
    max-width: none;
    margin: 0;
    font-family: var(--font-copy);
    /* Sous le corps courant : c'est l'appareil du document, pas sa voix. */
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    text-indent: 0;
    /*
      Fer à fer ET césure : les deux vont ensemble. Justifier une colonne
      étroite sans couper les mots ouvre des blancs irréguliers d'une ligne à
      l'autre — le défaut même que la composition en colonnes doit éviter.
    */
    text-align: justify;
    hyphens: auto;
    /* Jamais une ligne seule au pied ou en tête d'une colonne. */
    orphans: 2;
    widows: 2;
  }

  .labo-philosophy__note + .labo-philosophy__note {
    margin-top: 0.85em;
  }

  .labo-philosophy__keywords {
    position: absolute;
    top: 0.35rem;
    right: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    font-style: normal;
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-transform: lowercase;
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    font-style: normal;
  }

  .labo-philosophy__letter,
  .labo-philosophy__letter-track,
  .labo-philosophy__letter-track > span {
    height: 1.3em;
    font-style: normal;
    line-height: 1.3;
  }

  @media (max-width: 767px) {
    .labo-philosophy {
      padding-inline: var(--spacing-gutter);
    }

    .labo-philosophy__lead {
      width: 100%;
      max-width: 100%;
      font-size: clamp(1.25rem, 5.5vw, 1.6rem);
      text-indent: 0;
    }

    /*
      Une seule colonne : à cette largeur, deux ne feraient plus que trente
      signes par ligne — la justification y creuserait des trous quoi qu'on
      fasse, et la césure couperait un mot sur deux.
    */
    .labo-philosophy__notes {
      columns: 1;
      width: 100%;
    }

    .labo-philosophy__note {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      text-align: left;
      hyphens: none;
    }

    .labo-philosophy__keywords {
      position: static;
      align-items: flex-end;
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-service,
    .labo-service__number {
      transition: none;
    }

    .labo-service__symbol {
      animation: none;
    }

    .labo-philosophy__letter-track {
      transition: none;
    }

    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: none;
    }

    .labo-orbit__label-text,
    .labo-orbit__label-text::before {
      transition: none;
    }

    .labo-orbit__node:hover .labo-orbit__label-text,
    .labo-orbit__node:focus-visible .labo-orbit__label-text {
      transform: none;
    }
  }

  /*
    Entrée des textes de lecture : le bloc entier monte et apparaît d'un coup,
    là où les grandes déclarations se révèlent mot à mot. Deux gestes distincts
    pour deux registres — et surtout, aucun temps d'attente imposé à qui lit :
    le paragraphe arrive entier.
  */
  :global(html.labo-rise-booting) [data-rise]:not([data-rise-ready]) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.labo-rise-booting) [data-rise] {
      opacity: 1;
    }
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const risingBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-rise]:not([data-rise-ready])'),
  );

  if (risingBlocks.length > 0 && !reducedMotion.matches) {
    risingBlocks.forEach((block) => {
      block.dataset.riseReady = '';

      gsap.fromTo(
        block,
        { opacity: 0, y: 22 },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: { trigger: block, start: 'top 88%', once: true },
        },
      );
    });
  }

  /*
    Les positions de déclenchement sont mesurées à l'exécution, avant que les
    fontes soient chargées et avant que le révélateur mot à mot ait redécoupé
    les grandes déclarations — deux choses qui changent la hauteur de tout ce
    qui suit. Sans ce recalcul, chaque bloc s'allumerait à côté de son repère.
  */
  document.fonts?.ready.then(() => ScrollTrigger.refresh());

  document.documentElement.classList.remove('labo-rise-booting');

  document.querySelectorAll<HTMLElement>('[data-labo-orbits]:not([data-orbits-ready])').forEach((system) => {
    system.dataset.orbitsReady = '';

    const motions: Array<{
      revolution: gsap.core.Timeline;
      spin: gsap.core.Timeline;
    }> = [];
    const carriers = system.querySelectorAll<HTMLElement>('[data-orbit-carrier]');

    carriers.forEach((carrier) => {
      const phase = Number(carrier.dataset.phase ?? 0);
      const duration = Number(carrier.dataset.duration ?? 60);
      const direction = Number(carrier.dataset.direction ?? 1);
      const spinDuration = Number(carrier.dataset.spinDuration ?? 180);
      const spinDirection = Number(carrier.dataset.spinDirection ?? -1);
      const orientation = carrier.querySelector<HTMLElement>('[data-orbit-orientation]');
      const spinner = carrier.querySelector<HTMLElement>('[data-orbit-spinner]');
      const spinPhase = (phase * 0.37 * spinDirection) % 360;

      gsap.set(carrier, { rotation: phase, force3D: true });
      if (orientation) gsap.set(orientation, { rotation: -phase, force3D: true });
      if (spinner) gsap.set(spinner, { rotation: spinPhase, force3D: true });

      if (reducedMotion.matches || !orientation || !spinner) return;

      const revolution = gsap.timeline({ paused: true, repeat: -1 });
      revolution.to(carrier, {
        rotation: phase + 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);
      revolution.to(orientation, {
        rotation: -phase - 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);

      const spin = gsap.timeline({ paused: true, repeat: -1 });
      spin.to(spinner, {
        rotation: spinPhase + 360 * spinDirection,
        duration: spinDuration,
        ease: 'none',
        force3D: true,
      });

      motions.push({ revolution, spin });
    });

    if (reducedMotion.matches || motions.length === 0) {
      return;
    }

    /*
      Réponse au scroll. La vitesse du geste devient une impulsion qui s'ajoute
      au régime de croisière des orbites, puis retombe d'elle-même. Les valeurs
      se lisent ensemble : un scroll de trackpad ordinaire tourne autour de
      1200 px/s, soit une impulsion d'environ 3 — les orbites quadruplent leur
      vitesse le temps du geste, et un lancer franc les pousse jusqu'à 8×.
    */
    const SCROLL_SENSITIVITY = 420; // px/s nécessaires pour +1× de vitesse
    const IMPULSE_MIN = -3;
    const IMPULSE_MAX = 7;
    const REVOLUTION_MIN = 0.25; // remonter le scroll fait presque caler l'orbite
    const REVOLUTION_MAX = 8;
    const SPIN_COUPLING = 0.5; // les symboles suivent, à mi-voix
    const SPIN_MIN = 0.4;
    const SPIN_MAX = 4;

    let hoverFactor = 1;
    let scrollImpulse = 0;

    const setHoverFactor = (isHovering: boolean) => {
      hoverFactor = isHovering ? 0.16 : 1;
    };

    system.addEventListener('pointerenter', () => setHoverFactor(true));
    system.addEventListener('pointerleave', () => setHoverFactor(false));

    const scrollTrigger = ScrollTrigger.create({
      trigger: system,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: ({ isActive }) => {
        motions.forEach(({ revolution, spin }) => {
          isActive ? revolution.play() : revolution.pause();
          isActive ? spin.play() : spin.pause();
        });
      },
      onUpdate: (self) => {
        scrollImpulse = gsap.utils.clamp(IMPULSE_MIN, IMPULSE_MAX, self.getVelocity() / SCROLL_SENSITIVITY);
      },
    });

    if (scrollTrigger.isActive) {
      motions.forEach(({ revolution, spin }) => {
        revolution.play();
        spin.play();
      });
    }

    /*
      Trois réglages de temps, calibrés pour une image de 60 Hz. Sur un écran
      120 Hz, les appliquer telles quelles ferait retomber l'élan deux fois plus
      vite et rendrait la poussée du scroll deux fois plus molle : le même geste
      ne donnerait pas le même mouvement d'une machine à l'autre. On les
      convertit donc en fonction du temps réellement écoulé.

      L'élan survit volontairement au geste : il met environ une demi-seconde à
      s'éteindre, et les orbites le rattrapent assez vite pour qu'on voie
      l'accélération arriver. C'est ce décalage — pousser, puis regarder le
      système redescendre tout seul — qui rend l'effet lisible.
    */
    const IMPULSE_DECAY = 0.945; // par image : l'élan garde la moitié de sa force ~200 ms
    const REVOLUTION_CATCH_UP = 0.16;
    const SPIN_CATCH_UP = 0.1;

    const perFrame = (rate: number, frames: number) => 1 - (1 - rate) ** frames;

    const updateMotion = () => {
      const frames = gsap.ticker.deltaRatio(60);
      scrollImpulse *= IMPULSE_DECAY ** frames;
      const revolutionSpeed =
        gsap.utils.clamp(REVOLUTION_MIN, REVOLUTION_MAX, 1 + scrollImpulse) * hoverFactor;
      const spinSpeed =
        gsap.utils.clamp(SPIN_MIN, SPIN_MAX, 1 + scrollImpulse * SPIN_COUPLING) * hoverFactor;

      motions.forEach(({ revolution, spin }) => {
        revolution.timeScale(
          gsap.utils.interpolate(revolution.timeScale(), revolutionSpeed, perFrame(REVOLUTION_CATCH_UP, frames)),
        );
        spin.timeScale(
          gsap.utils.interpolate(spin.timeScale(), spinSpeed, perFrame(SPIN_CATCH_UP, frames)),
        );
      });
    };

    gsap.ticker.add(updateMotion);
  });

  /*
    ── LE RANGEMENT DES STRATES ───────────────────────────────────────────────
    Les cinq tranches entrent par le BORD DROIT DE L'ÉCRAN, une à une, et
    viennent se ranger de la gauche vers la droite : la méthode se pose sous
    les yeux du lecteur, dans l'ordre de la descente.

    Elles partent toutes du même point — le bord de l'écran — et non chacune
    d'un peu plus loin : c'est ce qui donne le geste de la main qui pose les
    livres l'un après l'autre, plutôt qu'une rangée qui glisserait d'un bloc.
    La course de chacune est donc mesurée à l'exécution.

    `offsetLeft` et non `getBoundingClientRect()` : la mesure doit être celle de
    la MISE EN PAGE, pas celle du rendu — les tranches sont déjà déplacées par
    l'animation au moment où on recalcule, et un rectangle mesuré les prendrait
    à leur position courante. `offsetLeft`, lui, ignore les transformations ;
    l'étagère est son parent de positionnement (`position: relative`).

    Sans JavaScript, sans GSAP, ou en mouvement réduit : rien ne s'exécute et
    l'étagère est déjà rangée. Le contenu ne dépend jamais du geste.
  */
  document
    .querySelectorAll<HTMLElement>('[data-method-shelf]:not([data-shelf-ready])')
    .forEach((shelf) => {
      shelf.dataset.shelfReady = '';

      const strates = Array.from(shelf.querySelectorAll<HTMLElement>('[data-strate]'));
      if (strates.length === 0) return;

      const media = gsap.matchMedia();

      media.add('(prefers-reduced-motion: no-preference)', () => {
        /*
          Course d'une tranche : la distance qui amène son bord gauche au bord
          droit de la fenêtre, plus une garde pour qu'elle attende hors champ.
          `.labo` étant en `overflow: clip`, cette attente ne crée aucune barre
          de défilement horizontale.
        */
        const travel = (strate: HTMLElement) => () =>
          window.innerWidth - shelf.getBoundingClientRect().left - strate.offsetLeft + 24;

        const timeline = gsap.timeline({
          scrollTrigger: {
            trigger: shelf,
            start: 'top 92%',
            end: 'top 22%',
            /*
              `scrub` et non un déclenchement unique : c'est le lecteur qui
              range, et le geste doit pouvoir se rejouer en remontant. Le léger
              retard donne le poids de l'objet qu'on pose.
            */
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        });

        strates.forEach((strate, index) => {
          timeline.fromTo(
            strate,
            { x: travel(strate) },
            { x: 0, ease: 'power2.out', duration: 1, force3D: true },
            /*
              Un tiers de recouvrement entre deux rangements : la suivante
              s'élance avant que la précédente ne soit tout à fait posée. Sans
              ce recouvrement, la séquence se lit comme cinq gestes séparés.
            */
            index * 0.34,
          );
        });

        return () => {
          gsap.set(strates, { clearProps: 'transform' });
        };
      });
    });

</script>
