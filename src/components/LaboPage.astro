---
import { Image } from 'astro:assets';
import ProjectCatalogRail from '~/components/ProjectCatalogRail.astro';
import Constellation from '~/components/Constellation.astro';
import FigureCaption from '~/components/primitives/FigureCaption.astro';
import SanityImage from '~/components/primitives/SanityImage.astro';
import { useTranslations } from '~/i18n/ui';
import { documentFieldAttribute } from '~/lib/visualEditing';
import type { Locale } from '~/i18n/config';
import type { LaboPage } from '~/lib/sanity/types';

/*
  Les cinq lunes du studio remplacent les pictogrammes d'origine. Recadrées au
  carré sur le disque et réduites à 400 px : elles s'affichent à moins de deux
  rem, une planche A4 à 300 dpi n'avait rien à faire dans le dépôt.
*/
import luneBlancheSymbol from '~/assets/labo-symbols/lune-blanche.png';
import luneBlanche2Symbol from '~/assets/labo-symbols/lune-blanche-2.png';
import luneFumeeSymbol from '~/assets/labo-symbols/lune-fumee.png';
import luneGriseSymbol from '~/assets/labo-symbols/lune-grise.png';
import lunePayneSymbol from '~/assets/labo-symbols/lune-payne.png';
import lunePayne2Symbol from '~/assets/labo-symbols/lune-payne-2.png';

interface Props {
  page: LaboPage;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);
/*
  Le parcours compte cinq étapes, et l'orbite en porte une par anneau. Les
  tableaux de réglage suivent donc cette cardinalité ; les valeurs de repli
  couvrent une sixième étape ajoutée depuis le Studio sans retoucher le code.
*/
const services = (page.services ?? []).slice(0, 6);

/*
  Les étapes se numérotent en chiffres romains — la numérotation d'un sommaire,
  pas d'une liste. Les IDENTIFIANTS d'ancre, eux, restent en chiffres arabes
  (« labo-service-001 ») : ce sont des adresses, elles ne changent pas parce que
  l'affichage change.
*/
const ROMAN: Array<[number, string]> = [
  [10, 'X'],
  [9, 'IX'],
  [5, 'V'],
  [4, 'IV'],
  [1, 'I'],
];

const toRoman = (value: number) => {
  let rest = value;
  let out = '';

  for (const [weight, sign] of ROMAN) {
    while (rest >= weight) {
      out += sign;
      rest -= weight;
    }
  }

  return out;
};
const orbitPhases = [198, 315, 64, 142, 252];
// Vitesse angulaire décroissante du centre vers l'extérieur : chaque unité
// conserve son propre rythme, même lorsque le scroll module l'ensemble.
const orbitDurations = [22, 34, 49, 68, 92];
const orbitDirections = [1, -1, 1, -1, 1];
/*
  ROTATION PROPRE DES LUNES — la même partout.

  Chaque lune tourne sur elle-même en 90 secondes, dans le même sens, sur
  l'orbite comme dans l'index des services plus bas (`labo-service-moon-spin`).
  Elles avaient ici cinq régimes différents et des sens alternés, hérités des
  pictogrammes qu'elles remplacent : deux fois le même disque tournant à deux
  vitesses se lisait comme deux objets, alors que c'est le même repère aux deux
  endroits de la page.

  Leur ANGLE DE DÉPART reste propre à chacune (voir `spinPhase`) : elles tournent
  ensemble sans jamais montrer la même face au même moment. Et le scroll module
  toujours l'ensemble — c'est le régime de croisière qui est commun, pas la
  vitesse instantanée.
*/
const MOON_SPIN_DURATION = 90;
const spinDurations = Array(5).fill(MOON_SPIN_DURATION);
const spinDirections = [1, 1, 1, 1, 1];
/*
  Le grain de la trajectoire s'affine vers l'extérieur : pointillés au centre,
  règle graduée puis micro-graduations sur les deux anneaux les plus longs, où
  la circonférence laisse la place au détail.
*/
const orbitMotifs = ['dots', 'dashes', 'morse', 'ticks', 'microticks'];
const orbitRulerTicks = Array.from({ length: 72 }, (_, index) => ({
  angle: index * 5,
  level: index % 6 === 0 ? 'major' : index % 3 === 0 ? 'medium' : 'minor',
}));
const orbitMicroTicks = Array.from({ length: 180 }, (_, index) => ({
  angle: index * 2,
  level: index % 15 === 0 ? 'major' : index % 5 === 0 ? 'medium' : 'minor',
}));
const orbitDegreeMarks = [
  { value: '270°', angle: 0 },
  { value: '180°', angle: 90 },
  { value: '90°', angle: 180 },
  { value: '0°', angle: 270 },
];
/*
  Une lune par étape, dans l'ordre du parcours. Le même repère sert à l'orbite
  et au paragraphe qu'elle désigne : changer l'un change l'autre, c'est
  volontaire — c'est ce qui relie le système en mouvement à sa description.
*/
const orbitSymbols = [
  lunePayneSymbol,
  luneGriseSymbol,
  luneFumeeSymbol,
  lunePayne2Symbol,
  luneBlanche2Symbol,
];
const orbitSystem = services.map((service, index) => ({
  service,
  index: toRoman(index + 1),
  anchor: String(index + 1).padStart(3, '0'),
  symbol: orbitSymbols[index] ?? luneGriseSymbol,
  size: `${38 + index * 10}%`,
  phase: orbitPhases[index] ?? index * 60,
  duration: orbitDurations[index] ?? 60 + index * 12,
  direction: orbitDirections[index] ?? 1,
  spinDuration: spinDurations[index] ?? MOON_SPIN_DURATION,
  spinDirection: spinDirections[index] ?? 1,
  motif: orbitMotifs[index] ?? 'dots',
}));
/*
  ── LA MÉTHODE ────────────────────────────────────────────────────────────
  Mot, phrase et spécimen viennent tous du Studio. La coupe à CINQ est tenue
  ici et pas seulement dans le modèle : au-delà, les tranches deviennent trop
  étroites pour que le mot s'y compose à la verticale, et mieux vaut ne pas
  ranger la sixième que la ranger illisible.
*/
const STRATE_LIMIT = 5;
/*
  Le nom de la méthode se compose DANS le repère de section, comme la Vision
  compose le sien dans « [02 — Manifeste - Vision] ». Le numéro et l'intitulé
  fixe restent du code — ce sont des mentions de composition ; seul le nom
  vient du Studio. S'il est vide, le repère se referme sur l'intitulé seul
  plutôt que sur un tiret orphelin.
*/
const methodTitle = page.methodTitle?.trim() ?? '';
const methodIndex = methodTitle ? `[03 — La méthode - ${methodTitle}]` : '[03 — La méthode]';
const strates = (page.method ?? []).slice(0, STRATE_LIMIT);

const archiveCount = page.archiveProjects.length;
const archiveTitle = t('labo.archive');
/*
  Le champ a longtemps été un simple tableau de chaînes. Une chaîne héritée est
  donc encore acceptée et prend la colonne étroite, sa composition d'origine.
*/
const philosophyEntries = page.philosophy.map((entry, index) =>
  typeof entry === 'string' ? { _key: `philosophy-${index}`, text: entry } : entry,
);
const [philosophyLead, ...philosophyNotes] = philosophyEntries;
const philosophyKeywords = ['INTENTION', 'POSTURE', 'REGARD', 'RÉCIT'];
const foundationParagraphs = page.foundationParagraphs ?? [];
const hasFoundationNote = foundationParagraphs.length > 0;

/*
  ── LA CONSTELLATION ───────────────────────────────────────────────────────
  Rien à saisir dans le singleton : la liste vient des fiches « Étoiles », que
  la requête rassemble toutes seules. Une personne s'encode une fois et paraît
  ici ; l'interrupteur de sa fiche l'en retire sans la supprimer.
*/
const stars = (page.stars ?? []).filter((star) => Boolean(star?.name?.trim()));

/*
  ── L'APPEL DE NOTE ────────────────────────────────────────────────────────
  La note de fondation n'est plus un feuillet posé dans la page : c'est une
  NOTE DE BAS DE PAGE, appelée depuis le nom du studio comme dans un livre.

  Le texte d'ouverture de la section est donc coupé juste après « Abîme » pour
  y glisser l'appel. La coupe est faite sur la première occurrence seulement —
  le nom revient plus loin dans d'autres champs, un appel par mention ferait
  une page criblée de renvois.

  Si le mot ne s'y trouve pas — texte réécrit depuis le Studio, version
  anglaise — `after` reste vide : le paragraphe se rend d'une pièce, sans
  appel, et la note reste atteignable par le menu. Rien ne casse.
*/
const NOTE_CALL_WORD = 'Abîme';
const teamLeadText = page.teamLead ?? '';
const noteCallAt = teamLeadText.indexOf(NOTE_CALL_WORD);
const teamLead =
  noteCallAt === -1
    ? { before: teamLeadText, after: '' }
    : {
        before: teamLeadText.slice(0, noteCallAt + NOTE_CALL_WORD.length),
        after: teamLeadText.slice(noteCallAt + NOTE_CALL_WORD.length),
      };
const showNoteCall = hasFoundationNote && teamLead.after !== '';

/*
  Le champ est DÉCOUPÉ : sa traîne d'édition visuelle ne décrit plus le texte
  qui la précède, et le champ cesserait d'être cliquable dans le Presentation
  Tool. On le désigne donc explicitement (voir `src/lib/visualEditing.ts`).
*/
const teamLeadEditable = documentFieldAttribute(page._id, page._type, 'teamLead');
---

<script is:inline>
  /*
    Marque la page comme animable AVANT la première peinture : sans cette
    classe, aucun bloc n'est masqué. Si le script d'animation ne s'exécute
    jamais — erreur, réseau coupé — le délai la retire et tout redevient
    visible. Le contenu n'est donc jamais prisonnier de l'animation.
  */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('labo-rise-booting');
    window.setTimeout(() => document.documentElement.classList.remove('labo-rise-booting'), 3000);
  }
</script>

<article class="labo">
  {/*
    Sans `id`. L'en-tête en portait un — « vision » —, hérité et que rien ne
    visait : le menu renvoyait alors la section du manifeste à « philosophie ».
    En la renommant, les deux se sont retrouvés à porter le MÊME identifiant,
    et c'est le premier du document qui l'emporte : « /labo#vision » déposait
    donc en haut de page au lieu du manifeste. Un doublon d'identifiant ne
    lève aucune erreur — il choisit silencieusement.
  */}
  <header class="labo-hero container-wide">
    <h1 class="labo-hero__title type-titre" data-text-reveal>01. {page.title}</h1>

    {/*
      Texte d'ouverture, entre le titre et l'animation — même place et même
      composition que sur les index Expériences et Journal, pour que les trois
      sections s'ouvrent de la même manière.
    */}
    {page.intro && <p class="labo-hero__intro type-copy text-pretty">{page.intro}</p>}

    {/*
      Le repère de section ouvre la page, au-dessus de l'animation — comme
      « [01 — Informations] » sur la page Contact. Il annonce ce qu'on va lire ;
      il n'a pas à attendre la fin de la figure pour le dire.
    */}
    {/*
      L'ancre « Services » du menu tombe ICI, sur le repère, et non plus sur la
      grille : c'est là que la section commence à se lire, au-dessus de la
      figure qui l'annonce. Le suivi de lecture du rail n'observe que le HAUT de
      la cible, la hauteur du repère n'a donc aucune importance pour lui.
    */}
    <span class="labo-hero__index type-note" id="services">[01 — Services]</span>

    <div class="labo-orbits" aria-label="Les champs de recherche du laboratoire" data-labo-orbits>
      <div class="labo-orbits__axis" aria-hidden="true"></div>
      <div class="labo-orbits__degrees" aria-hidden="true">
        {orbitDegreeMarks.map((mark) => (
          <span class="labo-orbits__degree" style={`--degree-angle:${mark.angle}deg;`}>
            <span>{mark.value}</span>
          </span>
        ))}
      </div>
      <div class="labo-orbits__core">
        {/*
          La lune est une IMAGE et non un fond : elle a disparu avec l'aplat
          qu'on a retiré. Posée sous la phrase, sans cadre ni grain — c'est le
          disque qu'on voit, pas la pastille qui le portait.

          Décorative : la phrase qu'elle accompagne dit déjà tout.
        */}
        <Image
          src={luneBlancheSymbol}
          width={480}
          height={480}
          alt=""
          class="labo-orbits__moon"
        />
        <span class="type-note">Le fond</span>
        <strong>{t('labo.emphasisPrecedes')}</strong>
        <span class="type-note">la forme</span>
      </div>

      {orbitSystem.map((orbit) => (
        <div
          class:list={['labo-orbit', `labo-orbit--${orbit.motif}`]}
          style={`--orbit-size:${orbit.size};--orbit-phase:${orbit.phase}deg;`}
        >
          <svg class="labo-orbit__track" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle class="labo-orbit__track-line" cx="50" cy="50" r="49" pathLength="100" />
            {(orbit.motif === 'double' || orbit.motif === 'ticks') && (
              <circle class="labo-orbit__track-line labo-orbit__track-line--secondary" cx="50" cy="50" r="46.8" pathLength="100" />
            )}
            {orbit.motif === 'ticks' && (
              <g class="labo-orbit__ruler">
                {orbitRulerTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__ruler-tick', `labo-orbit__ruler-tick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '5.4' : tick.level === 'medium' ? '4.1' : '3'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
            {orbit.motif === 'microticks' && (
              <g class="labo-orbit__microticks">
                {orbitMicroTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__microtick', `labo-orbit__microtick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '3.2' : tick.level === 'medium' ? '2.4' : '1.85'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
          </svg>

          <div
            class="labo-orbit__carrier"
            data-orbit-carrier
            data-phase={orbit.phase}
            data-duration={orbit.duration}
            data-direction={orbit.direction}
            data-spin-duration={orbit.spinDuration}
            data-spin-direction={orbit.spinDirection}
          >
            <a
              class="labo-orbit__node"
              href={`#labo-service-${orbit.anchor}`}
              data-index={orbit.index}
              data-cursor-interactive
              aria-label={`Découvrir : ${orbit.service.title}`}
            >
              <span class="labo-orbit__orientation" data-orbit-orientation>
                <span class="labo-orbit__spinner" data-orbit-spinner>
                  {/*
                    Rendu à deux fois la taille d'affichage : les lunes sont des
                    dégradés, un rendu à 32 px les ferait baver sur un écran à
                    haute densité.
                  */}
                  <Image
                    src={orbit.symbol}
                    width={64}
                    height={64}
                    alt=""
                    class="labo-orbit__symbol"
                  />
                </span>
                <span class="labo-orbit__label" data-orbit-label>
                  <span class="labo-orbit__label-index">{orbit.index}</span>
                  <span class="labo-orbit__label-text">{orbit.service.title}</span>
                </span>
              </span>
            </a>
          </div>
        </div>
      ))}

    </div>

  </header>

  <section class="labo-services container-wide" aria-labelledby="labo-services-title">
    <h2 id="labo-services-title" class="sr-only">{t('labo.sectionServices')}</h2>
    {/*
      Sous la figure, sa légende : le système d'orbites est une planche du site
      comme une autre, elle porte donc son numéro et son nom, dans la même
      composition que les figures des projets et du Journal.
    */}
    <div class="labo-services__heading">
      <FigureCaption as="p" value="fig. 01 — Index orbital" />
    </div>

    <ol class="labo-services__grid">
      {services.map((service, index) => (
        <li class="labo-service" id={`labo-service-${String(index + 1).padStart(3, '0')}`} data-rise>
          {/*
            La lune se place devant le chiffre et son intitulé, exactement comme
            sur l'orbite : le repère précède l'étape des deux côtés de la page,
            et c'est lui qui relie le système en mouvement à sa description.

            Décorative (`alt` vide) : le symbole ne dit rien que le titre juste
            en dessous ne dise déjà, et l'annoncer deux fois n'apprendrait rien.
          */}
          <Image
            src={orbitSymbols[index] ?? luneGriseSymbol}
            width={48}
            height={48}
            alt=""
            class="labo-service__symbol"
          />
          <span class="labo-service__number">{toRoman(index + 1)}</span>
          <h3>{service.title}</h3>
          <div class="labo-service__body">
            <p class="labo-service__description">{service.description}</p>
            {service.tools && service.tools.length > 0 && (
              <ul class="labo-service__tools">
                {service.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <script>
    /*
      Aligne l'atterrissage de toutes les fiches de service sur l'en-tête de la
      section : la marge de défilement de chaque fiche vaut sa distance à cet
      en-tête, plus la garde laissée à la barre de marque. Mesuré au chargement,
      après le chargement des fontes — qui change la hauteur des lignes — et à
      chaque redimensionnement.

      Uniquement à partir de 768 px, où la grille montre les neuf fiches d'un
      coup : viser l'en-tête donne alors l'index entier, la fiche demandée
      comprise. En dessous, elles s'empilent sur toute la hauteur de l'écran —
      atterrir sur l'en-tête reviendrait à répondre « cherchez vous-même » à qui
      vient de désigner un service. La fiche y garde donc sa propre ancre, et le
      repli CSS suffit.
    */
    const wideLayout = window.matchMedia('(min-width: 768px)');
    const servicesSection = document.querySelector('.labo-services');
    const serviceCards = [...document.querySelectorAll('.labo-service')];

    if (servicesSection instanceof HTMLElement && serviceCards.length > 0) {
      let measureFrame = 0;

      const measureServiceAnchors = () => {
        measureFrame = 0;

        if (!wideLayout.matches) {
          serviceCards.forEach((card) => {
            if (card instanceof HTMLElement) card.style.removeProperty('--service-anchor-offset');
          });
          return;
        }

        const guard = Number.parseFloat(getComputedStyle(servicesSection).scrollMarginTop) || 0;
        const sectionTop = servicesSection.getBoundingClientRect().top;

        serviceCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const distance = card.getBoundingClientRect().top - sectionTop;
          card.style.setProperty('--service-anchor-offset', `${Math.round(distance + guard)}px`);
        });
      };

      const scheduleMeasure = () => {
        if (!measureFrame) measureFrame = window.requestAnimationFrame(measureServiceAnchors);
      };

      measureServiceAnchors();
      window.addEventListener('resize', scheduleMeasure, { passive: true });
      document.fonts?.ready.then(measureServiceAnchors);
    }
  </script>

  <section class="labo-philosophy container-wide" id="vision" aria-labelledby="labo-philosophy-title">
    <h2 id="labo-philosophy-title" class="sr-only">{t('labo.sectionVision')}</h2>

    <aside class="labo-philosophy__margin" aria-hidden="true">
      <div class="labo-philosophy__index type-note">[02 — Manifeste - Vision]</div>
      <div class="labo-philosophy__scale">
        <span>{t('labo.studyOfSubstance')}</span>
      </div>
      <div class="labo-philosophy__marginalia">
        <span class="type-note">OBSERVATION</span>
        <p>Recherche sensible<br />Forme vivante</p>
      </div>
    </aside>

    <div class="labo-philosophy__page">
      <header class="labo-philosophy__folio type-note" aria-hidden="true">
        <span>{t('labo.researchNotebook')}</span>
        <span>MANIFESTE</span>
      </header>

      {philosophyLead && (
        <p class="labo-philosophy__lead">
          <span class="labo-philosophy__quote" aria-hidden="true">“</span>
          <span data-text-reveal>{philosophyLead.text}</span>
          <span class="labo-philosophy__quote-close" aria-hidden="true">”</span>
        </p>
      )}

      {/*
        ── LE CORPS DU MANIFESTE, EN DEUX COLONNES ────────────────────────
        Les paragraphes se composaient chacun à sa largeur — pleine page,
        colonne à droite, grande déclaration — et changeaient de corps d'un
        bloc à l'autre. Chaque changement demandait à l'œil de retrouver où
        reprendre : c'est ce qui rendait la section fatigante à lire, pour un
        texte qui, lui, se suit d'un bout à l'autre.

        Un seul corps, une seule mesure, deux colonnes : le texte redevient un
        document de recherche, et les « morceaux » cessent de disputer au fond
        l'attention qu'il demande. Le champ « Largeur » qui les pilotait a été
        retiré du modèle.
      */}
      <div class="labo-philosophy__notes" data-rise>
        {philosophyNotes.map((paragraph) => (
          <p class="labo-philosophy__note">{paragraph.text}</p>
        ))}
      </div>

      <footer class="labo-philosophy__keywords" aria-hidden="true">
        {philosophyKeywords.map((word) => (
          <span class="labo-philosophy__keyword" aria-label={word}>
            {Array.from(word).map((letter, index) => (
              <span class="labo-philosophy__letter" style={`--letter-index:${index};`} aria-hidden="true">
                <span class="labo-philosophy__letter-track">
                  <span>{letter}</span>
                  <span>{letter}</span>
                </span>
              </span>
            ))}
          </span>
        ))}
      </footer>
    </div>
  </section>

  {/*
    Sans `id`. Cette section portait « equipe », renommé en « methode » quand
    le menu a changé de libellé — avant que la VRAIE section Méthode n'existe.
    Les deux se sont retrouvées à porter le même identifiant, et c'est la
    première du document qui l'emporte : « /labo#methode » déposait donc ici,
    au-dessus de la déclaration, au lieu du repère « [03 — La méthode — … ».

    Un doublon d'identifiant ne lève aucune erreur. Il choisit silencieusement.
    Plus rien ne vise cette section : elle se lit dans la foulée de ce qui la
    précède, elle n'a pas besoin d'adresse.
  */}
  <section class="labo-team container-wide" aria-labelledby="labo-team-title">
    <h2 id="labo-team-title" class="sr-only">{t('labo.sectionTeam')}</h2>

    {page.teamLead && (
      <p class="labo-team__lead" data-text-reveal data-sanity={teamLeadEditable}>
        {teamLead.before}{showNoteCall && (
          <a
            class="labo-note__call"
            id="appel-note-fondation"
            href="#note-fondation"
            aria-label="Note 1 — note de fondation"
            data-cursor-interactive
          >[1]</a>
        )}{teamLead.after}
      </p>
    )}
    {page.teamBody && <p class="labo-team__body" data-rise>{page.teamBody}</p>}

    {hasFoundationNote && (
      <aside class="labo-note" id="note-fondation" aria-labelledby="labo-note-title" data-rise>
        {/*
          Le numéro renvoie à l'appel, comme le fait le rappel de note d'un
          livre : on repart d'où l'on venait sans avoir à chercher la ligne.
          Sans appel dans le texte, il n'a nulle part où revenir — il redevient
          alors le simple chiffre de la note.
        */}
        {showNoteCall ? (
          <a class="labo-note__number" href="#appel-note-fondation" aria-label="Revenir au texte" data-cursor-interactive>[1]</a>
        ) : (
          <span class="labo-note__number" aria-hidden="true">[1]</span>
        )}

        <div class="labo-note__body">
          <h3 id="labo-note-title" class="labo-note__title type-note">{page.foundationTitle}</h3>

          {/*
            Les paragraphes sont dans leur propre boîte : ce sont EUX qui se
            composent en deux colonnes, pas le titre ni la signature, qui
            tiennent la mesure entière au-dessus et en dessous.
          */}
          <div class="labo-note__columns">
            {foundationParagraphs.map((paragraph) => (
              <p class="labo-note__paragraph">{paragraph}</p>
            ))}
          </div>

          {page.foundationSignature && (
            <p class="labo-note__signature">{page.foundationSignature}</p>
          )}
        </div>
      </aside>
    )}
  </section>

  {/*
    ┌─ LA CONSTELLATION ────────────────────────────────────────────────────┐
    │ La note de fondation se referme sur « il ne m'appartient plus tout à  │
    │ fait ». C'est exactement là que la constellation doit paraître : le   │
    │ studio au centre, et autour de lui tous ceux qui y ont travaillé.     │
    │ L'aveu appelle la preuve.                                             │
    │                                                                       │
    │ La figure se remplit SEULE — toute étoile encodée y est, sans qu'on   │
    │ ait à l'ajouter à la page. C'est ce qui la distingue de la            │
    │ constellation d'un projet, où l'on désigne une équipe précise.        │
    │                                                                       │
    │ Pas de repère numéroté : les trois de la page — Services, Manifeste,  │
    │ Méthode — annoncent des sections qui se lisent. Celle-ci se regarde,  │
    │ et sa légende suffit à la nommer, comme pour l'index orbital.         │
    └───────────────────────────────────────────────────────────────────────┘
  */}
  {stars.length > 0 && (
    <section class="labo-constellation container-wide" aria-labelledby="labo-constellation-title">
      <h2 id="labo-constellation-title" class="sr-only">{t('labo.sectionConstellation')}</h2>

      <Constellation
        stars={stars}
        seed={`${page._id}-constellation`}
        variant="labo"
        caption="fig. 02 — Constellation — L’équipe"
      />
    </section>
  )}

  {/*
    ┌─ [03 — LA MÉTHODE] ───────────────────────────────────────────────────┐
    │ Cinq strates rangées comme des livres sur une étagère : on ne les lit │
    │ pas de face, on lit leur TRANCHE. Chacune porte son spécimen en tête, │
    │ son mot au pied, et la phrase qui l'explique juste au-dessus du mot.  │
    │                                                                       │
    │ Le geste : au défilement, elles arrivent une à une du bord droit de   │
    │ l'écran et viennent se ranger de la gauche vers la droite — on RANGE  │
    │ la méthode sous les yeux du lecteur, dans l'ordre de la descente.     │
    │                                                                       │
    │ Le repère « [03 — La méthode] » reste composé en clair, comme         │
    │ « [01 — Services] » et « [02 — Manifeste - Vision] » : c'est une      │
    │ mention de composition, pas du contenu piloté depuis le Studio.       │
    └───────────────────────────────────────────────────────────────────────┘
  */}
  <section class="labo-method container-wide" id="methode" aria-labelledby="labo-method-title">
    {/*
      Le repère EST le titre. Il portait « [03 — La méthode] » seul, et la
      méthode annonçait son nom en dessous, au corps des titres : deux
      annonces pour une section, et la seconde volait à l'étagère l'entrée en
      matière qui lui revient. Le nom rentre donc dans le repère, sur le
      modèle de « [02 — Manifeste - Vision] ».

      C'est donc lui qui est le `h2` de la section : un repère composé en clair
      qui dit le titre n'a pas besoin qu'on lui en cache un second.
    */}
    <h2 id="labo-method-title" class="labo-method__index type-note">{methodIndex}</h2>

    {strates.length > 0 && (
      <div class="labo-method__stage">
        {/*
          Une liste ORDONNÉE : les cinq strates se suivent, et l'ordre est le
          propos même de la section. Sans mouvement — JavaScript coupé, ou
          mouvement réduit — elles sont simplement rangées, déjà lisibles.
        */}
        {/*
          ── LA PLANCHE SOUS L'ÉTAGÈRE ──────────────────────────────────
          Au survol d'une tranche, le spécimen reparaît en grand DERRIÈRE
          l'étagère, à l'endroit, centré sur la tranche qu'on désigne.

          Deux exemplaires de la même image, et c'est leur ordre qui fait
          l'effet — un seul fichier est téléchargé, le navigateur le sert
          deux fois :

           · `__reveal` — net, sous tout le reste. On ne le voit donc que
             LÀ OÙ IL DÉPASSE de l'étagère, en haut et en bas ;
           · `__veil` — le même, flouté, mais découpé au rectangle exact de
             l'étagère (`overflow: hidden`). Il recouvre le premier dans ce
             rectangle, et lui seul.

          Les tranches passent alors au papier translucide : le flou se lit
          À TRAVERS elles, le texte reste au-dessus, net et lisible.

          Décoratif de bout en bout — `aria-hidden`, et le spécimen est déjà
          dans la tranche : rien ne dépend du survol.
        */}
        <div class="labo-method__reveal" aria-hidden="true" style={`--ghost-count:${strates.length}`}>
          {strates.map((strate, index) => (
            <span class="labo-method__ghost" style={`--ghost-index:${index}`}>
              <SanityImage image={strate.image} width={720} sizes="42rem" alt="" loading="lazy" />
            </span>
          ))}
        </div>

        <div class="labo-method__veil" aria-hidden="true" style={`--ghost-count:${strates.length}`}>
          {strates.map((strate, index) => (
            <span class="labo-method__ghost" style={`--ghost-index:${index}`}>
              <SanityImage image={strate.image} width={720} sizes="42rem" alt="" loading="lazy" />
            </span>
          ))}
        </div>

        <ol class="labo-method__shelf" data-method-shelf>
          {strates.map((strate) => (
            <li class="labo-strate" data-strate>
              <div class="labo-strate__spine">
                {/*
                  Le spécimen. Décoratif au sens strict — il illustre le mot
                  composé juste en dessous, il ne le complète pas — d'où
                  l'`alt` vide : l'annoncer reviendrait à faire lire deux fois
                  la même chose.
                */}
                {/*
                  Le mot et sa phrase ne se suivent pas : ils sont CÔTE À CÔTE
                  en travers de la tranche, et partent tous deux du même pied.
                  C'est la composition d'une tranche de livre — le titre, et
                  sous lui la mention en petit corps, alignés au même fer.
                */}
                <div class="labo-strate__label">
                  <h3 class="labo-strate__word">{strate.word}</h3>
                  <p class="labo-strate__note">{strate.note}</p>
                </div>
                {strate.image && (
                  <span class="labo-strate__picto">
                    <SanityImage image={strate.image} width={240} sizes="7rem" alt="" loading="lazy" />
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {strates.length > 0 && (
      <FigureCaption as="p" class="labo-method__caption" value="fig. 03 — Les cinq strates" />
    )}
  </section>

  <section class="labo-archive project-index" id="archives" aria-labelledby="labo-archive-title">
    <div class="labo-archive__layout container-wide">
      <header class="labo-archive__head">
        <h2 id="labo-archive-title" class="type-titre" data-text-reveal>{archiveTitle}</h2>
      </header>

