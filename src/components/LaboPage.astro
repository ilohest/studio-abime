---
import { Image } from 'astro:assets';
import ProjectCatalogRail from '~/components/ProjectCatalogRail.astro';
import SmartLink from '~/components/primitives/SmartLink.astro';
import type { Locale } from '~/i18n/config';
import type { LaboPage } from '~/lib/sanity/types';

import flashSymbol from '~/assets/labo-symbols/flash.png';
import libraSymbol from '~/assets/labo-symbols/libra.png';
import moonSymbol from '~/assets/labo-symbols/moon.png';
import piscesSymbol from '~/assets/labo-symbols/pisces.png';
import scorpioSymbol from '~/assets/labo-symbols/scorpio.png';
import springSymbol from '~/assets/labo-symbols/spring.png';

interface Props {
  page: LaboPage;
  locale: Locale;
}

const { page, locale } = Astro.props;
const services = (page.services ?? []).slice(0, 6);
const orbitPhases = [198, 315, 64, 142, 252, 18];
// Vitesse angulaire décroissante du centre vers l'extérieur : chaque unité
// conserve son propre rythme, même lorsque le scroll module l'ensemble.
const orbitDurations = [22, 34, 49, 68, 92, 124];
const orbitDirections = [1, -1, 1, -1, 1, -1];
const spinDurations = [86, 118, 157, 204, 276, 348];
const spinDirections = [-1, 1, -1, 1, -1, 1];
const orbitMotifs = ['dots', 'dashes', 'morse', 'double', 'ticks', 'spaced'];
const orbitRulerTicks = Array.from({ length: 72 }, (_, index) => ({
  angle: index * 5,
  level: index % 6 === 0 ? 'major' : index % 3 === 0 ? 'medium' : 'minor',
}));
const orbitMicroTicks = Array.from({ length: 180 }, (_, index) => ({
  angle: index * 2,
  level: index % 15 === 0 ? 'major' : index % 5 === 0 ? 'medium' : 'minor',
}));
const orbitDegreeMarks = [
  { value: '270°', angle: 0 },
  { value: '180°', angle: 90 },
  { value: '90°', angle: 180 },
  { value: '0°', angle: 270 },
];
const orbitSymbols = [flashSymbol, libraSymbol, springSymbol, moonSymbol, scorpioSymbol, piscesSymbol];
const orbitSystem = services.map((service, index) => ({
  service,
  index: String(index + 1).padStart(3, '0'),
  symbol: orbitSymbols[index] ?? moonSymbol,
  size: `${38 + index * 10}%`,
  phase: orbitPhases[index] ?? index * 60,
  duration: orbitDurations[index] ?? 60 + index * 12,
  direction: orbitDirections[index] ?? 1,
  spinDuration: spinDurations[index] ?? 180 + index * 30,
  spinDirection: spinDirections[index] ?? -1,
  motif:
    service._key === 'regard' || service.title.toLocaleLowerCase('fr').includes('pratiques du regard')
      ? 'microticks'
      : orbitMotifs[index] ?? 'dots',
}));
const archiveCount = page.archiveProjects.length;
const archiveTitle = !page.archiveTitle || page.archiveTitle.trim() === 'Archive'
  ? 'Archives'
  : page.archiveTitle;
const [philosophyLead, ...philosophyParagraphs] = page.philosophy;
const philosophyNotes = philosophyParagraphs.length >= 4
  ? [
      `${philosophyParagraphs[0]} ${philosophyParagraphs[1]}`,
      `${philosophyParagraphs[2]} ${philosophyParagraphs[3]}`,
      ...philosophyParagraphs.slice(4),
    ]
  : philosophyParagraphs;
const philosophyKeywords = ['INTENTION', 'POSTURE', 'REGARD', 'RÉCIT'];
const whyLeadMarker = 'Un endroit où l’on peut';
const whyLeadMarkerIndex = page.whyLead?.indexOf(whyLeadMarker) ?? -1;
const whyLeadIntro = whyLeadMarkerIndex >= 0
  ? page.whyLead?.slice(0, whyLeadMarkerIndex).trim()
  : page.whyLead;
const whyListIntro = whyLeadMarkerIndex >= 0
  ? page.whyLead?.slice(whyLeadMarkerIndex).trim()
  : 'Un endroit où l’on peut :';
const whyTitle = page.whyTitle
  ? `${page.whyTitle.replace(/\?\s*$/, '')}?`
  : 'Pourquoi un laboratoire?';
---

<article class="labo">
  <header class="labo-hero container-wide" id="vision">
    <h1 class="labo-hero__title type-titre" data-text-reveal>01. {page.title}</h1>

    <div class="labo-orbits" aria-label="Les champs de recherche du laboratoire" data-labo-orbits>
      <div class="labo-orbits__axis" aria-hidden="true"></div>
      <div class="labo-orbits__degrees" aria-hidden="true">
        {orbitDegreeMarks.map((mark) => (
          <span class="labo-orbits__degree" style={`--degree-angle:${mark.angle}deg;`}>
            <span>{mark.value}</span>
          </span>
        ))}
      </div>
      <div class="labo-orbits__core">
        <span class="type-note">Le fond</span>
        <strong>précède</strong>
        <span class="type-note">la forme</span>
      </div>

      {orbitSystem.map((orbit) => (
        <div
          class:list={['labo-orbit', `labo-orbit--${orbit.motif}`]}
          style={`--orbit-size:${orbit.size};--orbit-phase:${orbit.phase}deg;`}
        >
          <svg class="labo-orbit__track" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle class="labo-orbit__track-line" cx="50" cy="50" r="49" pathLength="100" />
            {(orbit.motif === 'double' || orbit.motif === 'ticks') && (
              <circle class="labo-orbit__track-line labo-orbit__track-line--secondary" cx="50" cy="50" r="46.8" pathLength="100" />
            )}
            {orbit.motif === 'ticks' && (
              <g class="labo-orbit__ruler">
                {orbitRulerTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__ruler-tick', `labo-orbit__ruler-tick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '5.4' : tick.level === 'medium' ? '4.1' : '3'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
            {orbit.motif === 'microticks' && (
              <g class="labo-orbit__microticks">
                {orbitMicroTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__microtick', `labo-orbit__microtick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '3.2' : tick.level === 'medium' ? '2.4' : '1.85'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
          </svg>

          <div
            class="labo-orbit__carrier"
            data-orbit-carrier
            data-phase={orbit.phase}
            data-duration={orbit.duration}
            data-direction={orbit.direction}
            data-spin-duration={orbit.spinDuration}
            data-spin-direction={orbit.spinDirection}
          >
            <a
              class="labo-orbit__node"
              href={`#labo-service-${orbit.index}`}
              data-index={orbit.index}
              data-cursor-interactive
              aria-label={`Découvrir : ${orbit.service.title}`}
            >
              <span class="labo-orbit__orientation" data-orbit-orientation>
                <span class="labo-orbit__spinner" data-orbit-spinner>
                  <Image
                    src={orbit.symbol}
                    width={32}
                    height={32}
                    alt=""
                    class="labo-orbit__symbol"
                  />
                </span>
                <span class="labo-orbit__label" data-orbit-label>
                  <span class="labo-orbit__label-index">{orbit.index}</span>
                  <span class="labo-orbit__label-text">{orbit.service.title}</span>
                </span>
              </span>
            </a>
          </div>
        </div>
      ))}

    </div>

  </header>

  <section class="labo-services container-wide" id="services" aria-labelledby="labo-services-title">
    <div class="labo-section-heading labo-services__heading">
      <span class="type-note">[01 — Index orbital - Services]</span>
      <h2 id="labo-services-title" class="type-titre" data-text-reveal>{page.servicesTitle}</h2>
    </div>

    <ol class="labo-services__grid">
      {services.map((service, index) => (
        <li class="labo-service" id={`labo-service-${String(index + 1).padStart(3, '0')}`}>
          <span class="labo-service__number">{String(index + 1).padStart(3, '0')}</span>
          <div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </li>
      ))}
    </ol>

    {page.note && <p class="labo-services__note type-annotation">({page.note})</p>}
  </section>

  <script>
    /*
      Aligne l'atterrissage de toutes les fiches de service sur l'en-tête de la
      section : la marge de défilement de chaque fiche vaut sa distance à cet
      en-tête, plus la garde laissée à la barre de marque. Mesuré au chargement,
      après le chargement des fontes — qui change la hauteur des lignes — et à
      chaque redimensionnement.
    */
    const servicesSection = document.querySelector('.labo-services');
    const serviceCards = [...document.querySelectorAll('.labo-service')];

    if (servicesSection instanceof HTMLElement && serviceCards.length > 0) {
      let measureFrame = 0;

      const measureServiceAnchors = () => {
        measureFrame = 0;
        const guard = Number.parseFloat(getComputedStyle(servicesSection).scrollMarginTop) || 0;
        const sectionTop = servicesSection.getBoundingClientRect().top;

        serviceCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const distance = card.getBoundingClientRect().top - sectionTop;
          card.style.setProperty('--service-anchor-offset', `${Math.round(distance + guard)}px`);
        });
      };

      const scheduleMeasure = () => {
        if (!measureFrame) measureFrame = window.requestAnimationFrame(measureServiceAnchors);
      };

      measureServiceAnchors();
      window.addEventListener('resize', scheduleMeasure, { passive: true });
      document.fonts?.ready.then(measureServiceAnchors);
    }
  </script>

  <section class="labo-philosophy container-wide surface-paper" id="philosophie" aria-labelledby="labo-philosophy-title">
    <div class="labo-philosophy__grain surface-paper-grain" aria-hidden="true"></div>
    <h2 id="labo-philosophy-title" class="sr-only">{page.eyebrow}</h2>

    <aside class="labo-philosophy__margin" aria-hidden="true">
      <div class="labo-philosophy__index type-note">[02 — Manifeste - Philosophie]</div>
      <div class="labo-philosophy__scale">
        <span>ÉTUDE DU FOND</span>
      </div>
      <div class="labo-philosophy__marginalia">
        <span class="type-note">OBSERVATION</span>
        <p>Recherche sensible<br />Forme vivante</p>
      </div>
    </aside>

    <div class="labo-philosophy__page">
      <header class="labo-philosophy__folio type-note" aria-hidden="true">
        <span>Studio Abîme · Cahier de recherche</span>
        <span>MANIFESTE</span>
      </header>

      {philosophyLead && (
        <p class="labo-philosophy__lead">
          <span class="labo-philosophy__quote" aria-hidden="true">“</span>
          {philosophyLead}
          <span class="labo-philosophy__quote-close" aria-hidden="true">”</span>
        </p>
      )}

      <div class="labo-philosophy__notes">
        {philosophyNotes.map((paragraph) => (
          <p class="labo-philosophy__note type-copy">{paragraph}</p>
        ))}
      </div>

      <footer class="labo-philosophy__keywords" aria-hidden="true">
        {philosophyKeywords.map((word) => (
          <span class="labo-philosophy__keyword" aria-label={word}>
            {Array.from(word).map((letter, index) => (
              <span class="labo-philosophy__letter" style={`--letter-index:${index};`} aria-hidden="true">
                <span class="labo-philosophy__letter-track">
                  <span>{letter}</span>
                  <span>{letter}</span>
                </span>
              </span>
            ))}
          </span>
        ))}
      </footer>
    </div>
  </section>

  <section class="labo-why container-wide" aria-labelledby="labo-why-title">
    <div class="labo-section-heading">
      <h2 id="labo-why-title">{whyTitle}</h2>
    </div>

    <div class="labo-why__body">
      {whyLeadIntro && <p class="labo-why__lead">{whyLeadIntro}</p>}
      <div class="labo-principles-wrap">
        <p class="labo-principles__intro">{whyListIntro}</p>
        <ul class="labo-principles">
          {page.principles.map((principle) => (
            <li>{principle}</li>
          ))}
        </ul>
      </div>
      {page.whyClosing && <p class="labo-why__closing">{page.whyClosing}</p>}
    </div>
  </section>

  <section class="labo-closing container-wide" aria-label="Conclusion">
    <div class="labo-closing__lines">
      {page.closingLines.map((line, index) => (
        <p class:list={['labo-closing__line', { 'labo-closing__keystone': index === 2 }]}
          data-text-reveal={index < 2 ? '' : undefined}>
          {index === 2
            ? line.split(/\.\s+/, 2).map((part, partIndex) => <span>{part}{partIndex === 0 ? '.' : ''}</span>)
            : line}
        </p>
      ))}
    </div>
    {page.cta && (
      <div class="labo-closing__action">
        <SmartLink link={page.cta} locale={locale} class="button-minimal labo-closing__cta" arrow />
        <p>en est la traduction visible.</p>
      </div>
    )}
  </section>

  <section class="labo-archive project-index" id="archives" aria-labelledby="labo-archive-title">
    <div class="labo-archive__layout container-wide">
      <header class="labo-archive__head">
        <h2 id="labo-archive-title" class="type-titre" data-text-reveal>{archiveTitle}</h2>
      </header>

      <div class="labo-archive__rail">
        <ProjectCatalogRail
          projects={page.archiveProjects}
          locale={locale}
          ariaLabel="Archives de projets"
          itemCount={archiveCount}
          revealText
        />
      </div>
    </div>
  </section>
</article>

<style>
  .labo {
    overflow: clip;
    background: var(--color-surface);
  }

  .labo-hero {
    min-height: 100svh;
    padding-top: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .labo-hero__title {
    margin-top: 0.35rem;
    text-align: center;
  }

  .labo-orbits {
    position: relative;
    width: min(100%, 58rem);
    aspect-ratio: 1;
    margin: clamp(2.5rem, 3vw, 4rem) auto 0;
    contain: layout;
  }

  .labo-orbits::before {
    content: none;
  }

  .labo-orbits__axis {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: 94%;
    aspect-ratio: 1;
    background:
      linear-gradient(var(--color-line), var(--color-line)) center / 1px 100% no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) center / 100% 1px no-repeat;
    transform: translate(-50%, -50%) rotate(17deg);
    opacity: 0.72;
  }

  .labo-orbits__axis::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.08rem;
    width: 0.62rem;
    height: 0.62rem;
    border-top: 1px solid var(--color-ink);
    border-right: 1px solid var(--color-ink);
    transform: translateY(-50%) rotate(45deg);
    transform-origin: center;
  }

  .labo-orbits__degrees {
    position: absolute;
    z-index: 3;
    inset: 2.2%;
    border-radius: 50%;
    pointer-events: none;
  }

  .labo-orbits__degree {
    position: absolute;
    inset: 0;
    transform: rotate(var(--degree-angle));
  }

  .labo-orbits__degree > span {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    font-family: var(--font-titre);
    font-size: clamp(0.5rem, 0.62vw, 0.65rem);
    letter-spacing: 0.04em;
    line-height: 1;
    opacity: 0.62;
    transform: translateX(-50%) rotate(calc(-1 * var(--degree-angle)));
    white-space: nowrap;
  }

  .labo-orbits__core {
    position: absolute;
    z-index: 5;
    isolation: isolate;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(8.5rem, 14vw, 11.5rem);
    aspect-ratio: 1;
    place-content: center;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-accent);
    overflow: hidden;
    text-align: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 0.75rem color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .labo-orbits__core::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -36%;
    background: url('/textures/grain-fin.svg') 0 0 / 12.5rem 12.5rem repeat;
    mix-blend-mode: multiply;
    opacity: 0.31;
    pointer-events: none;
    animation: labo-core-grain 1.15s steps(8, end) infinite;
    will-change: transform, opacity;
  }

  .labo-orbits__core > * {
    position: relative;
    z-index: 1;
  }

  @keyframes labo-core-grain {
    0% { transform: translate3d(-4%, -3%, 0); opacity: 0.28; }
    14% { transform: translate3d(3%, -5%, 0); opacity: 0.34; }
    29% { transform: translate3d(-5%, 2%, 0); opacity: 0.3; }
    43% { transform: translate3d(4%, 4%, 0); opacity: 0.35; }
    57% { transform: translate3d(-2%, -4%, 0); opacity: 0.31; }
    71% { transform: translate3d(5%, 1%, 0); opacity: 0.34; }
    86% { transform: translate3d(-3%, 5%, 0); opacity: 0.29; }
    100% { transform: translate3d(-4%, -3%, 0); opacity: 0.28; }
  }

  .labo-orbits__core strong {
    font-family: var(--font-titre);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .labo-orbit {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: var(--orbit-size);
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .labo-orbit__track {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;
    shape-rendering: geometricPrecision;
  }

  .labo-orbit__track-line {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 38%, transparent);
    stroke-width: 1;
  }

  .labo-orbit--dots .labo-orbit__track-line {
    stroke-dasharray: 0.45 1.55;
    stroke-linecap: round;
    opacity: 0.76;
  }

  .labo-orbit--dashes .labo-orbit__track-line {
    stroke-dasharray: 5.6 3.15;
    stroke-linecap: butt;
    opacity: 0.58;
  }

  .labo-orbit--morse .labo-orbit__track-line {
    stroke-dasharray: 0.42 1.15 3.8 1.15;
    stroke-linecap: round;
    opacity: 0.68;
  }

  .labo-orbit--double .labo-orbit__track-line {
    stroke-dasharray: 8 2.4;
    stroke-width: 0.8;
    opacity: 0.42;
  }

  .labo-orbit--double .labo-orbit__track-line--secondary {
    stroke-dasharray: 0.35 1.65;
    stroke-linecap: round;
    opacity: 0.3;
  }

  .labo-orbit--ticks .labo-orbit__track-line {
    stroke-dasharray: none;
    stroke-width: 0.8;
    opacity: 0.5;
  }

  .labo-orbit--ticks .labo-orbit__track-line--secondary {
    stroke-width: 0.65;
    opacity: 0.34;
  }

  .labo-orbit--microticks .labo-orbit__track-line {
    stroke-dasharray: none;
    stroke-width: 0.55;
    opacity: 0.28;
  }

  .labo-orbit__microtick {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 52%, transparent);
    stroke-width: 0.38;
    stroke-linecap: butt;
    opacity: 0.34;
  }

  .labo-orbit__microtick--medium {
    stroke-width: 0.48;
    opacity: 0.48;
  }

  .labo-orbit__microtick--major {
    stroke-width: 0.62;
    opacity: 0.62;
  }

  .labo-orbit__ruler-tick {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 58%, transparent);
    stroke-width: 0.55;
  }

  .labo-orbit__ruler-tick--minor { opacity: 0.46; }
  .labo-orbit__ruler-tick--medium {
    stroke-width: 0.75;
    opacity: 0.62;
  }
  .labo-orbit__ruler-tick--major {
    stroke-width: 1;
    opacity: 0.78;
  }

  .labo-orbit--spaced .labo-orbit__track-line {
    stroke-dasharray: 2.4 5.4;
    stroke-linecap: round;
    opacity: 0.48;
  }

  .labo-orbit__carrier {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    transform: rotate(var(--orbit-phase));
    will-change: transform;
  }

  .labo-orbit__node {
    position: absolute;
    top: 50%;
    right: -0.8rem;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    color: var(--color-ink);
    pointer-events: auto;
    text-decoration: none;
    transform: translateY(-50%);
  }

  .labo-orbit__node:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 0.3rem;
  }

  .labo-orbit__orientation {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    will-change: transform;
  }

  .labo-orbit__spinner {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    will-change: transform;
  }

  .labo-orbit__symbol {
    display: block;
    width: clamp(1.2rem, 1.65vw, 1.6rem);
    height: auto;
    object-fit: contain;
  }

  .labo-orbit__label {
    position: absolute;
    top: 50%;
    left: 1.9rem;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    width: clamp(7.5rem, 13vw, 11.5rem);
    gap: 0.16rem;
    justify-items: start;
    align-items: start;
    padding: 0.2rem 0.35rem;
    background: transparent;
    font-family: var(--font-titre);
    font-size: clamp(0.58rem, 0.72vw, 0.72rem);
    line-height: 1.25;
    letter-spacing: var(--tracking-copy);
    text-align: left;
    text-transform: uppercase;
    transform: translateY(-50%);
    transform-origin: -1.9rem 50%;
  }

  .labo-orbit__label-index {
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    opacity: 0.58;
    white-space: nowrap;
  }

  .labo-orbit__label-text {
    position: relative;
    opacity: 0.82;
    transition:
      opacity 0.35s ease-out,
      letter-spacing 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .labo-orbit__label-text::before {
    content: '';
    position: absolute;
    top: 0.47em;
    left: -0.72rem;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transform: scale(0.2);
    transition:
      opacity 0.3s ease-out,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .labo-orbit__node:hover .labo-orbit__label-text,
  .labo-orbit__node:focus-visible .labo-orbit__label-text {
    letter-spacing: 0.045em;
    opacity: 1;
    transform: translateX(0.42rem);
  }

  .labo-orbit__node:hover .labo-orbit__label-text::before,
  .labo-orbit__node:focus-visible .labo-orbit__label-text::before {
    opacity: 0.75;
    transform: scale(1);
  }

  .labo-philosophy,
  .labo-why,
  .labo-services,
  .labo-closing {
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  .labo-philosophy {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: clamp(8rem, 15vw, 13rem) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    box-sizing: border-box;
    width: auto;
    max-width: min(100%, var(--container-wide));
    min-height: 100svh;
    overflow: hidden;
  }

  .labo-philosophy::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 7% 2% 5% 22%;
    background:
      linear-gradient(90deg, transparent 0 17%, color-mix(in srgb, var(--color-ciel) 18%, transparent) 17% 42%, transparent 42% 66%, color-mix(in srgb, var(--color-sable) 26%, transparent) 66% 88%, transparent 88%),
      radial-gradient(circle at 70% 38%, color-mix(in srgb, var(--color-ciel) 22%, transparent), transparent 42%);
    filter: blur(0.2px);
    opacity: 0.62;
    pointer-events: none;
  }

  .labo-philosophy__grain {
    z-index: 0;
    opacity: 0.28;
  }

  .labo-philosophy__margin,
  .labo-philosophy__page {
    position: relative;
    z-index: 1;
  }

  .labo-philosophy__margin {
    display: grid;
    grid-template-rows: auto minmax(18rem, 1fr) auto;
    gap: 2rem;
    min-width: 0;
  }

  .labo-philosophy__index {
    white-space: nowrap;
  }

  .labo-philosophy__scale {
    position: relative;
    width: 100%;
    min-height: 20rem;
    background:
      repeating-linear-gradient(to bottom, var(--color-line) 0 1px, transparent 1px 0.55rem) right 1.15rem top / 0.65rem 100% no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) right 1.15rem center / 1px 100% no-repeat;
  }

  .labo-philosophy__scale::before,
  .labo-philosophy__scale::after {
    content: '';
    position: absolute;
    right: 0.85rem;
    width: 1.25rem;
    height: 1px;
    background: var(--color-ink);
  }

  .labo-philosophy__scale::before { top: 0; }
  .labo-philosophy__scale::after { bottom: 0; }

  .labo-philosophy__scale span {
    position: absolute;
    top: 50%;
    right: 2.4rem;
    font-family: var(--font-titre);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: right center;
    white-space: nowrap;
  }

  .labo-philosophy__marginalia {
    max-width: 10rem;
    transform: rotate(-1.6deg);
  }

  .labo-philosophy__marginalia p {
    margin-top: 0.45rem;
    font-family: var(--font-annotation);
    font-size: 0.88rem;
    font-style: italic;
    line-height: 1.25;
  }

  .labo-philosophy__page {
    display: grid;
    align-content: start;
    justify-self: end;
    box-sizing: border-box;
    inline-size: min(100%, 52rem);
    max-inline-size: 100%;
    min-width: 0;
    padding-inline-end: clamp(1.5rem, 3vw, 3rem);
    overflow-wrap: break-word;
  }

  .labo-philosophy__folio {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3rem, 7vw, 7rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .labo-philosophy__folio span:last-child {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .labo-philosophy__lead {
    position: relative;
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    margin: 0;
    font-family: var(--font-copy);
    font-size: clamp(2.5rem, 5.7vw, 6rem);
    line-height: var(--text-titre--line-height);
    letter-spacing: var(--tracking-titre);
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
    text-align: left;
    text-wrap: wrap;
  }

  .labo-philosophy__quote {
    position: absolute;
    top: -0.08em;
    left: -0.48em;
    font-family: var(--font-copy);
    font-size: 1.25em;
    line-height: 1;
  }

  .labo-philosophy__quote-close {
    margin-left: 0.04em;
  }

  .labo-philosophy__notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.35rem, 2.25vw, 2.25rem);
    justify-self: end;
    inline-size: min(100%, 38rem);
    max-inline-size: 100%;
    min-inline-size: 0;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .labo-philosophy__note {
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    margin: 0;
    font-size: clamp(0.95rem, 1.2vw, 1.12rem);
    line-height: 1.48;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .labo-philosophy__notes {
      width: min(100%, 31rem);
    }
  }

  @media (min-width: 1280px) {
    .labo-philosophy__page {
      inline-size: min(100%, 52rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
    }
  }

  /*
   * Entre tablette et petit desktop, le rail fixe retire 16rem à la page.
   * Cette plage doit donc être composée selon la largeur réellement restante,
   * et non comme un viewport desktop complet.
   */
  @media (min-width: 768px) and (max-width: 1279px) {
    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
      padding-right: clamp(2.5rem, 5vw, 4rem);
    }

    .labo-philosophy__page {
      inline-size: min(100%, 42rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__lead {
      font-size: clamp(2.7rem, 5.2vw, 4.15rem);
    }

    .labo-philosophy__notes {
      inline-size: min(100%, 27rem);
    }
  }

  .labo-philosophy__keywords {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.7vw, 3rem);
    margin-top: clamp(5rem, 10vw, 10rem);
    font-family: var(--font-titre);
    font-size: clamp(1.5rem, 2.7vw, 3.2rem);
    line-height: 0.92;
    letter-spacing: 0.025em;
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    cursor: default;
  }

  .labo-philosophy__letter {
    display: inline-block;
    height: 0.92em;
    overflow: hidden;
    perspective: 4em;
  }

  .labo-philosophy__letter-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--letter-index) * 34ms);
  }

  .labo-philosophy__letter-track > span {
    display: block;
    height: 0.92em;
    line-height: 0.92;
  }

  @media (hover: hover) and (pointer: fine) {
    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: translateY(-50%);
    }
  }

  .labo-section-heading {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .labo-section-heading h2 {
    max-width: 16ch;
  }

  .labo-why {
    padding-block: clamp(6rem, 12vw, 13rem);
    overflow: clip;
  }

  .labo-why .labo-section-heading {
    display: block;
    margin-bottom: clamp(5rem, 10vw, 10rem);
  }

  .labo-why .labo-section-heading h2 {
    max-width: none;
    font-family: var(--font-copy);
    font-size: clamp(4.5rem, 10vw, 11rem);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .labo-why__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
    margin: 0;
  }

  .labo-why__lead,
  .labo-why__closing {
    font-family: var(--font-copy);
    font-size: clamp(1.25rem, 1.9vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.018em;
    text-align: left;
  }

  .labo-why__lead {
    grid-column: 1 / 9;
    max-width: 42ch;
  }

  .labo-principles {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    row-gap: clamp(4rem, 8vw, 9rem);
    margin-block: clamp(6rem, 12vw, 13rem);
  }

  .labo-principles li {
    max-width: 22ch;
    padding: 0;
    border: 0;
    font-family: var(--font-copy);
    font-size: clamp(1.8rem, 3.4vw, 4rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.035em;
    list-style: none;
  }

  .labo-principles li:nth-child(1) {
    grid-column: 2 / 8;
  }

  .labo-principles li:nth-child(2) {
    grid-column: 7 / 13;
    justify-self: end;
  }

  .labo-principles li:nth-child(3) {
    grid-column: 1 / 9;
  }

  .labo-why__closing {
    grid-column: 6 / 13;
    max-width: 38ch;
    justify-self: end;
  }

  .labo-services {
    padding-block: clamp(2rem, 3vw, 3.5rem) clamp(7rem, 11vw, 11rem);
    /* Destination commune de toutes les fiches : l'en-tête « Index orbital ». */
    scroll-margin-top: clamp(5rem, 10vw, 9rem);
  }

  .labo-services__heading {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(2rem, 3.5vw, 4rem);
    align-items: baseline;
    margin-bottom: clamp(4.5rem, 7vw, 7rem);
  }

  .labo-services__heading > span {
    grid-column: 1;
  }

  .labo-services__heading h2 {
    grid-column: 2 / -1;
    max-width: none;
    margin: 0;
    justify-self: end;
    font-family: var(--font-titre);
    font-size: clamp(1.15rem, 1.7vw, 1.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tracking-titre);
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .labo-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(2rem, 3.5vw, 4rem);
    row-gap: clamp(4.5rem, 7vw, 7rem);
  }

  /*
    Les nœuds de l'orbite mènent tous au même endroit, sans que le clic soit
    intercepté : chaque fiche garde son ancre — donc partageable, et le bouton
    retour conserve son repère — mais sa marge de défilement vaut sa distance à
    l'en-tête. Le navigateur atterrit alors toujours sur « Index orbital », et
    `:target` désigne la fiche demandée. La valeur exacte est posée au chargement
    par le script ; la valeur de repli sert tant qu'il n'a pas mesuré.
  */
  .labo-service {
    display: block;
    min-height: 0;
    scroll-margin-top: var(--service-anchor-offset, clamp(5rem, 10vw, 9rem));
    transition: color 320ms ease;
  }

  /*
    Mise en évidence par RETRAIT : l'index entier passe en gris, la fiche lue
    seule garde l'encre pleine et son numéro tamponné. Rien ne s'ajoute à la
    page, et la marge négative compense le fond pour que le chiffre ne bouge pas.
  */
  .labo-services__grid:has(.labo-service:target) .labo-service:not(:target) {
    color: var(--color-muted);
  }

  .labo-service:target .labo-service__number {
    padding-inline: 0.45em;
    margin-inline-start: -0.45em;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    opacity: 1;
  }

  .labo-service__number,
  .labo-service h3 {
    font-family: var(--font-titre);
  }

  .labo-service h3 {
    max-width: 28ch;
    min-height: 2.9em;
    font-size: clamp(0.7rem, 0.76vw, 0.82rem);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .labo-service p {
    max-width: 31ch;
    margin-top: clamp(0.9rem, 1.25vw, 1.3rem);
    font-family: var(--font-copy);
    font-size: clamp(1rem, 1.15vw, 1.2rem);
    line-height: 1.42;
    letter-spacing: 0.005em;
  }

  .labo-service__number {
    display: block;
    width: fit-content;
    transition: background-color 320ms ease, color 320ms ease;
    /*
      Plus serré que l'écart titre/description : le numéro se lit comme
      l'étiquette du titre, pas comme une ligne autonome au-dessus de lui.
    */
    margin-bottom: clamp(0.4rem, 0.6vw, 0.6rem);
    font-size: clamp(0.64rem, 0.7vw, 0.75rem);
    line-height: 1;
    letter-spacing: 0.08em;
    opacity: 0.68;
  }

  .labo-services__note {
    max-width: 42ch;
    margin: clamp(5rem, 8vw, 8rem) 0 0 auto;
    text-align: right;
  }

  .labo-closing {
    display: grid;
    min-height: auto;
    padding-block: clamp(5rem, 10vw, 11rem) clamp(8rem, 14vw, 15rem);
    border-top: 0;
    text-align: left;
  }

  .labo-closing__lines {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    row-gap: clamp(6rem, 11vw, 12rem);
    width: 100%;
    max-width: none;
  }

  .labo-closing__line {
    font-family: var(--font-copy);
    font-size: clamp(1.3rem, 2.2vw, 2.35rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-align: left;
  }

  .labo-closing__line:nth-child(1) {
    grid-column: 7 / 13;
  }

  .labo-closing__line:nth-child(2) {
    grid-column: 1 / 10;
  }

  .labo-closing__line:nth-child(4) {
    grid-column: 6 / 13;
    max-width: 34ch;
    justify-self: end;
  }

  .labo-closing__keystone {
    grid-column: 2 / 12;
    max-width: none;
    margin: clamp(1rem, 3vw, 3rem) 0;
    font-size: clamp(4rem, 8.2vw, 9.5rem);
    line-height: 0.84;
    letter-spacing: -0.055em;
    text-align: center;
    text-transform: none;
  }

  .labo-closing__cta {
    justify-self: end;
    margin: clamp(4rem, 7vw, 7rem) 0 0;
    font-family: var(--font-copy);
    font-size: clamp(3rem, 7vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-align: right;
  }

  .labo-archive {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .labo-archive__layout {
    display: grid;
    grid-template-columns: clamp(12rem, 20vw, 19rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .labo-archive__head {
    position: relative;
    z-index: 2;
    padding-top: 0.15rem;
  }

  .labo-archive__head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, 3rem);
    line-height: 1;
  }

  .labo-archive__rail {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .labo-orbits {
      width: 100%;
      min-height: 0;
    }

    .labo-orbits::before {
      inset: 0;
    }

    .labo-orbits__axis {
      width: 98%;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 17vw, 7.5rem);
      box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--color-surface) 84%, transparent);
    }

    .labo-orbits__core strong {
      font-size: clamp(0.72rem, 1.5vw, 1rem);
    }

    .labo-orbit__label {
      left: 1.55rem;
      display: block;
      width: auto;
      padding: 0;
      transform-origin: -1.55rem 50%;
    }

    .labo-orbit__label-text {
      display: none;
    }

    .labo-orbit__label-index {
      display: block;
      font-size: 0.52rem;
      opacity: 0.72;
    }

    .labo-services__heading,
    .labo-services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .labo-services__grid {
      row-gap: clamp(4rem, 7vw, 6rem);
    }

    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }

    .labo-philosophy::before {
      inset-inline: 18% 0;
    }

    .labo-philosophy__lead {
      max-width: none;
      font-size: clamp(2.7rem, 5.2vw, 4.15rem);
    }

    .labo-philosophy__notes {
      grid-template-columns: 1fr;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

  }

  @media (max-width: 767px) {
    .labo-orbit__label-index {
      font-size: 0.48rem;
    }

    .labo-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 25vw, 6.5rem);
    }

    .labo-orbits__core strong {
      font-size: 0.72rem;
    }

    .labo-philosophy,
    .labo-section-heading,
    .labo-archive__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .labo-services__heading > span,
    .labo-services__heading h2 {
      grid-column: 1;
    }

    .labo-services__heading h2 {
      max-width: 10ch;
      margin-top: 1rem;
      justify-self: start;
      text-align: left;
      white-space: normal;
    }

    .labo-philosophy {
      min-height: auto;
      padding-top: 5rem;
    }

    .labo-philosophy::before {
      inset: 11rem -15% 4rem 16%;
    }

    .labo-philosophy__margin {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .labo-philosophy__scale {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      min-height: 3.25rem;
      background:
        repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px 0.55rem) left bottom 1rem / 100% 0.65rem no-repeat,
        linear-gradient(var(--color-line), var(--color-line)) left bottom 1rem / 100% 1px no-repeat;
    }

    .labo-philosophy__scale::before,
    .labo-philosophy__scale::after {
      bottom: 0.7rem;
      width: 1px;
      height: 1.25rem;
    }

    .labo-philosophy__scale::before {
      top: auto;
      right: auto;
      left: 0;
    }

    .labo-philosophy__scale::after {
      right: 0;
    }

    .labo-philosophy__scale span {
      top: 0;
      right: auto;
      left: 0;
      transform: none;
    }

    .labo-philosophy__marginalia {
      text-align: right;
    }

    .labo-philosophy__folio {
      margin-bottom: 3.5rem;
      font-size: 0.58rem;
    }

    .labo-philosophy__page {
      width: calc(100% - 1.2rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__lead {
      max-width: none;
      margin: 0;
      font-size: clamp(2.25rem, 11.5vw, 3.6rem);
      hyphens: none;
      text-align: left;
    }

    .labo-philosophy__notes {
      gap: 1.35rem;
      margin-top: 3.5rem;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
      margin-top: 5rem;
    }

    .labo-why {
      padding-block: 6rem 8rem;
    }

    .labo-why .labo-section-heading {
      margin-bottom: 5rem;
    }

    .labo-why .labo-section-heading h2 {
      font-size: clamp(3.2rem, 16vw, 5.5rem);
      line-height: 0.88;
    }

    .labo-why__body,
    .labo-principles,
    .labo-closing__lines {
      grid-template-columns: minmax(0, 1fr);
    }

    .labo-why__lead,
    .labo-why__closing,
    .labo-principles li {
      grid-column: 1;
      justify-self: stretch;
    }

    .labo-principles li:nth-child(1),
    .labo-principles li:nth-child(2),
    .labo-principles li:nth-child(3),
    .labo-closing__line:nth-child(1),
    .labo-closing__line:nth-child(2),
    .labo-closing__line:nth-child(4),
    .labo-closing__line.labo-closing__keystone {
      grid-column: 1;
      justify-self: stretch;
    }

    .labo-why__lead,
    .labo-why__closing,
    .labo-closing__line {
      font-size: clamp(1.15rem, 5vw, 1.55rem);
    }

