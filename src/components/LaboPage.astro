---
import { Image } from 'astro:assets';
import ProjectCatalogRail from '~/components/ProjectCatalogRail.astro';
import SanityImage from '~/components/primitives/SanityImage.astro';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { LaboPage } from '~/lib/sanity/types';

import flashSymbol from '~/assets/labo-symbols/flash.png';
import libraSymbol from '~/assets/labo-symbols/libra.png';
import moonSymbol from '~/assets/labo-symbols/moon.png';
import scorpioSymbol from '~/assets/labo-symbols/scorpio.png';
import springSymbol from '~/assets/labo-symbols/spring.png';
import foundationPhoto from '~/assets/sections/note-fondation.webp';

interface Props {
  page: LaboPage;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);
/*
  Le parcours compte cinq étapes, et l'orbite en porte une par anneau. Les
  tableaux de réglage suivent donc cette cardinalité ; les valeurs de repli
  couvrent une sixième étape ajoutée depuis le Studio sans retoucher le code.
*/
const services = (page.services ?? []).slice(0, 6);
const orbitPhases = [198, 315, 64, 142, 252];
// Vitesse angulaire décroissante du centre vers l'extérieur : chaque unité
// conserve son propre rythme, même lorsque le scroll module l'ensemble.
const orbitDurations = [22, 34, 49, 68, 92];
const orbitDirections = [1, -1, 1, -1, 1];
const spinDurations = [86, 118, 157, 204, 276];
const spinDirections = [-1, 1, -1, 1, -1];
/*
  Le grain de la trajectoire s'affine vers l'extérieur : pointillés au centre,
  règle graduée puis micro-graduations sur les deux anneaux les plus longs, où
  la circonférence laisse la place au détail.
*/
const orbitMotifs = ['dots', 'dashes', 'morse', 'ticks', 'microticks'];
const orbitRulerTicks = Array.from({ length: 72 }, (_, index) => ({
  angle: index * 5,
  level: index % 6 === 0 ? 'major' : index % 3 === 0 ? 'medium' : 'minor',
}));
const orbitMicroTicks = Array.from({ length: 180 }, (_, index) => ({
  angle: index * 2,
  level: index % 15 === 0 ? 'major' : index % 5 === 0 ? 'medium' : 'minor',
}));
const orbitDegreeMarks = [
  { value: '270°', angle: 0 },
  { value: '180°', angle: 90 },
  { value: '90°', angle: 180 },
  { value: '0°', angle: 270 },
];
const orbitSymbols = [flashSymbol, libraSymbol, springSymbol, moonSymbol, scorpioSymbol];
const orbitSystem = services.map((service, index) => ({
  service,
  index: String(index + 1).padStart(3, '0'),
  symbol: orbitSymbols[index] ?? moonSymbol,
  size: `${38 + index * 10}%`,
  phase: orbitPhases[index] ?? index * 60,
  duration: orbitDurations[index] ?? 60 + index * 12,
  direction: orbitDirections[index] ?? 1,
  spinDuration: spinDurations[index] ?? 180 + index * 30,
  spinDirection: spinDirections[index] ?? -1,
  motif: orbitMotifs[index] ?? 'dots',
}));
const archiveCount = page.archiveProjects.length;
const archiveTitle = t('labo.archive');
/*
  Le champ a longtemps été un simple tableau de chaînes. Une chaîne héritée est
  donc encore acceptée et prend la colonne étroite, sa composition d'origine.
*/
const philosophyEntries = page.philosophy.map((entry, index) =>
  typeof entry === 'string'
    ? { _key: `philosophy-${index}`, text: entry, layout: 'colonne' as const }
    : { ...entry, layout: entry.layout ?? 'colonne' },
);
const [philosophyLead, ...philosophyNotes] = philosophyEntries;
const philosophyKeywords = ['INTENTION', 'POSTURE', 'REGARD', 'RÉCIT'];
const foundationParagraphs = page.foundationParagraphs ?? [];
/*
  La photographie de la note est fournie par le dépôt : elle appartient à la
  composition, pas au contenu courant. Le champ Sanity la remplace lorsqu'il
  est rempli, sans qu'il faille repasser par le code.
*/
const hasFoundationImage = Boolean(page.foundationImage?.asset);
---

<script is:inline>
  /*
    Marque la page comme animable AVANT la première peinture : sans cette
    classe, aucun bloc n'est masqué. Si le script d'animation ne s'exécute
    jamais — erreur, réseau coupé — le délai la retire et tout redevient
    visible. Le contenu n'est donc jamais prisonnier de l'animation.
  */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('labo-rise-booting');
    window.setTimeout(() => document.documentElement.classList.remove('labo-rise-booting'), 3000);
  }
</script>

<article class="labo">
  <header class="labo-hero container-wide" id="vision">
    <h1 class="labo-hero__title type-titre" data-text-reveal>01. {page.title}</h1>

    <div class="labo-orbits" aria-label="Les champs de recherche du laboratoire" data-labo-orbits>
      <div class="labo-orbits__axis" aria-hidden="true"></div>
      <div class="labo-orbits__degrees" aria-hidden="true">
        {orbitDegreeMarks.map((mark) => (
          <span class="labo-orbits__degree" style={`--degree-angle:${mark.angle}deg;`}>
            <span>{mark.value}</span>
          </span>
        ))}
      </div>
      <div class="labo-orbits__core">
        <span class="type-note">Le fond</span>
        <strong>{t('labo.emphasisPrecedes')}</strong>
        <span class="type-note">la forme</span>
      </div>

      {orbitSystem.map((orbit) => (
        <div
          class:list={['labo-orbit', `labo-orbit--${orbit.motif}`]}
          style={`--orbit-size:${orbit.size};--orbit-phase:${orbit.phase}deg;`}
        >
          <svg class="labo-orbit__track" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle class="labo-orbit__track-line" cx="50" cy="50" r="49" pathLength="100" />
            {(orbit.motif === 'double' || orbit.motif === 'ticks') && (
              <circle class="labo-orbit__track-line labo-orbit__track-line--secondary" cx="50" cy="50" r="46.8" pathLength="100" />
            )}
            {orbit.motif === 'ticks' && (
              <g class="labo-orbit__ruler">
                {orbitRulerTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__ruler-tick', `labo-orbit__ruler-tick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '5.4' : tick.level === 'medium' ? '4.1' : '3'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
            {orbit.motif === 'microticks' && (
              <g class="labo-orbit__microticks">
                {orbitMicroTicks.map((tick) => (
                  <line
                    class:list={['labo-orbit__microtick', `labo-orbit__microtick--${tick.level}`]}
                    x1="50"
                    y1="1"
                    x2="50"
                    y2={tick.level === 'major' ? '3.2' : tick.level === 'medium' ? '2.4' : '1.85'}
                    transform={`rotate(${tick.angle} 50 50)`}
                  />
                ))}
              </g>
            )}
          </svg>

          <div
            class="labo-orbit__carrier"
            data-orbit-carrier
            data-phase={orbit.phase}
            data-duration={orbit.duration}
            data-direction={orbit.direction}
            data-spin-duration={orbit.spinDuration}
            data-spin-direction={orbit.spinDirection}
          >
            <a
              class="labo-orbit__node"
              href={`#labo-service-${orbit.index}`}
              data-index={orbit.index}
              data-cursor-interactive
              aria-label={`Découvrir : ${orbit.service.title}`}
            >
              <span class="labo-orbit__orientation" data-orbit-orientation>
                <span class="labo-orbit__spinner" data-orbit-spinner>
                  <Image
                    src={orbit.symbol}
                    width={32}
                    height={32}
                    alt=""
                    class="labo-orbit__symbol"
                  />
                </span>
                <span class="labo-orbit__label" data-orbit-label>
                  <span class="labo-orbit__label-index">{orbit.index}</span>
                  <span class="labo-orbit__label-text">{orbit.service.title}</span>
                </span>
              </span>
            </a>
          </div>
        </div>
      ))}

    </div>

  </header>

  <section class="labo-services container-wide" id="services" aria-labelledby="labo-services-title">
    <h2 id="labo-services-title" class="sr-only">{t('labo.sectionServices')}</h2>
    <div class="labo-services__heading">
      <span class="type-note">[01 — Index orbital - Services]</span>
    </div>

    <ol class="labo-services__grid">
      {services.map((service, index) => (
        <li class="labo-service" id={`labo-service-${String(index + 1).padStart(3, '0')}`} data-rise>
          <span class="labo-service__number">{String(index + 1).padStart(3, '0')}</span>
          <div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            {service.tools && service.tools.length > 0 && (
              <ul class="labo-service__tools type-note">
                {service.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    {page.note && <p class="labo-services__note type-annotation">({page.note})</p>}
  </section>

  <script>
    /*
      Aligne l'atterrissage de toutes les fiches de service sur l'en-tête de la
      section : la marge de défilement de chaque fiche vaut sa distance à cet
      en-tête, plus la garde laissée à la barre de marque. Mesuré au chargement,
      après le chargement des fontes — qui change la hauteur des lignes — et à
      chaque redimensionnement.
    */
    const servicesSection = document.querySelector('.labo-services');
    const serviceCards = [...document.querySelectorAll('.labo-service')];

    if (servicesSection instanceof HTMLElement && serviceCards.length > 0) {
      let measureFrame = 0;

      const measureServiceAnchors = () => {
        measureFrame = 0;
        const guard = Number.parseFloat(getComputedStyle(servicesSection).scrollMarginTop) || 0;
        const sectionTop = servicesSection.getBoundingClientRect().top;

        serviceCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const distance = card.getBoundingClientRect().top - sectionTop;
          card.style.setProperty('--service-anchor-offset', `${Math.round(distance + guard)}px`);
        });
      };

      const scheduleMeasure = () => {
        if (!measureFrame) measureFrame = window.requestAnimationFrame(measureServiceAnchors);
      };

      measureServiceAnchors();
      window.addEventListener('resize', scheduleMeasure, { passive: true });
      document.fonts?.ready.then(measureServiceAnchors);
    }
  </script>

  <section class="labo-philosophy container-wide surface-paper" id="philosophie" aria-labelledby="labo-philosophy-title">
    <div class="labo-philosophy__grain surface-paper-grain" aria-hidden="true"></div>
    <h2 id="labo-philosophy-title" class="sr-only">{t('labo.sectionPhilosophy')}</h2>

    <aside class="labo-philosophy__margin" aria-hidden="true">
      <div class="labo-philosophy__index type-note">[02 — Manifeste - Philosophie]</div>
      <div class="labo-philosophy__scale">
        <span>{t('labo.studyOfSubstance')}</span>
      </div>
      <div class="labo-philosophy__marginalia">
        <span class="type-note">OBSERVATION</span>
        <p>Recherche sensible<br />Forme vivante</p>
      </div>
    </aside>

    <div class="labo-philosophy__page">
      <header class="labo-philosophy__folio type-note" aria-hidden="true">
        <span>{t('labo.researchNotebook')}</span>
        <span>MANIFESTE</span>
      </header>

      {philosophyLead && (
        <p class="labo-philosophy__lead">
          <span class="labo-philosophy__quote" aria-hidden="true">“</span>
          <span data-text-reveal>{philosophyLead.text}</span>
          <span class="labo-philosophy__quote-close" aria-hidden="true">”</span>
        </p>
      )}

      <div class="labo-philosophy__notes">
        {philosophyNotes.map((paragraph) => (
          <p
            class:list={['labo-philosophy__note', 'type-copy', `labo-philosophy__note--${paragraph.layout}`]}
            data-text-reveal={paragraph.layout === 'declaration' ? '' : undefined}
            data-rise={paragraph.layout === 'declaration' ? undefined : ''}
          >
            {paragraph.text}
          </p>
        ))}
      </div>

      <footer class="labo-philosophy__keywords" aria-hidden="true">
        {philosophyKeywords.map((word) => (
          <span class="labo-philosophy__keyword" aria-label={word}>
            {Array.from(word).map((letter, index) => (
              <span class="labo-philosophy__letter" style={`--letter-index:${index};`} aria-hidden="true">
                <span class="labo-philosophy__letter-track">
                  <span>{letter}</span>
                  <span>{letter}</span>
                </span>
              </span>
            ))}
          </span>
        ))}
      </footer>
    </div>
  </section>

  <section class="labo-team container-wide" id="equipe" aria-labelledby="labo-team-title">
    <h2 id="labo-team-title" class="sr-only">{t('labo.sectionTeam')}</h2>
    <div class="labo-team__heading">
      <span class="type-note">[03 — {t('labo.collective')}]</span>
    </div>

    {page.teamLead && <p class="labo-team__lead" data-text-reveal>{page.teamLead}</p>}
    {page.teamBody && <p class="labo-team__body type-copy" data-rise>{page.teamBody}</p>}

    {foundationParagraphs.length > 0 && (
      <div class="labo-foundation" data-rise>
        <figure class="labo-foundation__figure">
          {hasFoundationImage ? (
            <SanityImage
              image={page.foundationImage}
              width={720}
              sizes="(max-width: 767px) 62vw, 24vw"
              class="labo-foundation__image"
            />
          ) : (
            <Image
              src={foundationPhoto}
              widths={[380, 560, 772]}
              sizes="(max-width: 767px) 62vw, 24vw"
              alt="Deux avant-bras noués, l’un soutenant l’autre."
              class="labo-foundation__image"
              loading="lazy"
            />
          )}
        </figure>

        <div class="labo-foundation__note">
          <h3 class="labo-foundation__title type-note">{page.foundationTitle}</h3>
          {foundationParagraphs.map((paragraph) => (
            <p class="labo-foundation__paragraph type-copy">{paragraph}</p>
          ))}
          {page.foundationSignature && (
            <p class="labo-foundation__signature">{page.foundationSignature}</p>
          )}
        </div>
      </div>
    )}
  </section>

  <section class="labo-archive project-index" id="archives" aria-labelledby="labo-archive-title">
    <div class="labo-archive__layout container-wide">
      <header class="labo-archive__head">
        <h2 id="labo-archive-title" class="type-titre" data-text-reveal>{archiveTitle}</h2>
      </header>

      <div class="labo-archive__rail">
        <ProjectCatalogRail
          projects={page.archiveProjects}
          locale={locale}
          ariaLabel="Archives de projets"
          itemCount={archiveCount}
          revealText
        />
      </div>
    </div>
  </section>
</article>

<style>
  .labo {
    overflow: clip;
    background: var(--color-surface);
  }

  .labo-hero {
    min-height: 100svh;
    padding-top: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .labo-hero__title {
    margin-top: 0.35rem;
    text-align: center;
  }

  .labo-orbits {
    position: relative;
    width: min(100%, 58rem);
    aspect-ratio: 1;
    margin: clamp(2.5rem, 3vw, 4rem) auto 0;
    contain: layout;
  }

  .labo-orbits::before {
    content: none;
  }

  .labo-orbits__axis {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: 94%;
    aspect-ratio: 1;
    background:
      linear-gradient(var(--color-line), var(--color-line)) center / 1px 100% no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) center / 100% 1px no-repeat;
    transform: translate(-50%, -50%) rotate(17deg);
    opacity: 0.72;
  }

  .labo-orbits__axis::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.08rem;
    width: 0.62rem;
    height: 0.62rem;
    border-top: 1px solid var(--color-ink);
    border-right: 1px solid var(--color-ink);
    transform: translateY(-50%) rotate(45deg);
    transform-origin: center;
  }

  .labo-orbits__degrees {
    position: absolute;
    z-index: 3;
    inset: 2.2%;
    border-radius: 50%;
    pointer-events: none;
  }

  .labo-orbits__degree {
    position: absolute;
    inset: 0;
    transform: rotate(var(--degree-angle));
  }

  .labo-orbits__degree > span {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    letter-spacing: var(--tracking-sous-titre);
    line-height: 1;
    opacity: 0.62;
    transform: translateX(-50%) rotate(calc(-1 * var(--degree-angle)));
    white-space: nowrap;
  }

  .labo-orbits__core {
    position: absolute;
    z-index: 5;
    isolation: isolate;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(8.5rem, 14vw, 11.5rem);
    aspect-ratio: 1;
    place-content: center;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-accent);
    overflow: hidden;
    text-align: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 0.75rem color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .labo-orbits__core::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -36%;
    background: url('/textures/grain-fin.svg') 0 0 / 12.5rem 12.5rem repeat;
    mix-blend-mode: multiply;
    opacity: 0.31;
    pointer-events: none;
    animation: labo-core-grain 1.15s steps(8, end) infinite;
    will-change: transform, opacity;
  }

  .labo-orbits__core > * {
    position: relative;
    z-index: 1;
  }

  @keyframes labo-core-grain {
    0% { transform: translate3d(-4%, -3%, 0); opacity: 0.28; }
    14% { transform: translate3d(3%, -5%, 0); opacity: 0.34; }
    29% { transform: translate3d(-5%, 2%, 0); opacity: 0.3; }
    43% { transform: translate3d(4%, 4%, 0); opacity: 0.35; }
    57% { transform: translate3d(-2%, -4%, 0); opacity: 0.31; }
    71% { transform: translate3d(5%, 1%, 0); opacity: 0.34; }
    86% { transform: translate3d(-3%, 5%, 0); opacity: 0.29; }
    100% { transform: translate3d(-4%, -3%, 0); opacity: 0.28; }
  }

  .labo-orbits__core strong {
    font-family: var(--font-titre);
    /*
      Un cran sous la déclaration : le mot pivot doit dominer les deux lignes
      qui l'encadrent sans saturer le disque. Le facteur garde le token comme
      référence, donc le corps reste fluide avec la largeur.
    */
    font-size: calc(var(--text-declaration) * 0.82);
    font-weight: 400;
    letter-spacing: var(--tracking-titre);
    text-transform: uppercase;
  }

  .labo-orbit {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: var(--orbit-size);
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .labo-orbit__track {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;
    shape-rendering: geometricPrecision;
  }

  .labo-orbit__track-line {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 38%, transparent);
    stroke-width: 1;
  }

  .labo-orbit--dots .labo-orbit__track-line {
    stroke-dasharray: 0.45 1.55;
    stroke-linecap: round;
    opacity: 0.76;
  }

  .labo-orbit--dashes .labo-orbit__track-line {
    stroke-dasharray: 5.6 3.15;
    stroke-linecap: butt;
    opacity: 0.58;
  }

  .labo-orbit--morse .labo-orbit__track-line {
    stroke-dasharray: 0.42 1.15 3.8 1.15;
    stroke-linecap: round;
    opacity: 0.68;
  }

  .labo-orbit--double .labo-orbit__track-line {
    stroke-dasharray: 8 2.4;
    stroke-width: 0.8;
    opacity: 0.42;
  }

  .labo-orbit--double .labo-orbit__track-line--secondary {
    stroke-dasharray: 0.35 1.65;
    stroke-linecap: round;
    opacity: 0.3;
  }

  .labo-orbit--ticks .labo-orbit__track-line {
    stroke-dasharray: none;
    stroke-width: 0.8;
    opacity: 0.5;
  }

  .labo-orbit--ticks .labo-orbit__track-line--secondary {
    stroke-width: 0.65;
    opacity: 0.34;
  }

  .labo-orbit--microticks .labo-orbit__track-line {
    stroke-dasharray: none;
    stroke-width: 0.55;
    opacity: 0.28;
  }

  .labo-orbit__microtick {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 52%, transparent);
    stroke-width: 0.38;
    stroke-linecap: butt;
    opacity: 0.34;
  }

  .labo-orbit__microtick--medium {
    stroke-width: 0.48;
    opacity: 0.48;
  }

  .labo-orbit__microtick--major {
    stroke-width: 0.62;
    opacity: 0.62;
  }

  .labo-orbit__ruler-tick {
    vector-effect: non-scaling-stroke;
    stroke: color-mix(in srgb, var(--color-ink) 58%, transparent);
    stroke-width: 0.55;
  }

  .labo-orbit__ruler-tick--minor { opacity: 0.46; }
  .labo-orbit__ruler-tick--medium {
    stroke-width: 0.75;
    opacity: 0.62;
  }
  .labo-orbit__ruler-tick--major {
    stroke-width: 1;
    opacity: 0.78;
  }

  .labo-orbit--spaced .labo-orbit__track-line {
    stroke-dasharray: 2.4 5.4;
    stroke-linecap: round;
    opacity: 0.48;
  }

  .labo-orbit__carrier {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    transform: rotate(var(--orbit-phase));
    will-change: transform;
  }

  .labo-orbit__node {
    position: absolute;
    top: 50%;
    right: -0.8rem;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    color: var(--color-ink);
    pointer-events: auto;
    text-decoration: none;
    transform: translateY(-50%);
  }

  .labo-orbit__node:focus-visible {
    outline: 1px solid var(--color-ink);
    outline-offset: 0.3rem;
  }

  .labo-orbit__orientation {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    will-change: transform;
  }

  .labo-orbit__spinner {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    will-change: transform;
  }

  .labo-orbit__symbol {
    display: block;
    width: clamp(1.2rem, 1.65vw, 1.6rem);
    height: auto;
    object-fit: contain;
  }

  .labo-orbit__label {
    position: absolute;
    top: 50%;
    left: 1.9rem;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    width: clamp(7.5rem, 13vw, 11.5rem);
    gap: 0.16rem;
    justify-items: start;
    align-items: start;
    padding: 0.2rem 0.35rem;
    background: transparent;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: 1.25;
    letter-spacing: var(--tracking-copy);
    text-align: left;
    text-transform: uppercase;
    transform: translateY(-50%);
    transform-origin: -1.9rem 50%;
  }

  .labo-orbit__label-index {
    font-size: var(--text-note);
    letter-spacing: var(--tracking-sous-titre);
    opacity: 0.58;
    white-space: nowrap;
  }

  .labo-orbit__label-text {
    position: relative;
    opacity: 0.82;
    transition:
      opacity 0.35s ease-out,
      letter-spacing 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .labo-orbit__label-text::before {
    content: '';
    position: absolute;
    top: 0.47em;
    left: -0.72rem;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transform: scale(0.2);
    transition:
      opacity 0.3s ease-out,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .labo-orbit__node:hover .labo-orbit__label-text,
  .labo-orbit__node:focus-visible .labo-orbit__label-text {
    letter-spacing: var(--tracking-sous-titre);
    opacity: 1;
    transform: translateX(0.42rem);
  }

  .labo-orbit__node:hover .labo-orbit__label-text::before,
  .labo-orbit__node:focus-visible .labo-orbit__label-text::before {
    opacity: 0.75;
    transform: scale(1);
  }

  .labo-philosophy,


  .labo-services {
    padding-block: clamp(5rem, 10vw, 10rem);
  }

  .labo-philosophy {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: clamp(8rem, 15vw, 13rem) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    box-sizing: border-box;
    width: auto;
    max-width: min(100%, var(--container-wide));
    min-height: 100svh;
    overflow: hidden;
  }

  .labo-philosophy::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 7% 2% 5% 22%;
    background:
      linear-gradient(90deg, transparent 0 17%, color-mix(in srgb, var(--color-ciel) 18%, transparent) 17% 42%, transparent 42% 66%, color-mix(in srgb, var(--color-sable) 26%, transparent) 66% 88%, transparent 88%),
      radial-gradient(circle at 70% 38%, color-mix(in srgb, var(--color-ciel) 22%, transparent), transparent 42%);
    filter: blur(0.2px);
    opacity: 0.62;
    pointer-events: none;
  }

  .labo-philosophy__grain {
    z-index: 0;
    opacity: 0.28;
  }

  .labo-philosophy__margin,
  .labo-philosophy__page {
    position: relative;
    z-index: 1;
  }

  .labo-philosophy__margin {
    display: grid;
    grid-template-rows: auto minmax(18rem, 1fr) auto;
    gap: 2rem;
    min-width: 0;
  }

  .labo-philosophy__index {
    white-space: nowrap;
  }

  .labo-philosophy__scale {
    position: relative;
    width: 100%;
    min-height: 20rem;
    background:
      repeating-linear-gradient(to bottom, var(--color-line) 0 1px, transparent 1px 0.55rem) right 1.15rem top / 0.65rem 100% no-repeat,
      linear-gradient(var(--color-line), var(--color-line)) right 1.15rem center / 1px 100% no-repeat;
  }

  .labo-philosophy__scale::before,
  .labo-philosophy__scale::after {
    content: '';
    position: absolute;
    right: 0.85rem;
    width: 1.25rem;
    height: 1px;
    background: var(--color-ink);
  }

  .labo-philosophy__scale::before { top: 0; }
  .labo-philosophy__scale::after { bottom: 0; }

  .labo-philosophy__scale span {
    position: absolute;
    top: 50%;
    right: 2.4rem;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: right center;
    white-space: nowrap;
  }

  .labo-philosophy__marginalia {
    max-width: 10rem;
    transform: rotate(-1.6deg);
  }

  .labo-philosophy__marginalia p {
    margin-top: 0.45rem;
    font-family: var(--font-annotation);
    font-size: var(--text-note);
    font-style: italic;
    line-height: 1.25;
  }

  .labo-philosophy__page {
    display: grid;
    align-content: start;
    justify-self: end;
    box-sizing: border-box;
    inline-size: min(100%, 52rem);
    max-inline-size: 100%;
    min-width: 0;
    padding-inline-end: clamp(1.5rem, 3vw, 3rem);
    overflow-wrap: break-word;
  }

  .labo-philosophy__folio {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3rem, 7vw, 7rem);
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
  }

  .labo-philosophy__folio span:last-child {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .labo-philosophy__lead {
    position: relative;
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    margin: 0;
    font-family: var(--font-copy);
    font-size: clamp(2.5rem, 5.7vw, var(--text-titre));
    line-height: var(--text-titre--line-height);
    letter-spacing: var(--tracking-titre);
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
    text-align: left;
    text-wrap: wrap;
  }

  .labo-philosophy__quote {
    position: absolute;
    top: -0.08em;
    left: -0.48em;
    font-family: var(--font-copy);
    font-size: 1.25em;
    line-height: 1;
  }

  .labo-philosophy__quote-close {
    margin-left: 0.04em;
  }

  .labo-philosophy__notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.35rem, 2.25vw, 2.25rem);
    justify-self: end;
    inline-size: min(100%, 38rem);
    max-inline-size: 100%;
    min-inline-size: 0;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .labo-philosophy__note {
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    margin: 0;
    font-size: var(--text-copy);
    line-height: 1.48;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .labo-philosophy__notes {
      width: min(100%, 31rem);
    }
  }

  @media (min-width: 1280px) {
    .labo-philosophy__page {
      inline-size: min(100%, 52rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
    }
  }

  /*
   * Entre tablette et petit desktop, le rail fixe retire 16rem à la page.
   * Cette plage doit donc être composée selon la largeur réellement restante,
   * et non comme un viewport desktop complet.
   */
  @media (min-width: 768px) and (max-width: 1279px) {
    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
      padding-right: clamp(2.5rem, 5vw, 4rem);
    }

    .labo-philosophy__page {
      inline-size: min(100%, 42rem, calc(100vw - var(--rail-width) - 15rem));
      max-inline-size: calc(100vw - var(--rail-width) - 15rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__lead {
      font-size: clamp(2.7rem, 5.2vw, var(--text-titre));
    }

    .labo-philosophy__notes {
      inline-size: min(100%, 27rem);
    }
  }

  .labo-philosophy__keywords {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.7vw, 3rem);
    margin-top: clamp(5rem, 10vw, 10rem);
    font-family: var(--font-titre);
    font-size: clamp(1.5rem, 2.7vw, var(--text-titre));
    line-height: 0.92;
    letter-spacing: var(--tracking-copy);
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    cursor: default;
  }

  .labo-philosophy__letter {
    display: inline-block;
    height: 0.92em;
    overflow: hidden;
    perspective: 4em;
  }

  .labo-philosophy__letter-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--letter-index) * 34ms);
  }

  .labo-philosophy__letter-track > span {
    display: block;
    height: 0.92em;
    line-height: 0.92;
  }

  @media (hover: hover) and (pointer: fine) {
    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: translateY(-50%);
    }
  }

  .labo-section-heading {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .labo-section-heading h2 {
    max-width: 16ch;
  }

  /*
    L'équipe : une déclaration composée au fer à fer, puis le texte de service
    qui la précise. La note de fondation est une pièce rapportée — photographie
    posée à gauche, feuille de papier à droite, comme un document glissé dans
    le cahier.
  */
  /*
    Le manifeste se termine sur ses mots-clés, déjà largement dégagés : la
    cote de section n'a pas besoin d'une seconde respiration au-dessus d'elle,
    seulement en dessous, avant la section suivante.
  */
  .labo-team {
    padding-block: clamp(2rem, 3.5vw, 3.5rem) clamp(6rem, 11vw, 12rem);
  }

  .labo-team__heading {
    margin-bottom: clamp(3.5rem, 6vw, 6rem);
  }

  .labo-team__lead {
    margin: 0;
    /* Même alinéa que la citation du manifeste : le bloc s'ouvre en retrait. */
    text-indent: clamp(3.5rem, 8vw, 8rem);
    font-family: var(--font-copy);
    font-size: clamp(2rem, 4.6vw, 4rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-titre);
    /*
      Les deux bords sont alignés, comme un bloc de titre imprimé. La césure
      reste interdite : à cette taille, un mot coupé se verrait de loin.
    */
    text-align: justify;
    hyphens: none;
  }

  /*
    Même traitement que les notes de marge du manifeste : une colonne étroite
    poussée contre le bord droit, en retrait, sous la déclaration pleine page.
    Fer à gauche — sur 29rem, le fer à fer creuserait des rivières.
  */
  .labo-team__body {
    width: min(100%, 29rem);
    max-width: 100%;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0 auto;
    text-indent: clamp(3rem, 8vw, 8rem);
    hyphens: none;
  }

  /*
    La feuille est plus haute que large — un feuillet, pas un encart —, et la
    photographie se cale sur son milieu plutôt que sur son bord haut.
  */
  .labo-foundation {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(5rem, 9vw, 9rem);
  }

  .labo-foundation__figure {
    width: min(100%, 17rem);
    margin: 0 auto;
  }

  .labo-foundation__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    Un vergé clair posé sur le papier d'archive de la page : c'est l'écart de
    ton entre les deux qui donne la feuille. Pas de voile teinté par-dessus —
    il rabattrait la note sur le fond et il n'y aurait plus de feuillet.
  */
  .labo-foundation__note {
    box-sizing: border-box;
    padding: clamp(2rem, 4vw, 3.5rem);
    background-color: var(--color-surface);
    background-image: url('/textures/papier-note-fondation.jpg');
    background-position: center;
    background-size: cover;
  }

  .labo-foundation__title {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-titre);
    font-weight: 400;
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
  }

  /*
    Aucun plafond de mesure : le texte doit occuper la feuille jusqu'à son
    bord, sinon la texture se lit comme un fond vide à droite du bloc.
  */
  .labo-foundation__paragraph {
    margin: 0;
  }


  /* Alinéa à chaque reprise : la note se lit comme une lettre manuscrite. */
  .labo-foundation__paragraph {
    text-indent: 2.5em;
  }

  .labo-foundation__paragraph + .labo-foundation__paragraph {
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
  }

  .labo-foundation__signature {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-family: var(--font-annotation);
    font-size: var(--text-annotation);
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    text-align: right;
  }

  .labo-services {
    padding-block: clamp(2rem, 3vw, 3.5rem) clamp(7rem, 11vw, 11rem);
    /* Destination commune de toutes les fiches : l'en-tête « Index orbital ». */
    scroll-margin-top: clamp(5rem, 10vw, 9rem);
  }

  .labo-services__heading {
    margin-bottom: clamp(4.5rem, 7vw, 7rem);
  }

  .labo-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /*
      Colonnes resserrées : la gouttière ne sert plus qu'à séparer deux blocs de
      texte, la largeur de mesure de chacun (40ch sur le paragraphe) suffisant
      déjà à les tenir à distance.
    */
    column-gap: clamp(1.5rem, 2.2vw, 2.5rem);
    row-gap: clamp(3rem, 4.5vw, 4.5rem);
  }

  /*
    Les nœuds de l'orbite mènent tous au même endroit, sans que le clic soit
    intercepté : chaque fiche garde son ancre — donc partageable, et le bouton
    retour conserve son repère — mais sa marge de défilement vaut sa distance à
    l'en-tête. Le navigateur atterrit alors toujours sur « Index orbital », et
    `:target` désigne la fiche demandée. La valeur exacte est posée au chargement
    par le script ; la valeur de repli sert tant qu'il n'a pas mesuré.
  */
  .labo-service {
    display: block;
    min-height: 0;
    scroll-margin-top: var(--service-anchor-offset, clamp(5rem, 10vw, 9rem));
    transition: color 320ms ease;
  }

  /*
    Mise en évidence par RETRAIT : l'index entier passe en gris, la fiche lue
    seule garde l'encre pleine et son numéro tamponné. Rien ne s'ajoute à la
    page, et la marge négative compense le fond pour que le chiffre ne bouge pas.
  */
  .labo-services__grid:has(.labo-service:target) .labo-service:not(:target) {
    color: var(--color-muted);
  }

  .labo-service:target .labo-service__number {
    padding-inline: 0.45em;
    margin-inline-start: -0.45em;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    opacity: 1;
  }

  .labo-service__number,
  .labo-service h3 {
    font-family: var(--font-titre);
  }

  /*
    `min-height` valait 2,9em : deux lignes réservées sous CHAQUE intitulé, pour
    que les paragraphes des trois colonnes démarrent tous à la même hauteur
    quand l'un des titres se casse en deux. Le prix en était une ligne creuse
    sous les quatre titres qui tiennent sur une seule.

    On traite désormais la cause plutôt que le symptôme : la mesure passe de 28
    à 32ch, ce qui suffit à faire tenir « Produire selon les besoins » — le seul
    qui débordait — sur une ligne. Les cinq titres font alors la même hauteur,
    l'alignement est obtenu sans rien réserver, et le plancher retombe à une
    ligne juste.

    ⚠️ L'alignement dépend donc maintenant de la longueur des intitulés saisis
    dans le CMS. Un titre nettement plus long repassera à deux lignes et fera
    démarrer SON paragraphe un cran plus bas que les autres. C'est un écart
    visuel mineur et réversible (remonter la mesure, ou revenir à un plancher de
    2,84em) — pas une casse de mise en page.
  */
  .labo-service h3 {
    max-width: 36ch;
    min-height: 1.42em;
    font-size: var(--text-note);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
  }

  .labo-service p {
    max-width: 40ch;
    margin-top: clamp(0.35rem, 0.5vw, 0.5rem);
    font-family: var(--font-copy);
    font-size: var(--text-copy);
    line-height: 1.42;
    letter-spacing: var(--tracking-copy);
  }

  /*
    Les prestations couvertes par l'étape : une ligne d'étiquettes. Le point
    médian sépare la liste sans faire partie du contenu.

    L'italique passe par GT Canon Narrow S — la voix d'annotation du système,
    dessinée penchée. Poser `font-style: italic` sur le mono aurait fait
    fabriquer une oblique au navigateur, c'est-à-dire un faux italique.
    Les capitales et leur interlettrage tombent avec lui : ils avaient été
    réglés pour le mono et alourdissent un italique de labeur.
  */
  .labo-service__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin-top: clamp(0.55rem, 0.8vw, 0.8rem);
    padding: 0;
    font-family: var(--font-annotation);
    font-style: italic;
    letter-spacing: var(--tracking-copy);
    list-style: none;
    opacity: 0.68;
  }

  .labo-service__tools li + li::before {
    content: '•';
    display: inline-block;
    margin-inline-end: 0.5em;
  }

  .labo-service__number {
    display: block;
    width: fit-content;
    transition: background-color 320ms ease, color 320ms ease;
    /*
      Plus serré que l'écart titre/description : le numéro se lit comme
      l'étiquette du titre, pas comme une ligne autonome au-dessus de lui.
    */
    margin-bottom: clamp(0.4rem, 0.6vw, 0.6rem);
    font-size: var(--text-note);
    line-height: 1;
    letter-spacing: var(--tracking-sous-titre);
    opacity: 0.68;
  }

  .labo-services__note {
    max-width: 42ch;
    margin: clamp(5rem, 8vw, 8rem) 0 0 auto;
    text-align: right;
  }

  .labo-archive {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .labo-archive__layout {
    display: grid;
    grid-template-columns: clamp(12rem, 20vw, 19rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .labo-archive__head {
    position: relative;
    z-index: 2;
    padding-top: 0.15rem;
  }

  .labo-archive__head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, var(--text-titre));
    line-height: 1;
  }

  .labo-archive__rail {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .labo-orbits {
      width: 100%;
      min-height: 0;
    }

    .labo-orbits::before {
      inset: 0;
    }

    .labo-orbits__axis {
      width: 98%;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 17vw, 7.5rem);
      box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--color-surface) 84%, transparent);
    }

    .labo-orbits__core strong {
      font-size: var(--text-copy);
    }

    .labo-orbit__label {
      left: 1.55rem;
      display: block;
      width: auto;
      padding: 0;
      transform-origin: -1.55rem 50%;
    }

    .labo-orbit__label-text {
      display: none;
    }

    .labo-orbit__label-index {
      display: block;
      font-size: var(--text-note);
      opacity: 0.72;
    }

    .labo-services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .labo-services__grid {
      row-gap: clamp(2.75rem, 4.5vw, 4rem);
    }

    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }

    .labo-philosophy::before {
      inset-inline: 18% 0;
    }

    .labo-philosophy__lead {
      max-width: none;
      font-size: clamp(2.7rem, 5.2vw, var(--text-titre));
    }

    .labo-philosophy__notes {
      grid-template-columns: 1fr;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

  }

  @media (max-width: 767px) {
    .labo-orbit__label-index {
      font-size: var(--text-note);
    }

    .labo-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 25vw, 6.5rem);
    }

    .labo-orbits__core strong {
      font-size: var(--text-note);
    }

    .labo-philosophy,
    .labo-section-heading,
    .labo-archive__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }


    .labo-philosophy {
      min-height: auto;
      padding-top: 5rem;
    }

    .labo-philosophy::before {
      inset: 11rem -15% 4rem 16%;
    }

    .labo-philosophy__margin {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .labo-philosophy__scale {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      min-height: 3.25rem;
      background:
        repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px 0.55rem) left bottom 1rem / 100% 0.65rem no-repeat,
        linear-gradient(var(--color-line), var(--color-line)) left bottom 1rem / 100% 1px no-repeat;
    }

    .labo-philosophy__scale::before,
    .labo-philosophy__scale::after {
      bottom: 0.7rem;
      width: 1px;
      height: 1.25rem;
    }

    .labo-philosophy__scale::before {
      top: auto;
      right: auto;
      left: 0;
    }

    .labo-philosophy__scale::after {
      right: 0;
    }

    .labo-philosophy__scale span {
      top: 0;
      right: auto;
      left: 0;
      transform: none;
    }

    .labo-philosophy__marginalia {
      text-align: right;
    }

    .labo-philosophy__folio {
      margin-bottom: 3.5rem;
      font-size: var(--text-note);
    }

    .labo-philosophy__page {
      width: calc(100% - 1.2rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__lead {
      max-width: none;
      margin: 0;
      font-size: clamp(2.25rem, 11.5vw, var(--text-titre));
      hyphens: none;
      text-align: left;
    }

    .labo-philosophy__notes {
      gap: 1.35rem;
      margin-top: 3.5rem;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
      margin-top: 5rem;
    }

    .labo-archive__head {
      padding-bottom: 1.5rem;
    }

    .labo-archive__rail {
      grid-column: 1;
    }

    .labo-philosophy__lead {
      font-size: clamp(1.45rem, 7vw, var(--text-titre));
    }

    .labo-services__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
      row-gap: 3.5rem;
    }

    .labo-service {
      min-height: auto;
    }

    .labo-service h3 {
      max-width: none;
      min-height: 0;
    }

    /*
      Les plafonds en `ch` étaient pensés pour une colonne large : sur la
      seule colonne mobile, ils laissaient le texte inutilement étroit,
      repliés bien avant le bord de son conteneur.
    */
    .labo-service p {
      max-width: none;
    }

    /*
      Le fer à fer suppose une ligne assez longue pour absorber les blancs :
      sur une colonne mobile, il creuserait des rivières. On revient au fer à
      gauche, et l'alinéa se resserre.
    */
    .labo-team__lead,
    .labo-team__body {
      text-align: left;
    }

    .labo-team__lead,
    .labo-team__body {
      text-indent: 2rem;
    }

    .labo-team__body {
      width: 100%;
      margin-left: 0;
    }

    .labo-foundation {
      grid-template-columns: 1fr;
    }

    .labo-foundation__figure {
      width: min(62%, 14rem);
    }

  }

  /* Composition éditoriale de la séquence Philosophie, d'après la maquette. */
  .labo-philosophy {
    box-sizing: border-box;
    width: auto;
    max-width: var(--container-wide);
    margin-inline: auto;
    background-color: var(--color-surface);
    background-image:
      linear-gradient(rgb(239 235 226 / 28%), rgb(239 235 226 / 28%)),
      url('/textures/papier-froisse.jpg');
    background-position: center;
    background-size: cover;
  }

  .labo-philosophy {
    display: block;
    min-height: 0;
    padding-block: clamp(5rem, 8vw, 8rem) clamp(1.5rem, 2.5vw, 2.5rem);
    overflow: clip;
  }

  .labo-philosophy::before,
  .labo-philosophy__grain,
  .labo-philosophy__scale,
  .labo-philosophy__marginalia,
  .labo-philosophy__folio {
    display: none;
  }

  .labo-philosophy__margin,
  .labo-philosophy__page {
    width: min(100%, 66rem);
    max-width: 100%;
    margin-inline: auto;
  }

  .labo-philosophy__margin {
    display: block;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .labo-philosophy__index {
    white-space: normal;
  }

  .labo-philosophy__page {
    display: block;
    position: relative;
    padding: 0;
  }

  .labo-philosophy__lead {
    width: min(100%, 17ch);
    max-width: 17ch;
    margin: 0;
    /*
      Un cran au-dessus du plus grand corps de la charte : c'est la citation qui
      ouvre le manifeste. Exprimée en multiple du token, elle suit l'échelle
      typographique si celle-ci bouge. La colonne se mesure en ch, donc elle
      s'élargit d'autant et le nombre de lignes ne change pas.
    */
    font-size: calc(var(--text-titre) * 1.75);
    line-height: 0.92;
    letter-spacing: var(--tracking-titre);
    text-indent: clamp(3.5rem, 8vw, 8rem);
    text-align: left;
    text-wrap: pretty;
  }

  .labo-philosophy__quote,
  .labo-philosophy__quote-close {
    display: inline;
    position: static;
    margin: 0;
    font-size: 1em;
    line-height: inherit;
  }

  .labo-philosophy__notes {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    max-width: none;
    margin-top: clamp(3rem, 5vw, 5rem);
  }

  .labo-philosophy__note {
    width: 100%;
    max-width: none;
    font-family: var(--font-titre);
    font-size: var(--text-copy);
    line-height: 1.28;
    letter-spacing: var(--tracking-copy);
    text-align: left;
  }

  /*
    Deux largeurs de composition, décidées par le paragraphe lui-même et non
    par son rang : la pleine page tient le propos, la colonne étroite poussée
    contre le bord droit retraite ce qui se lit comme une note de marge. Un
    calage au rang laissait les paragraphes suivants en placement automatique,
    donc réduits à une colonne sur douze.
  */
  .labo-philosophy__note--pleine,
  .labo-philosophy__note--declaration {
    grid-column: 1 / -1;
  }

  /*
    Le point culminant du manifeste : pleine largeur dans le corps et la
    graisse de la citation d'ouverture, pour qu'une phrase du milieu de page
    porte autant que celle qui l'a ouverte.
  */
  .labo-philosophy__note--declaration {
    font-family: var(--font-copy);
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-titre);
  }

  /*
    L'alinéa ouvre le manifeste, puis marque chaque retour à la pleine page
    après une note de marge — le lecteur retrouve ainsi le fil principal.
  */
  .labo-philosophy__note:first-child,
  .labo-philosophy__note--colonne + .labo-philosophy__note--pleine,
  .labo-philosophy__note--colonne + .labo-philosophy__note--declaration {
    text-indent: clamp(4rem, 11vw, 11rem);
  }

  .labo-philosophy__note--colonne {
    grid-column: 7 / 13;
    width: min(100%, 29rem);
    justify-self: end;
    text-indent: clamp(3rem, 8vw, 8rem);
  }

  .labo-philosophy__keywords {
    position: absolute;
    top: 0.35rem;
    right: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    font-style: normal;
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-transform: lowercase;
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    font-style: normal;
  }

  .labo-philosophy__letter,
  .labo-philosophy__letter-track,
  .labo-philosophy__letter-track > span {
    height: 1.3em;
    font-style: normal;
    line-height: 1.3;
  }

  @media (max-width: 767px) {
    .labo-philosophy {
      padding-inline: var(--spacing-gutter);
    }

    .labo-philosophy__lead {
      width: 100%;
      max-width: 100%;
      font-size: clamp(2.5rem, 16vw, calc(var(--text-titre) * 1.75));
      text-indent: 1.5rem;
    }

    .labo-philosophy__notes {
      grid-template-columns: minmax(0, 1fr);
    }

    .labo-philosophy__note {
      grid-column: 1;
      width: 100%;
      max-width: 100%;
      margin-left: 0;
    }

    .labo-philosophy__note--colonne {
      justify-self: stretch;
    }

    .labo-philosophy__note {
      text-indent: 2rem;
    }

    .labo-philosophy__keywords {
      position: static;
      align-items: flex-end;
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-service,
    .labo-service__number {
      transition: none;
    }

    .labo-orbits__core::before {
      animation: none;
      transform: none;
    }

    .labo-philosophy__letter-track {
      transition: none;
    }

    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: none;
    }

    .labo-orbit__label-text,
    .labo-orbit__label-text::before {
      transition: none;
    }

    .labo-orbit__node:hover .labo-orbit__label-text,
    .labo-orbit__node:focus-visible .labo-orbit__label-text {
      transform: none;
    }
  }

  /*
    Entrée des textes de lecture : le bloc entier monte et apparaît d'un coup,
    là où les grandes déclarations se révèlent mot à mot. Deux gestes distincts
    pour deux registres — et surtout, aucun temps d'attente imposé à qui lit :
    le paragraphe arrive entier.
  */
  :global(html.labo-rise-booting) [data-rise]:not([data-rise-ready]) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.labo-rise-booting) [data-rise] {
      opacity: 1;
    }
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const risingBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-rise]:not([data-rise-ready])'),
  );

  if (risingBlocks.length > 0 && !reducedMotion.matches) {
    risingBlocks.forEach((block) => {
      block.dataset.riseReady = '';

      gsap.fromTo(
        block,
        { opacity: 0, y: 22 },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: { trigger: block, start: 'top 88%', once: true },
        },
      );
    });
  }

  /*
    Les positions de déclenchement sont mesurées à l'exécution, avant que les
    fontes soient chargées et avant que le révélateur mot à mot ait redécoupé
    les grandes déclarations — deux choses qui changent la hauteur de tout ce
    qui suit. Sans ce recalcul, chaque bloc s'allumerait à côté de son repère.
  */
  document.fonts?.ready.then(() => ScrollTrigger.refresh());

  document.documentElement.classList.remove('labo-rise-booting');

  document.querySelectorAll<HTMLElement>('[data-labo-orbits]:not([data-orbits-ready])').forEach((system) => {
    system.dataset.orbitsReady = '';

    const motions: Array<{
      revolution: gsap.core.Timeline;
      spin: gsap.core.Timeline;
    }> = [];
    const carriers = system.querySelectorAll<HTMLElement>('[data-orbit-carrier]');

    carriers.forEach((carrier) => {
      const phase = Number(carrier.dataset.phase ?? 0);
      const duration = Number(carrier.dataset.duration ?? 60);
      const direction = Number(carrier.dataset.direction ?? 1);
      const spinDuration = Number(carrier.dataset.spinDuration ?? 180);
      const spinDirection = Number(carrier.dataset.spinDirection ?? -1);
      const orientation = carrier.querySelector<HTMLElement>('[data-orbit-orientation]');
      const spinner = carrier.querySelector<HTMLElement>('[data-orbit-spinner]');
      const spinPhase = (phase * 0.37 * spinDirection) % 360;

      gsap.set(carrier, { rotation: phase, force3D: true });
      if (orientation) gsap.set(orientation, { rotation: -phase, force3D: true });
      if (spinner) gsap.set(spinner, { rotation: spinPhase, force3D: true });

      if (reducedMotion.matches || !orientation || !spinner) return;

      const revolution = gsap.timeline({ paused: true, repeat: -1 });
      revolution.to(carrier, {
        rotation: phase + 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);
      revolution.to(orientation, {
        rotation: -phase - 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);

      const spin = gsap.timeline({ paused: true, repeat: -1 });
      spin.to(spinner, {
        rotation: spinPhase + 360 * spinDirection,
        duration: spinDuration,
        ease: 'none',
        force3D: true,
      });

      motions.push({ revolution, spin });
    });

    if (reducedMotion.matches || motions.length === 0) {
      return;
    }

    /*
      Réponse au scroll. La vitesse du geste devient une impulsion qui s'ajoute
      au régime de croisière des orbites, puis retombe d'elle-même. Les valeurs
      se lisent ensemble : un scroll de trackpad ordinaire tourne autour de
      1200 px/s, soit une impulsion d'environ 3 — les orbites quadruplent leur
      vitesse le temps du geste, et un lancer franc les pousse jusqu'à 8×.
    */
    const SCROLL_SENSITIVITY = 420; // px/s nécessaires pour +1× de vitesse
    const IMPULSE_MIN = -3;
    const IMPULSE_MAX = 7;
    const REVOLUTION_MIN = 0.25; // remonter le scroll fait presque caler l'orbite
    const REVOLUTION_MAX = 8;
    const SPIN_COUPLING = 0.5; // les symboles suivent, à mi-voix
    const SPIN_MIN = 0.4;
    const SPIN_MAX = 4;

    let hoverFactor = 1;
    let scrollImpulse = 0;

    const setHoverFactor = (isHovering: boolean) => {
      hoverFactor = isHovering ? 0.16 : 1;
    };

    system.addEventListener('pointerenter', () => setHoverFactor(true));
    system.addEventListener('pointerleave', () => setHoverFactor(false));

    const scrollTrigger = ScrollTrigger.create({
      trigger: system,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: ({ isActive }) => {
        motions.forEach(({ revolution, spin }) => {
          isActive ? revolution.play() : revolution.pause();
          isActive ? spin.play() : spin.pause();
        });
      },
      onUpdate: (self) => {
        scrollImpulse = gsap.utils.clamp(IMPULSE_MIN, IMPULSE_MAX, self.getVelocity() / SCROLL_SENSITIVITY);
      },
    });

    if (scrollTrigger.isActive) {
      motions.forEach(({ revolution, spin }) => {
        revolution.play();
        spin.play();
      });
    }

    /*
      Trois réglages de temps, calibrés pour une image de 60 Hz. Sur un écran
      120 Hz, les appliquer telles quelles ferait retomber l'élan deux fois plus
      vite et rendrait la poussée du scroll deux fois plus molle : le même geste
      ne donnerait pas le même mouvement d'une machine à l'autre. On les
      convertit donc en fonction du temps réellement écoulé.

      L'élan survit volontairement au geste : il met environ une demi-seconde à
      s'éteindre, et les orbites le rattrapent assez vite pour qu'on voie
      l'accélération arriver. C'est ce décalage — pousser, puis regarder le
      système redescendre tout seul — qui rend l'effet lisible.
    */
    const IMPULSE_DECAY = 0.945; // par image : l'élan garde la moitié de sa force ~200 ms
    const REVOLUTION_CATCH_UP = 0.16;
    const SPIN_CATCH_UP = 0.1;

    const perFrame = (rate: number, frames: number) => 1 - (1 - rate) ** frames;

    const updateMotion = () => {
      const frames = gsap.ticker.deltaRatio(60);
      scrollImpulse *= IMPULSE_DECAY ** frames;
      const revolutionSpeed =
        gsap.utils.clamp(REVOLUTION_MIN, REVOLUTION_MAX, 1 + scrollImpulse) * hoverFactor;
      const spinSpeed =
        gsap.utils.clamp(SPIN_MIN, SPIN_MAX, 1 + scrollImpulse * SPIN_COUPLING) * hoverFactor;

      motions.forEach(({ revolution, spin }) => {
        revolution.timeScale(
          gsap.utils.interpolate(revolution.timeScale(), revolutionSpeed, perFrame(REVOLUTION_CATCH_UP, frames)),
        );
        spin.timeScale(
          gsap.utils.interpolate(spin.timeScale(), spinSpeed, perFrame(SPIN_CATCH_UP, frames)),
        );
      });
    };

    gsap.ticker.add(updateMotion);
  });

</script>
