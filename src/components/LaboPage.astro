    gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .labo-section-heading h2 {
    max-width: 16ch;
  }

  /*
    L'équipe : une déclaration composée au fer à fer, puis le texte de service
    qui la précise. La note de fondation est une pièce rapportée — photographie
    posée à gauche, feuille de papier à droite, comme un document glissé dans
    le cahier.
  */
  /*
    La section s'ouvre DIRECTEMENT sur sa déclaration : le repère « [03 — … »
    a été retiré. La garde du haut reprend donc à son compte ce que le repère
    et sa marge occupaient — sans elle, la déclaration remontait se coller aux
    mots-clés qui ferment la section précédente.
  */
  .labo-team {
    /*
      Le blanc au-dessus du repère vaut celui qui, dans la section Vision,
      sépare le repère « [02 — … » de sa colonne. La section précédente en
      apporte déjà une part par sa propre garde basse : celle-ci ne pose que
      le complément.
    */
    padding-block: clamp(1.5rem, 2.5vw, 2.5rem) clamp(2.5rem, 4.5vw, 4.5rem);
  }

  .labo-team__lead {
    margin: 0;
    /* Même alinéa que la citation du manifeste : le bloc s'ouvre en retrait. */
    text-indent: clamp(3.5rem, 8vw, 8rem);
    font-family: var(--font-copy);
    font-size: clamp(2rem, 4.6vw, 4rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-titre);
    /*
      Les deux bords sont alignés, comme un bloc de titre imprimé. La césure
      reste interdite : à cette taille, un mot coupé se verrait de loin.
    */
    text-align: justify;
    hyphens: none;
  }

  /*
    ┌─ LA MÊME COLONNE, RENVOYÉE À DROITE ──────────────────────────────────┐
    │ Ce paragraphe reprend EXACTEMENT la colonne de lecture de la section  │
    │ Vision — largeur, corps, justification, césure, alinéa — mais poussée │
    │ contre le bord droit de la page. Les deux blocs se répondent alors    │
    │ d'une section à l'autre, en miroir.                                   │
    │                                                                       │
    │ La largeur n'est pas recopiée en dur : c'est la MÊME opération que    │
    │ celle de la grille d'en face. Là-bas, les colonnes valent 0,8fr et    │
    │ 1,2fr de ce qui reste une fois la gouttière prise — la première fait  │
    │ donc 0,8 / 2 = 0,4 du reste. Écrite ainsi, elle suit toute retouche   │
    │ de la grille sans qu'on ait à y repenser.                            │
    │                                                                       │
    │ ➜ LIÉ À LA VARIANTE B : si c'est la variante A qui l'emporte, cette   │
    │   largeur n'a plus de colonne à laquelle correspondre. La rapporter   │
    │   alors sur la composition retenue.                                   │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-team__body {
    width: calc((100% - clamp(2.5rem, 6vw, 6rem)) * 0.4);
    max-width: 100%;
    /* `auto` à gauche : c'est lui qui renvoie le bloc contre le bord droit. */
    margin: clamp(2.5rem, 5vw, 4rem) 0 0 auto;
    font-family: var(--font-copy);
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    text-align: justify;
    hyphens: auto;
    text-indent: 2em;
    orphans: 2;
    widows: 2;
  }

  /*
    ┌─ LA NOTE DE FONDATION, EN BAS DE PAGE ────────────────────────────────┐
    │ Ce n'était pas une note mais un feuillet : un pavé de texte au corps  │
    │ courant, sur son propre papier, posé au milieu de la page. Il se      │
    │ lisait comme une section de plus.                                    │
    │                                                                       │
    │ C'en est une maintenant, au sens du livre : appelée depuis le mot     │
    │ qu'elle éclaire, rejetée au pied de la section, en petit corps, sans  │
    │ fond propre. Ce qui la désigne n'est plus un cadre mais le FILET      │
    │ COURT au-dessus d'elle et le blanc qui l'en sépare — la convention    │
    │ typographique exacte, qui ne coûte pas une couleur de plus.           │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-note {
    /*
      Le corps de la note. Nettement sous le texte courant — c'est le petit
      corps qui dit « note », avant même le filet — mais au-dessus du seuil de
      lisibilité d'un texte suivi de quatre paragraphes.
    */
    --note-size: clamp(0.8125rem, 0.55vw + 0.7rem, 0.9375rem);
    display: grid;
    /*
      Le numéro PEND dans la marge, le texte s'aligne sur lui-même : c'est ce
      décrochement qui fait lire un appel de note plutôt qu'une liste. La
      colonne est en `ch` de la note elle-même — elle tient « 1. » et son
      espace, quelle que soit la taille rendue.
    */
    grid-template-columns: 3ch minmax(0, 1fr);
    column-gap: 0.75rem;
    /*
      La note appartient encore à la section, mais elle est au PIED : le blanc
      au-dessus doit être franchement plus large que celui qui sépare deux
      paragraphes, sinon elle se lit comme la suite du texte.
    */
    margin-top: clamp(5rem, 9vw, 9rem);
    /* Mesure courte, comme en bas de page : la note ne file pas sur la laize. */
    max-width: 44rem;
    /*
      Même garde que les autres ancres de la page : arrivé par l'appel, on
      atterrit sur le filet et non le nez collé au bord haut de l'écran.
    */
    scroll-margin-top: clamp(1.5rem, 3vw, 3rem);
  }

  /*
    Le filet de note. Court et calé à gauche, comme l'imprimeur le pose : un
    trait sur toute la mesure ferait une séparation de section, pas une note.
  */
  .labo-note::before {
    content: '';
    grid-column: 1 / -1;
    width: 6rem;
    height: 1px;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    background-color: var(--color-line);
  }

  /*
    Le numéro est composé EXACTEMENT comme le titre qu'il précède — même fonte,
    même corps, même interligne, même approche. C'est la seule façon de les
    poser sur une même ligne de base : deux corps différents, et le chiffre
    flotte au-dessus ou sous le titre, quel que soit l'alignement demandé à la
    grille.
  */
  .labo-note__number,
  .labo-note__title {
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: var(--text-note--line-height);
    letter-spacing: var(--tracking-sous-titre);
    font-weight: 400;
  }

  .labo-note__number {
    /*
      Sans cela, la case de grille s'étire sur toute la hauteur de la note :
      le renvoi devient un lien de trois signes de large sur trois cents de
      haut, qui s'allume quand on passe à côté du texte.
    */
    align-self: start;
    color: var(--color-ink);
    text-decoration: none;
  }

  .labo-note__title {
    margin: 0 0 clamp(0.75rem, 1.5vw, 1.25rem);
    text-transform: uppercase;
  }

  /*
    Deux colonnes, comme le bas d'une page de livre. Le texte est court : les
    deux colonnes tiennent ensemble dans un écran, on ne remonte donc jamais
    chercher le haut de la seconde — c'est la seule condition qui rend la
    composition en colonnes lisible à l'écran.
  */
  .labo-note__columns {
    columns: 2;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /*
    Le texte de la note est dans la fonte de labeur, au petit corps : c'est un
    texte suivi, pas une mention machine. L'interligne reste ouvert — un petit
    corps serré sur quatre paragraphes ne se lit plus.
  */
  .labo-note__paragraph {
    margin: 0;
    font-family: var(--font-copy);
    font-size: var(--note-size);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    /*
      Fer à fer, et l'alinéa remplacé par un blanc entre les paragraphes : sur
      une colonne étroite, l'un ET l'autre feraient deux marques pour un seul
      changement de paragraphe.
    */
    text-align: justify;
    /*
      La césure est ce qui REND la justification tenable ici : sur une colonne
      de moins de cinquante signes, sans elle, les blancs entre mots s'ouvrent
      d'une ligne à l'autre et creusent des rivières. C'est le réglage inverse
      des grands textes de la page, où un mot coupé se verrait de loin.
    */
    hyphens: auto;
    /* Jamais une ligne seule au pied ou en tête d'une colonne. */
    orphans: 2;
    widows: 2;
  }

  .labo-note__paragraph + .labo-note__paragraph {
    margin-top: 0.7em;
  }

  .labo-note__signature {
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    font-family: var(--font-annotation);
    font-size: var(--note-size);
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    text-align: right;
  }

  /*
    L'APPEL, dans le texte. Exposant : la convention du livre, et le seul moyen
    de poser un renvoi dans une phrase sans en casser la ligne.

    `position: relative` plutôt que `<sup>` : l'élément exposant natif modifie
    la hauteur de ligne du paragraphe qui le porte, et la déclaration de la
    section est composée au fer à fer sur quatre lignes — un interlignage qui
    bouge sur une seule d'entre elles se voit immédiatement.
  */
  .labo-note__call {
    position: relative;
    top: -0.45em;
    margin-left: 0.12em;
    /*
      Le rapport de l'appel à son texte, et non une taille fixe : la
      déclaration passe de 2 à 4 rem selon la largeur, l'appel la suit.
    */
    font-size: 0.42em;
    letter-spacing: 0;
    text-decoration: none;
    /* Le chiffre ne se justifie pas avec le reste de la ligne. */
    white-space: nowrap;
    /* Cible tactile élargie sans toucher à la ligne : la garniture ne pousse rien. */
    padding-inline: 0.3em;
    margin-inline: -0.18em;
  }

  .labo-note__call:hover,
  .labo-note__call:focus-visible,
  .labo-note__number:hover,
  .labo-note__number:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /*
    À l'arrivée par l'ancre, la note se signale une fois — sinon on atterrit au
    pied d'une section sans savoir ce qu'on est venu y lire. Le filet suffit :
    il s'épaissit le temps qu'on le remarque, et rien ne bouge dans la page.
  */
  .labo-note:target::before {
    width: 12rem;
    height: 2px;
    transition:
      width 0.5s ease-out,
      height 0.5s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-note:target::before {
      transition: none;
    }
  }

  .labo-services {
    padding-block: clamp(2rem, 3vw, 3.5rem) clamp(7rem, 11vw, 11rem);
    /*
      Destination commune de toutes les fiches : l'en-tête « Index orbital ».

      La garde était de 9 rem au large : l'ancre déposait la section si bas que
      le titre flottait au milieu de l'écran, précédé d'un tiers de page vide.
      Elle se resserre — juste de quoi ne pas coller l'en-tête au bord — et
      cède le pas, sur écran étroit, au dégagement de la barre de marque, qui
      lui est fixe et masquerait le titre.

      Le script des fiches lit cette valeur pour composer la sienne
      (`--service-anchor-offset`) : la resserrer ici les resserre toutes.
    */
    scroll-margin-top: max(clamp(1.5rem, 3vw, 3rem), var(--mobile-brand-clearance, 0rem));
  }

  /*
    Écart resserré : la légende appartient à la figure au-dessus d'elle, pas à
    la grille en dessous. Une marge de fin de section l'aurait détachée des deux.
  */
  .labo-services__heading {
    margin-bottom: clamp(2rem, 3.5vw, 3.5rem);
    font-size: var(--text-note);
    line-height: 1.25;
  }

  /* Même place et même corps que le repère de la page Contact. */
  .labo-hero__index {
    display: block;
    margin-top: clamp(3rem, 6vw, 5rem);
    color: var(--color-muted);
    /*
      Réserve courte au-dessus de l'ancre : elle doit rester inférieure à la
      marge propre du repère (3 à 5 rem), sans quoi le défilement s'arrête assez
      haut pour laisser dépasser la dernière ligne du texte précédent — et la
      section s'ouvre sur la fin de la précédente.
    */
    scroll-margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .labo-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /*
      Colonnes resserrées : la gouttière ne sert plus qu'à séparer deux blocs de
      texte, la largeur de mesure de chacun (40ch sur le paragraphe) suffisant
      déjà à les tenir à distance.
    */
    column-gap: clamp(1.5rem, 2.2vw, 2.5rem);
    row-gap: clamp(3rem, 4.5vw, 4.5rem);
  }

  /*
    Les nœuds de l'orbite mènent tous au même endroit, sans que le clic soit
    intercepté : chaque fiche garde son ancre — donc partageable, et le bouton
    retour conserve son repère — mais sa marge de défilement vaut sa distance à
    l'en-tête. Le navigateur atterrit alors toujours sur « Index orbital », et
    `:target` désigne la fiche demandée. La valeur exacte est posée au chargement
    par le script ; la valeur de repli sert tant qu'il n'a pas mesuré.

    En dessous de 768 px, le script ne pose rien : c'est le repli qui s'applique,
    et le clic mène à la fiche elle-même (voir le script de la section).
  */
  /*
    Deux colonnes : la lune à gauche, le chiffre et l'intitulé empilés à droite
    — la disposition exacte du nœud sur l'orbite. Le corps de la fiche reprend
    ensuite toute la largeur : c'est le COUPLE chiffre-titre que la lune
    désigne, pas le paragraphe.
  */
  .labo-service {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.6em;
    align-items: center;
    /*
      `start` et non l'étirement par défaut : une fiche plus courte que sa
      voisine est tirée à la hauteur de la rangée, et ses lignes — chiffre,
      intitulé, corps — se répartissaient l'excédent. L'écart entre le chiffre
      et son titre passait alors de 9 à 26 px d'une colonne à l'autre. Les
      rangées gardent désormais leur hauteur propre, identique partout.
    */
    align-content: start;
    min-height: 0;
    scroll-margin-top: var(--service-anchor-offset, clamp(5rem, 10vw, 9rem));
    transition: color 320ms ease;
  }

  /*
    Mise en évidence par RETRAIT : l'index entier passe en gris, la fiche lue
    seule garde l'encre pleine et son numéro tamponné. Rien ne s'ajoute à la
    page, et la marge négative compense le fond pour que le chiffre ne bouge pas.
  */
  .labo-services__grid:has(.labo-service:target) .labo-service:not(:target) {
    color: var(--color-muted);
  }

  .labo-service:target .labo-service__number {
    padding-inline: 0.45em;
    margin-inline-start: -0.45em;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    opacity: 1;
  }

  .labo-service__number,
  .labo-service h3 {
    font-family: var(--font-titre);
  }

  /*
    La lune précède le chiffre sur la même ligne, comme la pastille précède
    l'étiquette sur l'orbite. Calée sous la ligne de base pour se centrer sur la
    hauteur d'œil du chiffre plutôt que de flotter au-dessus.
  */
  /*
    Les lunes de l'index tournent lentement sur elles-mêmes, autour de leur
    propre centre : le même mouvement que sur l'orbite, à mi-voix. Une révolution
    par minute et demie — assez lent pour qu'on ne le surprenne qu'en s'arrêtant.
  */
  .labo-service__symbol {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
    width: clamp(1.4rem, 1.9vw, 1.8rem);
    height: auto;
    transform-origin: 50% 50%;
    animation: labo-service-moon-spin 90s linear infinite;
  }

  @keyframes labo-service-moon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .labo-service__body {
    /* Le texte repart du bord de la fiche, sous le couple qu'il développe. */
    grid-column: 1 / -1;
  }

  /*
    `min-height` valait 2,9em : deux lignes réservées sous CHAQUE intitulé, pour
    que les paragraphes des trois colonnes démarrent tous à la même hauteur
    quand l'un des titres se casse en deux. Le prix en était une ligne creuse
    sous les quatre titres qui tiennent sur une seule.

    On traite désormais la cause plutôt que le symptôme : la mesure passe de 28
    à 32ch, ce qui suffit à faire tenir « Produire selon les besoins » — le seul
    qui débordait — sur une ligne. Les cinq titres font alors la même hauteur,
    l'alignement est obtenu sans rien réserver, et le plancher retombe à une
    ligne juste.

    ⚠️ L'alignement dépend donc maintenant de la longueur des intitulés saisis
    dans le CMS. Un titre nettement plus long repassera à deux lignes et fera
    démarrer SON paragraphe un cran plus bas que les autres. C'est un écart
    visuel mineur et réversible (remonter la mesure, ou revenir à un plancher de
    2,84em) — pas une casse de mise en page.
  */
  .labo-service h3 {
    max-width: 36ch;
    min-height: 1.42em;
    font-size: var(--text-note);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: var(--tracking-sous-titre);
    text-transform: uppercase;
  }

  .labo-service p {
    max-width: 40ch;
    margin-top: clamp(0.35rem, 0.5vw, 0.5rem);
    font-family: var(--font-copy);
    font-size: var(--text-copy);
    line-height: 1.42;
    letter-spacing: var(--tracking-copy);
  }

  /*
    Les prestations couvertes par l'étape : une ligne d'étiquettes. Le point
    médian sépare la liste sans faire partie du contenu.

    L'italique passe par GT Canon Narrow S — la voix d'annotation du système,
    dessinée penchée. Poser `font-style: italic` sur le mono aurait fait
    fabriquer une oblique au navigateur, c'est-à-dire un faux italique.
    Les capitales et leur interlettrage tombent avec lui : ils avaient été
    réglés pour le mono et alourdissent un italique de labeur.
  */
  .labo-service__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin-top: clamp(0.55rem, 0.8vw, 0.8rem);
    padding: 0;
    font-family: var(--font-annotation);
    /*
      Corps du texte courant, et non celui des notes : ce sont les outils du
      studio, pas une mention de bas de fiche. L'italique et l'opacité suffisent
      à les tenir au second plan.
    */
    font-size: var(--text-copy);
    line-height: 1.4;
    font-style: italic;
    letter-spacing: var(--tracking-annotation);
    list-style: none;
    opacity: 0.68;
  }

  .labo-service__tools li + li::before {
    content: '•';
    display: inline-block;
    margin-inline-end: 0.5em;
  }

  .labo-service__number {
    grid-column: 2;
    display: block;
    width: fit-content;
    transition: background-color 320ms ease, color 320ms ease;
    /*
      Plus serré que l'écart titre/description : le numéro se lit comme
      l'étiquette du titre, pas comme une ligne autonome au-dessus de lui.
    */
    margin-bottom: clamp(0.4rem, 0.6vw, 0.6rem);
    font-size: var(--text-note);
    line-height: 1;
    letter-spacing: var(--tracking-sous-titre);
    opacity: 0.68;
  }

  /*
    La garde HAUTE vaut celle qu'avait le repère en tête de la section Équipe —
    le rythme des repères est le même d'une section à l'autre. Rien en dessous :
    la section n'a pas de contenu, et les archives apportent déjà leur propre
    garde. Le jour où le texte arrive, c'est ici que se pose son blanc.
  */
  .labo-method {
    padding-block: clamp(1.5rem, 2.5vw, 2.5rem) 0;
  }

  .labo-archive {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .labo-archive__layout {
    display: grid;
    grid-template-columns: clamp(12rem, 20vw, 19rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .labo-archive__head {
    position: relative;
    z-index: 2;
    padding-top: 0.15rem;
  }

  .labo-archive__head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2.8vw, var(--text-titre));
    line-height: 1;
  }

  .labo-archive__rail {
    grid-column: 2;
    min-width: 0;
  }

  @media (max-width: 1023px) {
    .labo-orbits {
      width: 100%;
      min-height: 0;
    }

    .labo-orbits::before {
      inset: 0;
    }

    .labo-orbits__axis {
      width: 98%;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 17vw, 7.5rem);
    }

    .labo-orbits__core strong {
      font-size: var(--text-copy);
    }

    .labo-orbit__label {
      left: 1.55rem;
      display: block;
      width: auto;
      padding: 0;
      transform-origin: -1.55rem 50%;
    }

    .labo-orbit__label-text {
      display: none;
    }

    .labo-orbit__label-index {
      display: block;
      font-size: var(--text-note);
      opacity: 0.72;
    }

    .labo-services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .labo-services__grid {
      row-gap: clamp(2.75rem, 4.5vw, 4rem);
    }

    .labo-philosophy {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

  }

  @media (max-width: 767px) {
    .labo-orbit__label-index {
      font-size: var(--text-note);
    }

    .labo-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .labo-orbits__core {
      width: clamp(5.4rem, 25vw, 6.5rem);
    }

    .labo-orbits__core strong {
      font-size: var(--text-note);
    }

    .labo-philosophy,
    .labo-section-heading,
    .labo-archive__layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }


    .labo-philosophy {
      min-height: auto;
      padding-top: 5rem;
    }

    .labo-philosophy__margin {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .labo-philosophy__scale {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      min-height: 3.25rem;
      background:
        repeating-linear-gradient(to right, var(--color-line) 0 1px, transparent 1px 0.55rem) left bottom 1rem / 100% 0.65rem no-repeat,
        linear-gradient(var(--color-line), var(--color-line)) left bottom 1rem / 100% 1px no-repeat;
    }

    .labo-philosophy__scale::before,
    .labo-philosophy__scale::after {
      bottom: 0.7rem;
      width: 1px;
      height: 1.25rem;
    }

    .labo-philosophy__scale::before {
      top: auto;
      right: auto;
      left: 0;
    }

    .labo-philosophy__scale::after {
      right: 0;
    }

    .labo-philosophy__scale span {
      top: 0;
      right: auto;
      left: 0;
      transform: none;
    }

    .labo-philosophy__marginalia {
      text-align: right;
    }

    .labo-philosophy__folio {
      margin-bottom: 3.5rem;
      font-size: var(--text-note);
    }

    .labo-philosophy__page {
      width: calc(100% - 1.2rem);
      padding-inline-end: 0;
    }

    .labo-philosophy__keywords {
      flex-wrap: wrap;
      justify-content: flex-start;
      margin-top: 5rem;
    }

    .labo-archive__head {
      padding-bottom: 1.5rem;
    }

    .labo-archive__rail {
      grid-column: 1;
    }

    .labo-services__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
      row-gap: 3.5rem;
    }

    .labo-service {
      min-height: auto;
    }

    .labo-service h3 {
      max-width: none;
      min-height: 0;
    }

    /*
      Les plafonds en `ch` étaient pensés pour une colonne large : sur la
      seule colonne mobile, ils laissaient le texte inutilement étroit,
      repliés bien avant le bord de son conteneur.
    */
    .labo-service p {
      max-width: none;
    }

    /*
      Le fer à fer suppose une ligne assez longue pour absorber les blancs :
      sur une colonne mobile, il creuserait des rivières. On revient au fer à
      gauche, et l'alinéa se resserre.
    */
    .labo-team__lead,
    .labo-team__body {
      text-align: left;
    }

    .labo-team__lead,
    .labo-team__body {
      text-indent: 2rem;
    }

    .labo-team__body {
      width: 100%;
      margin-left: 0;
      /* Trop étroit pour couper les mots — même arbitrage que les colonnes. */
      hyphens: none;
    }

    /*
      En colonne, le numéro ne pend plus dans une marge qu'il n'y a pas : il
      passe au-dessus du texte, sur sa propre ligne. Le décrochement aurait
      mangé un dixième de la mesure pour trois caractères.
    */
    .labo-note {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.35rem;
    }

    /*
      Une seule colonne : à cette largeur, deux ne feraient plus que trente
      signes par ligne — la justification y creuserait des trous quoi qu'on
      fasse, et la césure couperait un mot sur deux.
    */
    .labo-note__columns {
      columns: 1;
    }

  }

  /*
    Composition éditoriale de la séquence Vision.

    AUCUN FOND PROPRE : la section se pose à même le papier de la page. Elle
    portait une texture, un lavis coloré et un grain par-dessus le fond du
    site — trois épaisseurs sous un texte long, qui se lisait à travers elles.
    Ce qui doit se voir ici, c'est le texte.
  */
  .labo-philosophy {
    box-sizing: border-box;
    width: auto;
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .labo-philosophy {
    display: block;
    min-height: 0;
    /*
      Garde du haut RÉDUITE. Les Services se referment déjà sur une garde
      généreuse : les deux s'additionnaient, et le repère « [02 — … » se
      retrouvait à plus de 250 px du dernier contenu, contre environ 170 aux
      autres charnières de la page. C'est ce blanc cumulé qu'on rabat, pas
      celui de la section précédente — elle en a besoin pour ses fiches.
    */
    padding-block: clamp(2rem, 3vw, 3rem) clamp(1.5rem, 2.5vw, 2.5rem);
    overflow: clip;
  }

  .labo-philosophy__scale,
  .labo-philosophy__marginalia,
  .labo-philosophy__folio {
    display: none;
  }

  .labo-philosophy__page {
    width: min(100%, 66rem);
    max-width: 100%;
    margin-inline: auto;
  }

  /*
    Le repère de section se cale sur la MARGE DE LA PAGE, pas sur la colonne de
    lecture. Il partageait la boîte centrée de 66 rem : dès que la page est
    plus large, le centrage l'écartait du bord et il ne tombait plus sur la
    même verticale que « [01 — Services] » ou « [03 — L'équipe] ».

    Le bloc de texte, lui, reste centré : c'est le folio qui rejoint la marge,
    pas la colonne qui s'y déplace.
  */
  .labo-philosophy__margin {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  .labo-philosophy__margin {
    display: block;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .labo-philosophy__index {
    white-space: normal;
  }

  .labo-philosophy__page {
    display: block;
    position: relative;
    padding: 0;
  }

  /*
    Le chapeau. Il était composé à près de deux fois le plus grand corps de la
    charte, sur dix-sept signes de large : quatre mots par ligne, une accroche
    d'affiche. Ce que la section annonce, c'est un document de recherche — le
    chapeau descend donc au rapport d'un chapeau de revue, à peine plus d'une
    fois et demie le texte qui le suit.

    Fer à gauche, sur une mesure COURTE qui ne prend pas toute la laize : c'est
    ce qui le détache des deux colonnes en dessous, sans changer ni de fonte ni
    de couleur.
  */
  .labo-philosophy__lead {
    width: min(100%, 40rem);
    max-width: 100%;
    margin: 0;
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-indent: 0;
    text-align: left;
    text-wrap: pretty;
  }

  .labo-philosophy__quote,
  .labo-philosophy__quote-close {
    display: inline;
    position: static;
    margin: 0;
    font-size: 1em;
    line-height: inherit;
  }

  /*
    ┌─ POURQUOI DEUX COLONNES TIENNENT ICI ─────────────────────────────────┐
    │ Composer un texte en colonnes est d'ordinaire déconseillé à l'écran : │
    │ l'écran ne pagine pas. Arrivé au bas de la première colonne, il faut  │
    │ REMONTER chercher le haut de la seconde — un geste que le papier ne   │
    │ demande jamais.                                                       │
    │                                                                       │
    │ L'objection tombe à une condition, et une seule : que le bloc tienne  │
    │ dans la hauteur d'un écran. Le manifeste fait environ deux mille      │
    │ signes ; à cette mesure et à ce corps, les deux colonnes tiennent     │
    │ ensemble sous les yeux, et se lisent alors comme la page imprimée     │
    │ dont elles viennent.                                                  │
    │                                                                       │
    │ ➜ Si le texte s'allonge nettement depuis le Studio, la condition      │
    │   cesse d'être vraie : revenir à UNE colonne plutôt que de faire      │
    │   remonter le lecteur.                                                │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-philosophy__notes {
    display: block;
    columns: 2;
    column-gap: clamp(2rem, 4vw, 3.5rem);
    width: min(100%, 54rem);
    max-width: 100%;
    margin-top: clamp(3rem, 5vw, 5rem);
  }

  /*
    Un seul corps, une seule mesure, une seule fonte pour tout le manifeste.
    Les paragraphes changeaient de largeur et de taille selon un réglage du
    Studio : trois compositions dans un même texte, et l'œil devait retrouver
    à chaque bloc où reprendre sa lecture.
  */
  .labo-philosophy__note {
    width: 100%;
    max-width: none;
    margin: 0;
    font-family: var(--font-copy);
    /* Sous le corps courant : c'est l'appareil du document, pas sa voix. */
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    text-indent: 0;
    /*
      Fer à fer ET césure : les deux vont ensemble. Justifier une colonne
      étroite sans couper les mots ouvre des blancs irréguliers d'une ligne à
      l'autre — le défaut même que la composition en colonnes doit éviter.
    */
    text-align: justify;
    hyphens: auto;
    /* Jamais une ligne seule au pied ou en tête d'une colonne. */
    orphans: 2;
    widows: 2;
  }

  .labo-philosophy__note + .labo-philosophy__note {
    margin-top: 0.85em;
  }

  /*
    ┌─ VARIANTE B — colonne à gauche, chapeau tenu à droite ────────────────┐
    │ Styles de la seconde composition proposée. À supprimer entièrement    │
    │ avec sa section si c'est la première qui l'emporte.                   │
    └───────────────────────────────────────────────────────────────────────┘
  */
  .labo-vision-b {
    box-sizing: border-box;
    width: auto;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-block: clamp(5rem, 8vw, 8rem) clamp(1.5rem, 2.5vw, 2.5rem);
  }

  /* Même marge que les autres repères de section — voir la variante A. */
  .labo-vision-b__head {
    width: 100%;
    max-width: 100%;
    margin: 0 0 clamp(3rem, 5vw, 5rem);
  }

  .labo-vision-b__layout {
    display: grid;
    /*
      La colonne de lecture est la plus étroite des deux : c'est un texte
      suivi au petit corps, il ne doit pas dépasser la mesure confortable.
      Le chapeau, lui, prend la place que sa taille demande.
    */
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    /*
      INDISPENSABLE au maintien du chapeau : sans cela, chaque case de la
      grille s'étire sur toute la hauteur de la rangée, et un élément collant
      n'a plus un pixel de course à l'intérieur de sa case — il ne colle
      jamais. Aligné en haut, il retrouve sa hauteur de contenu, et la
      différence avec la colonne devient sa course.
    */
    align-items: start;
    /*
      TOUTE la largeur de la section, et non la boîte centrée de 66 rem :
      celle-ci laissait une quarantaine de pixels morts de chaque côté, qui
      rentraient la colonne de lecture et décollaient les notions du bord. Les
      deux extrémités tombent maintenant sur la même verticale que le repère
      « [02 — … » à gauche et que le bord de la section à droite.

      C'est le VIDE ENTRE LES DEUX qui tient la composition, pas une marge
      ajoutée autour d'elle : plus les deux blocs sont écartés, plus la colonne
      fixe se lit comme une marge de page et non comme une seconde colonne.
    */
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  /* Une seule colonne, justifiée, exactement au corps de la variante A. */
  .labo-vision-b__note {
    margin: 0;
    font-family: var(--font-copy);
    font-size: clamp(0.875rem, 0.5vw + 0.75rem, 1rem);
    line-height: 1.6;
    letter-spacing: var(--tracking-copy);
    text-align: justify;
    hyphens: auto;
    /*
      L'alinéa marque la reprise, comme dans un livre. Il remplace le blanc
      entre paragraphes : les deux ensemble marqueraient DEUX fois le même
      changement, et hacheraient une colonne qui doit se lire d'un trait.
    */
    text-indent: 2em;
  }


  .labo-vision-b__aside {
    position: sticky;
    /*
      Un tiers d'écran plutôt que le bord haut : le chapeau se tient à hauteur
      de lecture, là où l'œil revient, et non collé sous la barre du menu.
    */
    top: clamp(4rem, 22vh, 11rem);
    grid-column: 2;
    grid-row: 1;
    /*
      Le chapeau et les quatre notions côte à côte. La seconde colonne est en
      `auto` : elle ne prend que la largeur du plus long des quatre mots, et
      tout le reste va au chapeau.
    */
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.25rem, 2.5vw, 2.5rem);
    /*
      Alignés par le HAUT : les notions partent sur la même ligne que la
      première du chapeau. Étirées, elles se centreraient sur sa hauteur et
      flotteraient au milieu de la citation.
    */
    align-items: start;
  }

  .labo-vision-b__lead {
    position: relative;
    margin: 0;
    font-family: var(--font-copy);
    /*
      La citation détachée d'une page de revue, et elle porte seule tout le
      côté droit : elle est donc franchement au-dessus du texte courant. Le
      plafond dépasse le corps des Titres — ici la phrase EST le repère visuel
      de la section, il n'y a pas de titre au-dessus d'elle pour le tenir.
    */
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-titre);
    hyphens: none;
    text-wrap: pretty;
  }

  /*
    Le guillemet ouvrant est sorti dans la marge : la première ligne du chapeau
    s'aligne alors sur le haut de la colonne d'en face, et non en retrait de la
    largeur du signe.
  */
  .labo-vision-b__quote {
    position: absolute;
    top: -0.04em;
    left: -0.46em;
  }

  /*
    Les notions, en pile alignée à droite sous le chapeau. Même dispositif que
    dans la variante A, avec ses propres classes : les deux compositions sont
    faites pour qu'on en supprime une — partager les classes ferait tomber
    l'effet avec la section perdante.
  */
  .labo-vision-b__keywords {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0;
    /*
      La pile démarre au ras de la première ligne du chapeau. Le décalage rend
      ce que la hauteur de ligne des notions prend au-dessus de leurs lettres —
      sans lui, elles partent un cheveu plus bas que la capitale d'en face.
    */
    padding-top: 0.15em;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-transform: lowercase;
  }

  .labo-vision-b__keyword {
    display: inline-flex;
    cursor: default;
  }

  /*
    La fenêtre : haute d'UNE lettre, sur une piste qui en contient deux. Ce
    qui dépasse est coupé — c'est ce rognage qui fait la mécanique.
  */
  .labo-vision-b__letter {
    display: inline-block;
    height: 1.3em;
    overflow: hidden;
  }

  .labo-vision-b__letter-track {
    display: flex;
    flex-direction: column;
    will-change: transform;
    transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    /* Le retard par rang : les lettres roulent l'une après l'autre. */
    transition-delay: calc(var(--letter-index) * 34ms);
  }

  .labo-vision-b__letter-track > span {
    display: block;
    height: 1.3em;
    line-height: 1.3;
  }

  /*
    Au survol seulement, et seulement au pointeur fin : sur un écran tactile
    le survol reste collé après le doigt, et le mot resterait à mi-course.
  */
  @media (hover: hover) and (pointer: fine) {
    .labo-vision-b__keyword:hover .labo-vision-b__letter-track {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-vision-b__letter-track {
      transition: none;
    }

    .labo-vision-b__keyword:hover .labo-vision-b__letter-track {
      transform: none;
    }
  }

  @media (max-width: 1023px) {
    /*
      Sous cette largeur, les deux colonnes se disputent la place : le chapeau
      tombe à trois mots par ligne et la colonne de lecture sous quarante
      signes. On empile — et le chapeau, redevenu un bloc dans le flux, cesse
      de coller : il n'a plus rien à côté de quoi tenir.
    */
    .labo-vision-b__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 3rem);
    }

    .labo-vision-b__aside {
      position: static;
      grid-column: 1;
      grid-row: 1;
    }

    /*
      Empilé, le chapeau reprend toute la largeur : les notions ne peuvent plus
      lui prendre une colonne sans le réduire à trois mots par ligne. Elles
      repassent dessous, toujours calées à droite.
    */
    .labo-vision-b__aside {
      grid-template-columns: minmax(0, 1fr);
    }

    .labo-vision-b__keywords {
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
      padding-top: 0;
    }

    .labo-vision-b__notes {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (max-width: 767px) {
    .labo-vision-b {
      padding-inline: var(--spacing-gutter);
    }

    .labo-vision-b__lead {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }

    /* Même raison qu'en variante A : trop étroit pour justifier et couper. */
    .labo-vision-b__note {
      text-align: left;
      hyphens: none;
      text-indent: 1.25em;
    }
  }

  .labo-philosophy__keywords {
    position: absolute;
    top: 0.35rem;
    right: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    margin: 0;
    font-family: var(--font-titre);
    font-size: var(--text-note);
    font-style: normal;
    line-height: 1.3;
    letter-spacing: var(--tracking-copy);
    text-transform: lowercase;
  }

  .labo-philosophy__keyword {
    display: inline-flex;
    font-style: normal;
  }

  .labo-philosophy__letter,
  .labo-philosophy__letter-track,
  .labo-philosophy__letter-track > span {
    height: 1.3em;
    font-style: normal;
    line-height: 1.3;
  }

  @media (max-width: 767px) {
    .labo-philosophy {
      padding-inline: var(--spacing-gutter);
    }

    .labo-philosophy__lead {
      width: 100%;
      max-width: 100%;
      font-size: clamp(1.25rem, 5.5vw, 1.6rem);
      text-indent: 0;
    }

    /*
      Une seule colonne : à cette largeur, deux ne feraient plus que trente
      signes par ligne — la justification y creuserait des trous quoi qu'on
      fasse, et la césure couperait un mot sur deux.
    */
    .labo-philosophy__notes {
      columns: 1;
      width: 100%;
    }

    .labo-philosophy__note {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      text-align: left;
      hyphens: none;
    }

    .labo-philosophy__keywords {
      position: static;
      align-items: flex-end;
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labo-service,
    .labo-service__number {
      transition: none;
    }

    .labo-service__symbol {
      animation: none;
    }

    .labo-philosophy__letter-track {
      transition: none;
    }

    .labo-philosophy__keyword:hover .labo-philosophy__letter-track {
      transform: none;
    }

    .labo-orbit__label-text,
    .labo-orbit__label-text::before {
      transition: none;
    }

    .labo-orbit__node:hover .labo-orbit__label-text,
    .labo-orbit__node:focus-visible .labo-orbit__label-text {
      transform: none;
    }
  }

  /*
    Entrée des textes de lecture : le bloc entier monte et apparaît d'un coup,
    là où les grandes déclarations se révèlent mot à mot. Deux gestes distincts
    pour deux registres — et surtout, aucun temps d'attente imposé à qui lit :
    le paragraphe arrive entier.
  */
  :global(html.labo-rise-booting) [data-rise]:not([data-rise-ready]) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.labo-rise-booting) [data-rise] {
      opacity: 1;
    }
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const risingBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-rise]:not([data-rise-ready])'),
  );

  if (risingBlocks.length > 0 && !reducedMotion.matches) {
    risingBlocks.forEach((block) => {
      block.dataset.riseReady = '';

      gsap.fromTo(
        block,
        { opacity: 0, y: 22 },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: { trigger: block, start: 'top 88%', once: true },
        },
      );
    });
  }

  /*
    Les positions de déclenchement sont mesurées à l'exécution, avant que les
    fontes soient chargées et avant que le révélateur mot à mot ait redécoupé
    les grandes déclarations — deux choses qui changent la hauteur de tout ce
    qui suit. Sans ce recalcul, chaque bloc s'allumerait à côté de son repère.
  */
  document.fonts?.ready.then(() => ScrollTrigger.refresh());

  document.documentElement.classList.remove('labo-rise-booting');

  document.querySelectorAll<HTMLElement>('[data-labo-orbits]:not([data-orbits-ready])').forEach((system) => {
    system.dataset.orbitsReady = '';

    const motions: Array<{
      revolution: gsap.core.Timeline;
      spin: gsap.core.Timeline;
    }> = [];
    const carriers = system.querySelectorAll<HTMLElement>('[data-orbit-carrier]');

    carriers.forEach((carrier) => {
      const phase = Number(carrier.dataset.phase ?? 0);
      const duration = Number(carrier.dataset.duration ?? 60);
      const direction = Number(carrier.dataset.direction ?? 1);
      const spinDuration = Number(carrier.dataset.spinDuration ?? 180);
      const spinDirection = Number(carrier.dataset.spinDirection ?? -1);
      const orientation = carrier.querySelector<HTMLElement>('[data-orbit-orientation]');
      const spinner = carrier.querySelector<HTMLElement>('[data-orbit-spinner]');
      const spinPhase = (phase * 0.37 * spinDirection) % 360;

      gsap.set(carrier, { rotation: phase, force3D: true });
      if (orientation) gsap.set(orientation, { rotation: -phase, force3D: true });
      if (spinner) gsap.set(spinner, { rotation: spinPhase, force3D: true });

      if (reducedMotion.matches || !orientation || !spinner) return;

      const revolution = gsap.timeline({ paused: true, repeat: -1 });
      revolution.to(carrier, {
        rotation: phase + 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);
      revolution.to(orientation, {
        rotation: -phase - 360 * direction,
        duration,
        ease: 'none',
        force3D: true,
      }, 0);

      const spin = gsap.timeline({ paused: true, repeat: -1 });
      spin.to(spinner, {
        rotation: spinPhase + 360 * spinDirection,
        duration: spinDuration,
        ease: 'none',
        force3D: true,
      });

      motions.push({ revolution, spin });
    });

    if (reducedMotion.matches || motions.length === 0) {
      return;
    }

    /*
      Réponse au scroll. La vitesse du geste devient une impulsion qui s'ajoute
      au régime de croisière des orbites, puis retombe d'elle-même. Les valeurs
      se lisent ensemble : un scroll de trackpad ordinaire tourne autour de
      1200 px/s, soit une impulsion d'environ 3 — les orbites quadruplent leur
      vitesse le temps du geste, et un lancer franc les pousse jusqu'à 8×.
    */
    const SCROLL_SENSITIVITY = 420; // px/s nécessaires pour +1× de vitesse
    const IMPULSE_MIN = -3;
    const IMPULSE_MAX = 7;
    const REVOLUTION_MIN = 0.25; // remonter le scroll fait presque caler l'orbite
    const REVOLUTION_MAX = 8;
    const SPIN_COUPLING = 0.5; // les symboles suivent, à mi-voix
    const SPIN_MIN = 0.4;
    const SPIN_MAX = 4;

    let hoverFactor = 1;
    let scrollImpulse = 0;

    const setHoverFactor = (isHovering: boolean) => {
      hoverFactor = isHovering ? 0.16 : 1;
    };

    system.addEventListener('pointerenter', () => setHoverFactor(true));
    system.addEventListener('pointerleave', () => setHoverFactor(false));

    const scrollTrigger = ScrollTrigger.create({
      trigger: system,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: ({ isActive }) => {
        motions.forEach(({ revolution, spin }) => {
          isActive ? revolution.play() : revolution.pause();
          isActive ? spin.play() : spin.pause();
        });
      },
      onUpdate: (self) => {
        scrollImpulse = gsap.utils.clamp(IMPULSE_MIN, IMPULSE_MAX, self.getVelocity() / SCROLL_SENSITIVITY);
      },
    });

    if (scrollTrigger.isActive) {
      motions.forEach(({ revolution, spin }) => {
        revolution.play();
        spin.play();
      });
    }

    /*
      Trois réglages de temps, calibrés pour une image de 60 Hz. Sur un écran
      120 Hz, les appliquer telles quelles ferait retomber l'élan deux fois plus
      vite et rendrait la poussée du scroll deux fois plus molle : le même geste
      ne donnerait pas le même mouvement d'une machine à l'autre. On les
      convertit donc en fonction du temps réellement écoulé.

      L'élan survit volontairement au geste : il met environ une demi-seconde à
      s'éteindre, et les orbites le rattrapent assez vite pour qu'on voie
      l'accélération arriver. C'est ce décalage — pousser, puis regarder le
      système redescendre tout seul — qui rend l'effet lisible.
    */
    const IMPULSE_DECAY = 0.945; // par image : l'élan garde la moitié de sa force ~200 ms
    const REVOLUTION_CATCH_UP = 0.16;
    const SPIN_CATCH_UP = 0.1;

    const perFrame = (rate: number, frames: number) => 1 - (1 - rate) ** frames;

    const updateMotion = () => {
      const frames = gsap.ticker.deltaRatio(60);
      scrollImpulse *= IMPULSE_DECAY ** frames;
      const revolutionSpeed =
        gsap.utils.clamp(REVOLUTION_MIN, REVOLUTION_MAX, 1 + scrollImpulse) * hoverFactor;
      const spinSpeed =
        gsap.utils.clamp(SPIN_MIN, SPIN_MAX, 1 + scrollImpulse * SPIN_COUPLING) * hoverFactor;

      motions.forEach(({ revolution, spin }) => {
        revolution.timeScale(
          gsap.utils.interpolate(revolution.timeScale(), revolutionSpeed, perFrame(REVOLUTION_CATCH_UP, frames)),
        );
        spin.timeScale(
          gsap.utils.interpolate(spin.timeScale(), spinSpeed, perFrame(SPIN_CATCH_UP, frames)),
        );
      });
    };

    gsap.ticker.add(updateMotion);
  });

</script>
