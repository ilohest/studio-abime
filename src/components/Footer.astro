---
import SmartLink from '~/components/primitives/SmartLink.astro';
import Wordmark from '~/components/brand/Wordmark.astro';
import LocaleSwitcher from '~/components/LocaleSwitcher.astro';

import { localizedPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { SiteContext } from '~/lib/sanity/types';

interface Props {
  locale: Locale;
  site: SiteContext;
  /** L'en-tête ayant disparu, le sélecteur de langue vit désormais ici. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, site, alternates } = Astro.props;

/**
 * Baseline par défaut : sert tant que la phrase n'est pas renseignée dans
 * Sanity (« Textes et SEO » → Général → « Phrase de pied de page »). Dès
 * qu'elle l'est, c'est le contenu du CMS qui s'affiche.
 *
 * Elle reste ici plutôt que d'être seulement une valeur initiale du Studio :
 * un pied de page ne doit jamais paraître amputé parce qu'un champ est vide,
 * ni sur un jeu de données neuf, ni dans une langue qu'on vient d'ouvrir.
 */
const DEFAULT_BASELINE =
  'Créer depuis le fond. Donner forme avec justesse. À la frontière du sensible, du social et du créatif.';

/*
  Crédits de réalisation — hors CMS, ils ne relèvent pas du contenu éditorial.

  Deux mains, deux mentions : la direction artistique appartient au studio, le
  design et le développement à qui les a faits. Seule la seconde porte un lien,
  la première renvoyant au site sur lequel on se trouve déjà.
*/
const CREDIT = { name: 'Isaure', href: 'https://isaure-lohest.com/' };

const t = useTranslations(locale);
const nav = site.localized?.footerNav ?? [];
/*
  Informations légales. Calculées en amont (voir `getLegalLinks`) et non tirées
  du CMS : ces liens sont une obligation, pas un choix éditorial. La liste est
  vide tant qu'aucun texte n'est publié — la ligne disparaît alors entièrement
  plutôt que d'annoncer un pied de page à trous.
*/
const legalLinks = site.legalLinks ?? [];
const social = site.settings?.socialLinks ?? [];
const siteTitle = site.localized?.siteTitle ?? 'Studio Abîme';
const year = new Date().getFullYear();
const homeHref = localizedPath(locale);
const baseline = site.localized?.footerText?.trim() || DEFAULT_BASELINE;
---

<footer>
  <div
    class="relative z-10 grid grid-cols-1 gap-12 px-6 py-14 md:px-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-16"
  >
    {/* ── Colonne de gauche : mention, baseline, liens ─────────────────── */}
    <div class="flex flex-col gap-10">
      <div class="max-w-[68ch]">
        <p class="type-note uppercase">© {year} {siteTitle}</p>

        <p class="type-note mt-1">{baseline}</p>
      </div>

      <div class="type-note flex flex-wrap gap-x-12 gap-y-2">
        {
          nav.length > 0 && (
            <ul class="flex flex-col gap-1">
              {nav.map((item) => (
                <li>
                  <SmartLink link={item} locale={locale} class="link-underline" />
                </li>
              ))}
            </ul>
          )
        }

        {
          social.length > 0 && (
            <ul class="flex flex-col gap-1">
              {social.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="footer-external">
                    <span class="footer-external__label">{item.platform}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <div class="footer-credit">
          {/*
            La direction artistique renvoie à l'accueil : c'est le site du
            studio, il se cite en pointant chez lui. Pas de flèche — on ne
            quitte pas le site.
          */}
          <p>
            <a href={homeHref} class="footer-external">
              <span class="footer-external__label">
                Direction artistique &amp; conception&nbsp;: Studio Abîme
              </span>
            </a>
          </p>
          {/*
            Le lien porte la mention ENTIÈRE, mention de rôle comprise : c'est
            la ligne qui renvoie au portfolio, pas le seul prénom. La flèche
            reste hors du libellé souligné, comme partout ailleurs — c'est un
            signe, pas un mot.
          */}
          <p>
            <a href={CREDIT.href} target="_blank" rel="noopener noreferrer" class="footer-external">
              <span class="footer-external__label">
                Design &amp; développement&nbsp;: {CREDIT.name}
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          </p>
        </div>

        <LocaleSwitcher locale={locale} alternates={alternates} />
      </div>

      {
        legalLinks.length > 0 && (
          <nav class="footer-legal type-note" aria-label={t('legal.title')}>
            <ul class="footer-legal__list">
              {legalLinks.map((item) => (
                <li>
                  <a href={item.href} class="link-underline">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    {/* ── Colonne de droite : la marque, retour à l'accueil ─────────────── */}
    <div class="w-full max-w-[30rem] lg:w-[30rem] lg:justify-self-end">
      {/*
        Le logo porte ici le nom accessible du lien : l'énoncer une seconde fois
        le ferait entendre en double aux lecteurs d'écran.
      */}
      <a href={homeHref} class="block transition-opacity hover:opacity-70">
        <Wordmark class="text-ink" title={`${siteTitle} — retour à l’accueil`} />
      </a>
    </div>
  </div>
</footer>

<style>
  /*
    Liens sortants du pied de page. Ils reprennent le signe de la page Contact :
    une flèche oblique annonce qu'on quitte le site, et seul le libellé porte le
    soulignement — la flèche reste un signe, pas un mot souligné.
  */
  .footer-external {
    display: inline-flex;
    align-items: baseline;
    /* Zone touchable au seuil des 24 px sans grossir le texte, qui n'en fait que 20. */
    min-height: 24px;
    gap: 0.45em;
    text-decoration: none;
  }

  .footer-external__label {
    text-underline-offset: 2px;
  }

  /*
    Deux mentions, deux lignes : la direction artistique et la réalisation ne
    se lisent pas d'une traite. L'écart reprend celui des colonnes de liens
    voisines, pour que les trois blocs battent au même rythme.
  */
  .footer-credit {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /*
    Chaque mention tient sur UNE ligne : coupée en deux, « Direction artistique
    & conception : Studio Abîme » se lit comme deux crédits au lieu d'un. En
    dessous de 768 px la place manque vraiment — le retour à la ligne y
    redevient préférable au débordement.
  */
  @media (min-width: 768px) {
    .footer-credit p {
      white-space: nowrap;
    }
  }

  /*
    Les informations légales forment une ligne à part, sous les autres liens :
    présentes et atteignables, sans concurrencer la navigation éditoriale.
  */
  .footer-legal__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.5em;
    color: var(--color-muted);
  }

  .footer-external:hover .footer-external__label,
  .footer-external:focus-visible .footer-external__label {
    text-decoration: underline;
  }
</style>
