---
import ShopProductGrid from '~/components/ShopProductGrid.astro';

import { shopIndexPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';
import type { Collection } from '~/lib/shopify/types';

/**
 * Page d'une collection — `/shop/collections/{handle}`, comme sur une
 * boutique Shopify classique.
 *
 * Même grille que l'index (`ShopProductGrid`), restreinte aux tirages de cette
 * collection. La description, si elle est renseignée dans Shopify, en tient
 * lieu d'intro — sans texte de repli inventé : une collection sans description
 * n'a besoin que de son titre.
 */
interface Props {
  collection: Collection;
  /**
   * Numéro de classement — « 01 », « 02 »… Le même que sur l'index de la
   * boutique : un repère ne vaut que s'il désigne la même chose partout.
   * `null` quand il n'a pas pu être établi ; le titre paraît alors seul, ce
   * qui vaut mieux qu'un numéro faux.
   */
  folio: string | null;
  locale: Locale;
}

const { collection, folio, locale } = Astro.props;
const t = useTranslations(locale);
const shopHref = shopIndexPath(locale);

/*
  Le numéro est composé DANS la chaîne du titre, et non dans une balise à part.

  Le titre porte `data-text-reveal`, dont le script le découpe mot à mot et
  reconstruit son contenu : toute balise interne y disparaît, avec la marge
  qu'elle portait — « N° 03 » se retrouvait collé au premier mot. Une espace
  ordinaire, elle, est un point de coupe que le script respecte.

  Espace insécable entre « N° » et le chiffre : la cote ne se coupe pas en deux.
*/
const heading = folio ? `N°\u00A0${folio} — ${collection.title}` : collection.title;
---

<div class="collection-page container-wide pt-(--spacing-breadcrumb-start) pb-(--spacing-section)">
  {/*
    Positionné en absolu à partir de 768px, pour que le titre et la description
    tombent exactement là où ils tombent sur `/shop`, qui n'a rien au-dessus
    des siens. En dessous, la barre mobile du menu (logo + bouton) occupe déjà
    ce coin en position fixe : le fil y reste en flux normal, comme partout
    ailleurs sur le site, pour ne pas se superposer à elle.
  */}
  <nav class="breadcrumb collection-page__breadcrumb type-note" aria-label={t('nav.breadcrumb')}>
    <ol role="list">
      <li>
        <a class="link-underline" href={shopHref}>{t('shop.title')}</a>
      </li>
      <li aria-current="page">
        <span class="breadcrumb__separator" aria-hidden="true">/</span>
        <span>{collection.title}</span>
      </li>
    </ol>
  </nav>

  {/*
    Valeurs reprises telles quelles de `.project-index__header` /
    `.project-index__title` / `.project-index__intro` (ShopIndex.astro) : le
    style scopé d'Astro isole chaque composant, un même nom de classe ne
    suffit donc pas à partager la règle. Si une troisième page a besoin du
    même gabarit, ça vaudra un composant commun plutôt qu'une troisième copie.
  */}
  <header class="collection-page__header">
    <h1 class="collection-page__title section-folio-title type-titre text-balance" data-text-reveal>
      {heading}
    </h1>

    {
      collection.descriptionHtml && (
        <div
          class="collection-page__description type-copy text-pretty"
          set:html={collection.descriptionHtml}
        />
      )
    }
  </header>

  {
    collection.products.length === 0 ? (
      <p class="collection-page__empty type-copy">{t('shop.empty')}</p>
    ) : (
      <ShopProductGrid products={collection.products} locale={locale} eagerFirstRow />
    )
  }
</div>

<style>

  /*
    Tout ce qui fait un fil d'Ariane vit dans `.breadcrumb` (global.css). Il ne
    reste ici que son PLACEMENT, qui seul appartient à cette page.

    Flux normal sur mobile — voir le commentaire dans le balisage.
  */
  .collection-page__breadcrumb {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /*
    Même réserve que sur une page de rubrique : le fil ne quitte le flux que
    lorsque la page est assez large pour que le titre centré ne vienne pas se
    poser dessus. Voir `LibraryRubricPage.astro`.
  */
  @media (min-width: 1300px) {
    /*
      Flotte dans le rembourrage haut du conteneur plutôt que de s'insérer
      dans le flux : le header qui suit démarre ainsi au même point que celui
      de `/shop`, qui n'a rien au-dessus de lui.
    */
    .collection-page {
      position: relative;
    }

    .collection-page__breadcrumb {
      position: absolute;
      top: var(--spacing-breadcrumb-start);
      inset-inline-start: 0;
      width: max-content;
      max-width: 100%;
      margin-bottom: 0;
    }
  }

  /* Copié de `.project-index__header` (ShopIndex.astro) — voir la remarque dans le balisage. */
  .collection-page__header {
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }

  /* Copié de `.project-index__title`. */
  .collection-page__title {
    text-align: center;
  }

  /* Copié de `.project-index__intro`. */
  .collection-page__description {
    max-width: 76rem;
    margin-top: clamp(5.5rem, 12vw, 12rem);
    margin-inline: auto;
    text-indent: clamp(7rem, 20vw, 22rem);
  }

  .collection-page__description :global(p) {
    margin: 0 0 0.75em;
  }

  .collection-page__description :global(p:last-child) {
    margin-bottom: 0;
  }

  .collection-page__empty {
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .collection-page__header {
      margin-bottom: 3rem;
    }

    .collection-page__description {
      margin-top: 4rem;
      text-indent: clamp(2.5rem, 20vw, 5rem);
    }
  }
</style>
