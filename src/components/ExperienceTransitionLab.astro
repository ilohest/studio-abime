      display: none;
    }

    /*
      Le recouvrement n'a plus de piste à recouvrir : sans lui, le catalogue
      remonterait d'une hauteur d'écran sur la section précédente.
    */
    .motion-lab__settled {
      margin-top: 0;
    }

    .motion-lab__settled :global(.project-catalog-item) {
      transform: none;
    }
  }
