---
import ProjectGrid from '~/components/ProjectGrid.astro';

import { projectPath } from '~/i18n/routes';
import { projectInitials, type ProjectEditorialCard } from '~/lib/viewModels';
import { buildReferenceSlots, referenceName, referenceSector } from '~/lib/references';
import type { Locale } from '~/i18n/config';
import type { Client, ProjectCard } from '~/lib/sanity/types';

interface Props {
  projects: ProjectCard[];
  locale: Locale;
  editorialCards?: ProjectEditorialCard[];
  /** Clients sans page projet — ils complètent les cases réservées. */
  clients?: Client[];
}

interface ElementCell {
  number: number | string;
  symbol: string;
  row: number;
  column: number;
}

const { projects, locale, editorialCards = [], clients = [] } = Astro.props;

const mainRows: Array<Array<[number | string, string, number]>> = [
  [[1, 'H', 1], [2, 'He', 18]],
  [[3, 'Li', 1], [4, 'Be', 2], [5, 'B', 13], [6, 'C', 14], [7, 'N', 15], [8, 'O', 16], [9, 'F', 17], [10, 'Ne', 18]],
  [[11, 'Na', 1], [12, 'Mg', 2], [13, 'Al', 13], [14, 'Si', 14], [15, 'P', 15], [16, 'S', 16], [17, 'Cl', 17], [18, 'Ar', 18]],
  [[19, 'K', 1], [20, 'Ca', 2], [21, 'Sc', 3], [22, 'Ti', 4], [23, 'V', 5], [24, 'Cr', 6], [25, 'Mn', 7], [26, 'Fe', 8], [27, 'Co', 9], [28, 'Ni', 10], [29, 'Cu', 11], [30, 'Zn', 12], [31, 'Ga', 13], [32, 'Ge', 14], [33, 'As', 15], [34, 'Se', 16], [35, 'Br', 17], [36, 'Kr', 18]],
  [[37, 'Rb', 1], [38, 'Sr', 2], [39, 'Y', 3], [40, 'Zr', 4], [41, 'Nb', 5], [42, 'Mo', 6], [43, 'Tc', 7], [44, 'Ru', 8], [45, 'Rh', 9], [46, 'Pd', 10], [47, 'Ag', 11], [48, 'Cd', 12], [49, 'In', 13], [50, 'Sn', 14], [51, 'Sb', 15], [52, 'Te', 16], [53, 'I', 17], [54, 'Xe', 18]],
  [[55, 'Cs', 1], [56, 'Ba', 2], ['57–71', '—', 3], [72, 'Hf', 4], [73, 'Ta', 5], [74, 'W', 6], [75, 'Re', 7], [76, 'Os', 8], [77, 'Ir', 9], [78, 'Pt', 10], [79, 'Au', 11], [80, 'Hg', 12], [81, 'Tl', 13], [82, 'Pb', 14], [83, 'Bi', 15], [84, 'Po', 16], [85, 'At', 17], [86, 'Rn', 18]],
  [[87, 'Fr', 1], [88, 'Ra', 2], ['89–103', '—', 3], [104, 'Rf', 4], [105, 'Db', 5], [106, 'Sg', 6], [107, 'Bh', 7], [108, 'Hs', 8], [109, 'Mt', 9], [110, 'Ds', 10], [111, 'Rg', 11], [112, 'Cn', 12], [113, 'Nh', 13], [114, 'Fl', 14], [115, 'Mc', 15], [116, 'Lv', 16], [117, 'Ts', 17], [118, 'Og', 18]],
];

const lanthanides = ['La', 'Ce', 'Pr', 'Nd', 'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb', 'Lu'];
const actinides = ['Ac', 'Th', 'Pa', 'U', 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm', 'Md', 'No', 'Lr'];

const elements: ElementCell[] = mainRows.flatMap((row, rowIndex) =>
  row.map(([number, symbol, column]) => ({ number, symbol, row: rowIndex + 1, column })),
);

lanthanides.forEach((symbol, index) => {
  elements.push({ number: 57 + index, symbol, row: 9, column: index + 3 });
});
actinides.forEach((symbol, index) => {
  elements.push({ number: 89 + index, symbol, row: 10, column: index + 3 });
});

const columns = Array.from({ length: 18 }, (_, columnIndex) =>
  elements.filter((element) => element.column === columnIndex + 1),
);
/*
  Les sept cases réservées : projets favoris d'abord, puis clients sans page
  projet. Une case sans référence garde son élément chimique — la table ne
  simule jamais une signature qu'elle n'a pas.
*/
const referenceSlots = buildReferenceSlots(projects, clients);
const slotByAtom = new Map(referenceSlots.map((slot) => [slot.atomicNumber, slot]));

/*
  Un projet rangé dans la table porte le numéro de sa case jusque dans la
  grille : c'est le même objet, vu deux fois. Les autres gardent leur rang
  éditorial, faute de case qui leur corresponde.
*/
const elementNumbers = Object.fromEntries(
  referenceSlots
    .filter((slot) => slot.source.kind === 'project')
    .map((slot) => [(slot.source as { project: ProjectCard }).project._id, slot.atomicNumber]),
);
---

<section
  id="cas-etude"
  class="motion-lab"
  data-experience-motion
  aria-label="Table des éléments et grille d’expériences"
>
  <div class="motion-lab__runway" data-motion-runway>
    <div class="motion-lab__stage" data-motion-stage>
      <div class="motion-lab__meta type-note" aria-hidden="true">
        <span>TABLE DES ÉLÉMENTS</span>
        <span data-motion-state>VUE D’ENSEMBLE</span>
      </div>

      <div class="motion-lab__table-layer" data-table-layer>
        <div class="element-table" aria-label="Table des éléments du Studio Abîme">
          {
            columns.map((column, columnIndex) => (
              <div
                class="element-table__column"
                data-element-column
                data-column-index={columnIndex}
              >
                {Array.from({ length: 10 }, (_, rowIndex) => {
                  if (rowIndex === 7) return <span class="element-table__spacer" aria-hidden="true"></span>;
                  const row = rowIndex + 1;
                  const element = column.find((candidate) => candidate.row === row);
                  if (!element) return <span class="element-table__gap" aria-hidden="true"></span>;

                  const slot = typeof element.number === 'number'
                    ? slotByAtom.get(element.number)
                    : undefined;
                  const reference = slot?.source;
                  const linkedProject = reference?.kind === 'project' ? reference.project : undefined;
                  const name = reference ? referenceName(reference) : undefined;
                  const sector = reference ? referenceSector(reference) : undefined;
                  const client = reference?.kind === 'client' ? reference.client : undefined;
                  const Tag = reference ? 'a' : 'span';

                  return (
                    <Tag
                      class:list={[
                        'element-cell',
                        { 'element-cell--reference': reference, 'element-cell--project': linkedProject },
                      ]}
                      href={
                        linkedProject
                          ? projectPath(locale, linkedProject.slug)
                          : client
                            ? `#reference-${slot!.atomicNumber}`
                            : undefined
                      }
                      aria-label={
                        linkedProject
                          ? `Voir l’expérience ${linkedProject.title}`
                          : client
                            ? `${client.name} — voir la référence`
                            : undefined
                      }
                    >
                      <span class="element-cell__number">{element.number}</span>
                      <strong class="element-cell__symbol">
                        {name ? projectInitials(name) : element.symbol}
                      </strong>
                      <span class="element-cell__name">
                        {sector ?? name ?? (element.symbol === '—' ? 'série' : 'élément')}
                      </span>
                    </Tag>
                  );
                })}
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>

</section>

{/*
  Le catalogue, à sa hauteur propre — aucun plafond, quel que soit le nombre
  de projets à venir.

  Il CHEVAUCHE néanmoins la dernière hauteur d'écran de la piste (marge
  négative, voir la feuille) : sa première page écran occupe donc le même
  ruban de défilement que la scène épinglée, et ses fiches montent pendant
  que la table sort — les deux gestes se croisent, exactement comme du temps
  où la grille était une couche de la scène. Le temps de la montée, la couche
  intérieure est épinglée à l'écran comme l'est la scène ; elle retrouve le
  flux à l'instant où la grille se pose. Les rangées suivantes sont hors
  champ à l'atterrissage : elles gardent leur entrée discrète, jouée à leur
  arrivée à l'écran (voir le script plus bas).
*/}
<div class="motion-lab__settled container-wide" data-settled-catalog>
  <div class="motion-lab__settled-layer" data-settled-layer>
    <ProjectGrid
      projects={projects}
      locale={locale}
      editorialCards={editorialCards}
      elementNumbers={elementNumbers}
    />
  </div>
</div>

<script>
  const clamp = (value: number, min = 0, max = 1) => Math.min(Math.max(value, min), max);
  const range = (value: number, start: number, end: number) => clamp((value - start) / (end - start));
  const ease = (value: number) => value * value * (3 - 2 * value);

  /*
    Une case liée à un projet reste cliquable TANT QU'ELLE EST LISIBLE : ce
    n'est pas le départ de l'animation qui éteint les liens, c'est la sortie de
    chaque colonne. Deux seuils suffisent :
      · TABLE_EXIT_END — instant où la dernière colonne a fini de sortir ;
        au-delà, la couche entière cesse de capter la souris, sans quoi son
        cadre invisible masquerait la grille des projets qui prend le relais.
      · COLUMN_LIVE_OPACITY — en deçà de cette opacité, une colonne est trop
        effacée pour qu'on puisse viser ses cases : elle se retire seule.
  */
  const TABLE_EXIT_END = 0.72;
  const COLUMN_LIVE_OPACITY = 0.4;

  /*
    Montée de la première page écran du catalogue — les valeurs d'origine de
    la grille-couche.

    L'écart entre colonnes (0,30 de la piste) est plus large que celui de la
    table qui se vide (0,26) : la grille se remplit donc en éventail plus
    ouvert que celui par lequel la table s'efface. Son entrée commence tôt,
    pendant que la table sort encore — les deux mouvements se croisent au lieu
    de se succéder. La dernière colonne se pose à 1, à la fin exacte de la
    piste : c'est l'instant où la scène cesse d'être épinglée, et une colonne
    posée plus tôt resterait immobile jusque-là.
  */
  const CARD_TRAVEL_VH = 112;
  const CARD_ENTER_START = 0.18;
  const CARD_ENTER_END = 0.7;
  const CARD_COLUMN_SHIFT = 0.3;

  /*
    Sur écran étroit, l'éventail se referme à DEUX colonnes et la piste est plus
    courte : la table finissait de sortir par le haut alors que les fiches
    étaient encore sous le bord bas, et l'écran restait un moment entièrement
    vide au milieu du geste. Elles partent donc de moins loin et entrent plus
    tôt — les deux mouvements se croisent au lieu de laisser un trou entre eux.
    Le décalage de colonne se resserre d'autant : à deux colonnes, l'éventail
    n'a pas besoin de la même amplitude qu'à quatre.
  */
  const narrowCardMotion = {
    travelVh: 68,
    enterStart: 0.06,
    enterEnd: 0.72,
    columnShift: 0.2,
  };

  /*
    Tant que les fiches volent séparées, elles ne peuvent plus compter sur leur
    voisine pour fermer leur cadre : chacune peint alors ses quatre côtés. Et
    elles ne captent la souris qu'une fois presque posées — sans quoi elles
    voleraient au-dessus de la table en lui prenant ses clics.
  */
  const GRID_SETTLED = 1;
  const GRID_LIVE = 0.78;

  document.querySelectorAll('[data-experience-motion]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.motionReady) return;
    root.dataset.motionReady = 'true';

    const runway = root.querySelector('[data-motion-runway]');
    const tableLayer = root.querySelector('[data-table-layer]');
    const elementColumns = [...root.querySelectorAll('[data-element-column]')];
    const tableLinks = [...root.querySelectorAll('a.element-cell')];
    const stateLabel = root.querySelector('[data-motion-state]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    /*
      Le catalogue vit dans le flux, à sa hauteur propre — mais sa PREMIÈRE
      PAGE ÉCRAN monte pendant que la table sort. Deux choses le permettent :

       · le bloc chevauche la dernière hauteur d'écran de la piste, si bien
         qu'à l'instant où la scène se décolle, sa première rangée est déjà
         en place, en haut de l'écran ;
       · la grille est ÉPINGLÉE le temps de la montée, comme la scène l'est
         elle-même : `position: fixed`, posée à la hauteur exacte où elle
         atterrira. Les fiches n'ont alors que leur propre course à jouer.

      L'épinglage est celui du navigateur, pas une imitation calculée à chaque
      image. Annuler le défilement fiche par fiche — un pixel de transformation
      pour un pixel de page — donnait le même dessin, mais juste à une image
      près seulement : le temps que le fil principal rende la sienne, la page
      avait déjà défilé. Une fiche encore en vol le masquait ; une fiche POSÉE
      — la colonne de droite, qui touche le haut de l'écran bien avant la fin
      et y reste — le montrait crûment. C'est là que la grille tremblait.
      Épinglée pour de bon, il n'y a plus rien à rattraper : le compositeur la
      tient immobile tout seul.

      Le bloc garde sa hauteur mesurée le temps de l'épinglage : sans elle il
      se refermerait sur sa couche sortie du flux, et la page raccourcirait
      d'un coup sous le curseur.
    */
    const settled = document.querySelector<HTMLElement>('[data-settled-catalog]');
    const layer = document.querySelector<HTMLElement>('[data-settled-layer]');
    const catalogItems = settled
      ? [...settled.querySelectorAll<HTMLElement>('.project-catalog-item')]
      : [];

    /*
      Position naturelle d'une fiche dans le bloc : `offsetTop` ignore les
      transformations, la mesure reste donc valable pendant toute la montée.
      Seules s'envolent les fiches de la première page écran — les suivantes
      sont hors champ à l'atterrissage, et gardent l'entrée discrète jouée
      plus bas. Le partage est fait une fois pour toutes : redimensionner la
      fenêtre en cours de route ne le rejoue pas, mais ne peut pas non plus
      confier une même fiche aux deux gestes à la fois.
    */
    const naturalTop = (element: HTMLElement, stop: HTMLElement) => {
      let offset = 0;
      let node: HTMLElement | null = element;
      while (node && node !== stop) {
        offset += node.offsetTop;
        node = node.offsetParent instanceof HTMLElement ? node.offsetParent : null;
      }
      return offset;
    };

    const flightCards = settled
      ? catalogItems.filter((item) => naturalTop(item, settled) < window.innerHeight)
      : [];
    flightCards.forEach((card) => {
      card.dataset.flight = 'true';
    });

    /*
      Les rangées SUIVANTES ne jouent rien. Elles portaient une entrée au
      défilement — chaque colonne remontait de 13 rem en suivant le scroll —,
      et le geste ne s'arrêtait jamais : arrivé à la troisième rangée, on voyait
      encore une ligne se décoller de celle du dessus, et un vide s'ouvrir entre
      les deux. Une grille se pose une fois ; passé la première page écran, elle
      se lit, elle ne se rejoue pas.

      Le décalage initial reste posé en CSS pour que rien ne clignote avant que
      ce script ne tourne. Il est annulé ici, définitivement : ni observateur,
      ni écouteur de défilement, ni position relue à chaque image.
    */
    catalogItems.forEach((item) => {
      if (item.dataset.flight !== 'true') item.style.transform = 'none';
    });

    /*
      Hauteur d'atterrissage de la grille, lue sur la page plutôt que déduite
      de la marge : `100vh` et `window.innerHeight` ne coïncident pas partout
      — les barres d'outils mobiles les séparent — et c'est la COUTURE qui
      compte. Mesurée ainsi, la position épinglée et la position naturelle se
      rejoignent au pixel près à l'instant du décrochage.
    */
    let landingTop = 0;
    let layerLeft = 0;
    let layerWidth = 0;
    let blockHeight = 0;
    let pinned = false;

    const setPinned = (next: boolean) => {
      if (!settled || !layer || next === pinned) return;
      pinned = next;
      if (next) {
        settled.style.height = `${blockHeight}px`;
        layer.style.position = 'fixed';
        layer.style.top = `${landingTop}px`;
        layer.style.left = `${layerLeft}px`;
        layer.style.width = `${layerWidth}px`;
      } else {
        settled.style.height = '';
        layer.style.position = '';
        layer.style.top = '';
        layer.style.left = '';
        layer.style.width = '';
      }
    };

    const measureCatalog = () => {
      if (!settled || !layer || !(runway instanceof HTMLElement)) return;
      const wasPinned = pinned;
      setPinned(false);
      const blockRect = settled.getBoundingClientRect();
      const layerRect = layer.getBoundingClientRect();
      const runwayDocTop = runway.getBoundingClientRect().top + window.scrollY;
      const distance = Math.max(1, runway.offsetHeight - window.innerHeight);
      blockHeight = blockRect.height;
      layerLeft = layerRect.left;
      layerWidth = layerRect.width;
      landingTop = layerRect.top + window.scrollY - (runwayDocTop + distance);
      setPinned(wasPinned);
    };

    /*
      Géométrie figée des cases liées à un projet. `offsetTop` ignore les
      transformations : la position mesurée ici reste donc valable pendant toute
      la sortie, et l'animation n'a jamais à interroger la mise en page — elle ne
      fait que soustraire la distance déjà parcourue par la colonne.
    */
    const linkGeometry = new Map<HTMLElement, { top: number; height: number }>();
    let layerTop = 0;

    const measureLinks = () => {
      layerTop = tableLayer instanceof HTMLElement ? tableLayer.offsetTop : 0;
      tableLinks.forEach((link) => {
        if (link instanceof HTMLElement) {
          linkGeometry.set(link, { top: link.offsetTop, height: link.offsetHeight });
        }
      });
    };

    const renderColumns = (progress: number) => {
      if (tableLayer instanceof HTMLElement) {
        tableLayer.style.transform = 'none';
        tableLayer.style.opacity = '1';
      }

      const totalOutgoing = Math.max(1, elementColumns.length - 1);
      elementColumns.forEach((column, index) => {
        if (!(column instanceof HTMLElement)) return;
        const rightToLeft = (totalOutgoing - index) / totalOutgoing;
        /*
          La première colonne part à 0, c'est-à-dire à l'instant PRÉCIS où la
          scène s'épingle. Le moindre retard se paie d'un temps mort : la page
          cesse de défiler puisque la scène est fixe, et rien n'a encore
          commencé à bouger — c'est là, et nulle part ailleurs, que le geste
          semblait marquer un arrêt.
        */
        const columnProgress = ease(range(progress, rightToLeft * 0.26, 0.41 + rightToLeft * 0.26));
        const opacity = 1 - range(columnProgress, 0.72, 1);
        column.style.transform = `translate3d(0, ${(-118 * columnProgress).toFixed(3)}vh, 0)`;
        column.style.opacity = String(opacity);
        column.dataset.live = String(opacity > COLUMN_LIVE_OPACITY);
        // Distance parcourue vers le haut, en pixels : sert au clavier.
        column.dataset.travel = String(1.18 * window.innerHeight * columnProgress);
      });

      if (flightCards.length === 0) return;

      const columnCount = window.innerWidth >= 1440 ? 4 : window.innerWidth >= 900 ? 3 : 2;
      const totalIncoming = Math.max(1, columnCount - 1);
      const motion =
        columnCount > 2
          ? {
              travelVh: CARD_TRAVEL_VH,
              enterStart: CARD_ENTER_START,
              enterEnd: CARD_ENTER_END,
              columnShift: CARD_COLUMN_SHIFT,
            }
          : narrowCardMotion;

      flightCards.forEach((card, index) => {
        const columnIndex = index % columnCount;
        const rightToLeft = (totalIncoming - columnIndex) / totalIncoming;
        const columnProgress = ease(
          range(
            progress,
            motion.enterStart + rightToLeft * motion.columnShift,
            motion.enterEnd + rightToLeft * motion.columnShift,
          ),
        );
        /*
          Translation seule, sans mise à l'échelle : une fiche réduite se
          décolle de ses voisines et ouvre des jours entre les cases. Elle
          monte donc à sa taille définitive, et la trame reste jointive
          pendant toute la montée.
        */
        const rise = (motion.travelVh / 100) * window.innerHeight * (1 - columnProgress);
        card.style.transform = `translate3d(0, ${rise.toFixed(3)}px, 0)`;
        card.style.opacity = String(range(columnProgress, 0.04, 0.32));
      });
    };

    const update = () => {
      frame = 0;
      if (!(runway instanceof HTMLElement)) return;

      const rect = runway.getBoundingClientRect();
      const distance = Math.max(1, runway.offsetHeight - window.innerHeight);
      const progress = reducedMotion.matches ? 1 : clamp(-rect.top / distance);
      const tableIsInteractive = !reducedMotion.matches && progress < TABLE_EXIT_END;

      renderColumns(progress);

      if (tableLayer instanceof HTMLElement) {
        tableLayer.style.pointerEvents = tableIsInteractive ? 'auto' : 'none';
        tableLayer.setAttribute('aria-hidden', String(!tableIsInteractive));
      }
      // Colonne par colonne : celles encore à l'écran gardent souris et clavier.
      elementColumns.forEach((column) => {
        if (column instanceof HTMLElement) {
          column.style.pointerEvents = column.dataset.live === 'true' ? 'auto' : 'none';
        }
      });
      /*
        Le clavier suit la case, pas la colonne : une case déjà remontée hors du
        cadre ne doit plus recevoir le focus, même si sa colonne est encore
        lisible plus bas.
      */
      tableLinks.forEach((link) => {
        if (!(link instanceof HTMLElement)) return;
        // Case privée de son lien sur écran étroit : elle reste hors du parcours.
        if (link instanceof HTMLAnchorElement && !link.hasAttribute('href')) {
          link.tabIndex = -1;
          return;
        }
        const column = link.closest('[data-element-column]');
        const travel = column instanceof HTMLElement ? Number(column.dataset.travel ?? 0) : 0;
        const geometry = linkGeometry.get(link);
        const onScreen = geometry ? layerTop + geometry.top + geometry.height - travel > 0 : false;
        link.tabIndex = tableIsInteractive && onScreen ? 0 : -1;
      });
      /*
        Épinglée pendant la montée, rendue au flux dès qu'elle est posée. Au-
        dessus de la piste — avant que la scène ne se colle — le bloc reprend
        aussi sa place : autrement la grille resterait plantée à l'écran,
        invisible mais bien là, par-dessus la section précédente.
      */
      setPinned(!reducedMotion.matches && progress > 0 && progress < GRID_SETTLED);

      /*
        La couche épinglée couvre l'écran : tant qu'elle vole, elle ne doit pas
        prendre à la table les clics qui lui reviennent. Le clavier, lui, garde
        sa route — donner le focus à une fiche fait défiler la page jusqu'à sa
        place, donc jusqu'à la grille posée.
      */
      const gridIsLive = reducedMotion.matches || progress > GRID_LIVE;
      if (layer) layer.style.pointerEvents = gridIsLive ? '' : 'none';
      // Cadres complets tant que les fiches ne se touchent pas.
      if (settled) {
        settled.toggleAttribute(
          'data-motion-detached',
          !reducedMotion.matches && progress < GRID_SETTLED,
        );
      }
      if (stateLabel instanceof HTMLElement) {
        stateLabel.textContent = progress < 0.22
          ? 'VUE D’ENSEMBLE'
          : progress < 0.76
            ? 'TRANSFORMATION'
            : 'EXPÉRIENCES';
      }
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const remeasure = () => {
      measureLinks();
      measureCatalog();
      requestUpdate();
    };

    /*
      Descente vers la note de bas de page.

      Le défilement natif « smooth » va vite et sa durée ne se règle pas : on
      mène la course nous-mêmes. Deux pièges, tous deux payés d'un temps mort
      à l'écran :

       · la feuille globale pose `scroll-behavior: smooth` sur la racine, ce qui
         fait de CHAQUE `scrollTo` une animation lissée du navigateur. Notre
         boucle en émettait une par image : le défilement traînait derrière au
         lieu de suivre. Le comportement natif est donc écarté pendant tout le
         geste, et rendu à la fin ;

       · poser le fragment AVANT la descente fait sauter la page à l'arrivée,
         puis revenir. On descend d'abord, et le fragment est posé une fois sur
         place — il ne déplace alors plus rien, et `:target` allume la ligne au
         moment où on y arrive.

      Un geste de l'utilisateur pendant la descente l'interrompt : il reprend la
      main immédiatement, sans être ramené à l'arrivée.
    */
    /*
      Descente vers la note de bas de page.

      Pas de courbe d'accélération classique ici : elle est la plus rapide en
      son MILIEU, c'est-à-dire précisément là où la table devient grille, et le
      passage s'y perdait. Le mouvement garde donc une VITESSE CONSTANTE, lissée
      seulement sur ses deux extrémités — la transformation se lit au même
      rythme du début à la fin, sans temps mort.

      La durée suit la distance plutôt qu'une valeur fixe : un clic donné plus
      bas dans la page, alors que la grille est déjà formée, ne s'étire pas
      inutilement.
    */
    const SCROLL_SPEED = 1350; // pixels par seconde
    const SCROLL_MIN = 340;
    const SCROLL_MAX = 3200;
    const EASE_EDGE = 0.16; // part du trajet consacrée à démarrer, puis à freiner

    /*
      Vitesse constante au centre, rampes aux extrémités. La vitesse de croisière
      compense les deux demi-rampes pour que le trajet fasse exactement 1.
    */
    const easeSteady = (value: number) => {
      const cruise = 1 / (1 - EASE_EDGE);
      if (value < EASE_EDGE) return (cruise * value * value) / (2 * EASE_EDGE);
      if (value > 1 - EASE_EDGE) {
        const remaining = 1 - value;
        return 1 - (cruise * remaining * remaining) / (2 * EASE_EDGE);
      }
      return (cruise * EASE_EDGE) / 2 + cruise * (value - EASE_EDGE);
    };

    root.querySelectorAll<HTMLAnchorElement>('a.element-cell[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const hash = link.getAttribute('href');
        const target = hash ? document.querySelector<HTMLElement>(hash) : null;
        if (!target || event.defaultPrevented || event.metaKey || event.ctrlKey) return;

        /*
          On descend jusqu'à la SECTION, pas jusqu'à la ligne : viser la ligne
          la pose bien à la bonne hauteur, mais fait alors passer le titre de la
          note au-dessus du bord de l'écran, et laisse voir la fin de la section
          précédente. C'est `:target` qui désigne la ligne, le défilement n'a
          pas à s'en charger.
        */
        const landing = target.closest<HTMLElement>('.references') ?? target;
        const from = window.scrollY;
        const margin = Number.parseFloat(getComputedStyle(landing).scrollMarginTop) || 0;
        const limit = document.documentElement.scrollHeight - window.innerHeight;
        const to = clamp(landing.getBoundingClientRect().top + from - margin, 0, limit);

        // Trop court ou mouvement refusé : le saut natif fait déjà l'affaire.
        if (reducedMotion.matches || Math.abs(to - from) < 2) return;

        event.preventDefault();

        const duration = Math.min(
          Math.max((Math.abs(to - from) / SCROLL_SPEED) * 1000, SCROLL_MIN),
          SCROLL_MAX,
        );

        /*
          La feuille globale pose `scroll-behavior: smooth` sur la racine :
          chaque `scrollTo` deviendrait lui-même une animation lissée du
          navigateur, et la boucle en émet une par image. Le comportement natif
          est donc écarté pendant tout le geste, et rendu à la fin.
        */
        const documentElement = document.documentElement;
        const previousBehavior = documentElement.style.scrollBehavior;
        documentElement.style.scrollBehavior = 'auto';

        let cancelled = false;
        const interrupt = () => {
          cancelled = true;
        };
        const events = ['wheel', 'touchstart', 'keydown'] as const;
        events.forEach((name) =>
          window.addEventListener(name, interrupt, { once: true, passive: true }),
        );

        const release = () => {
          documentElement.style.scrollBehavior = previousBehavior;
          events.forEach((name) => window.removeEventListener(name, interrupt));
        };

        const start = performance.now();
        const step = (now: number) => {
          if (cancelled) {
            release();
            return;
          }

          const progressed = clamp((now - start) / duration);
          window.scrollTo(0, from + (to - from) * easeSteady(progressed));

          if (progressed < 1) {
            window.requestAnimationFrame(step);
            return;
          }

          // Arrivés : le fragment ne déplace plus rien, il ne fait qu'allumer.
          window.location.hash = hash!;
          release();
        };

        window.requestAnimationFrame(step);
      });
    });

    /*
      Sur écran étroit, une case de la table mesure 17 px de large : dix-huit
      colonnes tiennent dans 375 px, et aucune mise en page ne rattrapera ça.
      C'est sous le seuil des cibles tactiles, et faute d'un `href` un lien
      n'en est plus un — ni cliquable, ni atteignable au clavier, ni annoncé.

      Rien ne se perd : les projets s'ouvrent depuis la grille juste en dessous,
      et les clients se lisent dans la note de bas de page, en toutes lettres.
      La table redevient ce qu'elle est à cette taille — une planche.
    */
    const narrowScreen = window.matchMedia('(max-width: 767px)');

    const applyCellLinks = () => {
      tableLinks.forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (narrowScreen.matches) {
          const href = link.getAttribute('href');
          if (href) {
            link.dataset.href = href;
            link.removeAttribute('href');
          }
        } else if (link.dataset.href) {
          link.setAttribute('href', link.dataset.href);
          delete link.dataset.href;
        }
      });
    };

    applyCellLinks();
    narrowScreen.addEventListener('change', () => {
      applyCellLinks();
      requestUpdate();
    });

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', remeasure, { passive: true });
    reducedMotion.addEventListener('change', remeasure);
    measureLinks();
    measureCatalog();
    update();
  });
</script>

<style>
  .motion-lab {
    --motion-line: color-mix(in srgb, var(--color-ink) 36%, transparent);
    margin-top: clamp(2.5rem, 6vw, 6rem);
    /*
      Zéro, contrairement au reste du site : la scène est collante et fait une
      hauteur d'écran pile. La moindre marge la décale vers le bas et lui coupe
      ses dernières lignes. Elle réserve elle-même, en interne, la place de
      l'en-tête et de sa ligne de titre.
    */
    scroll-margin-top: 0;
  }

  /*
    Le catalogue complet, une fois la piste franchie. Posé dans le flux
    normal — donc à sa hauteur propre, sans plafond, aussi loin qu'il grandira
    — il utilise la même trame et les mêmes cases que le reste de la page
    (`.project-index`, portée par le conteneur parent) : rien à répéter ici.

    La marge négative lui fait CHEVAUCHER la dernière hauteur d'écran de la
    piste. Deux conséquences, l'une et l'autre voulues :

     · à l'instant où la scène se décolle, la première rangée est exactement
       à la place que la table vient de quitter — sous les repères de la
       scène, dont la grille recouvrait autrement les deux lignes ;
     · la piste et l'entrée de la grille partagent le même ruban de
       défilement, ce qui rend le croisement des deux gestes possible.

    D'où la piste rendue à ses 300 vh d'origine : recouvrement compris, il
    reste 200 vh de défilement épinglé pour la transformation — la mesure
    exacte d'avant.

    Le rang de superposition met les fiches en vol AU-DESSUS de la scène, dont
    le fond est opaque ; il reste sous le rail de menu, fixé bien plus haut.

    La couche intérieure n'a pas de style propre : sa position, sa largeur et
    sa hauteur d'atterrissage sont mesurées puis posées par le script — elles
    dépendent de la piste, que la feuille ne connaît pas. Elle existe pour
    donner au navigateur QUELQUE CHOSE à épingler pendant la montée : une
    grille restée dans le flux ne peut être tenue immobile qu'à la main, image
    par image, et c'est ce qui la faisait trembler.
  */
  .motion-lab__settled {
    position: relative;
    z-index: 1;
    /*
      Le recouvrement s'arrête à la HAUTEUR DE LA TABLE, pas à celle de
      l'écran : la grille se pose là où la table commençait — même retrait que
      `.motion-lab__table-layer` — et laisse au-dessus d'elle la ligne des
      repères, « Table des éléments » et l'état de la scène.
    */
    margin-top: calc(-100vh + clamp(3.4rem, 7vh, 5.25rem));
    padding-block: clamp(0.5rem, 1.5vw, 1.5rem) clamp(4rem, 8vw, 7rem);
  }

  /*
    Position de départ, avant que le script ne prenne le relais : la fiche
    est légèrement basse, mais déjà pleinement visible — seule sa position
    bouge, pas son opacité. Aucune transition CSS ici — c'est le défilement
    lui-même qui pilote la position, image par image, exactement comme les
    colonnes de la table.

    Les fiches de la première page écran, elles, sont reprises dès la première
    image par la piste : elles partent de bien plus bas, et en fondu.
  */
  .motion-lab__settled :global(.project-catalog-item) {
    transform: translate3d(0, 13rem, 0);
  }

  /*
    Seules les fiches reprises par la piste bougent encore une fois la grille
    posée : le navigateur ne réserve une couche que pour celles-là. Les autres
    sont remises à plat par le script, une fois, et n'y touchent plus.
  */
  .motion-lab__settled :global(.project-catalog-item[data-flight='true']) {
    will-change: transform;
  }

  /*
    La grille ne peint qu'un trait entre deux fiches : chacune porte son filet
    de pied et son filet de gauche, la voisine fournit les deux autres.

    En vol, ce sont les COLONNES qui se séparent, jamais les rangées : une
    colonne monte d'un bloc, ses fiches restent jointives les unes au-dessus
    des autres. Les filets horizontaux se suffisent donc à eux-mêmes, et il n'y
    a que le bord DROIT à compléter — là où la voisine de droite, montée plus
    haut, ne fournit plus son filet de gauche.

    Ce filet est peint UN PIXEL EN DEHORS de la fiche, sur la ligne même où
    cette voisine peint le sien : les deux se superposent au lieu de s'accoler,
    et le filet commun reste d'un pixel quand les colonnes se rejoignent.
    Peint à l'intérieur, il en aurait fait deux.

    Les croix de construction, elles, sont centrées sur les sommets : deux
    fiches voisines y posent la même marque au même endroit, sans surépaisseur.
  */
  .motion-lab__settled[data-motion-detached] :global(.project-catalog-item) {
    --project-card-top-right-cross-color: var(--project-card-cross-color);
    --project-card-bottom-left-cross-color: var(--project-card-cross-color);
    --project-card-bottom-right-cross-color: var(--project-card-cross-color);
  }

  .motion-lab__settled[data-motion-detached] :global(.project-catalog-card)::after {
    content: '';
    position: absolute;
    top: 0;
    right: -1px;
    z-index: 1;
    width: 1px;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(
      var(--project-card-line-color),
      var(--project-card-line-color)
    );
  }

  /*
    La dernière colonne, elle, porte déjà son filet de droite : le doubler
    épaissirait le bord extérieur de la grille. Mêmes sélecteurs que la trame
    elle-même, colonne par colonne selon la largeur.
  */
  @media (max-width: 899px) {
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:nth-child(2n) .project-catalog-card)::after,
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:last-child .project-catalog-card)::after {
      content: none;
    }
  }

  @media (min-width: 900px) and (max-width: 1439px) {
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:nth-child(3n) .project-catalog-card)::after,
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:last-child .project-catalog-card)::after {
      content: none;
    }
  }

  @media (min-width: 1440px) {
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:nth-child(4n) .project-catalog-card)::after,
    .motion-lab__settled[data-motion-detached] :global(.project-catalog-item:last-child .project-catalog-card)::after {
      content: none;
    }
  }

  .motion-lab__runway {
    position: relative;
    height: 300vh;
  }

  .motion-lab__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 38rem;
    overflow: hidden;
    background: var(--color-lumiere);
