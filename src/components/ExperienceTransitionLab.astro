  .motion-lab__meta {
    position: absolute;
    inset: 1rem 0 auto;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .motion-lab__table-layer {
    position: absolute;
    inset: clamp(3.4rem, 7vh, 5.25rem) 0 clamp(2.2rem, 5vh, 3.5rem);
    transform-origin: 72% 42%;
    will-change: transform, opacity;
  }

  .element-table {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: repeat(18, minmax(0, 1fr));
    gap: clamp(0.12rem, 0.25vw, 0.3rem);
  }

  .element-table__column {
    display: grid;
    min-width: 0;
    grid-template-rows: repeat(7, minmax(0, 1fr)) 0.34fr repeat(2, minmax(0, 1fr));
    gap: clamp(0.12rem, 0.25vw, 0.3rem);
    will-change: transform, opacity;
  }

  .element-table__gap,
  .element-table__spacer {
    display: block;
  }

  .element-cell {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(0.12rem, 0.3vw, 0.28rem);
    border: 1px solid var(--motion-line);
    color: var(--color-ink);
    font-family: var(--font-titre);
    line-height: 1;
    text-decoration: none;
    overflow: hidden;
  }

  /*
    Le fond ne signale QUE ce qui est cliquable : une case de client, faute de
    page à ouvrir, garde l'apparence d'un élément ordinaire. Elle se distingue
    par son symbole et son secteur, pas par une couleur qui promettrait un lien.
  */
  .element-cell--project {
    border-color: var(--color-ink);
    background: var(--color-ciel);
  }

  .element-cell--reference .element-cell__name {
    text-transform: lowercase;
  }

  /*
    L'inversion complète reste au projet : c'est lui qui ouvre une page. Une
    case de client ne mène qu'à sa ligne dans la note — son survol se contente
    donc d'affermir le cadre et de poser le symbole en pleine encre.
  */
  .element-cell--project:hover,
  .element-cell--project:focus-visible {
    background: var(--color-ink);
    color: var(--color-lumiere);
  }

  a.element-cell--reference:not(.element-cell--project) {
    border-color: var(--motion-line);
    transition: border-color 220ms ease, opacity 220ms ease;
    opacity: 0.82;
  }

  a.element-cell--reference:not(.element-cell--project):hover,
  a.element-cell--reference:not(.element-cell--project):focus-visible {
    border-color: var(--color-ink);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    a.element-cell--reference:not(.element-cell--project) {
      transition: none;
    }
  }

  /*
    La table des éléments compose ses cases à l'échelle de la grille, pas à
    celle du texte courant : les corps y sont sous le plancher de la charte
    parce qu'une case fait quelques dizaines de pixels de côté.
  */
  .element-cell__number {
    font-size: clamp(0.28rem, 0.48vw, 0.52rem);
  }

  .element-cell__symbol {
    align-self: center;
    max-width: 100%;
    font-size: clamp(0.48rem, 1vw, 1.05rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    overflow-wrap: anywhere;
    text-align: center;
    text-transform: uppercase;
  }

  .element-cell__name {
    display: block;
    width: 100%;
    font-size: clamp(0.2rem, 0.34vw, 0.38rem);
    line-height: 1.05;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    /*
      Deux colonnes au lieu de trois : l'éventail se referme, la piste peut
      donc être plus courte. Le recouvrement d'une hauteur d'écran est
      conservé — c'est lui qui pose la grille en haut de l'écran.
    */
    .motion-lab__runway {
      height: 240vh;
    }

    .motion-lab__stage {
      min-height: 32rem;
    }

    .motion-lab__table-layer {
      inset-inline: -10%;
      width: 120%;
    }
  }

  @media (max-width: 560px) {
