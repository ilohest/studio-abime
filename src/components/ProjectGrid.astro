---
import SanityImage from '~/components/primitives/SanityImage.astro';

import { projectPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import {
  insertProjectEditorialCards,
  projectInitials,
  type ProjectEditorialCard,
} from '~/lib/viewModels';
import type { Locale } from '~/i18n/config';
import type { ProjectCard } from '~/lib/sanity/types';

/**
 * Grille de projets — HTML pur, zéro JavaScript envoyé au navigateur.
 *
 * Le catalogue se lit d'un bloc : il n'y a rien à filtrer, donc rien à hydrater.
 */
interface Props {
  projects: ProjectCard[];
  locale: Locale;
  /** Anime le cartouche typographique des projets à son entrée dans le viewport. */
  revealText?: boolean;
  /** Affiche les métadonnées et le résumé sous l’image. */
  showDetails?: boolean;
  /** Cartes éditoriales intercalées dans la grille, à leur rang. */
  editorialCards?: ProjectEditorialCard[];
  /**
   * Numéro de case dans la table des éléments, par identifiant de projet.
   * Une carte ainsi désignée porte le chiffre de sa case plutôt que son rang.
   */
  elementNumbers?: Record<string, number>;
}

const {
  projects,
  locale,
  revealText = false,
  showDetails = true,
  editorialCards = [],
  elementNumbers = {},
} = Astro.props;
const t = useTranslations(locale);

const staticCards = projects.map((project, index) => ({
  kind: 'project' as const,
  key: project._id,
  project,
  index,
  /*
    Orientation du visuel, lue sur l'asset. À largeur égale, une image en
    hauteur occupe bien plus de surface qu'une image en largeur : la fiche la
    pose un cran plus petit (voir `.project-index` dans la feuille globale).
    Sans ratio connu, on la traite comme une image en largeur.
  */
  portrait: (project.thumbnail?.asset?.metadata?.dimensions?.aspectRatio ?? 1) < 1,
  facts: (project.listingFacts ?? [])
    .filter((fact) => fact.label?.trim() && fact.value?.trim())
    .slice(0, 5),
}));
const staticCatalogItems = insertProjectEditorialCards(staticCards, editorialCards);

---

  <ul class="project-catalog-grid">
    {staticCatalogItems.map((entry) => entry.kind === 'editorial' && entry.editorial.kind === 'text' ? (
      <li class="project-catalog-item">
        <div class="project-catalog-card project-catalog-state-card project-catalog-state-quote">
          <p>{entry.editorial.text}</p>
        </div>
      </li>
    ) : entry.kind === 'editorial' ? (
      <li class="project-catalog-item" aria-hidden="true">
        <div class="project-catalog-card project-catalog-spacer">
          <span class="project-catalog-diagonal"></span>
        </div>
      </li>
    ) : (
      <li class="project-catalog-item">
        <a
          href={projectPath(locale, entry.value.project.slug)}
          class:list={[
            'project-catalog-card group',
            { 'project-catalog-card--no-facts': entry.value.facts.length === 0 },
          ]}
        >
          <header class="project-catalog-heading">
            <span
              class="project-catalog-number"
              data-text-reveal={revealText ? '' : undefined}
            >
              {elementNumbers[entry.value.project._id] ??
                String(entry.value.index + 1).padStart(2, '0')}
            </span>
            <span
              class="project-catalog-symbol"
              aria-hidden="true"
            >
              {projectInitials(entry.value.project.title)}
            </span>
            <h3 data-text-reveal={revealText ? '' : undefined}>{entry.value.project.title}</h3>
          </header>

          <div
            class:list={[
              'project-catalog-media',
              { 'project-catalog-media--portrait': entry.value.portrait },
            ]}
          >
            <SanityImage
              image={entry.value.project.thumbnail}
              width={900}
              sizes="(min-width: 1440px) 22vw, (min-width: 900px) 30vw, 50vw"
              alt={entry.value.project.title}
              class="project-catalog-image"
            />
          </div>

          {showDetails && entry.value.facts.length > 0 && (
            <dl class="project-catalog-facts">
              {entry.value.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {showDetails && entry.value.project.excerpt && <p class="project-catalog-copy">{entry.value.project.excerpt}</p>}
          <span class="sr-only">{t('projects.viewProject')}</span>
        </a>
      </li>
    ))}

    {projects.length === 0 && (
      <Fragment>
        <li class="project-catalog-item">
          <div class="project-catalog-card project-catalog-empty project-catalog-state-card" role="status">
            <span class="project-catalog-number">[01]</span>
            <p>{t('projects.empty')}</p>
          </div>
        </li>

        <li class="project-catalog-item" aria-hidden="true">
          <div class="project-catalog-card project-catalog-spacer project-catalog-state-card">
            <span class="project-catalog-number">[02]</span>
            <span class="project-catalog-diagonal"></span>
          </div>
        </li>

        <li class="project-catalog-item" aria-hidden="true">
          <div class="project-catalog-card project-catalog-state-card project-catalog-state-image-card">
            <span class="project-catalog-number">[03]</span>
            <div class="project-catalog-state-media">
              <img
                src="/media/studio-abime-fond-irise.jpg"
                width="1240"
                height="2048"
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </li>

        <li class="project-catalog-item">
          <div class="project-catalog-card project-catalog-state-card project-catalog-state-quote">
            <span class="project-catalog-number">[04]</span>
            <p>
              Communicare : mettre en commun. Relier. C’est le geste le plus ancien, celui qui nous a
              faits humains. À force de tout diffuser, en a-t-on oublié le sens ?
            </p>
          </div>
        </li>
      </Fragment>
    )}
  </ul>
