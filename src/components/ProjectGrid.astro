---
import ProjectExplorer from '~/components/vue/ProjectExplorer.vue';
import SanityImage from '~/components/primitives/SanityImage.astro';

import { projectPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import {
  getProjectSpacerPositions,
  insertProjectNotes,
  toCategoryViews,
  toProjectCardView,
  type ProjectNote,
} from '~/lib/viewModels';
import type { Locale } from '~/i18n/config';
import type { CategorySummary, ProjectCard } from '~/lib/sanity/types';

/**
 * Grille de projets — point de bascule entre rendu statique et interactif.
 *
 * `showFilters: false` → HTML pur, zéro JavaScript envoyé au navigateur.
 * `showFilters: true`  → composant Vue hydraté en `client:visible`.
 *
 * Le coût en JavaScript est ainsi payé uniquement là où l'interaction existe,
 * ce qui est tout l'intérêt de l'architecture en îlots d'Astro.
 */
interface Props {
  projects: ProjectCard[];
  categories: CategorySummary[];
  locale: Locale;
  showFilters?: boolean;
  /** Cartes de texte intercalées dans la grille, à leur rang. */
  notes?: ProjectNote[];
}

const { projects, categories, locale, showFilters = false, notes = [] } = Astro.props;
const t = useTranslations(locale);

const projectViews = projects.map((project, index) => toProjectCardView(project, locale, index));
const categoryViews = toCategoryViews(categories, projectViews);
const spacerPositions = new Set(getProjectSpacerPositions(projects.map((project) => project._id)));
const staticCards = projects.map((project, index) => ({
  kind: 'project' as const,
  key: project._id,
  project,
  index,
  facts: (project.listingFacts ?? [])
    .filter((fact) => fact.label?.trim() && fact.value?.trim())
    .slice(0, 5),
}));
const staticCatalogItems = insertProjectNotes(
  staticCards.flatMap((card, index) => [
    card,
    ...(spacerPositions.has(index)
      ? [{ kind: 'spacer' as const, key: `spacer-${card.project._id}` }]
      : []),
  ]),
  notes,
);

// Les filtres n'ont d'intérêt que s'il existe plusieurs catégories à départager.
const useExplorer = showFilters && categoryViews.length > 1;
---

{
  useExplorer ? (
    <ProjectExplorer
      client:visible
      projects={projectViews}
      categories={categoryViews}
      notes={notes}
      queryParam="filtre"
      labels={{
        all: t('projects.all'),
        filterBy: t('projects.filterBy'),
        empty: t('projects.empty'),
        count: t('projects.count'),
        viewProject: t('projects.viewProject'),
      }}
    />
  ) : (
    <ul class="project-catalog-grid">
      {staticCatalogItems.map((entry) => entry.kind === 'note' ? (
        <li class="project-catalog-item">
          <div class="project-catalog-card project-catalog-state-card project-catalog-state-quote">
            <p>{entry.note.text}</p>
          </div>
        </li>
      ) : entry.value.kind === 'spacer' ? (
        <li class="project-catalog-item" aria-hidden="true">
          <div class="project-catalog-card project-catalog-spacer">
            <span class="project-catalog-diagonal"></span>
          </div>
        </li>
      ) : (
        <li class="project-catalog-item">
          <a href={projectPath(locale, entry.value.project.slug)} class="project-catalog-card group">
            <header class="project-catalog-heading">
              <span class="project-catalog-number">[{String(entry.value.index + 1).padStart(2, '0')}]</span>
              <h3>{entry.value.project.title}</h3>
            </header>

            <div class="project-catalog-media">
              <SanityImage
                image={entry.value.project.thumbnail?.asset ? entry.value.project.thumbnail : entry.value.project.coverImage}
                width={900}
                ratio="portrait"
                sizes="(min-width: 1440px) 22vw, (min-width: 900px) 30vw, 50vw"
                alt={entry.value.project.title}
                class="project-catalog-image"
              />
            </div>

            {entry.value.facts.length > 0 && (
              <dl class="project-catalog-facts">
                {entry.value.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {entry.value.project.excerpt && <p class="project-catalog-copy">{entry.value.project.excerpt}</p>}
            <span class="sr-only">{t('projects.viewProject')}</span>
          </a>
        </li>
      ))}

      {projects.length === 0 && (
        <Fragment>
          <li class="project-catalog-item">
            <div class="project-catalog-card project-catalog-empty project-catalog-state-card" role="status">
              <span class="project-catalog-number">[01]</span>
              <p>{t('projects.empty')}</p>
            </div>
          </li>

          <li class="project-catalog-item" aria-hidden="true">
            <div class="project-catalog-card project-catalog-spacer project-catalog-state-card">
              <span class="project-catalog-number">[02]</span>
              <span class="project-catalog-diagonal"></span>
            </div>
          </li>

          <li class="project-catalog-item" aria-hidden="true">
            <div class="project-catalog-card project-catalog-state-card project-catalog-state-image-card">
              <span class="project-catalog-number">[03]</span>
              <div class="project-catalog-state-media">
                <img
                  src="/media/studio-abime-fond-irise.jpg"
                  width="1240"
                  height="2048"
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </li>

          <li class="project-catalog-item">
            <div class="project-catalog-card project-catalog-state-card project-catalog-state-quote">
              <span class="project-catalog-number">[04]</span>
              <p>
                Communicare : mettre en commun. Relier. C’est le geste le plus ancien, celui qui nous a
                faits humains. À force de tout diffuser, en a-t-on oublié le sens ?
              </p>
            </div>
          </li>
        </Fragment>
      )}
    </ul>
  )
}
