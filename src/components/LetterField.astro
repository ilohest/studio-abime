---
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';

/**
 * LE CHAMP AIMANTÉ — la phrase du studio se recompose sous le curseur.
 *
 * ┌─ Le geste ──────────────────────────────────────────────────────────────┐
 * │ Une grille répète un seul mot : VISIBLE, une lettre par colonne, autant  │
 * │ de rangées que la planche en accepte. Chaque lettre se comporte comme    │
 * │ une aiguille aimantée : elle se tourne pour se tenir DEBOUT SUR le       │
 * │ pointeur, comme si celui-ci faisait gravité. Le curseur, lui, porte les  │
 * │ mots « sous le » — la primitive de curseur du site sait déjà porter un   │
 * │ mot (voir `CustomCursor.astro`). Partout où la main se pose, la phrase   │
 * │ du studio se reforme : « sous le visible ».                              │
 * │                                                                          │
 * │ La planche vient juste après le bouton « Plonger sous le visible » : le  │
 * │ bouton l'énonce, le champ le fait faire.                                 │
 * └─────────────────────────────────────────────────────────────────────────┘
 *
 * ── LES MOTS SONT FIXÉS EN CODE ────────────────────────────────────────────
 *
 * Comme le libellé du bouton qui précède, le mot du champ et celui du curseur
 * ne sont pas des champs Sanity : ils ne se remplissent pas, ils SE LISENT
 * ENSEMBLE. Un mot d'une autre longueur ne donnerait pas une variante mais une
 * autre composition — le nombre de colonnes, donc le corps des lettres et la
 * hauteur de la planche, se déduisent de lui. Ils vivent avec les autres
 * textes d'interface traduits, dans `src/i18n/ui.ts`.
 *
 * ── DEUX COMPOSITIONS, UN SEUL PROPOS ──────────────────────────────────────
 *
 *  · AU CURSEUR — la planche est un carré, plafonnée par la hauteur d'écran.
 *    La main explore latéralement ; le mot « sous le » lui tient lieu de
 *    pointeur, et la phrase se recompose là où elle se pose.
 *
 *  · AU DOIGT — il n'y a pas de survol, et un téléphone ne s'explore pas de
 *    côté : il se DESCEND. La planche s'y poursuit donc bien au-delà de
 *    l'écran (rangées de réserve), et l'aimant devient un point fixe au
 *    milieu de la vue, qui porte le mot. C'est le DÉFILEMENT qui fait
 *    traverser la phrase au champ : les rangées se retournent une à une au
 *    passage, et « sous le visible » se forme sans qu'on ait rien à toucher.
 *    Un doigt posé reprend la main, le temps du glissement.
 *
 *    Ce n'est pas la version réduite du geste au curseur : c'est le même
 *    propos — plonger — dit avec le geste natif de l'appareil.
 *
 * ── RIEN NE S'ANNONCE ──────────────────────────────────────────────────────
 *
 * Ni filet d'encadrement, ni invitation écrite : la planche n'a pas de bord et
 * ne demande rien. Le mot répété se tient seul comme une composition, et la
 * bascule se découvre en passant. Ce n'est pas une commande — rien n'est perdu
 * à ne jamais y poser la main.
 *
 * ── CE QUI TIENT SANS JAVASCRIPT ───────────────────────────────────────────
 *
 * Au repos, toutes les lettres sont droites : la planche est un champ
 * typographique lisible, et chaque rangée y énonce le mot. Le script ne fait
 * qu'AJOUTER l'orientation. Sans lui — script en échec, mouvement réduit,
 * écran tactile immobile — il ne manque rien à comprendre.
 */
interface Props {
  locale: Locale;
  /**
   * Rangées de la planche. AUTANT QUE DE LETTRES, par défaut : la planche est
   * alors un carré de mots — le mot se lit dans les deux sens de lecture, et
   * la main atteint toujours une rangée, où qu'elle se pose.
   */
  rows?: number;
  class?: string;
}

const { locale, rows, class: className } = Astro.props;
const t = useTranslations(locale);

/*
  `Array.from` et non un `split('')` : une lettre accentuée écrite en deux
  points de code (le Î d'ABÎME, par exemple) resterait entière ici, là où un
  découpage naïf la couperait en deux cases.
*/
const letters = Array.from(t('home.fieldWord').toLocaleUpperCase(locale));
const rowCount = rows ?? letters.length;

/*
  ┌─ LES RANGÉES DE RÉSERVE ──────────────────────────────────────────────────┐
  │ Au doigt, la planche doit être PLUS HAUTE QUE L'ÉCRAN : sans cela, le      │
  │ point fixe la traverserait en un seul geste de pouce et la phrase          │
  │ n'aurait pas le temps de se former. Ces rangées supplémentaires sont       │
  │ rendues pour tout le monde et masquées là où il y a un curseur — une       │
  │ requête de média ne peut pas ajouter du contenu, seulement en retirer.     │
  │                                                                            │
  │ Elles ne coûtent rien d'autre que leur balisage : masquées, elles n'ont    │
  │ plus de boîte, et le script les ignore à la mesure.                        │
  └────────────────────────────────────────────────────────────────────────────┘
*/
const TOUCH_ROWS = 18;
const rowIndexes = Array.from(
  { length: Math.max(rowCount, TOUCH_ROWS) },
  (_, index) => index,
);

/*
  Le corps des lettres se déduit du nombre de colonnes, en pour-cent de la
  LARGEUR DE LA PLANCHE (`cqi`) : la composition garde exactement les mêmes
  proportions du téléphone au grand écran, et un mot plus long donne
  mécaniquement des lettres plus petites plutôt qu'une planche qui déborde.

  Le calcul est fait ici plutôt qu'en CSS pour ne pas diviser par une variable
  personnalisée dans un `calc()`.
*/
const glyphSize = ((100 / letters.length) * 0.72).toFixed(3);

/*
  ┌─ LA PLANCHE NE DÉPASSE JAMAIS L'ÉCRAN ────────────────────────────────────┐
  │ Sa hauteur se déduit de sa largeur : autant de rangées que de colonnes,    │
  │ chaque case étant plus large que haute (4/3). Sur un grand écran, la       │
  │ largeur disponible donnait donc une planche plus haute que la fenêtre —    │
  │ on ne pouvait plus voir converger tout le champ d'un seul regard, ce qui   │
  │ est précisément ce que le geste raconte.                                   │
  │                                                                             │
  │ La largeur est donc PLAFONNÉE par la hauteur d'écran : on donne ici le      │
  │ facteur qui convertit l'une en l'autre (largeur = hauteur × ce facteur),    │
  │ pour n'avoir à diviser par rien dans la feuille de style. Au-delà, la       │
  │ planche cesse de grandir et les lettres avec elle.                          │
  └─────────────────────────────────────────────────────────────────────────────┘
*/
const CELL_RATIO = 1; // hauteur d'une case rapportée à sa largeur — carrée
const plateSpan = (letters.length / (rowCount * CELL_RATIO)).toFixed(4);
---

{/*
  ┌─ LA BANDE ENTIÈRE EST SENSIBLE ─────────────────────────────────────────┐
  │ La planche est plafonnée par la hauteur d'écran : sur un grand écran,    │
  │ elle est plus étroite que la colonne, et il reste du blanc de part et    │
  │ d'autre. Ce blanc FAIT PARTIE du champ — une main qui passe à côté des   │
  │ lettres est quand même quelque part, et les lettres doivent la suivre.   │
  │                                                                          │
  │ L'écoute, le mot porté par le curseur et l'effacement du pointeur        │
  │ système sont donc posés ici, sur toute la largeur, et non sur la seule   │
  │ grille de lettres.                                                       │
  └──────────────────────────────────────────────────────────────────────────┘
*/}
<figure
  class:list={['letter-field', className]}
  data-letter-field
  data-cursor-label={t('home.fieldCursor')}
  data-cursor-bare
>
  {/*
    La planche est un DESSIN : elle est retirée de l'arbre d'accessibilité et
    c'est la légende, juste dessous, qui en dit le propos. Une grille de
    trente-cinq lettres épelée une à une n'apprendrait rien à personne.

    `data-cursor-label` est ce qui met le mot dans le curseur : l'attribut est
    porté par la planche entière, et le compagnon de curseur le trouve depuis
    n'importe quelle lettre survolée (`closest`).
  */}
  <div
    class="letter-field__plate"
    aria-hidden="true"
    style={`--cols: ${letters.length}; --glyph-size: ${glyphSize}cqi; --plate-span: ${plateSpan};`}
  >
    {rowIndexes.map((row) =>
      letters.map((letter) => (
        <span
          class:list={['letter-field__cell', row >= rowCount && 'letter-field__cell--reserve']}
          style={`--row: ${row};`}
        >
          <span class="letter-field__glyph">{letter}</span>
        </span>
      )),
    )}
  </div>

  {/*
    Le mot du doigt. Au curseur, c'est le compagnon qui le porte et ce
    marqueur n'existe pas ; au doigt, il se pose au milieu de la vue et
    descend avec le défilement — ou saute sous le doigt qui glisse, décalé
    vers le haut pour ne pas disparaître sous la main.

    Il naît masqué : sans script, aucun mot ne flotte au milieu des lettres.
  */}
  <p class="letter-field__anchor" aria-hidden="true" hidden>{t('home.fieldCursor')}</p>

  <figcaption class="sr-only">{t('home.fieldDescription')}</figcaption>
</figure>

<style>
  .letter-field {
    position: relative;
    margin: 0;
    /*
      La bande déborde un peu la planche, en haut comme en bas : la main est
      « dans le champ » avant d'être dans les lettres, et le mot s'allume à
      l'approche plutôt qu'au contact. Assez pour sentir la marge, trop peu
      pour attraper le pointeur qui ne fait que passer vers la suite.
    */
    padding-block: clamp(1rem, 3.5vh, 2.5rem);
    /*
      Les lettres SONT du texte : le pointeur y prenait la forme du curseur
      de sélection, et un glissement surlignait la planche au lieu de
      l'orienter. Ici, la lettre est un objet dessiné, pas un mot à copier —
      rien ne se sélectionne.
    */
    user-select: none;
    -webkit-user-select: none;
    cursor: default;
  }

  /*
    Le compagnon de curseur est en service : sur la bande, c'est le mot
    « sous le » qui tient lieu de pointeur (`data-cursor-bare`), et le curseur
    système s'efface pour lui laisser la place. Sans compagnon — script en
    échec, pointeur grossier — la règle ne s'applique pas et la flèche reste.
  */
  :global(html.has-cursor) .letter-field {
    cursor: none;
  }

  .letter-field__plate {
    /*
      Le conteneur de requête, c'est la PLANCHE elle-même : les `cqi` du corps
      des lettres mesurent sa largeur réelle — celle qui reste après le
      plafond de hauteur ci-dessous — et non l'espace disponible autour. Les
      lettres suivent donc la planche quand elle se resserre.
    */
    container-type: inline-size;
    /* Plafonnée, la planche devient plus étroite que la colonne : on la centre. */
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }

  /*
    La case est CARRÉE : d'une lettre à l'autre, l'écart est le même en
    hauteur et en largeur. C'est ce qui fait qu'une lettre couchée ne paraît
    ni plus serrée ni plus lâche qu'une lettre droite — le champ tourne sans
    que sa trame bouge. Le corps des lettres vaut 72 % de la case ; au-delà,
    deux lettres en diagonale finiraient par se rencontrer.
  */
  .letter-field__cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .letter-field__glyph {
    display: block;
    font-family: var(--font-titre);
    font-size: clamp(1.5rem, var(--glyph-size), 7.5rem);
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-ink);
    /*
      L'angle est posé par le script, en degrés, SANS ramener la valeur dans
      un tour : une lettre qui passe de 179° à 181° doit continuer sa rotation,
      pas revenir en arrière sur presque un tour complet.
    */
    transform: rotate(var(--angle, 0deg));
    transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
    /*
      Un retard par rangée : la planche ne bascule pas d'un bloc, elle se
      retourne en vague, du haut vers le bas. Quatre-vingts millisecondes au
      plus — au-delà, le champ traîne derrière la main.
    */
    transition-delay: calc(min(var(--row), 6) * 16ms);
  }

  /*
    ┌─ CE QUI DISTINGUE LES DEUX COMPOSITIONS ──────────────────────────────┐
    │ Un seul basculement, sur la PRÉSENCE D'UN CURSEUR — pas sur la largeur │
    │ de l'écran : c'est le geste disponible qui décide de la forme, et une  │
    │ tablette en paysage doit avoir la planche du doigt, pas celle de la    │
    │ souris.                                                                │
    │                                                                        │
    │ Au curseur : la planche est plafonnée par la hauteur d'écran et les    │
    │ rangées de réserve disparaissent — un carré qu'on embrasse d'un        │
    │ regard. Au doigt : elle garde toute sa hauteur et déborde la vue.      │
    └────────────────────────────────────────────────────────────────────────┘
  */
  @media (pointer: fine) {
    .letter-field__plate {
      max-width: min(100%, calc(76svh * var(--plate-span)));
    }

    .letter-field__cell--reserve {
      display: none;
    }

    .letter-field__anchor {
      display: none;
    }
  }

  /* ── Le mot du doigt ──────────────────────────────────────────────────── */
  .letter-field__anchor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    margin: 0;
    /* Posé par le script, en pixels, dans le repère de la bande. */
    transform: translate(calc(var(--anchor-x, 50%) - 50%), calc(var(--anchor-y, 50%) - 50%));
    font-family: var(--font-annotation);
    font-style: italic;
    font-size: var(--text-annotation);
    line-height: 1;
    letter-spacing: var(--tracking-annotation);
    color: var(--color-ink);
    white-space: nowrap;
    /* Le mot ne prend jamais le geste : il le commente. */
    pointer-events: none;
    text-shadow:
      0 0 0.4em var(--color-surface),
      0 0 0.9em var(--color-surface);
  }

  .letter-field__anchor[hidden] {
    display: none;
  }

  /* Le même halo rond que porte le curseur : le mot se détache des lettres. */
  .letter-field__anchor::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: 6.5em;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      var(--color-surface) 26%,
      color-mix(in srgb, var(--color-surface) 62%, transparent) 52%,
      color-mix(in srgb, var(--color-surface) 20%, transparent) 78%,
      color-mix(in srgb, var(--color-surface) 0%, transparent) 100%
    );
  }

  /*
    Mouvement réduit : la planche reste droite et lisible, et le script ne
    pose jamais d'angle (voir plus bas). La transition est retirée ici pour
    que même un angle hérité d'avant le changement de préférence retombe net.
  */
  @media (prefers-reduced-motion: reduce) {
    .letter-field__glyph {
      transform: none;
      transition: none;
    }

    /* Rien ne suit le défilement : le marqueur n'aurait plus de sens. */
    .letter-field__anchor {
      display: none;
    }
  }
</style>

<script>
  /*
    ┌─ L'AIMANT ────────────────────────────────────────────────────────────┐
    │ Chaque lettre reçoit l'angle qui met SON BAS face au point visé. Une   │
    │ lettre posée juste au-dessus est donc droite ; une lettre posée en     │
    │ dessous est retournée ; sur les côtés, elle se couche. Le champ entier │
    │ converge visuellement vers un seul point.                              │
    │                                                                        │
    │ Ce point a deux origines selon le geste disponible :                   │
    │   · au curseur — la position de la main, tant qu'elle est dans la      │
    │     bande ; à la sortie, le champ se redresse et le mot redevient      │
    │     lisible d'un bout à l'autre de chaque rangée ;                     │
    │   · au doigt — le MILIEU DE LA VUE, que le défilement fait descendre   │
    │     à travers la planche. Un doigt posé reprend la main le temps du    │
    │     glissement, puis rend le point au défilement.                      │
    └───────────────────────────────────────────────────────────────────────┘
  */
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const coarse = window.matchMedia('(pointer: coarse)');

  /* De combien le mot remonte au-dessus du doigt, pour rester visible. */
  const FINGER_LIFT = 44;

  for (const field of document.querySelectorAll<HTMLElement>('[data-letter-field]')) {
    const plate = field.querySelector<HTMLElement>('.letter-field__plate');
    if (!plate) continue;

    const anchor = field.querySelector<HTMLElement>('.letter-field__anchor');
    const cells = Array.from(plate.querySelectorAll<HTMLElement>('.letter-field__cell'));
    const glyphs = cells.map((cell) => cell.querySelector<HTMLElement>('.letter-field__glyph'));

    /*
      Les centres sont mesurés sur les CASES, jamais sur les lettres : une
      lettre déjà tournée n'a plus le même rectangle englobant, et la planche
      se mettrait à viser de travers dès le premier mouvement.

      Ils sont relatifs à la planche, donc insensibles au défilement : une
      seule mesure tient tant que la mise en page ne change pas. Une case sans
      boîte — les rangées de réserve, masquées au curseur — vaut `null` et
      sort du calcul.
    */
    let centers: ({ x: number; y: number } | null)[] = [];

    const measure = () => {
      const plateBox = plate.getBoundingClientRect();
      centers = cells.map((cell) => {
        const box = cell.getBoundingClientRect();
        if (!box.width) return null;
        return {
          x: box.left - plateBox.left + box.width / 2,
          y: box.top - plateBox.top + box.height / 2,
        };
      });
    };

    /* Dernier angle POSÉ, cumulé — voir le chemin le plus court plus bas. */
    const angles = new Float64Array(cells.length);
    let pointer: { x: number; y: number } | null = null;
    let frame = 0;
    /* Un doigt est posé : il l'emporte sur le défilement, le temps du geste. */
    let touching = false;
    /* La bande est à l'écran : sinon, le défilement n'a rien à piloter. */
    let onScreen = false;

    const settle = () => {
      frame = 0;
      if (!centers.length) return;

      for (let index = 0; index < glyphs.length; index += 1) {
        const glyph = glyphs[index];
        const center = centers[index];
        if (!glyph || !center) continue;

        let target = 0;

        if (pointer) {
          const dx = pointer.x - center.x;
          const dy = pointer.y - center.y;

          /*
            Le bas de la lettre — le vecteur (0, 1) de son repère — doit
            pointer vers le point visé. Une rotation d'angle a l'envoie sur
            (-sin a, cos a) : l'angle cherché est donc atan2(-dx, dy).
          */
          target = (Math.atan2(-dx, dy) * 180) / Math.PI;
        }

        /*
          On ramène la consigne dans le tour le plus proche de l'angle déjà
          posé. Sans cela, le passage de +179° à -179° ferait faire à la lettre
          un tour complet à l'envers, et la vague se briserait à chaque
          traversée de l'axe.
        */
        const next = target + Math.round((angles[index] - target) / 360) * 360;
        angles[index] = next;
        glyph.style.setProperty('--angle', `${next.toFixed(1)}deg`);
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(settle);
    };

    /*
      Le mot du doigt se place dans le repère de la BANDE — c'est son parent
      de positionnement — alors que le point visé est exprimé dans celui de la
      planche. Hors de la bande, il n'est pas dessiné : un mot ne flotte pas
      au milieu de la section suivante.
    */
    const placeAnchor = (plateBox: DOMRect, point: { x: number; y: number }, lift: number) => {
      if (!anchor) return;

      const fieldBox = field.getBoundingClientRect();
      const x = plateBox.left - fieldBox.left + point.x;
      const y = plateBox.top - fieldBox.top + point.y - lift;

      if (y < 0 || y > fieldBox.height) {
        anchor.hidden = true;
        return;
      }

      anchor.style.setProperty('--anchor-x', `${x.toFixed(1)}px`);
      anchor.style.setProperty('--anchor-y', `${y.toFixed(1)}px`);
      anchor.hidden = false;
    };

    const hideAnchor = () => {
      if (anchor) anchor.hidden = true;
    };

    /*
      Le point du défilement : le milieu de la vue, ramené dans le repère de
      la planche. Il n'y a rien à animer — c'est le doigt de l'utilisateur qui
      fait avancer la scène, image par image, au rythme qu'il choisit.
    */
    const syncScroll = () => {
      if (touching || !coarse.matches || reducedMotion.matches || !onScreen) return;
      if (!centers.length) measure();

      const plateBox = plate.getBoundingClientRect();
      pointer = { x: plateBox.width / 2, y: window.innerHeight / 2 - plateBox.top };
      placeAnchor(plateBox, pointer, 0);
      schedule();
    };

    /*
      Le rectangle de la planche est relu à chaque mouvement plutôt que gardé :
      la page défile, et une position mémorisée viserait le point où la planche
      se trouvait. C'est une lecture par événement, jamais par lettre.

      Le point visé est ramené dans le repère de la PLANCHE, où sont mesurés
      les centres — il peut donc sortir de ses bords, et c'est exactement ce
      qu'on veut : à côté des lettres, elles regardent encore vers la main.
    */
    field.addEventListener(
      'pointermove',
      (event) => {
        if (reducedMotion.matches) return;
        if (!centers.length) measure();

        const plateBox = plate.getBoundingClientRect();
        pointer = { x: event.clientX - plateBox.left, y: event.clientY - plateBox.top };

        if (event.pointerType === 'mouse') {
          hideAnchor();
        } else {
          touching = true;
          placeAnchor(plateBox, pointer, FINGER_LIFT);
        }

        schedule();
      },
      { passive: true },
    );

    /*
      Fin du geste. Au doigt, le point retourne au défilement — la planche ne
      se redresse pas, elle reprend sa lecture là où la vue en est. Au
      curseur, la sortie de la bande redresse tout.
    */
    const release = () => {
      touching = false;

      if (coarse.matches) {
        syncScroll();
        return;
      }

      pointer = null;
      hideAnchor();
      schedule();
    };

    field.addEventListener('pointerleave', release);
    field.addEventListener('pointercancel', release);
    field.addEventListener('pointerup', (event) => {
      if (event.pointerType !== 'mouse') release();
    });

    window.addEventListener('scroll', syncScroll, { passive: true });
    window.addEventListener('resize', syncScroll, { passive: true });

    /*
      Rien n'est calculé quand la bande est ailleurs : l'écoute du défilement
      est globale, mais elle rend la main tout de suite tant que le champ
      n'est pas à l'écran. En sortant, le mot s'efface avec lui.
    */
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      if (onScreen) syncScroll();
      else hideAnchor();
    }).observe(field);

    /* La planche change de taille (fenêtre, rail, rotation) : on remesure. */
    new ResizeObserver(() => {
      if (centers.length) measure();
      syncScroll();
    }).observe(plate);

    /*
      La préférence peut changer pendant la visite : on redresse la planche
      sans attendre le prochain geste.
    */
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      touching = false;
      pointer = null;
      hideAnchor();
      schedule();
    });

    /* Le geste disponible peut changer aussi — clavier posé, souris branchée. */
    coarse.addEventListener('change', () => {
      measure();
      if (coarse.matches) syncScroll();
      else release();
    });
  }
</script>
