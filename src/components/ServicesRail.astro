---
import Wordmark from '~/components/brand/Wordmark.astro';
import CartDrawer from '~/components/vue/CartDrawer.vue';
import { getCollections } from '~/lib/shopify/catalogue';
import {
  collectionPath,
  getCollectionsSegment,
  getRubricsSegment,
  libraryIndexPath,
  shopIndexPath,
} from '~/i18n/routes';
import { getSiteSections } from '~/lib/siteIndex';
import { useTranslations } from '~/i18n/ui';
import type { Locale } from '~/i18n/config';

interface Props {
  locale: Locale;
  mode?: 'embedded' | 'page';
  homeHref?: string;
  class?: string;
}

const { locale, mode = 'page', homeHref = '/', class: className } = Astro.props;
const shopHref = shopIndexPath(locale);
const t = useTranslations(locale);

/*
  Sous-entrées de « Shop » : les vraies collections Shopify, chacune vers sa
  propre page (`/shop/collections/{handle}`, comme sur un Shopify classique).
  Rendu partout — ce composant habille chaque page du site — donc en cache
  d'échec silencieux : `getCollections()` renvoie une liste vide si Shopify ne
  répond pas, plutôt que de faire échouer une page qui n'a rien à voir avec la
  boutique. Tant qu'aucune collection n'existe dans l'admin, ce groupe n'a
  simplement pas de sous-liste — pas de nom de collection à inventer ici.
*/
const shopCollections = await getCollections();
const shopItems = shopCollections.map((collection) => ({
  label: collection.title,
  href: collectionPath(locale, collection.handle),
}));

/*
  Libellés du panier. Le tiroir naît côté navigateur : il n'a aucun moyen de
  lire le dictionnaire, on les lui passe déjà traduits.
*/
const cartLabels = {
  cart: t('cart.title'),
  close: t('cart.close'),
  empty: t('cart.empty'),
  browseShop: t('cart.browseShop'),
  subtotal: t('cart.subtotal'),
  note: t('cart.note'),
  recipient: t('cart.recipient'),
  checkout: t('cart.checkout'),
  remove: t('cart.remove'),
  quantity: t('cart.quantity'),
  decrease: t('cart.decrease'),
  increase: t('cart.increase'),
  shipping: t('cart.shipping'),
  taxes: t('cart.taxes'),
  calculatedAtCheckout: t('cart.calculatedAtCheckout'),
  error: t('shop.error'),
};
/*
  Les sections et leur numérotation viennent de `src/lib/siteIndex.ts`, que lit
  aussi l'index de la page Contact : deux dispositifs affichent les mêmes
  folios, ils ne peuvent pas les tenir chacun de leur côté.

  Seul le Shop complète la table au rendu, ses sous-entrées étant les
  collections Shopify.
*/
const groups = getSiteSections(locale).map((section) => ({
  _key: section.key,
  number: section.folio,
  title: section.title,
  href: section.href,
  items:
    section.key === 'shop'
      ? shopItems
      : section.items.map((item) => ({ label: item.label, href: item.href })),
}));
const currentPath = Astro.url.pathname;
// Une page de collection a sa propre sous-entrée à allumer : le groupe
// « Shop » ne doit pas s'allumer en plus, sous peine de deux points à la fois.
const collectionsPrefix = `${shopHref}/${getCollectionsSegment(locale)}/`;
// Même raison pour la Bibliothèque : une page de rubrique allume sa propre
// sous-entrée, le groupe doit alors s'éteindre.
const rubricsPrefix = `${libraryIndexPath(locale)}/${getRubricsSegment(locale)}/`;
const numbered = groups.map((group) => ({
  ...group,
  isCurrent:
    currentPath === group.href ||
    (currentPath.startsWith(`${group.href}/`) &&
      !(group._key === 'shop' && currentPath.startsWith(collectionsPrefix)) &&
      !(group._key === 'bibliotheque' && currentPath.startsWith(rubricsPrefix))),
  // Correspondance stricte : contrairement au groupe, une sous-entrée ne doit
  // pas s'allumer pour une simple page « en dessous » d'elle dans l'arborescence.
  items: group.items.map((item) => ({ ...item, isCurrent: currentPath === item.href })),
}));
const panelId = `services-menu-${mode}`;
---

<nav
  class:list={['services-rail', `services-rail--${mode}`, className]}
  data-services-rail
  data-page-rail
  aria-label={t('a11y.mainNavigation')}
>
  <button
    class="services-rail__mobile-toggle"
    type="button"
    aria-label={t('a11y.openMenu')}
    aria-controls={panelId}
    aria-expanded="false"
    data-services-toggle
    data-cursor-interactive
  >
    <span></span>
    <span></span>
  </button>

  <a
    class="services-rail__mobile-logo"
    href={homeHref}
    aria-label={t('a11y.backHome')}
    data-cursor-interactive
  >
    <Wordmark title={null} />
  </a>

  <div class="services-rail__mobile-panel" id={panelId} data-services-panel>
    <ol class="services-rail__groups">
      {
        numbered.map((group) => (
          <li
            class:list={['services-rail__group', { 'is-current': group.isCurrent }]}
            data-nav-group={group._key}
            data-href={group.href}
          >
            <div class="services-rail__label">
              <span class="type-note">{group.number}.</span>
              <a
                class="type-note uppercase"
                href={group.href}
                aria-current={group.isCurrent ? 'page' : undefined}
                data-cursor-interactive
              >
                {group.title}
              </a>
            </div>

            {
              /*
                Le panier reste toujours affiché sous « Shop », même sans
                aucune collection créée dans l'admin : il ne dépend pas des
                sous-entrées, qui elles s'effacent tant qu'il n'y a rien à lister.
              */
              (group.items.length > 0 || group._key === 'shop') && (
                <ul class="services-rail__items">
                  {group.items.map((item) => (
                    <li class:list={['type-note', { 'is-current': item.isCurrent }]}>
                      <a
                        href={item.href}
                        aria-current={item.isCurrent ? 'page' : undefined}
                        data-cursor-interactive
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}

                  {group._key === 'shop' && (
                    <li class="type-note services-rail__cart">
                      {/*
                        `client:load` et non `client:visible` : le compteur doit
                        être juste dès l'arrivée sur n'importe quelle page, et le
                        menu est replié sur mobile — il ne croiserait jamais
                        l'observateur d'intersection.
                      */}
                      <CartDrawer client:load labels={cartLabels} shopHref={shopHref} />
                    </li>
                  )}
                </ul>
              )
            }
          </li>
        ))
      }
    </ol>

    {/*
      LES REPÈRES DE SUITE. Sur un écran bas, la liste ne tient pas dans le
      rail et défile dans sa boîte — mais rien ne le disait : les dernières
      entrées étaient simplement absentes, sans que le menu paraisse incomplet.

      Ce sont des BOUTONS et non des marques : on les clique et la liste s'y
      rend. Un repère qu'on voit et qu'on ne peut pas suivre est une invitation
      sans porte. Ils portent donc un nom, et le clavier les atteint.

      Ils n'existent que quand il reste quelque chose à voir de leur côté :
      celui du haut apparaît dès qu'on a descendu la liste, celui du bas
      disparaît quand on touche le fond.
    */}
    <button
      class="services-rail__more services-rail__more--up"
      type="button"
      data-rail-scroll="up"
      aria-label={t('a11y.railScrollUp')}
      data-cursor-interactive
    >↑</button>

    <button
      class="services-rail__more services-rail__more--down"
      type="button"
      data-rail-scroll="down"
      aria-label={t('a11y.railScrollDown')}
      data-cursor-interactive
    >↓</button>

    <a
      class="services-rail__logo"
      href={homeHref}
      aria-label={t('a11y.backHome')}
      data-cursor-interactive
    >
      <Wordmark title={null} />
    </a>
  </div>
</nav>

<style>
  .services-rail {
    --menu-indent: 1.35rem;
  }

  .services-rail__mobile-toggle {
    display: none;
  }

  .services-rail__mobile-logo {
    display: none;
  }

  .services-rail__mobile-panel {
    display: contents;
  }

  .services-rail__logo {
    position: absolute;
    z-index: 1;
    top: 1.5rem;
    right: 1.5rem;
    left: 1.5rem;
    display: block;
    color: var(--ink);
    opacity: 1;
    transition: opacity 0.35s ease-out;
  }

  .services-rail--embedded .services-rail__logo {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(.services[data-docked]) .services-rail--embedded .services-rail__logo {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .services-rail {
    /*
      La bande que le repère de marque occupe en haut du rail : sa garde
      (1,5 rem) plus sa hauteur rendue. Le logo est en `position: absolute` —
      il ne pousse donc RIEN, et la liste passait dessous dès que la fenêtre
      manquait de hauteur. Sur un écran de 640 px, « 01. Le Labo » se
      retrouvait recouvert sur 58 px : le lien existait toujours, mais c'est le
      logo qui recevait le clic.

      La bande est réservée ici, en garniture du rail : la liste ne peut plus
      remonter dedans, quelle que soit la hauteur.
    */
    --rail-logo-band: 6.5rem;
  }

  .services-rail--page {
    position: fixed;
    z-index: 40;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--rail-width);
    align-items: center;
    padding: var(--rail-logo-band) 1.5rem 3rem;
  }

  .services-rail__groups {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 32rem;
    flex-direction: column;
    /*
      Même resserrement qu'au menu mobile, et pour la même raison : chaque
      groupe porte déjà ses sous-entrées, un blanc trop large les faisait lire
      comme cinq listes sans rapport plutôt que comme un sommaire.
    */
    /*
      L'écart suit la HAUTEUR de la fenêtre, et son plancher est bas : sur un
      écran court, c'est lui qu'on peut rendre, le texte non. Le plafond garde
      au large le blanc qui fait lire un sommaire.
    */
    gap: clamp(0.9rem, 3.2vh, 3.6rem);
    margin-inline-start: calc(var(--rail-groups-margin, 0px) - var(--rail-dot-gutter, 0px));
    /*
      Le filet de sécurité, pour les hauteurs où même l'écart minimal ne suffit
      plus : la liste défile dans sa boîte au lieu de déborder du rail. Chaque
      entrée reste alors atteignable — c'est ce qui compte dans un menu.
    */
    max-height: 100%;
    overflow-y: auto;
    /*
      ⚠️ LA GOUTTIÈRE DU POINT. Rendre la liste défilante en fait une boîte de
      défilement — et une boîte de défilement ROGNE ce qui déborde, sur les
      DEUX axes. Or le point de section ne se pose pas dans le texte : il pend
      dans la marge, à gauche du numéro. Il se retrouvait donc coupé, allumé
      mais invisible : « 01. LE LABO » n'avait plus jamais son point.

      On lui rend sa place en garniture, et on décale la boîte d'autant vers la
      gauche : le texte ne bouge pas d'un pixel, et le point a de nouveau où
      s'afficher. Le décalage s'ajoute à la marge de la scène d'accueil, qui
      résorbe le centrage au fil du défilement — d'où le calcul plutôt qu'une
      valeur seule.
    */
    --rail-dot-gutter: 1.5rem;
    padding-inline-start: var(--rail-dot-gutter);
    /*
      Sans barre : le rail fait 16 rem, une barre y prendrait sur la mesure des
      intitulés et les ferait passer à la ligne.
    */
    scrollbar-width: none;
  }

  .services-rail__groups::-webkit-scrollbar {
    display: none;
  }

  /*
    ┌─ « ÇA CONTINUE PLUS BAS » ────────────────────────────────────────────┐
    │ Deux signes, posés seulement quand il reste quelque chose à voir :    │
    │                                                                        │
    │  · la liste s'ESTOMPE sur son dernier centimètre — le texte ne se      │
    │    coupe plus net, il s'efface, ce qui se lit comme une suite ;       │
    │  · une flèche discrète sous le rail le confirme.                      │
    │                                                                        │
    │ Les deux disparaissent dès qu'on touche le bas de la liste : un       │
    │ repère qui reste allumé quand il n'y a plus rien à voir cesse d'être  │
    │ un repère.                                                            │
    └────────────────────────────────────────────────────────────────────────┘
  */
  /*
    Le fondu est un MASQUE, pas un dégradé posé par-dessus : un dégradé aurait
    dû reprendre la couleur du fond, et le rail en traverse plusieurs selon la
    page. Un masque efface, quelle que soit la couleur dessous.

    Les deux bords sont pilotés par des variables, à zéro par défaut : le
    masque est alors franc de bout en bout, donc sans effet. Chaque attribut
    n'ouvre QUE son côté.
  */
  .services-rail__groups {
    --rail-fade-top: 0px;
    --rail-fade-bottom: 0px;
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 var(--rail-fade-top),
      #000 calc(100% - var(--rail-fade-bottom)),
      transparent 100%
    );
  }

  .services-rail[data-more-up] .services-rail__groups {
    --rail-fade-top: 2.5rem;
  }

  .services-rail[data-more-down] .services-rail__groups {
    --rail-fade-bottom: 2.5rem;
  }

  .services-rail__more {
    position: absolute;
    left: 1.5rem;
    /* Assez large pour le doigt sans peser à l'œil : le signe reste petit. */
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-titre);
    font-size: var(--text-note);
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    /* Invisible, elle ne doit pas non plus intercepter un clic. */
    pointer-events: none;
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }

  /* Chacune part du côté d'où elle vient, et s'y remet en disparaissant. */
  .services-rail__more--up {
    top: calc(var(--rail-logo-band, 3rem) - 1.9rem);
    transform: translateY(0.25rem);
  }

  .services-rail__more--down {
    bottom: 1.1rem;
    transform: translateY(-0.25rem);
  }

  .services-rail[data-more-up] .services-rail__more--up,
  .services-rail[data-more-down] .services-rail__more--down {
    opacity: 0.5;
    pointer-events: auto;
    transform: translateY(0);
  }

  .services-rail__more:hover,
  .services-rail__more:focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .services-rail__more {
      transition: none;
      transform: none;
    }
  }

  .services-rail__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
  }

  .services-rail__label {
    display: flex;
    grid-column: 1;
    grid-row: 1;
    align-items: baseline;
    gap: 0.55em;
    white-space: nowrap;
  }

  .services-rail__label > span {
    position: relative;
    flex: none;
  }

  .services-rail__label > a {
    text-decoration: none;
    transition: opacity 0.25s ease-out;
  }

  /*
    LE POINT — un seul repère, trois usages.

    Il désignait la page courante. Il désigne maintenant aussi l'entrée
    SURVOLÉE, et la SECTION LUE quand une page en compte plusieurs : le menu
    répond au geste avec le signe qu'il emploie déjà pour dire « c'est ici »,
    plutôt qu'avec un vocabulaire de plus.

    Il est donc posé en permanence et simplement ÉTEINT : on n'anime pas
    l'apparition d'un `content`, alors qu'une opacité se fond. Le point ne prend
    aucune place — il est hors du flux, dans la marge — et n'existe pour les
    lecteurs d'écran dans aucun des trois cas : l'entrée courante s'annonce par
    `aria-current`, et ni un survol ni un défilement n'ont à s'annoncer.
  */
  /*
    Le point est CENTRÉ SUR LA LIGNE qu'il désigne, et non posé sur sa ligne de
    base. Laissé à sa position statique, il suivait la base du texte : le glyphe
    du point, qui se dessine à mi-hauteur d'x, se retrouvait haut sur les
    libellés en capitales des groupes et bas sur les sous-entrées en bas de
    casse. Le voici calé sur le milieu exact de la boîte du texte, quelle que
    soit la casse.
  */
  .services-rail__label > span::before,
  .services-rail__items li::before {
    content: '•';
    position: absolute;
    inset-inline-end: calc(100% + 0.45em);
    top: 50%;
    transform: translateY(-50%);
    color: currentColor;
    font-size: 1.25em;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.25s ease-out;
  }

  .services-rail__group.is-current .services-rail__label > span::before {
    opacity: 1;
  }

  /*
    `is-echo` : le point allumé depuis AILLEURS que le rail — aujourd'hui par le
    survol d'un folio dans l'index de la page Contact, qui renvoie ici.

    Classe distincte de `is-current` à dessein : le rail pose et retire
    lui-même `is-current` au fil du défilement, et un dispositif extérieur qui
    écrirait dans la même classe lui effacerait sa lecture en cours.
  */
  .services-rail__group.is-echo .services-rail__label > span::before,
  .services-rail__items li.is-echo::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .services-rail__label > span::before,
    .services-rail__items li::before {
      transition: none;
    }
  }

  .services-rail__label > a:hover,
  .services-rail__label > a:focus-visible {
    opacity: 1;
  }

  .services-rail__label > a[aria-current='page'] {
    opacity: 1;
  }

  /*
    Les sous-sections se serrent autant que le permet le seuil des cibles de
    pointage : l'écart tombe à zéro, et c'est la garniture des liens — 24 px de
    haut, pas un de moins — qui tient désormais seule le rythme vertical.
  */
  .services-rail__items {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 0;
    padding-inline-start: 2.75rem;
    transform: var(--rail-items-transform, none);
  }

  .services-rail__items li {
    position: relative;
    white-space: nowrap;
  }

  /* Même point que le groupe actif, réutilisé à l'échelle de la sous-entrée. */
  .services-rail__items li.is-current::before {
    opacity: 1;
  }

  /*
    ┌─ Écart assumé au critère 2.5.8 ────────────────────────────────────────┐
    │ Ces liens font environ 20 px de haut, sous le minimum de 24 px exigé   │
    │ pour une cible de pointage. C'est un ARBITRAGE ÉDITORIAL, pris en      │
    │ connaissance de cause : le rythme serré du menu prime ici sur le       │
    │ seuil, et le site n'est donc pas conforme AA sur ce point précis.      │
    │                                                                        │
    │ Ne pas « corriger » sans en reparler : la garniture avait été portée à │
    │ 0,25 rem pour atteindre 24 px, puis ramenée sciemment.                 │
    │                                                                        │
    │ Ce qui est conservé : le lien occupe TOUTE la largeur de sa ligne. La  │
    │ cible reste donc large, seule sa hauteur est en cause — au doigt, on   │
    │ vise la ligne, pas les quelques caractères du libellé.                 │
    └────────────────────────────────────────────────────────────────────────┘
  */
  .services-rail__label > a,
  .services-rail__items a {
    display: block;
    padding-block: 0.1rem;
  }

  .services-rail__items a {
    text-decoration: none;
    transition: opacity 0.25s ease-out;
  }

  .services-rail__items a:hover,
  .services-rail__items a:focus-visible {
    opacity: 1;
  }

  /*
    Le survol allume le point plutôt que d'éteindre le mot. Réservé aux
    pointeurs : sur un écran tactile, `:hover` reste collé après le doigt et
    laisserait deux points allumés à la fois.
  */
  @media (hover: hover) {
    .services-rail__label:hover > span::before,
    .services-rail__label:focus-within > span::before,
    .services-rail__items li:hover::before,
    .services-rail__items li:focus-within::before {
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .services-rail {
      --mobile-logo-width: min(10rem, calc(100vw - 6.5rem));
      --mobile-logo-top: 1rem;
      --mobile-logo-left: 1.25rem;
    }

    .services-rail--page,
    .services-rail--embedded[data-mobile-root] {
      /* Une seule couche fixe pour la marque et le menu, indépendante des
         surfaces animées. Le nav ne reste pas une boîte hors écran en fin
         de document avec deux descendants composités séparément. */
      position: fixed;
      z-index: 80;
      inset: 0 0 auto;
      width: 100vw;
      height: 0;
      padding: 0;
      pointer-events: none;
    }

    .services-rail__mobile-toggle {
      position: fixed;
      z-index: 82;
      top: 1rem;
      left: calc(100vw - 3.75rem);
      right: auto;
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.42rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--color-ink);
      cursor: pointer;
      pointer-events: auto;
    }

    .services-rail__mobile-logo {
      position: fixed;
      z-index: 81;
      top: var(--mobile-logo-top);
      left: var(--mobile-logo-left);
      display: block;
      width: var(--mobile-logo-width);
      color: var(--color-ink);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity 0.3s ease,
        visibility 0s linear;
    }

    .services-rail--embedded .services-rail__mobile-logo {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .services-rail--embedded[data-mobile-logo-visible] .services-rail__mobile-logo {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .services-rail[data-menu-open] .services-rail__mobile-logo {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .services-rail__mobile-toggle span {
      display: block;
      width: 1.8rem;
      height: 1px;
      background-color: currentColor;
      transform-origin: center;
      transition:
        transform 0.35s ease,
        width 0.35s ease;
    }

    .services-rail[data-menu-open] .services-rail__mobile-toggle span:first-child {
      transform: translateY(0.24rem) rotate(45deg);
    }

    .services-rail[data-menu-open] .services-rail__mobile-toggle span:last-child {
      transform: translateY(-0.24rem) rotate(-45deg);
    }

    .services-rail__mobile-panel {
      position: fixed;
      z-index: 80;
      inset: 0;
      right: auto;
      width: 100vw;
      display: flex;
      align-items: center;
      overflow-y: auto;
      /*
        La garniture du haut dégage le repère de marque, posé par-dessus le
        panneau (`--mobile-logo-top` plus la hauteur du mot et de sa mention).
        Six rem laissaient le premier groupe lui coller au sous-titre : le menu
        commençait avant que l'enseigne ait fini.
      */
      padding: 7.75rem 1.5rem 2rem;
      /*
        UN FOND PLAT. Le panneau portait le papier froissé du site, éclairci
        d'un voile : sous une liste de vingt lignes serrées, la matière se
        lisait comme un bruit derrière le texte plutôt que comme une page.

        Reste la couleur du papier, seule. Elle n'est pas décorative : le menu
        recouvre la page, et sans fond opaque le contenu se lirait au travers.
      */
      background-color: var(--color-papier);
      color: var(--color-ink);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.75rem);
      transition:
        opacity 0.35s ease,
        visibility 0s linear 0.35s,
        transform 0.35s ease;
    }

    .services-rail[data-menu-open] .services-rail__mobile-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .services-rail[data-menu-open] .services-rail__logo {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .services-rail__logo {
      top: var(--mobile-logo-top);
      right: auto;
      left: var(--mobile-logo-left);
      width: var(--mobile-logo-width);
      max-width: none;
    }

    /*
      À l'inverse du rail de bureau, le menu tactile s'AÈRE. Ce qu'on y vise
      n'est pas un pointeur d'un pixel mais un doigt : entre deux groupes, le
      blanc est ce qui évite d'ouvrir « Journal » en voulant toucher « Shop ».
      L'écran haut le rend gratuit — la liste tient largement, et le blanc
      qu'elle laissait en bas est mieux employé entre les lignes.
    */
    .services-rail__groups {
      max-width: 20rem;
      gap: clamp(1.75rem, 5svh, 3rem);
      margin: auto;
    }

    .services-rail__group {
      display: block;
    }

    .services-rail__label {
      display: flex;
    }


    .services-rail__items {
      margin-top: 0.1rem;
      /*
        Un cran FRANC à droite du titre, pas un alignement sur lui : le numéro
        et son écart occupent près de 2 rem, la sous-section part donc au-delà
        pour que la subordination se lise d'un coup d'œil.
      */
      padding-inline-start: 3rem;
      transform: none;
    }

    .services-rail__items li {
      white-space: normal;
    }

    .services-rail :global(.type-note) {
      font-size: var(--text-note);
      line-height: 1.45;
    }
  }
</style>

<script>
  /*
    ── RESTE-T-IL QUELQUE CHOSE À VOIR SOUS LA LISTE ? ─────────────────────
    Le rail pose `data-more` tant que la liste n'est pas au bout. C'est ce
    seul attribut qui allume le fondu et la flèche — la mise en forme reste
    entièrement dans la feuille de style.

    Trois choses le remettent en question : le défilement de la liste, un
    changement de taille du rail (fenêtre plus basse), et le chargement des
    fontes, qui change la hauteur du texte donc le débordement.
  */
  for (const rail of document.querySelectorAll<HTMLElement>('[data-services-rail]')) {
    const groups = rail.querySelector<HTMLElement>('.services-rail__groups');
    if (!groups) continue;

    /* Une tolérance d'un pixel : les hauteurs fractionnaires ne tombent jamais juste. */
    const END = 1;
    let frame = 0;

    const sync = () => {
      frame = 0;
      const reste = groups.scrollHeight - groups.clientHeight - groups.scrollTop;
      rail.toggleAttribute('data-more-up', groups.scrollTop > END);
      rail.toggleAttribute('data-more-down', reste > END);
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };

    /*
      Le pas d'un clic : la hauteur visible moins un tiers. On garde ainsi
      quelques entrées de l'écran précédent sous les yeux — sans ce recouvrement
      on saute d'un bloc à l'autre sans savoir ce qu'on vient de quitter.
    */
    const pas = () => groups.clientHeight * 0.66;

    for (const bouton of rail.querySelectorAll<HTMLElement>('[data-rail-scroll]')) {
      bouton.addEventListener('click', () => {
        const sens = bouton.dataset.railScroll === 'up' ? -1 : 1;
        /*
          `smooth` en dur plutôt qu'hérité : le rail est un conteneur à part,
          et le défilement doux de la page ne descend pas jusqu'à lui. Le
          navigateur respecte de lui-même le réglage « moins d'animations ».
        */
        groups.scrollBy({ top: sens * pas(), behavior: 'smooth' });
      });
    }

    sync();
    document.fonts?.ready.then(sync);
    /*
      Au défilement, on met à jour DIRECTEMENT : deux attributs à poser, et les
      mesures lues sont celles que le navigateur vient de calculer pour
      défiler. Passer par une image d'animation retardait le repère d'un cran —
      et, dans un onglet qui ne peint pas, ne le mettait jamais à jour.

      Le redimensionnement, lui, garde la coalescence : il arrive en rafale.
    */
    groups.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(request).observe(groups);
  }
</script>

<script>
  const mobileMenus = document.querySelectorAll<HTMLElement>('[data-services-rail]');
  const mobileMedia = window.matchMedia('(max-width: 767px)');

  for (const menu of mobileMenus) {
    const toggle = menu.querySelector<HTMLButtonElement>('[data-services-toggle]');
    const panel = menu.querySelector<HTMLElement>('[data-services-panel]');
    if (!toggle || !panel || toggle.dataset.menuReady) continue;
    toggle.dataset.menuReady = 'true';

    const setOpen = (open: boolean) => {
      const next = mobileMedia.matches && open;
      menu.toggleAttribute('data-menu-open', next);
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Fermer le menu' : 'Ouvrir le menu');
      panel.setAttribute('aria-hidden', String(mobileMedia.matches && !next));
      document.body.classList.toggle('mobile-menu-open', next);
    };

    toggle.addEventListener('click', () => setOpen(!menu.hasAttribute('data-menu-open')));
    panel.addEventListener('click', (event) => {
      /*
        Un lien quitte la page, il referme le menu de lui-même. Le panier ne
        quitte rien — c'est un bouton, pas un lien — mais son tiroir se pose
        par-dessus ce même menu mobile : sans cette ligne, le fermer laissait
        retomber sur le menu resté ouvert en dessous.
      */
      if ((event.target as Element).closest('a, .cart-trigger')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    mobileMedia.addEventListener('change', () => setOpen(false));

    if (menu.classList.contains('services-rail--embedded')) {
      /*
        Le header appartient à la fenêtre, pas à la scène des prestations.
        Même sans transform, ses parents peuvent le confiner dans une couche
        ou le découper. Déplacer le nav original préserve liens, événements et
        panier ; le repère permet de le remettre en place sur desktop.
      */
      const origin = document.createComment('services-rail-origin');
      menu.before(origin);
      const syncMobileRoot = () => {
        if (mobileMedia.matches) {
          menu.setAttribute('data-mobile-root', '');
          document.body.append(menu);
        } else {
          origin.after(menu);
          menu.removeAttribute('data-mobile-root');
        }
      };
      mobileMedia.addEventListener('change', syncMobileRoot);
      syncMobileRoot();
      const hero = document.querySelector<HTMLElement>('.manifesto');
      const syncMobileLogo = () => {
        const visible = mobileMedia.matches && (!hero || hero.getBoundingClientRect().bottom <= 0);
        menu.toggleAttribute('data-mobile-logo-visible', visible);
      };

      if (hero) {
        const heroObserver = new IntersectionObserver(syncMobileLogo, { threshold: 0 });
        heroObserver.observe(hero);
      }
      window.addEventListener('scroll', syncMobileLogo, { passive: true });
      mobileMedia.addEventListener('change', syncMobileLogo);
      syncMobileLogo();
    }

    setOpen(false);
  }
</script>

<script>
  /*
    LA SECTION LUE — le point suit le défilement.

    Les sous-entrées du Labo, des Expériences et du Contact désignent des
    ANCRES de la page courante : `/labo#vision`. Le serveur, lui, compare
    `Astro.url.pathname` à un href qui porte son hash — une égalité qui ne peut
    jamais être vraie. Ces points ne s'allumaient donc jamais. Le hash ne se lit
    qu'ici, côté navigateur.

    Les rubriques de la Bibliothèque ne passent pas par là : ce sont des pages
    entières, dont le point est posé par le serveur à la comparaison des
    chemins. Elles n'ont aucune ancre à observer, et `watched` les écarte donc
    de lui-même.
  */
  function syncSectionNav(rail: HTMLElement) {
    const watched = [...rail.querySelectorAll<HTMLAnchorElement>('.services-rail__items a')]
      .map((link) => {
        const url = new URL(link.href, location.href);
        if (url.pathname !== location.pathname || !url.hash) return null;
        const section = document.querySelector<HTMLElement>(url.hash);
        const item = link.closest<HTMLElement>('li');
        return section && item ? { item, section } : null;
      })
      .filter((entry): entry is { item: HTMLElement; section: HTMLElement } => entry !== null)
      .sort(
        (a, b) =>
          a.section.getBoundingClientRect().top - b.section.getBoundingClientRect().top,
      );

    if (watched.length === 0) return;

    // Le groupe rend son point à la section lue : un seul point allumé à la fois.
    const groups = [
      ...new Set(
        watched
          .map(({ item }) => item.closest<HTMLElement>('.services-rail__group'))
          .filter((group): group is HTMLElement => group !== null),
      ),
    ];

    /*
      La ligne de lecture, au tiers haut de l'écran. Au bord haut, la section
      suivante s'allumerait avant qu'on ait fini la précédente ; au milieu, elle
      attendrait un demi-écran de trop.
    */
    const READING_LINE = 0.3;

    /*
      ┌─ TANT QU'ON N'A PAS ATTEINT LA PREMIÈRE SECTION, C'EST LA PAGE ───────┐
      │ qu'on lit — pas encore l'une de ses sections. Le point revient donc à │
      │ son TITRE, et la première sous-entrée prend le relais quand on arrive │
      │ RÉELLEMENT sur elle.                                                  │
      │                                                                        │
      │ Sans cette réserve, une page dont la première section commence haut —  │
      │ le Labo ouvre sur « Services », Contact sur « Informations » —         │
      │ allumait cette sous-entrée dès l'arrivée : la ligne de lecture, au     │
      │ tiers de l'écran, était déjà franchie avant le premier geste. On       │
      │ atterrissait sur la page sans que le menu dise laquelle.               │
      │                                                                        │
      │ Le seuil n'est pas une valeur choisie : c'est la position OÙ SON       │
      │ ANCRE DÉPOSE — le haut de la section moins la garde qu'elle s'est      │
      │ réservée. La sous-entrée s'allume donc exactement là où un clic sur    │
      │ elle aurait mené. Le menu dit la même chose qu'il fait.                │
      │                                                                        │
      │ Au-delà de ce seuil, la ligne de lecture reprend ses droits pour       │
      │ toutes les sections : c'est elle qui décide de la suite.               │
      └────────────────────────────────────────────────────────────────────────┘
    */
    const firstSection = watched[0].section;

    /** Position de défilement à laquelle l'ancre de la première section dépose. */
    const firstSectionLanding = () => {
      const guard = Number.parseFloat(getComputedStyle(firstSection).scrollMarginTop) || 0;
      return firstSection.getBoundingClientRect().top + window.scrollY - guard;
    };

    let frame = 0;

    const apply = () => {
      frame = 0;
      const line = window.innerHeight * READING_LINE;
      let active: HTMLElement | null = null;
      // La dernière section à avoir franchi la ligne est celle qu'on lit.
      if (window.scrollY >= firstSectionLanding()) {
        for (const { item, section } of watched) {
          if (section.getBoundingClientRect().top <= line) active = item;
        }
      }
      for (const { item } of watched) item.classList.toggle('is-current', item === active);
      for (const group of groups) group.classList.toggle('is-current', active === null);
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    window.addEventListener('hashchange', request);
  }

  for (const rail of document.querySelectorAll<HTMLElement>('[data-services-rail]')) {
    syncSectionNav(rail);
  }
</script>
