---
import type { ServicesMenu as ServicesMenuSection } from '~/lib/sanity/types';
import Wordmark from '~/components/brand/Wordmark.astro';

interface Props {
  groups?: ServicesMenuSection['groups'];
  mode?: 'embedded' | 'page';
  homeHref?: string;
  class?: string;
}

const DEFAULT_GROUPS: NonNullable<ServicesMenuSection['groups']> = [
  { _key: 'g1', title: 'Labo de com', items: ['Recherche de Sens', 'Accompagnement', 'Audit'] },
  { _key: 'g2', title: 'Définition', items: ['Direction artistique', 'Conception rédaction'] },
  { _key: 'g3', title: 'Production', items: ['Identité sensorielle', 'Graphisme', 'Visuels', 'Rédaction'] },
  { _key: 'g4', title: 'Expansion', items: ['Déploiement', 'Ateliers & formations', 'Conférences', 'Outils de com'] },
];

const { groups = DEFAULT_GROUPS, mode = 'page', homeHref = '/', class: className } = Astro.props;
const numbered = groups.map((group, index) => ({
  ...group,
  number: String(index + 1).padStart(2, '0'),
}));
const panelId = `services-menu-${mode}`;
---

<nav
  class:list={['services-rail', `services-rail--${mode}`, className]}
  data-services-rail
  data-page-rail
  aria-label="Services"
>
  <button
    class="services-rail__mobile-toggle"
    type="button"
    aria-label="Ouvrir le menu"
    aria-controls={panelId}
    aria-expanded="false"
    data-services-toggle
    data-cursor-interactive
  >
    <span></span>
    <span></span>
  </button>

  <a
    class="services-rail__mobile-logo"
    href={homeHref}
    aria-label="Retour à l'accueil de Studio Abîme"
    data-cursor-interactive
  >
    <Wordmark title={null} />
  </a>

  <div class="services-rail__mobile-panel" id={panelId} data-services-panel>
    <ol class="services-rail__groups">
      {
        numbered.map((group) => (
          <li class="services-rail__group">
            <div class="services-rail__label">
              <span class="type-note block">{group.number}</span>
              <p class="type-note uppercase">{group.title}</p>
            </div>

            <ul class="services-rail__items">
              {group.items?.map((item) => (
                <li class="type-note" data-cursor-interactive>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <a
      class="services-rail__logo"
      href={homeHref}
      aria-label="Retour à l'accueil de Studio Abîme"
      data-cursor-interactive
    >
      <Wordmark title={null} />
    </a>
  </div>
</nav>

<style>
  .services-rail {
    --menu-indent: 1.35rem;
  }

  .services-rail__mobile-toggle {
    display: none;
  }

  .services-rail__mobile-logo {
    display: none;
  }

  .services-rail__mobile-panel {
    display: contents;
  }

  .services-rail__logo {
    position: absolute;
    z-index: 1;
    top: 1.5rem;
    right: 1.5rem;
    left: 1.5rem;
    display: block;
    color: var(--ink);
    opacity: 1;
    transition: opacity 0.35s ease-out;
  }

  .services-rail--embedded .services-rail__logo {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(.services[data-docked]) .services-rail--embedded .services-rail__logo {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .services-rail--page {
    position: fixed;
    z-index: 40;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--rail-width);
    align-items: center;
    padding: 3rem 1.5rem;
  }

  .services-rail__groups {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: 32rem;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    margin-inline-start: var(--rail-groups-margin, 0);
  }

  .services-rail__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
  }

  .services-rail__label {
    display: contents;
    white-space: nowrap;
  }

  .services-rail__label > span {
    grid-column: 1;
    grid-row: 1;
  }

  .services-rail__label p {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    margin-top: 0.35em;
  }

  .services-rail__items {
    grid-column: 1;
    grid-row: 3;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0;
    padding-inline-start: 2.75rem;
    transform: var(--rail-items-transform, none);
  }

  .services-rail__items li {
    position: relative;
    white-space: nowrap;
  }

  .services-rail__items li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--menu-indent) * -0.62);
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0;
    transition: opacity 0.25s ease-out;
  }

  .services-rail__items li:hover::before,
  .services-rail__items li:focus-within::before,
  .services-rail__items li[aria-current]::before,
  .services-rail__items li[data-active]::before {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .services-rail {
      --mobile-logo-width: min(10rem, calc(100vw - 6.5rem));
      --mobile-logo-top: 1rem;
      --mobile-logo-left: 1.25rem;
    }

    .services-rail--page {
      position: static;
      width: 0;
      height: 0;
      padding: 0;
    }

    .services-rail__mobile-toggle {
      position: fixed;
      z-index: 82;
      top: 1rem;
      right: 1rem;
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.42rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--color-ink);
      cursor: pointer;
    }

    .services-rail__mobile-logo {
      position: fixed;
      z-index: 81;
      top: var(--mobile-logo-top);
      left: var(--mobile-logo-left);
      display: block;
      width: var(--mobile-logo-width);
      color: var(--color-ink);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity 0.3s ease,
        visibility 0s linear;
    }

    .services-rail--embedded .services-rail__mobile-logo {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .services-rail--embedded[data-mobile-logo-visible] .services-rail__mobile-logo {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .services-rail[data-menu-open] .services-rail__mobile-logo {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .services-rail__mobile-toggle span {
      display: block;
      width: 1.8rem;
      height: 1px;
      background-color: currentColor;
      transform-origin: center;
      transition:
        transform 0.35s ease,
        width 0.35s ease;
    }

    .services-rail[data-menu-open] .services-rail__mobile-toggle span:first-child {
      transform: translateY(0.24rem) rotate(45deg);
    }

    .services-rail[data-menu-open] .services-rail__mobile-toggle span:last-child {
      transform: translateY(-0.24rem) rotate(-45deg);
    }

    .services-rail__mobile-panel {
      position: fixed;
      z-index: 80;
      inset: 0;
      display: flex;
      align-items: center;
      overflow-y: auto;
      padding: 6rem 1.5rem 2rem;
      background-color: var(--color-papier);
      background-image:
        linear-gradient(rgb(239 235 226 / 72%), rgb(239 235 226 / 72%)),
        url('/textures/papier-froisse.jpg');
      background-position: center;
      background-size: cover;
      color: var(--color-ink);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.75rem);
      transition:
        opacity 0.35s ease,
        visibility 0s linear 0.35s,
        transform 0.35s ease;
    }

    .services-rail[data-menu-open] .services-rail__mobile-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .services-rail[data-menu-open] .services-rail__logo {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .services-rail__logo {
      top: var(--mobile-logo-top);
      right: auto;
      left: var(--mobile-logo-left);
      width: var(--mobile-logo-width);
      max-width: none;
    }

    .services-rail__groups {
      max-width: 20rem;
      gap: clamp(1.5rem, 4svh, 2.4rem);
      margin: auto;
    }

    .services-rail__group,
    .services-rail__label {
      display: block;
    }

    .services-rail__items {
      margin-top: 0.1rem;
      padding-inline-start: 1.6rem;
      transform: none;
    }

    .services-rail__items li {
      white-space: normal;
    }

    .services-rail :global(.type-note) {
      font-size: 0.72rem;
      line-height: 1.45;
    }
  }
</style>

<script>
  const mobileMenus = document.querySelectorAll<HTMLElement>('[data-services-rail]');
  const mobileMedia = window.matchMedia('(max-width: 767px)');

  for (const menu of mobileMenus) {
    const toggle = menu.querySelector<HTMLButtonElement>('[data-services-toggle]');
    const panel = menu.querySelector<HTMLElement>('[data-services-panel]');
    if (!toggle || !panel || toggle.dataset.menuReady) continue;
    toggle.dataset.menuReady = 'true';

    const setOpen = (open: boolean) => {
      const next = mobileMedia.matches && open;
      menu.toggleAttribute('data-menu-open', next);
      toggle.setAttribute('aria-expanded', String(next));
      toggle.setAttribute('aria-label', next ? 'Fermer le menu' : 'Ouvrir le menu');
      panel.setAttribute('aria-hidden', String(mobileMedia.matches && !next));
      document.body.classList.toggle('mobile-menu-open', next);
    };

    toggle.addEventListener('click', () => setOpen(!menu.hasAttribute('data-menu-open')));
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    mobileMedia.addEventListener('change', () => setOpen(false));

    if (menu.classList.contains('services-rail--embedded')) {
      const hero = document.querySelector<HTMLElement>('.manifesto');
      const syncMobileLogo = () => {
        const visible = mobileMedia.matches && (!hero || hero.getBoundingClientRect().bottom <= 0);
        menu.toggleAttribute('data-mobile-logo-visible', visible);
      };

      if (hero) {
        const heroObserver = new IntersectionObserver(syncMobileLogo, { threshold: 0 });
        heroObserver.observe(hero);
      }
      window.addEventListener('scroll', syncMobileLogo, { passive: true });
      mobileMedia.addEventListener('change', syncMobileLogo);
      syncMobileLogo();
    }

    setOpen(false);
  }
</script>
