---
import { stegaClean } from '@sanity/client/stega';

import FigureCaption from '~/components/primitives/FigureCaption.astro';
import SanityImage from '~/components/primitives/SanityImage.astro';
import type { JournalFigureView } from '~/lib/journal';

/**
 * Figure d'article : une à trois images sous une légende numérotée.
 *
 * La légende est celle du reste du site — « fig. 01 » en italique, un tiret,
 * puis le texte au corps romain, à la taille des notes : c'est `FigureCaption`
 * qui la compose, ici comme en page d'accueil.
 *
 * L'échelle est portée par une variable et non par une classe par cas : la
 * même figure se compose donc à l'identique dans la colonne de lecture et dans
 * la marge, seule sa largeur change.
 */
interface Props {
  figure: JournalFigureView;
  /** En marge, la largeur s'adapte à l'orientation de chaque image. */
  variant?: 'texte' | 'marge';
}

const { figure, variant = 'texte' } = Astro.props;
/*
  L'échelle pilote un sélecteur d'attribut : elle doit être nettoyée des
  marqueurs invisibles du stega, sans quoi aucune règle ne s'applique en mode
  édition visuelle et toutes les figures retombent sur la valeur par défaut.
*/
const scale = stegaClean(figure.scale) || 'colonne';
const images = (figure.images ?? []).filter((image) => image?.asset);
const preparedImages = images.map((image) => {
  const ratio = image.asset?.metadata?.dimensions?.aspectRatio;
  const portrait = typeof ratio === 'number' && ratio < 1;

  return {
    image,
    portrait,
    ratio,
    width: variant === 'marge' ? 420 : 1100,
    sizes: variant === 'marge' ? '11rem' : '(min-width: 1024px) 34rem, 90vw',
  };
});
const singlePortraitRatio =
  variant === 'marge' && preparedImages.length === 1 && preparedImages[0]?.portrait
    ? preparedImages[0].ratio
    : undefined;
---

{
  preparedImages.length > 0 && (
    <figure
      class:list={['journal-figure', `journal-figure--${variant}`]}
      data-scale={scale}
      style={
        singlePortraitRatio
          ? `--margin-portrait-width: ${singlePortraitRatio * 100}%`
          : undefined
      }
    >
      <div class="journal-figure__plate" data-count={preparedImages.length}>
        {preparedImages.map(({ image, portrait, width, sizes }) => (
          <SanityImage
            image={image}
            width={width}
            sizes={sizes}
            alt={image.alt ?? ''}
            class={`journal-figure__image${portrait ? ' journal-figure__image--portrait' : ''}`}
          />
        ))}
      </div>

      {figure.caption && (
        <FigureCaption
          reference={figure.label ?? undefined}
          text={figure.caption}
          class="journal-figure__caption"
        />
      )}
    </figure>
  )
}

<style>
  .journal-figure {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
  }

  /*
    L'image d'un article scientifique n'occupe pas la mesure du texte : elle
    est citée, pas exposée. L'échelle se lit donc en fraction de la colonne.
  */
  .journal-figure--texte {
    width: 100%;
    max-width: var(--figure-width, 72%);
  }

  .journal-figure--texte[data-scale='petite'] {
    --figure-width: 46%;
  }

  .journal-figure--texte[data-scale='colonne'] {
    --figure-width: 72%;
  }

  .journal-figure--texte[data-scale='pleine'] {
    --figure-width: 100%;
  }

  .journal-figure--marge {
    align-self: flex-start;
    width: 100%;
  }

  .journal-figure__plate {
    display: grid;
    gap: 0.5rem;
    align-items: end;
  }

  .journal-figure__plate[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .journal-figure__plate[data-count='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  :global(.journal-figure__image) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    Une image paysage utilise toute la largeur RÉELLE de la marge. Pour un
    portrait seul, on inverse ce rectangle : sa hauteur devient cette largeur
    et sa largeur est déduite de son ratio. La valeur doit donc être un
    pourcentage du conteneur, et non une multiplication du token `11rem` : la
    colonne peut avoir une largeur calculée différente selon le viewport.
    Dans une planche multiple, chaque image conserve sa cellule.
  */
  .journal-figure--marge :global(.journal-figure__image--portrait) {
    width: min(100%, var(--margin-portrait-width, 100%));
    justify-self: start;
  }

  /*
    Quand la colonne de marge se rabat sous le texte, la figure conserve son
    statut d'appareil éditorial : elle ne devient pas une image pleine page.
    La mesure reste compacte tout en diminuant progressivement sur mobile.
  */
  @media (max-width: 1023px) {
    .journal-figure--marge {
      width: min(100%, clamp(11rem, 28vw, 18rem));
    }
  }

  /*
    Même corps qu'en page d'accueil — la taille des notes — dans la colonne
    comme dans la marge : une légende ne change pas de voix selon la place
    qu'elle occupe. La famille et l'italique du repère viennent de
    `.figure-caption`, partagée avec tout le site.
  */
  .journal-figure__caption {
    font-size: var(--text-note);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  @media (max-width: 767px) {
    .journal-figure--texte {
      max-width: 100%;
    }
  }
</style>
