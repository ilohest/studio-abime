---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import defaultVisual from '~/assets/sections/labo-de-com.webp';
import type { ServicesMenu } from '~/lib/sanity/types';

/**
 * Menu des services — visuel à gauche, prestations à droite, puis rail de menu.
 *
 * ┌─ Mécanique ─────────────────────────────────────────────────────────────┐
 * │ La section réserve une « piste » de défilement. Pendant cette distance   │
 * │ la scène reste collée en haut et la progression `--p` (0 → 1) pilote :   │
 * │                                                                          │
 * │   • le visuel, qui sort du cadre par la gauche ;                         │
 * │   • le panneau, dont le bord gauche ET la largeur convergent vers le     │
 * │     rail — une seule et même expression, donc aucun saut en fin de       │
 * │     course ;                                                             │
 * │   • le compactage interne (titres et prestations se rapprochent).        │
 * │                                                                          │
 * │ À l'arrivée, le panneau bascule en `position: fixed` : il reste alors    │
 * │ ancré à gauche pendant que la suite de la page défile. La bascule a lieu │
 * │ quand la scène occupe déjà tout l'écran, aux mêmes coordonnées — elle    │
 * │ est donc invisible.                                                      │
 * └──────────────────────────────────────────────────────────────────────────┘
 */
interface Props {
  section: ServicesMenu;
}

const { section } = Astro.props;
const groups = section.groups ?? [];

/** Numérotation dérivée de l'ordre : réordonner ne renumérote rien à la main. */
const numbered = groups.map((group, index) => ({
  ...group,
  number: String(index + 1).padStart(2, '0'),
}));
---

<section class="services" data-services-menu>
  <div class="services__runway">
    <div class="services__stage surface-paper">
      <div class="services__grain surface-paper-grain"></div>

      {/* ── Visuel : sort du cadre par la gauche ───────────────────────── */}
      <figure class="services__visual">
        {
          section.image?.asset ? (
            <SanityImage
              image={section.image}
              width={1200}
              sizes="50vw"
              class="h-full w-full object-cover"
            />
          ) : (
            <Image
              src={defaultVisual}
              alt=""
              widths={[640, 875]}
              sizes="50vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          )
        }
      </figure>

      {/*
        ── Prestations : deviennent le rail de menu ─────────────────────
        Volontairement SANS fond : la scène derrière peint déjà le papier sur
        toute la largeur de l'écran. Un fond propre au panneau redessinerait la
        même texture en `cover` de SA boîte — donc à une autre échelle — et
        laisserait une couture visible à son bord droit pendant le défilement
        horizontal. Une fois ancré, c'est la page qui fournit le papier.
      */}
      <nav class="services__panel" data-services-rail aria-label="Services">
        <ol class="services__groups">
          {
            numbered.map((group) => (
              <li class="services__group">
                <div class="services__label">
                  <span class="type-note block">{group.number}</span>
                  <h2 class="type-note uppercase">{group.title}</h2>
                </div>

                <ul class="services__items">
                  {group.items?.map((item) => (
                    <li class="type-note">{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
</section>

<style>
  .services {
    --travel: 100vh; /* distance de défilement consommée par la transition */
    --p: 0; /* progression 0 → 1, écrite par le script */
    --rail-width: 16rem; /* largeur du rail une fois ancré */
    --groups-max: 32rem; /* largeur du bloc de prestations, au repos */
  }

  .services[data-compact] {
    --groups-max: calc(var(--rail-width) - 3rem);
  }

  .services__runway {
    height: calc(100svh + var(--travel));
  }

  .services__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /*
    Une fois ancré, le rail doit passer AU-DESSUS des sections suivantes.

    Le monter d'un cran ne suffit pas : `position: sticky` crée un contexte
    d'empilement, et le `z-index` du panneau y reste donc confiné. Les sections
    suivantes, plus loin dans le DOM, se peignent alors par-dessus lui.
    C'est la SCÈNE qu'il faut élever — elle seule sort le rail de ce piège.

    Sans risque de recouvrement : la scène n'est visible qu'à la fin de sa
    piste, où la section suivante est encore sous la ligne de flottaison.
  */
  .services[data-docked] .services__stage {
    z-index: 30;
  }

  .services__grain {
    z-index: 0;
  }

  /* ── Visuel ───────────────────────────────────────────────────────────── */
  .services__visual {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 1;
    width: 50%;
    overflow: hidden;
    background-color: var(--color-sable);
    /* -100 % de SA propre largeur = exactement la moitié de la scène. */
    transform: translate3d(calc(var(--p) * -100%), 0, 0);
    will-change: transform;
  }

  .services__visual :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    /* Contre-mouvement léger : évite l'effet « bloc unique ». */
    transform: translate3d(calc(var(--p) * 18%), 0, 0);
  }

  /* ── Panneau / rail ───────────────────────────────────────────────────── */
  .services__panel {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    height: 100%;
    width: 50%;
    /*
      Retrait horizontal CONSTANT, identique à celui du rail : c'est lui qui
      fixe le bord gauche du contenu une fois ancré. Le centrage au repos est
      obtenu par la marge de `.services__groups`, qui se résorbe avec `--p` —
      et non par `justify-content`, qui ferait sauter le contenu au moment où
      le panneau se rétrécit.
    */
    padding: 3rem 1.5rem;
    /*
      Déplacement en `transform` uniquement : -100 % de SA propre largeur amène
      le panneau exactement sur le bord gauche.

      Une version antérieure interpolait `left` ET `width` — ce qui forçait un
      recalcul de mise en page ET un re-passage à la ligne du texte à CHAQUE
      image rendue pendant tout le défilement. C'était la cause des à-coups.
      Ici le mouvement reste sur le compositeur ; le changement de forme se fait
      en une seule étape, au seuil de compactage.
    */
    transform: translate3d(calc(var(--p) * -100%), 0, 0);
    will-change: transform;
  }

  /*
    Ancré : quitte la scène pour rester en place sur toute la page.
    La largeur se réduit ici seulement — la scène papier est encore à l'écran
    derrière, le rétrécissement du fond est donc invisible.
  */
  .services[data-docked] .services__panel {
    position: fixed;
    left: 0;
    width: var(--rail-width);
    height: 100svh;
    transform: none;
    /* Menu plus haut que l'écran : il défile seul, sans bloquer la page. */
    overflow-y: auto;
    /*
      Une fois devenu menu, le rail s'efface pour laisser la page respirer, et
      revient au premier plan dès qu'on le vise. Le délai évite qu'il ne
      clignote quand la souris ne fait que traverser le bord gauche de l'écran.
    */
    opacity: 0.2;
    /*
      La largeur se rétrécit sur la MÊME durée que celle du contenu (400 ms).
      C'est ce qui autorise le compactage à se déclencher au moment exact de
      l'ancrage : le panneau part de sa demi-page et reste donc plus large que
      son contenu du premier au dernier instant, sans jamais le faire déborder.
      Ce rétrécissement est invisible — la scène papier est encore à l'écran
      derrière lui.
    */
    transition:
      opacity 0.6s ease-out 0.3s,
      width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* `focus-within` : au clavier aussi, le menu doit redevenir lisible. */
  .services[data-docked] .services__panel:hover,
  .services[data-docked] .services__panel:focus-within {
    opacity: 1;
  }

  .services__groups {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    width: 100%;
    max-width: var(--groups-max);
    /*
      Centrage au repos, qui se résorbe au fil de `--p` pour rejoindre le bord
      gauche du rail. La référence reste la largeur LARGE (`32rem`) et non
      `--groups-max` : cette dernière change d'un coup au seuil de compactage,
      et la marge sauterait avec elle. Ici la marge décroît continûment pendant
      que la largeur, elle, se resserre en 400 ms.
    */
    margin-inline-start: max(0px, calc((100% - 32rem) / 2 * (1 - var(--p))));
    position: relative;
    z-index: 1;
    /*
      Le panneau garde sa demi-largeur pendant tout le trajet ; c'est cette
      colonne qui se resserre à la largeur du rail. La transition ne dure que
      400 ms — le re-passage à la ligne du texte est donc payé une fois,
      et non à chaque image comme lorsque la largeur suivait le défilement.
    */
    transition:
      max-width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      gap 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Un pôle : deux colonnes au large, empilé et resserré au rail ─────── */
  .services__group {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: start;
    /*
      Seul `gap` est animé : `grid-template-columns` passe de deux pistes à une
      seule, ce que le navigateur ne sait pas interpoler — le passage en colonne
      unique est donc instantané, et c'est le resserrement qui porte le mouvement.
    */
    transition: gap 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
    Compactage : les prestations passent sous leur intitulé et s'en rapprochent.
    Déclenché à mi-parcours, pendant que le panneau se rétrécit encore — la
    bascule se lit comme une étape du mouvement, pas comme un changement d'état.
  */
  .services[data-compact] .services__groups {
    gap: 1.75rem;
  }

  .services[data-compact] .services__group {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
  }

  .services__label {
    white-space: nowrap;
  }

  .services__items {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* ── Mobile : empilement simple, aucun mouvement horizontal ───────────── */
  @media (max-width: 767px) {
    .services__runway {
      height: auto;
    }

    .services__stage {
      position: static;
      height: auto;
    }

    .services__visual {
      position: static;
      width: 100%;
      height: 70svh;
      transform: none;
    }

    .services__visual :global(img) {
      transform: none;
    }

    .services,
    .services[data-docked] .services__panel {
      position: static;
    }

    .services__panel,
    .services[data-docked] .services__panel {
      position: static;
      width: 100%;
      height: auto;
      padding-block: 3.5rem;
      transform: none;
    }

    .services__groups,
    .services[data-compact] .services__groups {
      max-width: none;
      margin-inline-start: 0;
    }
  }

  /* ── Mouvement réduit : les deux panneaux restent côte à côte ─────────── */
  @media (prefers-reduced-motion: reduce) {
    .services__runway {
      height: auto;
    }

    .services__stage {
      position: static;
      height: 100svh;
    }

    .services__visual,
    .services__visual :global(img) {
      transform: none;
    }

    .services__panel,
    .services[data-docked] .services__panel {
      position: absolute;
      left: 50%;
      width: 50%;
      transform: none;
    }

    .services__groups,
    .services[data-compact] .services__groups {
      max-width: none;
      margin-inline-start: 0;
    }

    .services__group,
    .services__groups {
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-services-menu]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 768px)');

  /**
   * Seuil unique : le menu garde sa disposition large pendant TOUT le trajet
   * et ne se resserre qu'en touchant le bord gauche — au même instant que
   * l'ancrage et que le passage en retrait.
   *
   * Le panneau et son contenu se rétrécissent alors ensemble, sur la même
   * durée (voir la transition `width` du panneau) : le panneau reste plus
   * large que son contenu du début à la fin, et rien ne déborde.
   */
  const DOCK_AT = 0.999;

  for (const section of sections) {
    const runway = section.querySelector<HTMLElement>('.services__runway');
    if (!runway) continue;

    let ticking = false;

    const setState = (compact: boolean, docked: boolean) => {
      section.toggleAttribute('data-compact', compact);
      section.toggleAttribute('data-docked', docked);
      // Le rail sort du flux : la suite de la page doit lui réserver sa place.
      document.documentElement.classList.toggle('rail-docked', docked);
    };

    const update = () => {
      ticking = false;

      // Hors desktop ou en mouvement réduit, le CSS reprend entièrement la main.
      if (!desktop.matches || reducedMotion.matches) {
        section.style.removeProperty('--p');
        setState(false, false);
        return;
      }

      const rect = runway.getBoundingClientRect();

      // Piste hors écran : on fige l'état plutôt que de recalculer.
      if (rect.bottom < 0) {
        // Déjà dépassée : le rail reste ancré.
        setState(true, true);
        return;
      }
      if (rect.top > window.innerHeight) {
        setState(false, false);
        return;
      }

      // Distance de défilement réellement disponible dans la piste.
      const travel = rect.height - window.innerHeight;
      if (travel <= 0) return;

      // 0 quand le haut de la piste touche le haut de l'écran, 1 à la fin.
      const progress = Math.min(Math.max(-rect.top / travel, 0), 1);
      section.style.setProperty('--p', progress.toFixed(4));
      // Compactage et ancrage partagent le même seuil : la disposition change
      // au moment précis où le menu touche le bord.
      const docked = progress >= DOCK_AT;
      setState(docked, docked);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    /*
      Un unique écouteur passif, coalescé par `requestAnimationFrame` : au pire
      un `getBoundingClientRect` sur un seul élément par image rendue.
      Filtrer en amont avec un IntersectionObserver a été écarté — le gain est
      négligeable face au test de sortie d'écran ci-dessus, pour un état
      supplémentaire à maintenir (l'écouteur attaché ou non).
    */
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
