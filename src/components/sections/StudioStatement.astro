---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import FigureCaption from '~/components/primitives/FigureCaption.astro';
import { stegaClean } from '@sanity/client/stega';

import { figureLabel } from '~/lib/figureLabel';
import { PLATE_FIGURES } from '~/lib/sections';
import { laboPath } from '~/i18n/routes';
import { useTranslations } from '~/i18n/ui';
import { figureAttribute, sectionFieldAttribute } from '~/lib/visualEditing';
import type { Locale } from '~/i18n/config';
import type { StudioStatement } from '~/lib/sanity/types';

/**
 * Manifeste illustré — déclaration, note, planche de figures, appel à action.
 *
 * La planche repose sur une grille de 12 colonnes. Ses cinq premières figures
 * suivent la composition éditoriale de référence (trois en haut, deux en bas),
 * tandis que les médias et leurs légendes restent pilotés depuis le CMS.
 */
interface Props {
  section: StudioStatement;
  locale: Locale;
  documentId?: string;
  documentType?: string;
}

const { section, locale, documentId, documentType } = Astro.props;
const t = useTranslations(locale);

/*
  La déclaration est découpée pour mettre trois expressions en italique. Le
  découpage disperse le texte en plusieurs nœuds et laisse la traîne d'édition
  visuelle orpheline dans le dernier fragment : on la retire franchement, et on
  désigne le champ par un attribut (voir `src/lib/visualEditing.ts`).
*/
const statementEditable = sectionFieldAttribute(
  documentId,
  documentType,
  section._key,
  'statement',
);

/**
 * Les trois notions structurantes de la déclaration reçoivent la voix
 * manuscrite de l'exemple, sans transformer le champ Sanity en contenu riche.
 * La chaîne originale — et ses marqueurs d'édition visuelle — reste intacte.
 */
const statementParts = stegaClean(section.statement).split(/(les outils|les langages|espace)/gi);
const emphasizedStatementParts = new Set(['espace', 'les outils', 'les langages']);

/*
  Repère et texte sont saisis dans un seul champ ; `figureLabel()` en extrait le
  repère de tête pour lui garder sa mise en forme.
*/
const note = figureLabel(section.note);

/*
  ┌─ LA NUMÉROTATION NE SE SAISIT PLUS ───────────────────────────────────────┐
  │ Les figures portaient leur repère DANS leur légende — « fig.05 — La       │
  │ roche ». Le jour où les légendes ont été réécrites en clair, les repères  │
  │ sont partis avec, et la planche s'est retrouvée sans numéros : rien ne    │
  │ signalait la perte, puisque le repère n'a jamais été un champ à part.     │
  │                                                                           │
  │ Il se DÉDUIT donc du rang, comme les folios du menu se déduisent de       │
  │ l'ordre des sections. Une planche ne peut plus être mal numérotée, ni     │
  │ sauter un numéro quand une figure change.                                 │
  │                                                                           │
  │ La série CONTINUE celle de la note : la note porte « fig. 04 », la        │
  │ planche enchaîne donc à 05. C'est la lecture d'un document, où les        │
  │ figures se suivent d'un bout à l'autre — pas deux comptes séparés.        │
  └───────────────────────────────────────────────────────────────────────────┘
*/
const noteNumber = Number.parseInt((note.reference ?? '').replace(/\D+/g, ''), 10);
const firstFigure = Number.isFinite(noteNumber) ? noteNumber + 1 : 1;

/*
  ┌─ LA PLANCHE NE PREND QUE SES CINQ FIGURES ────────────────────────────────┐
  │ Les cinq positions sont dessinées dans la feuille de style, une par une   │
  │ (`.statement__figure:nth-child(1…5)`). Une sixième figure n'a donc aucune │
  │ place où aller : elle retombait en placement automatique et cassait la    │
  │ rangée du bas, sans que rien ne l'annonce.                                │
  │                                                                           │
  │ Le schéma la refuse déjà à la saisie. La coupe est tenue ICI AUSSI parce  │
  │ que la validation d'un tableau ne garde pas ce qui est arrivé avant elle  │
  │ — un contenu migré, une reprise de données. Deux gardes valent mieux      │
  │ qu'une planche cassée en production, et c'est le parti déjà pris par la   │
  │ page Labo pour ses strates et ses services.                               │
  └───────────────────────────────────────────────────────────────────────────┘
*/
const figures = (section.figures ?? []).slice(0, PLATE_FIGURES).map((figure, index) => ({
  ...figure,
  label: {
    reference: `fig. ${String(firstFigure + index).padStart(2, '0')}`,
    /*
      Le texte passe par `figureLabel` pour RETIRER un repère qui y serait
      encore écrit — dans une légende ancienne, ou saisi par habitude. Sans
      cela, la figure porterait deux numéros, et pas forcément le même.
    */
    text: figureLabel(figure.caption).text,
  },
}));
---

<section class="statement" data-statement-intro>
  <div class="statement__intro-runway">
    <div class="statement__intro-stage">
      <div class="statement__inner statement__scene">
        <div class="statement__text-slot">
          {/*
            Déclaration et note partagent un même conteneur : leurs bords
            gauches restent alignés, quelle que soit la largeur de composition.
          */}
          <div class="statement__lede">
            <p class="type-declaration statement__text" data-sanity={statementEditable}>
              {statementParts.map((part) =>
                emphasizedStatementParts.has(part.toLocaleLowerCase('fr')) ? (
                  <em class="statement__emphasis">{part}</em>
                ) : (
                  part
                ),
              )}
            </p>

            {(note.reference || note.text) && (
              <FigureCaption
                as="p"
                reference={note.reference}
                text={note.text}
                class="statement__note"
                editable={sectionFieldAttribute(documentId, documentType, section._key, 'note')}
              />
            )}
          </div>
        </div>

        <div class="statement__body">
          {/* ── Planche de figures ────────────────────────────────────── */}
          {
            figures.length > 0 && (
              <div
                class="statement__plate"
                data-lower-row={figures.length >= 4 ? '' : undefined}
              >
                {figures.map((figure, figureIndex) => (
                  <figure
                    class="statement__figure"
                    data-sanity={figureAttribute(documentId, documentType, section._key, figure._key)}
                  >
                    {figure.video?.url ? (
                      /*
                        ── UNE FIGURE QUI BOUGE ───────────────────────────
                        Elle se comporte comme un tirage, pas comme un
                        lecteur : muette, en boucle, sans commande. D'où
                        l'absence de `controls` — une barre de lecture sur
                        une planche d'images romprait la série.

                        `playsinline` est ce qui empêche iOS de la passer en
                        plein écran de lui-même au démarrage ; `muted` est ce
                        qui autorise la lecture automatique, aucun navigateur
                        ne la donnant à une vidéo sonore.

                        Elle est mise en pause pour qui a demandé moins
                        d'animations — voir le script en pied de composant :
                        le CSS ne sait pas arrêter une vidéo.
                      */
                      <video
                        class="statement__image statement__video"
                        src={figure.video.url}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                        data-statement-video
                      />
                    ) : figure.image?.asset ? (
                      <SanityImage
                        image={figure.image}
                        width={figureIndex === 4 ? 1100 : 900}
                        sizes={figureIndex === 4
                          ? '(min-width: 768px) 29vw, 80vw'
                          : '(min-width: 768px) 25vw, 80vw'}
                        class="statement__image"
                      />
                    ) : (
                      figure.fallbackImage && (
                        /*
                          `alt` vide : la légende adjacente porte déjà la
                          référence. Les visuels du CMS utilisent leur propre
                          champ « texte alternatif ».
                        */
                        <Image
                          src={figure.fallbackImage}
                          alt=""
                          widths={figureIndex === 4 ? [400, 900, 1200] : [400, 900]}
                          sizes={figureIndex === 4
                            ? '(min-width: 768px) 36vw, 80vw'
                            : '(min-width: 768px) 25vw, 80vw'}
                          loading="lazy"
                          class="statement__image"
                        />
                      )
                    )}

                    {(figure.label.reference || figure.label.text) && (
                      <FigureCaption
                        reference={figure.label.reference}
                        text={figure.label.text}
                        class="statement__caption"
                        editable={sectionFieldAttribute(
                          documentId,
                          documentType,
                          section._key,
                          `figures[_key=="${figure._key}"].caption`,
                        )}
                      />
                    )}
                  </figure>
                ))}

                {section.marker && (
                  <p class="type-note statement__marker">{section.marker}</p>
                )}

                {/*
                  Placé dans la planche pour venir sous la dernière figure.

                  Libellé et destination sont FIXÉS EN CODE, comme les titres de
                  section : ce bouton mène à la méthode, la suite que la
                  déclaration appelle. En faire un champ, c'était proposer de le
                  vider — et le vider laissait la déclaration sans suite.
                */}
                <div class="statement__actions">
                  <a href={`${laboPath(locale)}#methode`} class="button-minimal">
                    <span class="button-minimal__label">{t('home.enterStudio')}</span>
                    <span class="button-minimal__arrow" aria-hidden="true">↳</span>
                  </a>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
  <div class="statement__tail" aria-hidden="true"></div>
</section>

<style>
  .statement {
    --intro-x: 100vw;
    --intro-travel: 100svh;
    --scene-tail: 0px;
    --scene-lift: clamp(1.5rem, 5svh, 3rem);
    --plate-lift: clamp(10rem, 28svh, 15rem);
    position: relative;
    margin-top: -200svh;
    /*
      Le rail est réservé dès le début de l'entrée horizontale. La largeur
      ne change donc plus lorsque `rail-docked` est ajouté à la fin du trajet.
    */
    padding-left: var(--rail-width);
    padding-bottom: clamp(5rem, 12vh, 9rem);
    overflow: clip;
  }

  /*
    Au retour du scroll vertical, la section passe devant l'ancienne scène
    sticky. La découpe préserve le rail fixe et supprime la bande de fond qui
    recouvrait le haut des images.
  */
  :global(html.statement-vertical) .statement {
    z-index: 31;
    clip-path: inset(0 0 0 var(--rail-width));
  }

  .statement__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  .statement__intro-runway {
    height: calc(100svh + var(--intro-travel));
  }

  .statement__intro-stage {
    position: sticky;
    top: 0;
    z-index: 31;
    height: 100svh;
    /* La scène transparente ne doit pas bloquer le menu placé derrière. */
    pointer-events: none;
  }

  /*
    …sauf dans le Presentation Tool, une fois la scène ARRIVÉE.

    Cette transparence au pointeur rendait la scène entière inéditable : ni le
    texte de la note, ni les légendes des figures ne pouvaient être survolés, et
    l'overlay n'avait donc rien à surligner. Le piège est qu'on ne peut pas y
    remédier élément par élément — un texte éditable par sa traîne stega ne
    porte aucun attribut sur lequel s'accrocher.

    On rend donc la scène sensible au pointeur pendant l'édition — mais
    seulement une fois son entrée horizontale terminée, ce que dit
    `statement-vertical`. Pendant tout le trajet, la scène couvre l'écran de la
    largeur du rail jusqu'au bord droit : sensible au pointeur d'un bout à
    l'autre, elle prenait les clics du menu de l'accueil, qui traverse la même
    distance en sens inverse. Les entrées n'étaient donc atteignables qu'une
    fois ancrées à gauche, hors de la boîte de la scène.

    Les deux états s'excluent par construction : le menu s'ancre exactement
    quand la scène a fini d'entrer. À l'arrivée, la scène est éditable et le
    rail est en dehors d'elle ; avant, le rail se clique et la scène, en plein
    vol, n'avait de toute façon rien d'éditable.
  */
  :global(html[data-visual-editing].statement-vertical) .statement__intro-stage {
    pointer-events: auto;
  }

  .statement__scene {
    transform: translate3d(var(--intro-x), calc(-1 * var(--scene-lift)), 0);
    will-change: transform;
  }

  .statement__text-slot {
    display: flex;
    align-items: center;
    height: 100svh;
  }

  .statement__tail {
    height: var(--scene-tail);
  }

  .statement__body {
    /*
      La planche fait partie de la même scène que le texte : aucune compensation
      verticale n'est nécessaire et leur écart reste structurellement constant.
    */
    margin-top: calc(-1 * (clamp(3rem, 9vh, 7rem) + var(--plate-lift)));
  }

  /*
    Pleine largeur : la déclaration occupe tout l'espace disponible, qui est
    déjà réduit de la largeur du rail par la règle globale `html.rail-docked`.
    Aucune largeur à recalculer ici — le décalage du menu est déjà pris en
    compte en amont.
  */
  .statement__lede {
    max-width: none;
  }

  .statement__text {
    /* Retrait de première ligne : reprend la mise en page d'un texte imprimé. */
    text-indent: 3em;
  }

  :global(.statement__emphasis) {
    font-family: var(--font-annotation);
    font-style: italic;
    font-weight: 400;
    letter-spacing: var(--tracking-annotation);
  }

  /*
    Largeur volontairement plus étroite que la déclaration, pour que la note
    tienne sur deux lignes. `balance` répartit ensuite les mots entre elles
    plutôt que de laisser une seconde ligne orpheline.
  */
  .statement__note {
    max-width: 34rem;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    text-wrap: balance;
  }

  .statement__note {
    font-size: var(--text-note);
    line-height: 1.25;
    color: var(--color-ink);
  }

  /* ── Planche ──────────────────────────────────────────────────────────── */
  .statement__plate {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(7rem, 12vw, 12rem);
    align-items: start;
    margin-top: clamp(3rem, 9vh, 7rem);
  }

  /*
    Gabarit par défaut, pour toute figure au-delà de la cinquième : les cinq
    premières reçoivent leur place explicitement, juste en dessous.
  */
  .statement__figure {
    grid-column: span 3;
    min-width: 0;
  }

  /*
    ┌─ LA COMPOSITION EST FIXÉE EN CODE ────────────────────────────────────┐
    │ Largeur, débord et rejet à droite étaient trois réglages du Studio.   │
    │ Ils ne le sont plus : la planche est une DIRECTION ARTISTIQUE, pas un │
    │ gabarit à remplir. Les blancs y font partie du rythme au même titre   │
    │ que les images, et une figure déplacée d'une colonne ne produit pas   │
    │ une variante mais une planche cassée.                                 │
    │                                                                        │
    │ C'est la même règle que pour l'enchaînement des blocs de l'accueil,   │
    │ verrouillé lui aussi : ce qui relève de la mise en page ne se propose │
    │ pas à la saisie. Ce qui reste éditable, c'est l'image et sa légende.  │
    │                                                                        │
    │ Les positions restent exprimées en GRILLE, jamais en pixels : elles   │
    │ suivent ainsi la largeur du contenu et le rail latéral.               │
    └────────────────────────────────────────────────────────────────────────┘
  */
  .statement__figure:nth-child(1) {
    grid-column: 1 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(2) {
    grid-column: 4 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(3) {
    grid-column: 10 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(4) {
    grid-column: 1 / span 3;
    grid-row: 2;
  }

  /*
    La grande figure de la planche. Elle occupait cinq colonnes sur douze —
    près de la moitié de la largeur — et écrasait les quatre autres, qui n'en
    tiennent que trois. À quatre, elle reste la plus grande sans devenir le
    sujet de la planche.
  */
  .statement__figure:nth-child(5) {
    grid-column: 8 / span 4;
    grid-row: 2;
  }

  .statement__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    ┌─ LES BANDES NOIRES SONT DANS LE FICHIER ──────────────────────────────┐
    │ Le montage a été exporté dans un cadre 9:16 alors que le plan est     │
    │ plus large : deux bandes noires l'encadrent, INCRUSTÉES dans la       │
    │ vidéo. Rien dans la page ne les ajoutait — la boîte avait exactement  │
    │ le rapport de la source.                                              │
    │                                                                        │
    │ On les rogne donc : la boîte prend le rapport de l'IMAGE UTILE, et    │
    │ `cover` fait déborder la vidéo de part et d'autre, exactement de la   │
    │ hauteur des bandes. Le plan n'est pas recadré sur les côtés — le      │
    │ débordement est vertical et symétrique, comme les bandes.             │
    │                                                                        │
    │ Le rapport est MESURÉ au chargement, pas écrit ici : une autre vidéo  │
    │ aurait d'autres bandes, ou pas du tout. Sans mesure, il reste le      │
    │ rapport de la source, et la vidéo s'affiche telle quelle.             │
    └────────────────────────────────────────────────────────────────────────┘
  */
  .statement__video {
    aspect-ratio: var(--video-ratio, auto);
    object-fit: cover;
    /* Le fond évite le rectangle noir tant que la première image n'est pas là. */
    background-color: var(--color-surface);
  }

  .statement__caption {
    margin-top: 0.6rem;
    font-size: var(--text-note);
    line-height: 1.25;
    color: var(--color-ink);
  }

  /*
    Mention technique et bouton reçoivent une position explicite : l'ordre du
    DOM suit la logique de lecture (figures, puis mention, puis action), tandis
    que la grille les replace dans la composition.
  */
  .statement__marker {
    grid-column: 7 / span 3;
    grid-row: 1;
    /* Posée à mi-hauteur de la planche plutôt qu'en tête de rangée. */
    align-self: center;
    text-align: center;
  }

  .statement__actions {
    grid-column: span 3 / -1;
    grid-row: 2;
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }

  .statement__plate[data-lower-row] .statement__actions {
    grid-column: span 3 / -1;
    grid-row: 3;
    justify-content: flex-end;
    margin-top: calc(-1 * clamp(2rem, 4vw, 4rem));
  }

  /* ── Mobile : la planche s'empile, plus de débord ─────────────────────── */
  @media (max-width: 767px) {
    .statement {
      margin-top: 0;
      padding-left: 0;
      padding-block: clamp(5rem, 12vh, 9rem);
      overflow: hidden;
      clip-path: none;
    }

    .statement__intro-runway {
      height: auto;
    }

    .statement__intro-stage {
      position: static;
      display: block;
      height: auto;
    }

    .statement__scene {
      transform: none;
    }

    .statement__text-slot {
      height: auto;
    }

    .statement__tail {
      display: none;
    }

    .statement__body {
      margin-top: 0;
    }

    .statement__text {
      text-align: left;
      text-indent: 2em;
    }

    /*
      La grille de bureau range les figures en cases égales ; en colonne
      unique, la planche s'assemble plutôt à la main — chaque image garde son
      propre gabarit et son propre bord, comme des tirages posés côte à côte
      plutôt que rangés dans un classeur.
    */
    .statement__plate {
      display: flex;
      flex-direction: column;
      row-gap: clamp(3rem, 10vw, 5rem);
      align-items: stretch;
    }

    .statement__figure,
    .statement__figure:nth-child(n) {
      width: auto;
      max-width: none;
    }

    .statement__figure:nth-child(1) {
      width: 64%;
      align-self: flex-start;
    }

    .statement__figure:nth-child(2) {
      width: 82%;
      align-self: flex-end;
    }

    .statement__figure:nth-child(3) {
      width: 56%;
      align-self: flex-start;
    }

    .statement__figure:nth-child(4) {
      width: 74%;
      align-self: flex-end;
    }

    .statement__figure:nth-child(5) {
      width: 94%;
      align-self: center;
    }

    .statement__marker {
      align-self: flex-start;
      text-align: left;
    }

    .statement__actions,
    .statement__plate[data-lower-row] .statement__actions {
      align-self: flex-end;
      justify-content: flex-end;
      margin-top: clamp(1.5rem, 4vh, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 768px) {
    .statement {
      margin-top: 0;
      padding-left: 0;
      padding-block: clamp(5rem, 12vh, 9rem);
      clip-path: none;
    }

    .statement__intro-runway {
      height: auto;
    }

    .statement__intro-stage {
      position: static;
      display: block;
      height: auto;
    }

    .statement__scene {
      transform: none;
    }

    .statement__text-slot {
      height: auto;
    }

    .statement__tail {
      display: none;
    }

    .statement__body {
      margin-top: 0;
    }
  }
</style>

<script>
  /*
    Mouvement réduit : on ARRÊTE les vidéos de la planche.

    `prefers-reduced-motion` est une préférence système qu'aucune règle CSS ne
    peut appliquer à une vidéo — `animation: none` n'a pas de prise sur une
    lecture. Il faut donc la retirer ici, et retirer aussi `autoplay`, sans
    quoi un rechargement la relancerait.

    La préférence est écoutée : elle peut changer pendant la visite.
  */
  const reducedMotionVideos = window.matchMedia('(prefers-reduced-motion: reduce)');

  /*
    Mesure des bandes noires incrustées, sur une image de la vidéo.

    On relit la source en `crossOrigin: anonymous` plutôt que de dessiner
    l'élément déjà en page : sans cet attribut posé AVANT le chargement, le
    canevas est « teinté » par l'origine distante et devient illisible.

    On sonde UNE colonne, au milieu de l'image : les bandes traversent toute
    la largeur, une colonne suffit à les mesurer, et c'est mille fois moins de
    pixels à lire que l'image entière.
  */
  const NOIR = 24;

  const measureBars = async (video: HTMLVideoElement) => {
    const source = video.getAttribute('src');
    if (!source) return;

    const probe = document.createElement('video');
    probe.crossOrigin = 'anonymous';
    probe.muted = true;
    probe.src = source;

    await new Promise<void>((resolve, reject) => {
      probe.onloadeddata = () => resolve();
      probe.onerror = () => reject(new Error('video'));
    });

    // Pas la toute première image : une ouverture en fondu au noir tromperait la mesure.
    probe.currentTime = Math.min(0.5, (probe.duration || 1) / 2);
    await new Promise<void>((resolve) => {
      probe.onseeked = () => resolve();
      window.setTimeout(resolve, 2000);
    });

    const canvas = document.createElement('canvas');
    canvas.width = probe.videoWidth;
    canvas.height = probe.videoHeight;
    if (!canvas.width || !canvas.height) return;

    const context = canvas.getContext('2d');
    if (!context) return;
    context.drawImage(probe, 0, 0);

    const column = context.getImageData(Math.floor(canvas.width / 2), 0, 1, canvas.height).data;
    const isBlack = (row: number) =>
      column[row * 4] < NOIR && column[row * 4 + 1] < NOIR && column[row * 4 + 2] < NOIR;

    let top = 0;
    while (top < canvas.height && isBlack(top)) top += 1;
    let bottom = canvas.height - 1;
    while (bottom > top && isBlack(bottom)) bottom -= 1;

    const useful = bottom - top + 1;
    // Rien de noir, ou une image entièrement sombre : on ne touche à rien.
    if (useful >= canvas.height || useful < canvas.height / 4) return;

    video.style.setProperty('--video-ratio', `${canvas.width} / ${useful}`);
  };

  for (const video of document.querySelectorAll<HTMLVideoElement>('[data-statement-video]')) {
    // Silencieux : une mesure impossible (origine, format) laisse la vidéo intacte.
    measureBars(video).catch(() => {});
  }

  const syncStatementVideos = () => {
    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-statement-video]')) {
      if (reducedMotionVideos.matches) {
        video.autoplay = false;
        video.pause();
      } else {
        video.autoplay = true;
        // `play()` rend une promesse rejetée si le navigateur refuse : sans
        // rattrapage, elle remonterait en erreur non gérée dans la console.
        video.play().catch(() => {});
      }
    }
  };

  syncStatementVideos();
  reducedMotionVideos.addEventListener('change', syncStatementVideos);
</script>

<script>
  const statements = document.querySelectorAll<HTMLElement>('[data-statement-intro]');
  const desktop = window.matchMedia('(min-width: 768px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const statement of statements) {
    const runway = statement.querySelector<HTMLElement>('.statement__intro-runway');
    const scene = statement.querySelector<HTMLElement>('.statement__scene');
    if (!runway || !scene) continue;

    let ticking = false;

    const syncTail = () => {
      if (!desktop.matches || reducedMotion.matches) {
        statement.style.removeProperty('--scene-tail');
        return;
      }

      const tail = Math.max(scene.scrollHeight - window.innerHeight, 0);
      statement.style.setProperty('--scene-tail', `${tail}px`);
    };

    const update = () => {
      ticking = false;

      if (!desktop.matches || reducedMotion.matches) {
        statement.style.removeProperty('--intro-x');
        statement.style.removeProperty('--scene-tail');
        document.documentElement.classList.remove('statement-vertical');
        return;
      }

      const rect = runway.getBoundingClientRect();
      const travel = window.innerHeight;
      if (travel <= 0) return;

      const elapsed = Math.min(Math.max(-rect.top, 0), travel);
      const remaining = travel - elapsed;
      const horizontalOffset = (remaining / travel) * window.innerWidth;

      // Toute la scène partage ce seul déplacement horizontal.
      statement.style.setProperty('--intro-x', `${horizontalOffset}px`);
      document.documentElement.classList.toggle('statement-vertical', remaining <= 0);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    new ResizeObserver(syncTail).observe(scene);
    syncTail();
    update();
  }
</script>
