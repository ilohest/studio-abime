---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import SmartLink from '~/components/primitives/SmartLink.astro';
import FigureCaption from '~/components/primitives/FigureCaption.astro';
import { stegaClean } from '@sanity/client/stega';

import { figureLabel } from '~/lib/figureLabel';
import type { Locale } from '~/i18n/config';
import type { StudioStatement } from '~/lib/sanity/types';

/**
 * Manifeste illustré — déclaration, note, planche de figures, appel à action.
 *
 * La planche repose sur une grille de 12 colonnes. Ses cinq premières figures
 * suivent la composition éditoriale de référence (trois en haut, deux en bas),
 * tandis que les médias et leurs légendes restent pilotés depuis le CMS.
 */
interface Props {
  section: StudioStatement;
  locale: Locale;
}

const { section, locale } = Astro.props;

/**
 * Les trois notions structurantes de la déclaration reçoivent la voix
 * manuscrite de l'exemple, sans transformer le champ Sanity en contenu riche.
 * La chaîne originale — et ses marqueurs d'édition visuelle — reste intacte.
 */
const statementParts = section.statement.split(/(les outils|les langages|espace)/gi);
const emphasizedStatementParts = new Set(['espace', 'les outils', 'les langages']);

/*
  Repère et texte sont saisis dans un seul champ ; `figureLabel()` en extrait le
  repère de tête pour lui garder sa mise en forme. Les anciens champs séparés
  sont recomposés au passage, sans migration de contenu.
*/
const note = figureLabel(section.noteNumber, section.note);

const figures = (section.figures ?? []).map((figure) => ({
  ...figure,
  label: figureLabel(figure.number, figure.caption),
}));
---

<section class="statement" data-statement-intro>
  <div class="statement__intro-runway">
    <div class="statement__intro-stage">
      <div class="statement__inner statement__scene">
        <div class="statement__text-slot">
          {/*
            Déclaration et note partagent un même conteneur : leurs bords
            gauches restent alignés, quelle que soit la largeur de composition.
          */}
          <div class="statement__lede">
            <p class="type-declaration statement__text">
              {statementParts.map((part) =>
                emphasizedStatementParts.has(part.toLocaleLowerCase('fr')) ? (
                  <em class="statement__emphasis">{part}</em>
                ) : (
                  part
                ),
              )}
            </p>

            {(note.reference || note.text) && (
              <FigureCaption
                as="p"
                reference={note.reference}
                text={note.text}
                class="statement__note"
              />
            )}
          </div>
        </div>

        <div class="statement__body">
          {/* ── Planche de figures ────────────────────────────────────── */}
          {
            figures.length > 0 && (
              <div
                class="statement__plate"
                data-lower-row={figures.length >= 4 ? '' : undefined}
              >
                {figures.map((figure, figureIndex) => (
                  <figure
                    class="statement__figure"
                    data-bleed={stegaClean(figure.bleed) ?? 'none'}
                    data-push={figure.pushRight ? '' : undefined}
                    style={`--span:${Math.min(Math.max(figure.span ?? 3, 1), 12)}`}
                  >
                    {figure.image?.asset ? (
                      <SanityImage
                        image={figure.image}
                        width={figureIndex === 4 ? 1200 : 900}
                        sizes={figureIndex === 4
                          ? '(min-width: 768px) 36vw, 80vw'
                          : '(min-width: 768px) 25vw, 80vw'}
                        class="statement__image"
                      />
                    ) : (
                      figure.fallbackImage && (
                        /*
                          `alt` vide : la légende adjacente porte déjà la
                          référence. Les visuels du CMS utilisent leur propre
                          champ « texte alternatif ».
                        */
                        <Image
                          src={figure.fallbackImage}
                          alt=""
                          widths={figureIndex === 4 ? [400, 900, 1200] : [400, 900]}
                          sizes={figureIndex === 4
                            ? '(min-width: 768px) 36vw, 80vw'
                            : '(min-width: 768px) 25vw, 80vw'}
                          loading="lazy"
                          class="statement__image"
                        />
                      )
                    )}

                    {(figure.label.reference || figure.label.text) && (
                      <FigureCaption
                        reference={figure.label.reference}
                        text={figure.label.text}
                        class="statement__caption"
                      />
                    )}
                  </figure>
                ))}

                {section.marker && (
                  <p class="type-note statement__marker">{section.marker}</p>
                )}

                {/* Placé dans la planche pour venir sous la dernière figure. */}
                <div class="statement__actions">
                  <SmartLink link={section.cta} locale={locale} class="button-minimal" arrow />
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
  <div class="statement__tail" aria-hidden="true"></div>
</section>

<style>
  .statement {
    --intro-x: 100vw;
    --intro-travel: 100svh;
    --scene-tail: 0px;
    --scene-lift: clamp(1.5rem, 5svh, 3rem);
    --plate-lift: clamp(10rem, 28svh, 15rem);
    position: relative;
    margin-top: -200svh;
    /*
      Le rail est réservé dès le début de l'entrée horizontale. La largeur
      ne change donc plus lorsque `rail-docked` est ajouté à la fin du trajet.
    */
    padding-left: var(--rail-width);
    padding-bottom: clamp(5rem, 12vh, 9rem);
    overflow: clip;
  }

  /*
    Au retour du scroll vertical, la section passe devant l'ancienne scène
    sticky. La découpe préserve le rail fixe et supprime la bande de fond qui
    recouvrait le haut des images.
  */
  :global(html.statement-vertical) .statement {
    z-index: 31;
    clip-path: inset(0 0 0 var(--rail-width));
  }

  .statement__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  .statement__intro-runway {
    height: calc(100svh + var(--intro-travel));
  }

  .statement__intro-stage {
    position: sticky;
    top: 0;
    z-index: 31;
    height: 100svh;
    /* La scène transparente ne doit pas bloquer le menu placé derrière. */
    pointer-events: none;
  }

  .statement__scene {
    transform: translate3d(var(--intro-x), calc(-1 * var(--scene-lift)), 0);
    will-change: transform;
  }

  .statement__text-slot {
    display: flex;
    align-items: center;
    height: 100svh;
  }

  .statement__tail {
    height: var(--scene-tail);
  }

  .statement__body {
    /*
      La planche fait partie de la même scène que le texte : aucune compensation
      verticale n'est nécessaire et leur écart reste structurellement constant.
    */
    margin-top: calc(-1 * (clamp(3rem, 9vh, 7rem) + var(--plate-lift)));
  }

  /*
    Pleine largeur : la déclaration occupe tout l'espace disponible, qui est
    déjà réduit de la largeur du rail par la règle globale `html.rail-docked`.
    Aucune largeur à recalculer ici — le décalage du menu est déjà pris en
    compte en amont.
  */
  .statement__lede {
    max-width: none;
  }

  .statement__text {
    /* Retrait de première ligne : reprend la mise en page d'un texte imprimé. */
    text-indent: 3em;
  }

  :global(.statement__emphasis) {
    font-family: var(--font-annotation);
    font-style: italic;
    font-weight: 400;
    letter-spacing: var(--tracking-annotation);
  }

  /*
    Largeur volontairement plus étroite que la déclaration, pour que la note
    tienne sur deux lignes. `balance` répartit ensuite les mots entre elles
    plutôt que de laisser une seconde ligne orpheline.
  */
  .statement__note {
    max-width: 34rem;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    text-wrap: balance;
  }

  .statement__note {
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--color-ink);
  }

  /* ── Planche ──────────────────────────────────────────────────────────── */
  .statement__plate {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(7rem, 12vw, 12rem);
    align-items: start;
    margin-top: clamp(3rem, 9vh, 7rem);
  }

  .statement__figure {
    grid-column: span var(--span);
    min-width: 0;
  }

  /*
    Débord : la figure sort de la marge du bloc sans élargir la page — le
    `overflow: hidden` de la section coupe proprement le dépassement.
  */
  .statement__figure[data-bleed='left'] {
    margin-inline-start: calc(-1 * clamp(1.5rem, 4vw, 4rem));
  }

  .statement__figure[data-bleed='right'] {
    margin-inline-end: calc(-1 * clamp(1.5rem, 4vw, 4rem));
  }

  /* Pousse la figure en fin de rangée, en absorbant l'espace disponible. */
  .statement__figure[data-push] {
    grid-column: span var(--span) / -1;
  }

  /*
    Composition desktop de la planche de référence : les blancs font partie
    du rythme au même titre que les images. Les positions restent exprimées en
    grille, jamais en pixels absolus, pour suivre naturellement la largeur du
    contenu et le rail latéral.
  */
  .statement__figure:nth-child(1) {
    grid-column: 1 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(2) {
    grid-column: 4 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(3) {
    grid-column: 10 / span 3;
    grid-row: 1;
  }

  .statement__figure:nth-child(4) {
    grid-column: 1 / span 3;
    grid-row: 2;
  }

  .statement__figure:nth-child(5) {
    grid-column: 7 / span 5;
    grid-row: 2;
  }

  .statement__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .statement__caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    line-height: 1.25;
    color: var(--color-ink);
  }

  /*
    Mention technique et bouton reçoivent une position explicite : l'ordre du
    DOM suit la logique de lecture (figures, puis mention, puis action), tandis
    que la grille les replace dans la composition.
  */
  .statement__marker {
    grid-column: 7 / span 3;
    grid-row: 1;
    /* Posée à mi-hauteur de la planche plutôt qu'en tête de rangée. */
    align-self: center;
    text-align: center;
  }

  .statement__actions {
    grid-column: span 3 / -1;
    grid-row: 2;
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
  }

  .statement__plate[data-lower-row] .statement__actions {
    grid-column: 2 / span 3;
    grid-row: 3;
    margin-top: calc(-1 * clamp(2rem, 4vw, 4rem));
  }

  /* ── Mobile : la planche s'empile, plus de débord ─────────────────────── */
  @media (max-width: 767px) {
    .statement {
      margin-top: 0;
      padding-left: 0;
      padding-block: clamp(5rem, 12vh, 9rem);
      overflow: hidden;
      clip-path: none;
    }

    .statement__intro-runway {
      height: auto;
    }

    .statement__intro-stage {
      position: static;
      display: block;
      height: auto;
    }

    .statement__scene {
      transform: none;
    }

    .statement__text-slot {
      height: auto;
    }

    .statement__tail {
      display: none;
    }

    .statement__body {
      margin-top: 0;
    }

    .statement__text {
      text-align: left;
      text-indent: 0;
    }

    .statement__plate {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: clamp(2.5rem, 8vh, 4rem);
      align-items: start;
    }

    .statement__figure,
    .statement__figure:nth-child(n) {
      grid-column: span 1;
      grid-row: auto;
    }

    .statement__figure[data-bleed='left'],
    .statement__figure[data-bleed='right'] {
      margin-inline: 0;
    }

    .statement__figure[data-push] {
      grid-column-end: auto;
    }

    .statement__marker {
      grid-column: span 2;
      grid-row: auto;
      text-align: left;
    }

    .statement__actions,
    .statement__plate[data-lower-row] .statement__actions {
      grid-column: span 2;
      grid-row: auto;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 768px) {
    .statement {
      margin-top: 0;
      padding-left: 0;
      padding-block: clamp(5rem, 12vh, 9rem);
      clip-path: none;
    }

    .statement__intro-runway {
      height: auto;
    }

    .statement__intro-stage {
      position: static;
      display: block;
      height: auto;
    }

    .statement__scene {
      transform: none;
    }

    .statement__text-slot {
      height: auto;
    }

    .statement__tail {
      display: none;
    }

    .statement__body {
      margin-top: 0;
    }
  }
</style>

<script>
  const statements = document.querySelectorAll<HTMLElement>('[data-statement-intro]');
  const desktop = window.matchMedia('(min-width: 768px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const statement of statements) {
    const runway = statement.querySelector<HTMLElement>('.statement__intro-runway');
    const scene = statement.querySelector<HTMLElement>('.statement__scene');
    if (!runway || !scene) continue;

    let ticking = false;

    const syncTail = () => {
      if (!desktop.matches || reducedMotion.matches) {
        statement.style.removeProperty('--scene-tail');
        return;
      }

      const tail = Math.max(scene.scrollHeight - window.innerHeight, 0);
      statement.style.setProperty('--scene-tail', `${tail}px`);
    };

    const update = () => {
      ticking = false;

      if (!desktop.matches || reducedMotion.matches) {
        statement.style.removeProperty('--intro-x');
        statement.style.removeProperty('--scene-tail');
        document.documentElement.classList.remove('statement-vertical');
        return;
      }

      const rect = runway.getBoundingClientRect();
      const travel = window.innerHeight;
      if (travel <= 0) return;

      const elapsed = Math.min(Math.max(-rect.top, 0), travel);
      const remaining = travel - elapsed;
      const horizontalOffset = (remaining / travel) * window.innerWidth;

      // Toute la scène partage ce seul déplacement horizontal.
      statement.style.setProperty('--intro-x', `${horizontalOffset}px`);
      document.documentElement.classList.toggle('statement-vertical', remaining <= 0);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    new ResizeObserver(syncTail).observe(scene);
    syncTail();
    update();
  }
</script>
