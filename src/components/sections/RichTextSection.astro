---
import PortableText from '~/components/primitives/PortableText.astro';
import type { Locale } from '~/i18n/config';
import type { RichTextSection } from '~/lib/sanity/types';

interface Props {
  section: RichTextSection;
  locale: Locale;
  /**
   * `_updatedAt` du document. Seules les pages légales s'en servent, pour le
   * renvoi « Date de dernière mise à jour » (`identityValue`) : une date de
   * révision saisie à la main finit toujours par annoncer une révision qui n'a
   * pas eu lieu.
   */
  documentUpdatedAt?: string;
}

const { section, locale, documentUpdatedAt } = Astro.props;
---

<section class="py-(--spacing-section)">
  <div class="container-wide">
    <div class="reading-column">
      {section.eyebrow && <p class="type-sous-titre text-muted">{section.eyebrow}</p>}
      {section.heading && <h2 class="type-titre mt-3 text-balance" data-text-reveal>{section.heading}</h2>}

      <PortableText value={section.body} locale={locale} updatedAt={documentUpdatedAt} class="mt-8" />
    </div>
  </div>
</section>
