---
import PortableText from '~/components/primitives/PortableText.astro';
import type { Locale } from '~/i18n/config';
import type { RichTextSection } from '~/lib/sanity/types';

interface Props {
  section: RichTextSection;
  locale: Locale;
}

const { section, locale } = Astro.props;
---

<section class="py-(--spacing-section)">
  <div class="container-wide">
    <div class="mx-auto max-w-[44rem]">
      {section.eyebrow && <p class="type-sous-titre text-muted">{section.eyebrow}</p>}
      {section.heading && <h2 class="type-titre mt-3 text-balance">{section.heading}</h2>}

      <PortableText value={section.body} locale={locale} class="mt-8" />
    </div>
  </div>
</section>
