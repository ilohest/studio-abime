---
import ManifestoHero from './ManifestoHero.astro';
import ServicesMenu from './ServicesMenu.astro';
import StudioStatement from './StudioStatement.astro';
import PullQuote from './PullQuote.astro';
import PlateSpread from './PlateSpread.astro';
import ProjectShowcaseGrid from './ProjectShowcaseGrid.astro';
import FullBleedImage from './FullBleedImage.astro';
import Testimonials from './Testimonials.astro';
import HeroSection from './HeroSection.astro';
import RichTextSection from './RichTextSection.astro';
import MediaSection from './MediaSection.astro';
import ProjectListSection from './ProjectListSection.astro';
import CtaSection from './CtaSection.astro';

import { SECTION_TYPE_NAMES } from '~/lib/sections';
import type { Locale } from '~/i18n/config';
import type { Section } from '~/lib/sanity/types';

/**
 * Rendu du page builder.
 *
 * Registre `_type` (Sanity) → composant (Astro). C'est le pendant exact de
 * `sanity/schemaTypes/objects/sections/index.ts`, et les deux lisent désormais
 * la MÊME liste de noms (`src/lib/sections.ts`) : elles ne peuvent plus
 * diverger sans que le Studio le dise au chargement.
 *
 * ➜ AJOUTER UNE SECTION :
 *    1. le nom dans `SECTION_TYPE_NAMES` (`src/lib/sections.ts`) ;
 *    2. schéma dans `sanity/schemaTypes/objects/sections/` + export dans son index ;
 *    3. composant dans ce dossier ;
 *    4. une ligne dans le `switch` ci-dessous.
 *
 * Un `_type` inconnu (schéma déployé mais rendu pas encore livré) est ignoré
 * silencieusement en production et signalé en développement — jamais d'écran
 * blanc pour l'éditeur.
 */
interface Props {
  sections?: Section[] | null;
  locale: Locale;
  /** Date de révision du document, relayée aux blocs qui savent la citer. */
  documentUpdatedAt?: string;
  /**
   * Identité du document portant ces sections. Sert aux blocs qui transforment
   * leur texte (découpe, `stegaClean`) et doivent donc désigner leur champ
   * explicitement pour rester éditables — voir `src/lib/visualEditing.ts`.
   */
  documentId?: string;
  documentType?: string;
}

const { sections, locale, documentUpdatedAt, documentId, documentType } = Astro.props;

if (import.meta.env.DEV) {
  const known: readonly string[] = SECTION_TYPE_NAMES;
  for (const section of sections ?? []) {
    if (!known.includes(section._type)) {
      console.warn(`[sections] Aucun composant pour le type « ${section._type} ». Section ignorée.`);
    }
  }
}
---

{
  (sections ?? []).map((section, index) => {
    const isFirst = index === 0;

    switch (section._type) {
      case 'manifestoHero':
        return <ManifestoHero section={section} locale={locale} />;
      case 'servicesMenu':
        return <ServicesMenu section={section} locale={locale} />;
      case 'studioStatement':
        return (
          <StudioStatement
            section={section}
            locale={locale}
            documentId={documentId}
            documentType={documentType}
          />
        );
      case 'pullQuote':
        return (
          <PullQuote
            section={section}
            documentId={documentId}
            documentType={documentType}
          />
        );
      case 'plateSpread':
        return <PlateSpread section={section} />;
      case 'projectShowcase':
        return <ProjectShowcaseGrid section={section} locale={locale} />;
      case 'fullBleedImage':
        return <FullBleedImage section={section} />;
      case 'testimonials':
        return <Testimonials section={section} />;
      case 'heroSection':
        return <HeroSection section={section} locale={locale} isFirst={isFirst} />;
      case 'richTextSection':
        return <RichTextSection section={section} locale={locale} documentUpdatedAt={documentUpdatedAt} />;
      case 'mediaSection':
        return <MediaSection section={section} />;
      case 'projectListSection':
        return <ProjectListSection section={section} locale={locale} />;
      case 'ctaSection':
        return <CtaSection section={section} locale={locale} />;
      default:
        return null;
    }
  })
}
