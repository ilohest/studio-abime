---
import SanityImage from '~/components/primitives/SanityImage.astro';
import FigureCaption from '~/components/primitives/FigureCaption.astro';
import type { MediaSection } from '~/lib/sanity/types';

interface Props {
  section: MediaSection;
}

const { section } = Astro.props;

const columns = section.columns ?? 2;
const ratio = section.ratio ?? 'landscape';

const gridClass = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
}[columns];

// Les images sont demandées à la taille réellement affichée, pas à la taille max.
const sizes = {
  1: '100vw',
  2: '(min-width: 768px) 50vw, 100vw',
  3: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
}[columns];
---

<section class="py-(--spacing-section)">
  <div class="container-wide">
    <ul class:list={['grid gap-6', gridClass]}>
      {
        section.items?.map((item) => (
          <li>
            <figure>
              <SanityImage
                image={item.image}
                width={columns === 1 ? 1600 : 900}
                ratio={ratio}
                sizes={sizes}
                class="w-full object-cover"
              />
              {item.caption && (
                <FigureCaption value={item.caption} class="mt-3 text-muted" />
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
