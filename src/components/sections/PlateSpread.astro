---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import FigureCaption from '~/components/primitives/FigureCaption.astro';
import { figureLabel } from '~/lib/figureLabel';
import type { PlateSpread } from '~/lib/sanity/types';

/**
 * Planche — double page d'herbier, sur laquelle se posent des figures.
 *
 * Le fond est une trame et non une illustration : il est fortement atténué,
 * pour que les figures posées par-dessus restent le sujet.
 *
 * Les figures se répartissent en colonnes de part et d'autre du pli. Elles ne
 * sont pas positionnées en absolu : une grille laisse la planche se recomposer
 * seule quand la largeur change — et s'empiler en dessous de 768 px.
 */
interface Props {
  section: PlateSpread;
}

const { section } = Astro.props;
/* Repère et légende tiennent dans un seul champ — voir `figureLabel()`. */
const figures = (section.figures ?? []).map((figure) => ({
  ...figure,
  label: figureLabel(figure.number, figure.caption),
}));
const hasSanityBackground = Boolean(section.background?.asset);
---

<section class="plate surface-paper">
  <div class="plate__grain surface-paper-grain"></div>

  {/*
    Le fond de planche et les figures sont enfermés dans un conteneur commun.
    Positionné en absolu directement sur la section, le fond se calerait sur sa
    boîte de remplissage — donc jusque sous le retrait réservé au menu ancré.
    Ici il s'arrête à la zone de contenu. Le grain, lui, reste en pleine largeur :
    c'est le papier de la page, il doit rester continu sous le menu.
  */}
  <div class="plate__inner">
    {/* ── Fond : la double page imprimée ───────────────────────────────── */}
    <div class="plate__background" aria-hidden="true">
    {
      hasSanityBackground ? (
        <SanityImage image={section.background} width={1600} sizes="100vw" class="plate__backdrop" />
      ) : (
        section.fallbackBackground && (
          <Image
            src={section.fallbackBackground}
            alt=""
            widths={[900, 1600]}
            sizes="100vw"
            loading="lazy"
            class="plate__backdrop"
          />
        )
      )
    }
  </div>

  {/* ── Figures posées sur la planche ──────────────────────────────────── */}
  {
    figures.length > 0 && (
      <div class="plate__figures">
        {figures.map((figure) => (
          <figure class="plate__figure">
            {figure.image?.asset ? (
              <SanityImage
                image={figure.image}
                width={900}
                sizes="(min-width: 768px) 40vw, 80vw"
                class="plate__image"
              />
            ) : (
              /*
                `alt` vide : la légende adjacente porte la référence. Les visuels
                venus du CMS utilisent, eux, leur propre texte alternatif.
              */
              figure.fallbackImage && (
                <Image
                  src={figure.fallbackImage}
                  alt=""
                  widths={[400, 900]}
                  sizes="(min-width: 768px) 40vw, 80vw"
                  loading="lazy"
                  class="plate__image"
                />
              )
            )}

            {(figure.label.reference || figure.label.text) && (
              <FigureCaption
                reference={figure.label.reference}
                text={figure.label.text}
                class="plate__caption"
              />
            )}
          </figure>
        ))}
      </div>
      )
    }
  </div>
</section>

<style>
  .plate {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 7vh, 6rem);
  }

  .plate__grain {
    z-index: 0;
  }

  /*
    Référence de positionnement du fond de planche. Étant à l'intérieur de la
    section, il tient dans sa zone de contenu — donc à droite du retrait que la
    règle `html.rail-docked` réserve au menu.
  */
  .plate__inner {
    position: relative;
  }

  /* ── Fond ─────────────────────────────────────────────────────────────── */
  .plate__background {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .plate__backdrop {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      Fortement effacé : la planche imprimée sert de trame de fond, elle ne
      doit pas disputer l'attention aux figures posées dessus. `multiply`
      la fait mordre dans le papier au lieu de la poser comme un calque.
    */
    opacity: 0.4;
    mix-blend-mode: multiply;
  }

  /* ── Figures ──────────────────────────────────────────────────────────── */
  .plate__figures {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Écart large : c'est lui qui laisse le pli de la planche respirer. */
    gap: clamp(2rem, 11vw, 9rem);
    align-items: start;
    padding-inline: clamp(1.5rem, 4.5vw, 4.5rem);
  }

  .plate__figure {
    min-width: 0;
  }

  /*
    La figure de gauche déborde de la marge du bloc et vient chercher le bord.
    Le `overflow: hidden` de la section coupe ce qui dépasse, la largeur de page
    reste inchangée.

    Les deux marges se compensent : une marge négative seule élargirait la
    cellule, et la figure de gauche deviendrait plus grande que celle de droite.
    Ici le bloc se déplace sans changer de taille.
  */
  .plate__figure:first-child {
    --plate-shift: clamp(2.5rem, 7vw, 7rem);
    margin-inline-start: calc(-1 * var(--plate-shift));
    margin-inline-end: var(--plate-shift);
  }

  /*
    Menu ancré : le débord se limite exactement au retrait du bloc, si bien que
    la figure vient affleurer le bord de la zone de contenu sans jamais passer
    sous le rail. Sans ce plafond, le débord fixe la ferait glisser dessous —
    la section est décalée de `--rail-width`, mais la figure, elle, continuait
    de remonter vers la gauche.
  */
  :global(html.rail-docked) .plate__figure:first-child {
    --plate-shift: clamp(1.5rem, 4.5vw, 4.5rem);
  }

  .plate__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .plate__caption {
    margin-top: 0.6rem;
    font-size: var(--text-note);
    line-height: 1.4;
    color: var(--color-ink);
  }

  /* ── Mobile : la double page s'empile en une colonne ──────────────────── */
  @media (max-width: 767px) {
    .plate__figures {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 8vh, 4rem);
    }

    /* En colonne unique, le débord n'a plus de sens. */
    .plate__figure:first-child {
      margin-inline: 0;
    }
  }
</style>
