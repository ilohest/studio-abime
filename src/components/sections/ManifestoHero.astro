---
import Wordmark from '~/components/brand/Wordmark.astro';
import Stamp from '~/components/brand/Stamp.astro';
import { getLocaleMeta, type Locale } from '~/i18n/config';
import type { ManifestoHero } from '~/lib/sanity/types';

/**
 * Hero « manifeste » — double page imprimée.
 *
 * Mise en page figée (direction artistique), textes pilotés par Sanity.
 *
 * Le pli central est tracé en CSS et non peint dans la texture de fond :
 * le fond est en `cover`, donc recadré différemment à chaque largeur, alors
 * que le pli doit rester calé sur la colonne centrale. En CSS il reste net à
 * tous les DPR, ne pèse rien, et son écart/inclinaison restent réglables.
 */
interface Props {
  section: ManifestoHero;
  locale: Locale;
}

const { section, locale } = Astro.props;

// La date « (se modifie auto) » du document d'origine : recalculée à chaque rendu.
const today = new Intl.DateTimeFormat(getLocaleMeta(locale).htmlLang, {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(new Date());

/**
 * Une mention devient cliquable d'elle-même quand sa valeur est une adresse
 * e-mail ou une URL : l'éditeur saisit simplement « elodie@studioabime.com »
 * sans avoir à gérer un champ de lien séparé.
 */
function hrefFor(value: string): string | null {
  const trimmed = value.trim();
  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) return `mailto:${trimmed}`;
  if (/^https?:\/\//.test(trimmed)) return trimmed;
  return null;
}

const metaLines = (section.metaLines ?? []).map((line) => {
  const value = line.autoDate ? today : (line.value ?? '');
  return { label: line.label, value, href: hrefFor(value) };
});
---

<section class="manifesto surface-paper relative isolate flex min-h-[100svh] flex-col overflow-hidden">
  <div class="surface-paper-grain"></div>

  {/*
    Le pli : deux filets légèrement décalés, celui de droite très légèrement
    incliné. Ils débordent en hauteur (top/bottom négatifs) — une ligne pivotée
    ne toucherait plus les bords sinon.
  */}
  <div class="manifesto-fold" aria-hidden="true">
    <span class="manifesto-fold-line manifesto-fold-line--a"></span>
    <span class="manifesto-fold-line manifesto-fold-line--b"></span>
  </div>

  <div
    class="manifesto-layout relative z-10 grid flex-1 grid-cols-1 gap-x-12 gap-y-12 px-6 py-10 md:grid-cols-2 md:gap-y-16 md:px-10 md:py-16"
  >
    {
      metaLines.length > 0 && (
        <dl class="manifesto-meta type-note text-ink">
          {metaLines.map((line) => (
            <div class="flex gap-1">
              <dt>{line.label} :</dt>
              <dd>
                {line.href ? (
                  <a href={line.href} class="underline-offset-2 hover:underline">
                    {line.value}
                  </a>
                ) : (
                  line.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    {/*
      ── Page de gauche ────────────────────────────────────────────────
      En mobile la double page s'effondre en colonne unique : la marque
      passe alors en premier (`order`), pour que le logo reste au-dessus de
      la ligne de flottaison plutôt que rejeté après le manifeste.
    */}
    <div class="manifesto-left-page order-2 flex flex-col justify-between md:order-1">
      {/*
        Les décalages sont en MARGE et non en padding : `max-width` étant en
        border-box, un padding en % rognerait la largeur du texte et changerait
        les retours à la ligne du bloc.
      */}
      <div class="manifesto-notes mt-10 flex flex-col gap-10 md:mt-0 md:gap-14">
        {
          section.hypothesis && (
            <p class="type-note max-w-[34ch] md:ml-[16%]">
              <span class="uppercase">{section.hypothesisLabel ?? 'Hypothèse'}</span> :{' '}
              {section.hypothesis}
            </p>
          )
        }

        <div class="manifesto-stamp-mobile ml-auto mr-2 md:hidden">
          <Stamp variant="labo" class="w-24 text-ink" rotate={-8} />
        </div>

        {
          (section.intention?.length ?? 0) > 0 && (
            <div class="manifesto-intention md:mt-12 md:ml-[56%] md:max-w-[34ch]">
              <p class="type-note uppercase">{section.intentionLabel ?? 'Note d’intention'} :</p>

              <div class="mt-2 flex flex-col gap-2 md:mt-6 md:gap-4">
                {section.intention?.map((paragraph) => (
                  <p class="type-note">{paragraph}</p>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="mt-10 hidden md:mt-0 md:block">
        <Stamp variant="labo" class="w-20 text-ink md:w-28" rotate={-8} />
      </div>
    </div>

    {/* ── Page de droite ──────────────────────────────────────────────── */}
    <div
      class="manifesto-brand-page order-1 flex flex-col justify-center gap-10 md:order-2 md:justify-between md:gap-16 md:py-[12%]"
    >
      <div class="flex flex-1 items-center justify-center">
        <h1 class="w-full max-w-[30rem]">
          <Wordmark class="text-ink" />
        </h1>
      </div>

      {
        section.tagline && (
          <p class="type-note mx-auto max-w-[46ch] text-center text-balance" data-text-reveal>
            {section.tagline}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .manifesto-fold {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .manifesto-fold-line {
    position: absolute;
    /* Débordement vertical : une ligne inclinée ne rejoindrait pas les coins. */
    top: -9%;
    height: 118%;
    width: 1px;
    background: var(--color-ink);
  }

  /* Filet principal, parfaitement vertical, sur la colonne centrale. */
  .manifesto-fold-line--a {
    left: 50%;
  }

  /*
    Second filet : décalé de 3px et incliné de 0.35°. L'inclinaison suffit à
    faire lire un pli de papier plutôt qu'un trait vectoriel — l'écart entre
    les deux lignes s'ouvre progressivement du haut vers le bas.
  */
  .manifesto-fold-line--b {
    left: calc(50% + 2px);
    transform: rotate(0.35deg);
    transform-origin: center;
    background: var(--color-ink);
  }

  /* En mobile, la double page devient une page unique : plus de pli. */
  @media (max-width: 767px) {
    .manifesto-fold {
      display: none;
    }

    .manifesto-layout {
      padding-top: 1.25rem;
      padding-inline: 1.25rem;
    }

    .manifesto-meta {
      order: 0;
      max-width: calc(100% - 6rem);
    }

    .manifesto-brand-page {
      padding-top: 2rem;
    }

    .manifesto-notes {
      gap: 0;
      min-height: 12.375rem;
    }

    .manifesto-intention {
      position: absolute;
      right: 1.25rem;
      /* Relevée un peu au-dessus du bord bas, pour ne plus s'y coller. */
      bottom: 2.25rem;
      /* Même bord gauche que le repère et l'hypothèse au-dessus. */
      left: 1.25rem;
      max-width: none;
    }

    .manifesto-stamp-mobile {
      position: relative;
      z-index: 1;
    }
  }

  @media (min-width: 768px) {
    .manifesto-meta,
    .manifesto-left-page {
      grid-column: 1;
      grid-row: 1;
    }

    /*
      Les deux partagent la même cellule : les mentions en haut, le manifeste
      dessous (d'où les 12rem de retrait plus bas). Mais un élément de grille
      s'étire par défaut sur toute la hauteur de sa cellule — les deux boîtes
      se retrouvaient donc superposées au pixel près, et `.manifesto-left-page`,
      plus bas dans le DOM, recouvrait les mentions.

      Invisible à l'œil, les deux blocs étant transparents, mais l'adresse
      e-mail devenait impossible à cliquer : le clic atteignait le manifeste.

      `align-self: start` ramène les mentions à la hauteur de leur contenu, et
      le `z-index` leur rend la bande qu'elles occupent réellement. Le manifeste
      garde tout le reste.
    */
    .manifesto-meta {
      align-self: start;
      position: relative;
      z-index: 1;
    }

    .manifesto-left-page {
      padding-top: 12rem;
    }

    .manifesto-brand-page {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
