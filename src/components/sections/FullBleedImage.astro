---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import type { FullBleedImage } from '~/lib/sanity/types';

/**
 * Image pleine largeur — un visuel seul, d'un bord à l'autre.
 *
 * Aucun recadrage : l'image garde son format d'origine et la hauteur de la
 * section en découle.
 */
interface Props {
  section: FullBleedImage;
}

const { section } = Astro.props;
const hasSanityImage = Boolean(section.image?.asset);
---

<section class="bleed">
  <figure class="bleed__figure">
    {
      hasSanityImage ? (
        <SanityImage image={section.image} width={1800} sizes="100vw" class="bleed__image" />
      ) : (
        section.fallbackImage && (
          <Image
            src={section.fallbackImage}
            alt=""
            widths={[900, 1800]}
            sizes="100vw"
            loading="lazy"
            class="bleed__image"
          />
        )
      )
    }
  </figure>
</section>

<style>
  .bleed {
    position: relative;
  }

  .bleed__figure {
    margin: 0;
  }

  .bleed__image {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
