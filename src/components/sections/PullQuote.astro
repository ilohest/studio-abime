---
import { stegaClean } from '@sanity/client/stega';
import { sectionFieldAttribute } from '~/lib/visualEditing';
import type { PullQuote } from '~/lib/sanity/types';

interface Props {
  section: PullQuote;
  documentId?: string;
  documentType?: string;
}

const { section, documentId, documentType } = Astro.props;
// L'animation manipule la chaîne : les marqueurs invisibles de Visual Editing
// doivent être retirés pour ne pas être comptés comme des lettres.
const cleanText = stegaClean(section.text);

/*
  Les retirer rend le texte inéditable — l'overlay n'a plus rien à lire. On
  désigne donc le champ explicitement (voir `src/lib/visualEditing.ts`).
*/
const editable = sectionFieldAttribute(documentId, documentType, section._key, 'text');

let charIndex = 0;
const textLines = cleanText.split(/\n+/).map((line) => ({
  segments: line
    .trim()
    .split(/(\s+)/)
    .filter(Boolean)
    .map((value) => {
      const isWhitespace = /^\s+$/.test(value);

      return {
        value,
        isWhitespace,
        chars: isWhitespace
          ? []
          : Array.from(value).map((char) => ({ char, index: charIndex++ })),
      };
    }),
}));
---

<section class="pull-quote surface-paper" data-letter-reveal>
  <div class="pull-quote__grain surface-paper-grain"></div>

  <div class="pull-quote__inner">
    <blockquote class="pull-quote__text" aria-label={cleanText} data-sanity={editable}>
      <span class="pull-quote__lines" aria-hidden="true">
        {
          textLines.map((line, lineIndex) => (
            <>
              <span class="pull-quote__line">
                {line.segments.map((segment) =>
                  segment.isWhitespace ? (
                    segment.value
                  ) : (
                    <span class="pull-quote__word">
                      {segment.chars.map(({ char, index }) => (
                        <span class="pull-quote__char" data-char={char} data-char-index={index}>
                          {char}
                        </span>
                      ))}
                    </span>
                  ),
                )}
              </span>
              {lineIndex < textLines.length - 1 && ' '}
            </>
          ))
        }
      </span>
    </blockquote>
  </div>
</section>

<style>
  .pull-quote {
    position: relative;
    isolation: isolate;
    display: grid;
    /*
      `minmax(0, 1fr)` et non la colonne implicite : une colonne `auto` se
      dimensionne sur le contenu, et comme `place-items: center` empêche
      l'étirement, le bloc de citation prenait la largeur du texte mis sur une
      seule ligne — plusieurs milliers de pixels — au lieu de celle de la page.
      Les lignes n'avaient alors aucune largeur à laquelle se borner.
    */
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    overflow: hidden;
    min-height: 100svh;
    padding-block: clamp(5rem, 12vh, 9rem);
  }

  .pull-quote__grain {
    z-index: 0;
  }

  .pull-quote__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  /*
    Seul corps du site qui dépasse volontairement les 46 px de la charte : la
    citation est une prise de parole pleine page, dont les retours de ligne sont
    composés à la main dans le contenu. La ramener au token la casserait.
  */
  .pull-quote__text {
    font-family: var(--font-titre);
    font-size: clamp(1.7rem, 4.15vw, 4.35rem);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: var(--tracking-titre);
    text-align: center;
  }

  /* Chaque ligne garde la largeur de son texte et se centre. */
  .pull-quote__line {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
  }

  /*
    Les mots restent d'un seul tenant : seules les coupures naturelles entre
    eux servent au retour à la ligne, comme sur la référence éditoriale.
  */
  .pull-quote__word,
  .pull-quote__char {
    display: inline-block;
  }

  .pull-quote__word {
    white-space: nowrap;
  }

  .pull-quote__char {
    position: relative;
    color: var(--color-ink);
  }

  /*
    Amélioration progressive : sans JavaScript, le texte reste Encre. Le fond
    Sable n'est activé qu'une fois la progression de scroll initialisée.
  */
  .pull-quote[data-reveal-ready] .pull-quote__char {
    color: color-mix(in srgb, var(--color-ink) 20%, transparent);
  }

  .pull-quote__char::after {
    content: attr(data-char);
    position: absolute;
    inset: 0;
    color: var(--color-ink);
    opacity: var(--char-reveal, 0);
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .pull-quote {
      min-height: auto;
      padding-block: clamp(5rem, 15vh, 8rem);
    }

    .pull-quote__text {
      font-size: clamp(1.65rem, 7.8vw, 2.45rem);
      line-height: 1.1;
      letter-spacing: var(--tracking-titre);
    }

    .pull-quote__line {
      display: inline;
      width: auto;
      max-width: none;
      margin: 0;
    }
  }
</style>

<script>
  const revealSections = document.querySelectorAll<HTMLElement>('[data-letter-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  type RevealSection = {
    section: HTMLElement;
    text: HTMLElement;
    chars: HTMLElement[];
  };

  const reveals: RevealSection[] = Array.from(revealSections).flatMap((section) => {
    const text = section.querySelector<HTMLElement>('.pull-quote__text');
    if (!text) return [];

    return [
      {
        section,
        text,
        chars: Array.from(section.querySelectorAll<HTMLElement>('[data-char-index]')),
      },
    ];
  });

  let ticking = false;

  const setProgress = ({ chars }: RevealSection, progress: number) => {
    // Une petite zone de fondu adoucit le front de révélation, comme sur la
    // référence où plusieurs lettres sont simultanément entre 20 % et 100 %.
    const feather = 6;
    const sweep = progress * (chars.length + feather);

    chars.forEach((char, index) => {
      const reveal = Math.min(Math.max((sweep - index) / feather, 0), 1);
      char.style.setProperty('--char-reveal', reveal.toFixed(3));
    });
  };

  const update = () => {
    ticking = false;

    for (const reveal of reveals) {
      reveal.section.toggleAttribute('data-reveal-ready', !reducedMotion.matches);

      if (reducedMotion.matches) {
        setProgress(reveal, 1);
        continue;
      }

      const top = reveal.text.getBoundingClientRect().top;
      const viewport = window.innerHeight;

      /*
        Même rythme que la référence : le balayage commence quand le texte
        entre franchement dans l’écran et se termine autour de son tiers haut.
      */
      const start = viewport * 0.9;
      const end = viewport * 0.2;
      const progress = Math.min(Math.max((start - top) / (start - end), 0), 1);

      setProgress(reveal, progress);
    }
  };

  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
  reducedMotion.addEventListener('change', requestUpdate);
  update();
</script>
