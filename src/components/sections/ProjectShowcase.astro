---
import { Image } from 'astro:assets';
import SanityImage from '~/components/primitives/SanityImage.astro';
import { projectPath } from '~/i18n/routes';
import type { Locale } from '~/i18n/config';
import type { ProjectShowcase } from '~/lib/sanity/types';

/**
 * Sélection de projets — planche défilante.
 *
 * Les visuels sont posés côte à côte, légèrement de travers, et se parcourent
 * horizontalement : ceux qui dépassent du cadre se découvrent au défilement.
 *
 * Chaque image garde son format d'origine. Seule la LARGEUR est imposée ; la
 * hauteur suit. C'est la variété des proportions qui compose la planche —
 * fixer les deux dimensions la ramènerait à une grille régulière.
 */
interface Props {
  section: ProjectShowcase;
  locale: Locale;
}

const { section, locale } = Astro.props;
const start = section.startNumber ?? 1;

/** Le CMS fournit des projets ; le contenu d'amorçage, des visuels groupés. */
const items = (section.projects?.length ?? 0) > 0
  ? (section.projects ?? []).map((project, index) => ({
      key: project._id,
      title: project.title,
      href: projectPath(locale, project.slug),
      /* Même règle que la page portfolio : la vignette prime, la couverture supplée. */
      image: project.thumbnail?.asset ? project.thumbnail : project.coverImage,
      fallbackImage: undefined,
      number: String(start + index).padStart(2, '0'),
    }))
  : (section.fallbackItems ?? []).map((item, index) => ({
      key: item._key,
      title: item.title,
      href: item.href,
      image: null,
      fallbackImage: item.fallbackImage,
      number: String(start + index).padStart(2, '0'),
    }));
---

{
  items.length > 0 && (
    <section class="showcase surface-paper">
      <div class="showcase__grain surface-paper-grain"></div>

      {/*
        `tabindex` sur la zone défilante : sans lui, un utilisateur au clavier
        ne peut pas atteindre les visuels sortis du cadre.

        `data-cursor-interactive` : le curseur système étant masqué, un
        `cursor: grab` ne s'afficherait jamais. C'est donc l'anneau du curseur
        personnalisé qui signale que la planche se parcourt à la souris.
      */}
      <div
        class="showcase__track"
        data-drag-scroll
        data-cursor-interactive
        tabindex="0"
        role="group"
        aria-label="Sélection de projets"
      >
        {items.map((item) => (
          <figure class="showcase__item">
            <a href={item.href} class="showcase__link">
              {item.image ? (
                <SanityImage
                  image={item.image}
                  width={900}
                  sizes="(min-width: 768px) 22vw, 60vw"
                  alt={item.title}
                  class="showcase__image"
                />
              ) : (
                item.fallbackImage && (
                  <Image
                    src={item.fallbackImage}
                    alt={item.title}
                    widths={[400, 900]}
                    sizes="(min-width: 768px) 22vw, 60vw"
                    loading="lazy"
                    class="showcase__image"
                  />
                )
              )}
            </a>

            <figcaption class="showcase__caption">
              <span>fig.</span>
              <span>({item.number})</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 10vh, 8rem);
  }

  .showcase__grain {
    z-index: 0;
  }

  .showcase__track {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 4rem);
    overflow-x: auto;
    /* Le défilement horizontal ne doit pas entraîner la page avec lui. */
    overscroll-behavior-x: contain;
    /*
      Le défilement doux global rendrait chaque image du glissement à la souris
      poursuivie plutôt qu'immédiate : la planche traînerait derrière le curseur.
    */
    scroll-behavior: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
    /* Place laissée sous les visuels pour que la rotation ne soit pas rognée. */
    padding-block: 1.5rem;
    scrollbar-width: none;
  }

  .showcase__track::-webkit-scrollbar {
    display: none;
  }

  .showcase__track:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .showcase__item {
    flex: 0 0 auto;
    /* Seule la largeur est imposée : la hauteur suit le format de l'image. */
    width: clamp(11rem, 22vw, 22rem);
    margin: 0;
    transform: rotate(var(--tilt, 0deg));
  }

  /*
    Inclinaisons alternées, volontairement faibles et irrégulières : des angles
    identiques donneraient une trame répétitive plutôt qu'une pose à la main.
  */
  .showcase__item:nth-child(4n + 1) {
    --tilt: -1.1deg;
  }

  .showcase__item:nth-child(4n + 2) {
    --tilt: 0.7deg;
  }

  .showcase__item:nth-child(4n + 3) {
    --tilt: -0.5deg;
  }

  .showcase__item:nth-child(4n + 4) {
    --tilt: 1.3deg;
  }

  .showcase__link {
    display: block;
  }

  .showcase__image {
    display: block;
    width: 100%;
    height: auto;
    /*
      Sans cela, tirer sur une image déclencherait le glisser-déposer natif du
      navigateur au lieu de faire défiler la planche.
    */
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Pendant le glissement, aucune sélection de texte ne doit se former. */
  .showcase__track[data-dragging] {
    user-select: none;
  }

  .showcase__caption {
    display: flex;
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: 0.9rem;
    font-family: var(--font-annotation);
    font-style: italic;
    font-size: clamp(0.95rem, 1.4vw, 1.35rem);
    letter-spacing: var(--tracking-annotation);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__item {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Glissement à la souris — parcourir la planche en cliquant et tirant.
   *
   * Réservé au pointeur souris : sur tactile, le défilement natif est déjà là,
   * avec son inertie. Le reproduire en JavaScript ne ferait que la supprimer.
   */
  const tracks = document.querySelectorAll<HTMLElement>('[data-drag-scroll]');

  /** Au-delà de ce déplacement, le geste est un glissement, plus un clic. */
  const DRAG_THRESHOLD = 5;

  for (const track of tracks) {
    let pointerId: number | null = null;
    let startX = 0;
    let startLeft = 0;
    let travelled = 0;

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;

      pointerId = event.pointerId;
      startX = event.clientX;
      startLeft = track.scrollLeft;
      travelled = 0;

      // La capture garde le geste vivant même si le curseur sort de la planche.
      track.setPointerCapture(pointerId);
      track.setAttribute('data-dragging', '');
    });

    track.addEventListener('pointermove', (event) => {
      if (pointerId === null || event.pointerId !== pointerId) return;

      const delta = event.clientX - startX;
      travelled = Math.max(travelled, Math.abs(delta));
      track.scrollLeft = startLeft - delta;
    });

    const endDrag = (event: PointerEvent) => {
      if (pointerId === null || event.pointerId !== pointerId) return;

      if (track.hasPointerCapture(pointerId)) track.releasePointerCapture(pointerId);
      pointerId = null;
      track.removeAttribute('data-dragging');
    };

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    /*
      Un glissement se termine par un `click` sur le visuel relâché dessous.
      On l'intercepte à la capture, avant qu'il n'atteigne le lien : sans cela,
      parcourir la planche ouvrirait un projet au hasard.
      `travelled` n'est remis à zéro qu'au clic suivant, donc il est encore
      lisible ici — `click` survient après `pointerup`.
    */
    track.addEventListener(
      'click',
      (event) => {
        if (travelled > DRAG_THRESHOLD) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );
  }
</script>
