---
import { resolveLink } from '~/lib/routing';
import type { Locale } from '~/i18n/config';
import type { SanityLink } from '~/lib/sanity/types';

/**
 * Rend un lien Sanity. Ne produit RIEN si le lien est incomplet côté CMS
 * (destination manquante), plutôt qu'un `<a href="undefined">`.
 */
interface Props {
  link?: SanityLink | null;
  locale: Locale;
  class?: string;
  /** Libellé de repli si le CMS n'en fournit pas. */
  fallbackLabel?: string;
  /** Ajoute la flèche coudée commune aux appels à l'action. */
  arrow?: boolean;
}

const { link, locale, class: className, fallbackLabel, arrow = false } = Astro.props;
const resolved = resolveLink(link, locale);
const label = resolved?.label || fallbackLabel;
// Les anciens contenus pouvaient inclure leur propre flèche dans le libellé.
const visibleLabel = arrow ? label?.replace(/\s*(?:→|↳)\s*/gu, '') : label;
---

{
  resolved && label && (
    <a
      href={resolved.href}
      class={className}
      {...(resolved.openInNewTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <slot>
        <span class={arrow ? 'button-minimal__label' : undefined}>{visibleLabel}</span>
        {arrow && <span class="button-minimal__arrow" aria-hidden="true">↳</span>}
      </slot>
    </a>
  )
}
