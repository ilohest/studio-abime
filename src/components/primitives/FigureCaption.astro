---
import { figureLabel } from '~/lib/figureLabel';

interface Props {
  /** Légende complète, telle qu'elle est saisie dans Sanity. */
  value?: string;
  /** Compatibilité avec les anciens contenus à deux champs. */
  reference?: string;
  text?: string;
  as?: 'figcaption' | 'p' | 'span';
  class?: string;
  id?: string;
  /**
   * Attribut `data-sanity` désignant le champ d'où vient la légende
   * (`src/lib/visualEditing.ts`).
   *
   * Il ne sert QU'AU REPÈRE de tête. Le reste de la légende porte encore sa
   * traîne d'édition visuelle et reste cliquable tout seul : `figureLabel()`
   * détache le repère par le DÉBUT de la chaîne, or la traîne est accrochée à
   * la fin — elle part donc avec le texte, et le repère se retrouve seul,
   * lisible mais inerte.
   */
  editable?: string;
}

const {
  value,
  reference,
  text,
  as: Tag = 'figcaption',
  class: className,
  editable,
  ...attributes
} = Astro.props as Props;

const label = value === undefined
  ? figureLabel(reference, text)
  : figureLabel(value);
---

{
  (label.reference || label.text) && (
    <Tag class:list={['figure-caption', className]} {...attributes}>
      {label.reference && (
        <span class="figure-caption__prefix">
          <span class="figure-caption__reference" data-sanity={editable}>
            {label.reference}
          </span>
          {label.text && <span class="figure-caption__separator"> - </span>}
        </span>
      )}
      {label.text && <span class="figure-caption__text">{label.text}</span>}
    </Tag>
  )
}
