---
import { stegaClean } from '@sanity/client/stega';

import ProjectElementCell from '~/components/project/ProjectElementCell.astro';

import StandardTemplate from './StandardTemplate.astro';
import ImmersiveTemplate from './ImmersiveTemplate.astro';
import EditorialTemplate from './EditorialTemplate.astro';
import SplitTemplate from './SplitTemplate.astro';
import BannerTemplate from './BannerTemplate.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';
import { resolveImage } from '~/lib/sanity/image';

/**
 * Registre des modèles de page projet.
 *
 * Pendant exact de `sanity/lib/projectTemplates.ts` (côté CMS).
 * Un modèle inconnu — schéma déployé avant le rendu, ou valeur héritée —
 * retombe sur le modèle standard : la page reste toujours affichable.
 *
 * ➜ AJOUTER UN MODÈLE : créer le composant, l'importer, ajouter un `case`,
 *    puis déclarer l'entrée correspondante dans `sanity/lib/projectTemplates.ts`.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;

const Template = (() => {
  switch (stegaClean(project.template)) {
    case 'immersive':
      return ImmersiveTemplate;
    case 'editorial':
      return EditorialTemplate;
    case 'split':
      return SplitTemplate;
    case 'banner':
      return BannerTemplate;
    case 'standard':
    default:
      return StandardTemplate;
  }
})();

const background = resolveImage(project.backgroundImage, { width: 2560, quality: 86 });
const backgroundOpacity = Math.min(100, Math.max(0, project.backgroundOpacity ?? 100)) / 100;
---

<div class="project-page-shell">
  {
    background && (
      <div
        class="project-page-background"
        style={`background-image:url("${background.src}");opacity:${backgroundOpacity}`}
        aria-hidden="true"
      />
    )
  }

  {/*
    C'est la case que le visiteur vient de quitter, qu'il retrouve en ouvrant la
    page. Posée hors du flux, en haut à DROITE : elle ne repousse alors rien
    vers le bas, et le lien de retour garde sa place en haut à gauche.
  */}
  <div class="project-page-cell container-wide" aria-hidden="true">
    <ProjectElementCell project={project} class="project-page-cell__unit" />
  </div>

  <Template project={project} locale={locale} />
</div>

<style>
  .project-page-shell {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
  }

  .project-page-cell {
    position: absolute;
    z-index: 2;
    inset: clamp(1.5rem, 3vw, 2.5rem) 0 auto;
    pointer-events: none;
  }

  .project-page-cell :global(.project-page-cell__unit) {
    margin-inline-start: auto;
  }

  .project-page-background {
    position: fixed;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    pointer-events: none;
  }
</style>
