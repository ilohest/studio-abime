---
import { stegaClean } from '@sanity/client/stega';

import ProjectElementCell from '~/components/project/ProjectElementCell.astro';
import ProjectBackLink from '~/components/project/ProjectBackLink.astro';
import ProjectFacts from '~/components/project/ProjectFacts.astro';

import SplitTemplate from './SplitTemplate.astro';
import BannerTemplate from './BannerTemplate.astro';
import CompositionTemplate from './CompositionTemplate.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/**
 * Registre des modèles de page projet.
 *
 * Pendant exact de `sanity/lib/projectTemplates.ts` (côté CMS).
 * Un modèle inconnu — schéma déployé avant le rendu, valeur héritée, ou modèle
 * retiré depuis — retombe sur « Colonne fixe » : la page reste toujours
 * affichable, et c'est la mise en page dont le contenu des anciens modèles
 * s'accommode le mieux.
 *
 * ➜ AJOUTER UN MODÈLE : créer le composant, l'importer, ajouter un `case`,
 *    puis déclarer l'entrée correspondante dans `sanity/lib/projectTemplates.ts`.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;

/*
  Résolu, et non brut : un projet peut encore porter le nom d'un modèle retiré.
  L'attribut posé sur la page doit alors désigner le modèle RÉELLEMENT rendu,
  sans quoi les règles qui s'y accrochent — le retrait du cartouche de tête —
  ne s'appliqueraient pas.
*/
const requested = stegaClean(project.template);
const template =
  requested === 'banner' || requested === 'composition' ? requested : 'split';

const Template = (() => {
  switch (template) {
    case 'banner':
      return BannerTemplate;
    case 'composition':
      return CompositionTemplate;
    default:
      return SplitTemplate;
  }
})();

---

<div class="project-page-shell" data-project-shell data-template={template}>
  {/*
    Copie mobile du lien de retour — même parti que le relevé du gabarit
    « Colonne fixe », qui rend le sien deux fois : le lien vit DANS le gabarit,
    à la place que sa mise en page lui donne au bureau — en tête de la colonne
    fixe, où il reste visible tant qu'elle colle. Sous 900 px, le cartouche
    rentre dans le flux et passait devant lui : on lisait la case et le relevé
    avant de savoir comment revenir. Un second lien ouvre donc la page, et
    celui du gabarit s'efface — comme en tête d'un article du Journal.
  */}
  <div class="project-page-back container-wide">
    <ProjectBackLink locale={locale} />
  </div>

  {/*
    Le cartouche de tête : la case que le visiteur vient de quitter, et sous
    elle le relevé du projet. Posé hors du flux, en haut à DROITE — il ne
    repousse alors rien vers le bas, et le lien de retour garde sa place en haut
    à gauche. Les gabarits ne portent plus la fiche : elle est ici, une fois
    pour les cinq.
  */}
  <div class="project-page-aside container-wide">
    <div class="project-page-aside__unit">
      <ProjectElementCell project={project} />
      <ProjectFacts project={project} locale={locale} class="project-page-aside__facts" />
    </div>
  </div>

  <Template project={project} locale={locale} />
</div>

<script>
  /*
    Hauteur réelle du cartouche de tête, publiée en variable CSS. Les gabarits
    dont la colonne de droite commence en haut — « Colonne fixe », « Bandeau » —
    s'en servent pour démarrer dessous. Une valeur écrite à la main ne tiendrait
    pas : le relevé compte deux lignes ou six selon le projet.
  */
  document.querySelectorAll<HTMLElement>('[data-project-shell]').forEach((shell) => {
    const aside = shell.querySelector<HTMLElement>('.project-page-aside__unit');
    if (!aside) return;

    const publish = () => {
      shell.style.setProperty('--project-aside-height', `${Math.ceil(aside.getBoundingClientRect().height)}px`);
    };

    publish();
    if ('ResizeObserver' in window) new ResizeObserver(publish).observe(aside);
    document.fonts?.ready.then(publish);
  });
</script>

<style>
  .project-page-shell {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
  }

  .project-page-aside {
    position: absolute;
    z-index: 2;
    inset: clamp(1.5rem, 3vw, 2.5rem) 0 auto;
    /*
      Le bloc ne capte rien : il ne porte que du texte et une case muette. Les
      liens qu'il contient — les canaux du projet — le redemandent pour eux.
    */
    pointer-events: none;
  }

  /*
    La case se cale sur le BORD du cartouche, pas sur son début : elle est plus
    étroite que le relevé, et alignée à gauche elle rentrait dans la page au
    lieu de tenir le coin. Le relevé, lui, garde toute la largeur.
  */
  .project-page-aside__unit {
    display: flex;
    width: min(20rem, 100%);
    flex-direction: column;
    align-items: flex-end;
    margin-inline-start: auto;
    gap: clamp(1.1rem, 2vw, 1.6rem);
  }

  .project-page-aside :global(.project-page-aside__facts) {
    align-self: stretch;
  }

  /*
    « Colonne fixe » : la planche de droite n'est pas tenue par le conteneur de
    page, elle va jusqu'au bord de l'écran moins son propre retrait — plus large
    que la gouttière. Le cartouche s'alignait donc sur un bord que rien d'autre
    ne suivait, et la case dépassait les images d'une vingtaine de pixels. Il
    reprend ici le retrait de la planche : un seul bord droit pour toute la page.
  */
  @media (min-width: 900px) {
    .project-page-shell[data-template='split'] .project-page-aside {
      max-width: none;
      padding-inline-end: var(--project-plate-inset);
    }
  }

  .project-page-aside :global(a) {
    pointer-events: auto;
  }

  /* Au bureau, le lien du gabarit suffit : celui-ci n'existe que pour le flux. */
  .project-page-back {
    display: none;
  }

  /*
    Sous 900 px, la colonne de droite n'a plus la largeur d'accueillir le
    cartouche. Il rentrerait dans le flux, mais EN TÊTE — avant le titre : la
    page s'ouvrirait sur un sigle et un numéro sans dire de quel projet il
    s'agit. Il s'efface donc ici, et chaque gabarit rend le sien après son
    titre (`ProjectMobileHead`). Rien ne disparaît : c'est le même contenu, à
    sa place dans l'ordre de lecture.
  */
  @media (max-width: 899px) {
    .project-page-back {
      display: block;
      /*
        C'est lui, désormais, qui démarre la page : il porte le dégagement de la
        barre de marque, fixée en haut de l'écran sous 767 px (au-dessus,
        `--mobile-brand-clearance` vaut zéro et le `max` retombe sur l'écart
        courant).
      */
      padding-top: max(clamp(1.5rem, 3vw, 2.5rem), var(--mobile-brand-clearance));
    }

    /*
      Le lien que porte le gabarit s'efface : les deux se suivraient à trois
      lignes d'intervalle. Ciblé par la racine du gabarit — un `<article>`,
      chez les trois — plutôt que par une négation.
    */
    .project-page-shell > :global(article) :global(.back-link) {
      display: none;
    }

    .project-page-aside {
      display: none;
    }
  }


</style>
