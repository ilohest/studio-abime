---
import JournalComposition from '~/components/journal/JournalComposition.astro';
import NextProject from '~/components/project/NextProject.astro';
import ProjectBreadcrumb from '~/components/project/ProjectBreadcrumb.astro';
import ProjectHeading from '~/components/project/ProjectHeading.astro';
import ProjectMobileHead from '~/components/project/ProjectMobileHead.astro';
import ProjectConstellation from '~/components/project/ProjectConstellation.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/**
 * Modèle COMPOSITION LIBRE — le projet raconté comme un article.
 *
 * Les deux autres modèles imposent une architecture : une colonne fixe et sa
 * planche, ou un bandeau sous un texte. Celui-ci n'impose rien. Le corps de la
 * page est la suite exacte des blocs saisis — textes, figures, notes de marge —
 * rendue par le composant même qui compose les articles du Journal. Une seule
 * grammaire de mise en page pour les deux, apprise une fois.
 *
 * La composition s'affiche à l'échelle de la « planche illustrée » : dans un
 * projet, l'image pèse plus que dans un article de recherche.
 *
 * Pas de visuel de tête : la vignette du projet sert les listes et la table des
 * éléments. La composition ouvre sur ce que l'éditrice a placé en premier, et
 * l'imposer avant elle ferait doublon avec sa première figure.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;

const blocks = project.blocks ?? [];
---

<article class="composition">
  <div class="composition__inner container-wide">
    <ProjectBreadcrumb locale={locale} title={project.title} />

    <ProjectMobileHead
      project={project}
      locale={locale}
      part="cell"
      class="composition__mobile-cell"
    />

    <div class="composition__heading">
      <ProjectHeading project={project} />
    </div>

    <div class="composition__facts-row">
      <div class="composition__facts-column">
        <ProjectMobileHead
          project={project}
          locale={locale}
          part="facts"
          class="composition__mobile-facts"
        />
      </div>
    </div>

    {
      blocks.length > 0 && (
        <div class="composition__body">
          <JournalComposition blocks={blocks} locale={locale} />
        </div>
      )
    }
  </div>

  {/*
    Le générique, en clôture : qui a travaillé sur ce projet. Il vient après le
    contenu et avant le renvoi au projet suivant — on nomme les gens une fois le
    travail montré. Rien ne se rend si la fiche ne désigne aucune étoile.
  */}
  <ProjectConstellation project={project} locale={locale} />

  <NextProject project={project.next} locale={locale} />
</article>

<style>
  /* Le fil d'Ariane reprend le même départ vertical que partout ailleurs. */
  .composition__inner {
    padding-block: var(--spacing-breadcrumb-start) clamp(3rem, 8vw, 6rem);
  }

  /* Le titre occupe toute la largeur disponible quand le cartouche est mobile. */
  .composition__heading {
    max-width: 44rem;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    /*
      Dans ce gabarit seulement, le relevé suit le titre dans le flux : un
      titre long ne peut plus passer dessous. La case reste dans le coin haut
      droit via `ProjectTemplateRenderer`; sous 900 px, les règles mobiles du
      composant reprennent naturellement la main.
    */
    .composition :global(.composition__mobile-facts) {
      display: flex;
      width: min(20rem, 100%);
      flex-direction: column;
      align-items: flex-end;
      margin: clamp(3rem, 6vw, 4.5rem) 0 0 auto;
    }
  }

  /*
    Lorsque les deux colonnes de la composition sont présentes, le relevé
    appartient à la colonne de lecture : son bord droit rejoint celui du texte.
    Les 11 rem de marge et leur gouttière restent entièrement disponibles pour
    les notes et les figures.
  */
  @media (min-width: 1024px) {
    /*
      La réserve de la marge ne commence qu'avec la vraie mise en page à deux
      colonnes. En dessous, le titre reste centré sur toute la largeur utile.
    */
    .composition__heading {
      --composition-aside-gap: clamp(1.5rem, 3vw, 2.75rem);
      --composition-aside-space: calc(11rem + var(--composition-aside-gap));

      width: min(100%, calc(58rem + var(--composition-aside-space)));
      max-width: none;
      padding-right: var(--composition-aside-space);
    }

    .composition__facts-row {
      display: grid;
      grid-template-columns: minmax(0, 58rem) 11rem;
      column-gap: clamp(1.5rem, 3vw, 2.75rem);
      justify-content: center;
    }

    .composition__facts-column {
      grid-column: 1;
      width: 100%;
      justify-self: stretch;
    }

    .composition :global(.composition__mobile-facts) {
      margin-right: 0;
    }
  }

  /*
    Le dégagement de la barre de marque est porté par le lien de retour, en tête
    de page (voir `ProjectTemplateRenderer`) : le gabarit le reprenait à son
    compte, et l'écart se comptait deux fois avant le titre.
  */
  @media (max-width: 899px) {
    .composition__inner {
      padding-block-start: 0;
    }

  }

  /*
    Même respiration entre l'ouverture éditoriale et le premier bloc que dans
    un article (`JournalPost`). Le cartouche de spécifications vit dans sa
    colonne et ne doit plus dilater le rythme de la colonne de lecture.
  */
  .composition__body {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* L'écart d'avant le corps est déjà porté par le cartouche mobile. */
  @media (max-width: 899px) {
    .composition__body {
      margin-top: 0;
    }
  }
</style>
