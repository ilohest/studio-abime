---
import { stegaClean } from '@sanity/client/stega';

import SanityImage from '~/components/primitives/SanityImage.astro';
import SectionRenderer from '~/components/sections/SectionRenderer.astro';
import ProjectFacts from '~/components/project/ProjectFacts.astro';
import NextProject from '~/components/project/NextProject.astro';
import ProjectBackLink from '~/components/project/ProjectBackLink.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/**
 * Modèle IMMERSIF — couverture pleine hauteur sur fond sombre, titre en
 * surimpression, fiche projet à la suite. Pour les cas clients très visuels.
 *
 * La couleur d'accent vient de `templateOptions.accent` et n'est appliquée
 * qu'au titre : la palette reste maîtrisée quel que soit le choix de l'éditeur.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const options = project.templateOptions ?? {};

const accentClass = {
  lumiere: 'text-lumiere',
  ciel: 'text-ciel',
  sable: 'text-sable',
  papier: 'text-papier',
}[stegaClean(options.accent) ?? 'lumiere'];
---

<article>
  <header class="surface-invert relative flex min-h-screen flex-col justify-end overflow-hidden">
    {
      project.coverVideoUrl ? (
        <video
          src={project.coverVideoUrl}
          class="absolute inset-0 h-full w-full object-cover opacity-70"
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
        />
      ) : (
        project.thumbnail && (
          <SanityImage
            image={project.thumbnail}
            width={1920}
            ratio="cinema"
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover opacity-70"
          />
        )
      )
    }

    <ProjectBackLink locale={locale} class="absolute top-8 left-6 z-10 md:left-10" />

    <div class="relative container-wide pb-20">
      <h1
        class:list={['type-titre max-w-5xl text-balance text-[clamp(2.5rem,7vw,5rem)]', accentClass]}
        data-text-reveal
      >
        {project.title}
      </h1>
      {project.headline && <p class="type-copy mt-6 max-w-prose text-pretty" data-text-reveal>{project.headline}</p>}
    </div>
  </header>

  <div class="container-wide pt-16">
    <ProjectFacts project={project} locale={locale} />
  </div>

  <SectionRenderer sections={project.sections} locale={locale} />

  <NextProject project={project.next} locale={locale} />
</article>
