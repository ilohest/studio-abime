---
import SanityImage from '~/components/primitives/SanityImage.astro';
import SectionRenderer from '~/components/sections/SectionRenderer.astro';
import NextProject from '~/components/project/NextProject.astro';
import ProjectBackLink from '~/components/project/ProjectBackLink.astro';

import type { Locale } from '~/i18n/config';
import type { Project } from '~/lib/sanity/types';

/**
 * Modèle STANDARD — en-tête sobre, fiche projet en colonne latérale,
 * puis contenu modulaire. Convient à la majorité des cas clients.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
---

<article>
  <header class="container-wide standard__header pb-12">
    <ProjectBackLink locale={locale} class="mb-10" />
    <h1 class="type-titre max-w-4xl text-balance" data-text-reveal>{project.title}</h1>
    {project.headline && <p class="type-copy mt-6 max-w-prose text-pretty" data-text-reveal>{project.headline}</p>}
  </header>

  {
    project.thumbnail && (
      <div class="container-wide">
        <SanityImage
          image={project.thumbnail}
          width={1920}
          ratio="landscape"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full object-cover"
        />
      </div>
    )
  }

  <div class="container-wide mt-16 grid gap-12 lg:grid-cols-[1fr_18rem] lg:items-start">
    <div class="order-2 lg:order-1">
      <SectionRenderer sections={project.sections} locale={locale} />
    </div>

    <aside class="order-1 lg:order-2 lg:sticky lg:top-12">
    </aside>
  </div>

  <NextProject project={project.next} locale={locale} />
</article>

<style>
  /* La page démarre sous la barre de marque, fixée en haut de l'écran en mobile. */
  .standard__header {
    padding-top: max(4rem, var(--mobile-brand-clearance));
  }
</style>
