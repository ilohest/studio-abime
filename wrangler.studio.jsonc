{
  "$schema": "node_modules/wrangler/config-schema.json",

  /*
    LE STUDIO, DÉPLOYÉ À PART
    ─────────────────────────
    Configuration distincte de `wrangler.jsonc`, qui est celle du site : les deux
    applications vivent dans ce dépôt mais partent vers deux projets Cloudflare
    séparés (voir README § Déploiement). Le nom de fichier est passé à la
    commande de déploiement du projet « Studio » :

        npx wrangler deploy --config wrangler.studio.jsonc

    Aucun `main` ici, à la différence du site : le Studio est une application
    entièrement statique, sans code serveur. Cloudflare sert les fichiers, rien
    de plus — et rien n'est facturé.
  */
  "name": "studio-abime-studio",
  "compatibility_date": "2026-08-26",

  "assets": {
    "directory": "./dist-studio",

    /*
      Le Studio est une application à routage client : rafraîchir la page sur
      `/structure/project;abc` demande un fichier qui n'existe pas sur le
      disque. Cette valeur renvoie alors `index.html`, qui relit l'URL et
      restitue la vue attendue.

      C'est la SEULE façon de le faire ici. Un `_redirects` portant la règle
      `/* /index.html 200` — la convention Cloudflare Pages — fait échouer le
      déploiement : le serveur d'assets retire de lui-même les `/index` et les
      `.html`, `/index.html` redevient `/`, qui redéclenche `/*`, et l'API
      refuse la boucle (code 100324).
    */
    "not_found_handling": "single-page-application"
  }
}
