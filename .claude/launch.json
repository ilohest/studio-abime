{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "sanity-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "studio:dev"
      ],
      "port": 3333
    },
    {
      "name": "astro-dev-ouvert",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "MAINTENANCE_MODE=off npx astro dev --port 4321"
      ],
      "port": 4321
    }
  ]
}
